using System;
using System.Collections.Generic;
using System.IO;
using EpicGames.Core;
using Microsoft.Extensions.Logging;
using UnrealBuildBase;

namespace UnrealBuildTool
{
	class SimplyStreamToolChain : ClangToolChain
	{
		const int Memory32CompatibilityEpoch = 25;

		public enum MemoryMode
		{
			Memory32,
			Memory64,
			Memory64_Emulated,
		};

		internal static MemoryMode ParseMemoryMode(string? Name)
		{
			if (string.IsNullOrWhiteSpace(Name))
			{
				return MemoryMode.Memory64_Emulated;
			}
			return Name switch
			{
				"Memory64_Emulated" => MemoryMode.Memory64_Emulated,
				"Memory32" => MemoryMode.Memory32,
				"Memory64" => MemoryMode.Memory64,
				_ => throw new BuildException(
					$"Unknown EmscriptenMemoryMode '{Name}'. Expected Memory32, Memory64, or Memory64_Emulated."),
			};
		}

		protected static string? ClangPath;
		protected static string? ArPath;

		// ini configurations
		static bool enableMultithreading = true;
		static bool mt_lowthreads = true;
		static bool enableTracing = false; // Debug option
		static string ltoMode = "none";
		static readonly HashSet<string> NoLtoModules = new HashSet<string>(StringComparer.Ordinal)
		{
			"IoStoreOnDemand",             // Shipping memory64: keep startup delegate/container code out of full-LTO merging
			"IoStoreOnDemandCore",         // paired factory/callback side of the same Shipping startup path
			"WebGPURHI",                    // the WebGPU RHI — the core rendering IP
			"webgpu_utils",                 // WebGPU proxy/cache layer (Wonder)
			"wgsl_pack",                    // WGSL shader packing (Wonder)
			"wasm_utils",                   // asset tracker / cache client / pthreadfs (Wonder)
			"SimplyStreamJS",               // JS bridge
			"SimplyStreamPlatformFeatures", // platform features
			"SimplyStreamAudioMixer",       // audio mixer
		};
		static string profilerMode = "none";
		static bool enableShippingAssertions = true;
		//static bool preserveSymbolsShipping = false;
		static int initialMemoryMB = 256;
		static int maximumMemoryMB = 8192;
		static bool useUnrealInsights = false;
		static bool useUBsan = false;
		static bool useAsan = false;
		static bool useLsan = false;
		static bool enableSAFE_HEAP = false; // DIAG done 2026-08-19: SAFE_HEAP found 0 heap OOB writes (recursion, not stray write); alignment strictness false-positives on IoStore
		static bool enableAA = true;
		static bool enableDebug = false;
		static bool enableDwarf5 = false; // debugging doesnt work well without this enabled, can crash compiler
		static bool _enableSIMD = true;
		static bool buildForNode = false;
		static bool maximumOptimizations = false;
		//static bool optimizeForFastDevBuilds = false;
		readonly MemoryMode memoryMode;
		bool IsMemory32 => memoryMode == MemoryMode.Memory32;
		int Memory64Setting => memoryMode switch
		{
			MemoryMode.Memory32 => 0,
			MemoryMode.Memory64 => 1,
			MemoryMode.Memory64_Emulated => 2,
			_ => throw new BuildException($"Unsupported Emscripten memory mode: {memoryMode}"),
		};

		public static bool enableSIMD
		{
			get
			{
				return _enableSIMD;
			}
		}

		public static string libExt { get { return ".a"; } }
		public static string objExt { get { return ".o"; } }
		public static string h5LibPath { get { return "lib-" + SimplyStreamSDKInfo.EmscriptenVersion() + "-up-mt"; } }

		// verbose feedback
		delegate void VerbosePrint(CppConfiguration Configuration, bool bOptimizeForSize, ILogger Logger);  // proto
		static VerbosePrint PrintOnce = new VerbosePrint(PrintOnceOn);                      // fn ptr
		static void PrintOnceOff(CppConfiguration Configuration, bool bOptimizeForSize, ILogger Logger) { } // noop
		static void PrintOnceOn(CppConfiguration Configuration, bool bOptimizeForSize, ILogger Logger)
		{
			PrintOnce = new VerbosePrint(PrintOnceOff); // clear
		}

		public SimplyStreamToolChain(FileReference? InProjectFile, ClangToolChainOptions ToolchainOptions, ILogger InLogger)
			: base(ToolchainOptions, InLogger)
		{
			ConfigHierarchy Ini = ConfigCache.ReadHierarchy(ConfigHierarchyType.Engine, InProjectFile?.Directory, UnrealTargetPlatform.SimplyStream);


			Ini.GetBool("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "EnableMultithreading", out enableMultithreading);
			Ini.GetBool("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "EnableTracing", out enableTracing);
			Ini.GetString("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "EmscriptenLTOMode", out ltoMode);
			Ini.GetString("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "EmscriptenProfilerMode", out profilerMode);
			Ini.GetInt32("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "InitialMemoryMB", out initialMemoryMB);
			Ini.GetInt32("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "MaximumMemoryMB", out maximumMemoryMB);
			Ini.GetBool("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "EnableUnrealInsights", out useUnrealInsights);
			Ini.GetBool("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "EnableSIMD", out _enableSIMD);
			Ini.GetBool("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "EnableAA", out enableAA);
			string memoryModeName = "Memory64";
			Ini.GetString("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "EmscriptenMemoryMode", out memoryModeName);
			Ini.GetBool("/Script/SimplyStreamTargetPlatformSettings.SimplyStreamTargetSettings", "MaximumOptimizations", out maximumOptimizations);

			string Hybrid = Environment.GetEnvironmentVariable("WNDR_BUILD_HYBRID")!;
			if (!string.IsNullOrEmpty(Hybrid) && Hybrid == "1")
			{
				// Do something special
				InLogger.LogInformation("h5conf SimplyStreamToolChain: WNDR_BUILD_HYBRID is set to 1, enabling special features.");
				buildForNode = true;
			} else
			{
				InLogger.LogInformation("h5conf SimplyStreamToolChain: WNDR_BUILD_HYBRID is not set to 1, normal build.");
			}
			if (string.IsNullOrWhiteSpace(memoryModeName))
			{
				InLogger.LogInformation("h5conf SimplyStreamToolChain: MemoryMode not set, defaulting to Memory64_Emulated");
				memoryModeName = "Memory64_Emulated";
			}
			memoryMode = ParseMemoryMode(memoryModeName);

			InLogger.LogInformation("h5conf SimplyStreamToolChain: EnableMultithreading = {}", enableMultithreading);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: EnableTracing = {}", enableTracing);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: LTO mode = {}", ltoMode);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: Profiler mode = {}", profilerMode);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: InitialMemoryMB = {}", initialMemoryMB);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: MaximumMemoryMB = {}", maximumMemoryMB);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: EnableUnrealInsights = {}", useUnrealInsights);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: EnableAA = {}", enableAA);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: MemoryMode = {}", memoryMode);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: MaximumOptimizations = {}", maximumOptimizations);

			InLogger.LogInformation("h5conf SimplyStreamToolChain: EnableSIMD = {}", enableSIMD);
			InLogger.LogInformation("h5conf SimplyStreamToolChain: 3rd party lib path = {}", h5LibPath);

			PrintOnce = new VerbosePrint(PrintOnceOn); // reset
			string Ext = OperatingSystem.IsWindows() ? ".bat" : "";
			ClangPath = Path.Combine(SimplyStreamSDKInfo.EMSDK_ROOT.ToString(), $"upstream/emscripten/emcc{Ext}");
			ArPath = Path.Combine(SimplyStreamSDKInfo.EMSDK_ROOT.ToString(), $"upstream/emscripten/emar{Ext}");

			InLogger.LogInformation("h5conf Setting Emscripten SDK: located in " + SimplyStreamSDKInfo.EMSCRIPTEN_ROOT);
			InLogger.LogInformation("h5conf Setting Emscripten SDK: located in " + SimplyStreamSDKInfo.EMSDK_ROOT);
			InLogger.LogInformation("ClangPath: " + ClangPath);
			InLogger.LogInformation("ArPath: " + ArPath);
		}

		class SimplyStreamToolChainInfo : ClangToolChainInfo
		{
			public SimplyStreamToolChainInfo(FileReference Clang, FileReference Archiver, ILogger Logger)
				: base(new DirectoryReference(SimplyStreamSDKInfo.EMSDK_ROOT.ToString()), Clang, Archiver, Logger)
			{ }
			protected override string QueryClangVersionString() => Utils.RunLocalProcessAndReturnStdOut(Clang.FullName, "-v", null);
			protected override string QueryArchiverVersionString() => Utils.RunLocalProcessAndReturnStdOut(Archiver.FullName, "--version", null);
		}

		protected override ClangToolChainInfo GetToolChainInfo()
		{
			return new SimplyStreamToolChainInfo(FileReference.FromString(ClangPath)!, FileReference.FromString(ArPath)!, Logger);
		}

		public override CppCompileEnvironment CreateSharedResponseFile(CppCompileEnvironment CompileEnvironment, FileReference OutResponseFile, IActionGraphBuilder Graph)
		{
			// Seems like Wasm clang toolchain does not handle response files including response files
			return CompileEnvironment;
		}

		protected override FileItem GetCompileArguments_FileType(CppCompileEnvironment CompileEnvironment, FileItem SourceFile, DirectoryReference OutputDir, List<string> Arguments, Action CompileAction, CPPOutput CompileResult)
		{
			CompileAction.bCanExecuteRemotelyWithXGE = false;
			CompileAction.bCanExecuteInUBA = false;
			return base.GetCompileArguments_FileType(CompileEnvironment, SourceFile, OutputDir, Arguments, CompileAction, CompileResult);
		}

		protected override void GetCompileArguments_WarningsAndErrors(CppCompileEnvironment CompileEnvironment, List<string> Arguments)
		{
			base.GetCompileArguments_WarningsAndErrors(CompileEnvironment, Arguments);

			// it seems like no other platform gets these, but there are a LOT
			Arguments.Add("-Wno-shorten-64-to-32");

			// Some metasound code is tripping this
			Arguments.Add("-Wno-extra-qualification");

			// Debug build tripped this
			Arguments.Add("-Wno-ignored-attributes");


			Arguments.Add("-Wno-vla-cxx-extension");

			Arguments.Add("-Wno-deprecated-literal-operator");
			Arguments.Add("-Wno-unused-result");
			Arguments.Add("-Wno-unused-value");
			Arguments.Add("-Wno-nontrivial-memcall");

			// ClangToolchain adds some warning flags that are unknown, so just allow it
			Arguments.Add("-Wno-unknown-warning-option");

			Arguments.Add("-Wover-aligned");
			Arguments.Add("-Wc++11-narrowing");
			Arguments.Add("-Wno-missing-template-arg-list-after-template-kw");
			Arguments.Add("-Wno-implicit-float-conversion");
			Arguments.Add("-Wno-missing-braces");
			Arguments.Add("-Wno-shadow");
			Arguments.Add("-Wno-invalid-noreturn");
			Arguments.Add("-Wno-reorder-ctor");
			Arguments.Add("-Wno-implicit-int-conversion");
			Arguments.Add("-Wno-float-conversion");
			Arguments.Add("-Wno-invalid-constexpr");
			// C++23 stricter Unicode code-unit rules flag u8 string literal -> TCHAR (char16_t)
			// as ambiguous. UE source hits this extensively in Core/HTTP/etc.
			Arguments.Add("-Wno-character-conversion");
			// STOCK-EMSDK BRING-UP: stock clang 24 emits warnings their clang 23 did not.
			Arguments.Add("-Wno-unused-template");
			Arguments.Add("-Wno-error");
		}

		protected override void GetCppStandardCompileArgument(CppCompileEnvironment CompileEnvironment, List<string> Arguments)
		{
			Arguments.Add("-std=c++23");
		}

		protected override void GetCompileArguments_Global(CppCompileEnvironment CompileEnvironment, List<string> Arguments)
		{
			// wndr 5.8/wasm: a few stock engine headers contain CPU-specific inline asm that emscripten can't
			// assemble and that a macro shim cannot intercept (e.g. UnrealMathNeon.h's FPCR mrs/msr, AtomicQueue.h's
			// ARM isb). Emit build-time-patched shadow copies (ReplaceInline on the *current* engine source) into
			// Intermediate and search them first, so engine source on disk stays byte-stock and auto-tracks updates.
			DirectoryReference WasmShadowDir = GenerateWasmShadowHeaders();
			// HAL/Platform.h is included relative to CoreTypes.h, so ordinary -iquote precedence
			// cannot shadow it. Map that one stock path through clang's VFS overlay instead.
			Arguments.Add("-ivfsoverlay");
			Arguments.Add(string.Format("\"{0}\"", FileReference.Combine(WasmShadowDir, "SimplyStreamVfsOverlay.json").FullName.Replace("\\", "/")));
			// The ThirdParty system-header shadow (AtomicQueue, <>-included) must resolve before the engine's own
			// -isystem copy. clang searches -isystem dirs in command-line order, and the base emits the engine's
			// SystemIncludePaths during the base call below — so add the shadow `sys` dir as -isystem *before*
			// base, making it the first -isystem dir searched and thus the winner. (CppCompileEnvironment's
			// SystemIncludePaths is an unordered HashSet, so we can't reorder it there.) Keeping it -isystem
			// preserves the third-party header's pre-existing warning suppression (e.g. -Wundef on `#if _MSC_VER`).
			// Windows host: quote + forward-slash the shadow path. emscripten's Python emcc driver parses its
			// @response files with shell-style tokenization that consumes backslashes as escapes, so an UNQUOTED
			// C:\...\sys -isystem path is mangled and the AtomicQueue/rtm <>-shadows silently lose to the real
			// headers (AtomicQueue.h `isb` invalid-instruction + ACL VectorSet_W0). Forward slashes resolve for
			// clang/emcc on every host and dodge the escape entirely; quoting also tolerates spaces. The -iquote
			// shadows above never hit this because they were already quoted. (Linux FullName is already '/': no-op.)
			Arguments.Add(string.Format("-isystem\"{0}\"", DirectoryReference.Combine(WasmShadowDir, "sys").FullName.Replace("\\", "/")));

			base.GetCompileArguments_Global(CompileEnvironment, Arguments);

			// Remap the original virtual NameTypes.h path so relative and include-path opens share one file identity.
			Arguments.Add(string.Format("-ivfsoverlay\"{0}\"", FileReference.Combine(WasmShadowDir, "NameTypesVfsOverlay.yaml").FullName.Replace("\\", "/")));

			Arguments.Add(string.Format("-iquote\"{0}\"", WasmShadowDir.FullName.Replace("\\", "/"))); // for "..." includes (UnrealMathNeon); forward-slash for Windows-host emcc (see -isystem note)

			// wndr 5.8/wasm: -Wpass-failed is an *optimizer remark* ("the optimizer couldn't perform an optional
			// transformation", e.g. it can't auto-vectorize AES.cpp's already-NEON AesEncryptArmHW loop) — never a code
			// defect, and not suppressible via #pragma clang loop (it's the optimizer's own analysis report, not a
			// pragma-driven request). Downgrade it from error to a (still-visible) warning so it doesn't fail the build.
			Arguments.Add("-Wno-error=pass-failed");

			Arguments.Add("-sDISABLE_EXCEPTION_CATCHING=1");
			Arguments.Add("-sDISABLE_EXCEPTION_THROWING=1");
			Arguments.Add("-fno-rtti");
			Arguments.Add("-fno-exceptions");
			// wndr 5.8/wasm: longjmp stays OFF (emscripten longjmp instruments code and hurts perf). If the app aborts
			// with "missing function: setjmp", find and eliminate the setjmp caller (e.g. configure the offending
			// ThirdParty lib without setjmp) rather than enabling -sSUPPORT_LONGJMP.
			Arguments.Add("-sSUPPORT_LONGJMP=0");
			//Arguments.Add("-fwasm-exceptions");

			Arguments.Add("-fno-strict-aliasing");
			//Arguments.Add("-fno-builtin");
			// Replace all usage of Result with Arguments.Add
			if (useUBsan && useAsan && useLsan)
			{
				Arguments.Add("-fsanitize=address,undefined,leak");
			}
			else if(useUBsan && useAsan)
			{
				Arguments.Add("-fsanitize=address,undefined");
			}
			else if (useAsan && useLsan)
			{
				Arguments.Add("-fsanitize=address,leak");
			}
			else if (useUBsan)
			{
				Arguments.Add("-fsanitize=undefined");
			}
			else if (useAsan)
			{
				Arguments.Add("-fsanitize=address");
			}
			else if (useLsan)
			{
				Arguments.Add("-fsanitize=leak");
			}

			Arguments.Add("-Dstrncpy=strncpy2");
			//Arguments.Add("-DFORCE_USE_STATS=UE_BUILD_TEST");
			Arguments.Add(IsMemory32 ? "-DUE_ARCH_NAME=wasm32" : "-DUE_ARCH_NAME=wasm64");
			Arguments.Add(IsMemory32 ? "-DSIMPLYSTREAM_MEMORY32=1" : "-DSIMPLYSTREAM_MEMORY32=0");
			Arguments.Add(IsMemory32 ? "-DSIMPLYSTREAM_POINTER_BITS=32" : "-DSIMPLYSTREAM_POINTER_BITS=64");
			if (IsMemory32)
			{
				// Shadow contents are generated behind stable file names that UBT does not track as
				// source prerequisites. Bump this epoch for each wasm32 compatibility slice so no
				// object compiled against an older pointer layout can survive incrementally.
				Arguments.Add($"-DSIMPLYSTREAM_MEMORY32_COMPAT_EPOCH={Memory32CompatibilityEpoch}");
			}
			Arguments.Add($"-DPLATFORM_WASM_ENABLE_ANTIALIAS={enableAA}");

			//Arguments.Add("-DEIGEN_DONT_VECTORIZE");

			if (enableDebug == true)
			{
				//Result += " -gline-tables-only";
				if (enableDwarf5 == true)
				{
					Arguments.Add("-gsplit-dwarf");
					Arguments.Add("-gdwarf-5");
				}
				else
				{
					Arguments.Add("-g");
				}
			}

			// Keep the non-LTO code-size passes in Development so fleet dev ships exercise the same
			// symbol visibility and function merging behavior used by Shipping.
			if (CompileEnvironment.Configuration == CppConfiguration.Development ||
				CompileEnvironment.Configuration == CppConfiguration.Shipping)
			{
				Arguments.Add("-fvisibility=hidden");
				Arguments.Add("-fvisibility-inlines-hidden");
				Arguments.Add("-Xclang -fmerge-functions");
			}

			if (CompileEnvironment.Configuration == CppConfiguration.Shipping)
			{
				Arguments.Add("-O3");
				//Arguments.Add("-mllvm -inline-threshold=2000");
				Arguments.Add("-ffunction-sections");
				Arguments.Add("-fdata-sections");
				//Arguments.Add("-fno-PIE");
				//Arguments.Add("-fno-unroll-loops"); // test for safety first

				if (ltoMode.Equals("thin", StringComparison.InvariantCultureIgnoreCase) && !maximumOptimizations)
				{
					Arguments.Add("-flto=thin");
				}
				else if (ltoMode.Equals("full", StringComparison.InvariantCultureIgnoreCase) || maximumOptimizations)
				{
					Arguments.Add("-flto=full");
					Arguments.Add("-fwhole-program-vtables");
					// Some protected runtime modules are finalized with -fno-lto below. VFE cannot see
					// their vtable uses and removed live startup targets in Shipping revision 284.
					Arguments.Add("-fforce-emit-vtables");
				}
			} else
			{
				Arguments.Add("-Os");
			}

			if (enableTracing)
			{
				Arguments.Add("--tracing");
			}
			//PrintOnce(Configuration, bOptimizeForSize, bUseInlining);

			if (enableSIMD)
			{
				Arguments.Add("-Wno-c++11-narrowing");
				Arguments.Add("-msimd128");
				// wndr 5.8: ARM/NEON family on wasm. emscripten maps NEON intrinsics (arm_neon.h, used by
				// UnrealMathNeon) to wasm-simd128 under -msimd128. Do NOT pass -msse* — those select the x86
				// path, and 5.8's real-x86-only code (cpuid asm / AES-NI / MXCSR) can't build under emscripten.
				Arguments.Add("-DSIMPLYSTREAM_SIMD=1");
			} else
			{
				Arguments.Add("-DSIMPLYSTREAM_SIMD=0");
			}
			if (enableMultithreading)
			{
				Arguments.Add("-pthread");
			} else
			{
				Arguments.Add("-DSIMPLTSTREAM_ENABLE_RENDERER_THREAD=0");
			}

			Environment.SetEnvironmentVariable("EMCC_SKIP_SANITY_CHECK", "1");

			//Arguments.Add("-v"; // useful for path hunting issues

			if (BuildHostPlatform.Current.Platform == UnrealTargetPlatform.Linux)
			{
				// Packaging on Linux needs this - or else system clang will be attempted to be picked up instead of UE4's included emsdk
				Environment.SetEnvironmentVariable(SimplyStreamSDKInfo.PLATFORM_USER_HOME, SimplyStreamSDKInfo.SimplyStreamIntermediatory);
			}
			if (BuildHostPlatform.Current.Platform == UnrealTargetPlatform.Win64)
			{
				// Packaging on Window needs this - zap any existing HOME environment variables to prevent any accidental pick ups
				Environment.SetEnvironmentVariable("HOME", "");
			}

			Arguments.Add($"-sMEMORY64={Memory64Setting}");
			Arguments.Add($"-DMEMORY64={Memory64Setting}");

			//Arguments.Add("-fpic";
			// alignment fault, get working later
			//Arguments.Add("-DWITH_RHI_BREADCRUMBS=0");
		}

