		/// <summary>
		/// Swap selected Renderer private sources (compiled directly, or via a unity blob that includes them)
		/// for patched copies. SceneRendering dead-gates the unsupported FFT-bloom kernel load;
		/// DistanceFieldStreaming queues initial mip uploads under the normal per-frame byte budget. Copies live in the
		/// module's intermediate dir; its relative includes resolve through the Renderer module's own include
		/// paths (Renderer/Private and Internal are UserIncludePaths for the module), and a #line directive
		/// keeps diagnostics/debug info pointing at the original file.
		/// </summary>
		IEnumerable<FileItem> PatchRendererSources(IEnumerable<FileItem> InputFiles, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			FileItem? PatchedSceneRenderingItem = null;
			FileItem? PatchedDistanceFieldStreamingItem = null;
			List<FileItem> Output = new List<FileItem>();
			foreach (FileItem InputFile in InputFiles)
			{
				string FileName = InputFile.Location.GetFileName();
				if (FileName.Equals("SceneRendering.cpp", StringComparison.OrdinalIgnoreCase) &&
					InputFile.Location.FullName.Replace('\\', '/').Contains("/Runtime/Renderer/Private/"))
				{
					PatchedSceneRenderingItem ??= CreatePatchedSceneRendering(InputFile, OutputDir, Graph);
					Output.Add(PatchedSceneRenderingItem);
					continue;
				}
				if (FileName.Equals("DistanceFieldStreaming.cpp", StringComparison.OrdinalIgnoreCase) &&
					InputFile.Location.FullName.Replace('\\', '/').Contains("/Runtime/Renderer/Private/"))
				{
					PatchedDistanceFieldStreamingItem ??= CreatePatchedDistanceFieldStreaming(InputFile, OutputDir, Graph);
					Output.Add(PatchedDistanceFieldStreamingItem);
					continue;
				}
				// Unity blob (generated Module.Renderer*.cpp) that includes either patched source: rewrite the
				// blob copy to include the patched file instead. NOTE the blob's include paths are RELATIVE to
				// Engine/Source, so match line-by-line with a full path suffix.
				if (FileName.StartsWith("Module.Renderer", StringComparison.OrdinalIgnoreCase))
				{
					string[] BlobLines = File.ReadAllLines(InputFile.Location.FullName);
					bool bRewrote = false;
					for (int LineIdx = 0; LineIdx < BlobLines.Length; ++LineIdx)
					{
						string Trimmed = BlobLines[LineIdx].TrimStart();
						if (!Trimmed.StartsWith("#include", StringComparison.Ordinal))
						{
							continue;
						}
						int Q1 = Trimmed.IndexOf('"');
						int Q2 = Trimmed.LastIndexOf('"');
						if (Q1 < 0 || Q2 <= Q1)
						{
							continue;
						}
						string IncludePath = Trimmed.Substring(Q1 + 1, Q2 - Q1 - 1).Replace('\\', '/');
						FileItem? IncludeItem = null;
						if (IncludePath.EndsWith("Runtime/Renderer/Private/SceneRendering.cpp", StringComparison.OrdinalIgnoreCase))
						{
							FileItem OriginalItem = FileItem.GetItemByFileReference(FileReference.Combine(
								Unreal.EngineDirectory, "Source", "Runtime", "Renderer", "Private", "SceneRendering.cpp"));
							PatchedSceneRenderingItem ??= CreatePatchedSceneRendering(OriginalItem, OutputDir, Graph);
							IncludeItem = PatchedSceneRenderingItem;
						}
						else if (IncludePath.EndsWith("Runtime/Renderer/Private/DistanceFieldStreaming.cpp", StringComparison.OrdinalIgnoreCase))
						{
							FileItem OriginalItem = FileItem.GetItemByFileReference(FileReference.Combine(
								Unreal.EngineDirectory, "Source", "Runtime", "Renderer", "Private", "DistanceFieldStreaming.cpp"));
							PatchedDistanceFieldStreamingItem ??= CreatePatchedDistanceFieldStreaming(OriginalItem, OutputDir, Graph);
							IncludeItem = PatchedDistanceFieldStreamingItem;
						}
						if (IncludeItem != null)
						{
							BlobLines[LineIdx] = "#include \"" + IncludeItem.Location.FullName.Replace('\\', '/') + "\"";
							bRewrote = true;
						}
					}
					if (bRewrote)
					{
						FileReference NewBlobPath = FileReference.Combine(OutputDir, FileName.Replace(".cpp", ".simplystream-renderer.cpp"));
						FileItem NewBlobItem = Graph.CreateIntermediateTextFile(NewBlobPath, string.Join("\n", BlobLines));
						Output.Add(NewBlobItem);
						continue;
					}
				}
				Output.Add(InputFile);
			}
			return Output;
		}

		/// <summary>
		/// Patched engine-source copies must live OUTSIDE Engine/Intermediate/Build/SimplyStream: the
		/// precompiled-payload packager only gathers those trees and enforces a no-source policy over them
		/// (the SDK payload ships objects, never engine source) — a patched source copy inside the module
		/// intermediate failed the release with "refusing to package — hand-written source file(s)".
		/// Consumers link -UsePrecompiled and never need the file; producer re-plans regenerate it.
		/// </summary>
		static DirectoryReference GetSourcePatchDir(DirectoryReference OutputDir)
		{
			string Full = OutputDir.FullName.Replace('\\', '/');
			const string Needle = "/Intermediate/Build/SimplyStream/";
			int Idx = Full.IndexOf(Needle, StringComparison.OrdinalIgnoreCase);
			if (Idx < 0)
			{
				throw new BuildException("SimplyStream engine-source patch: cannot derive a payload-external patch dir from '{0}' — update GetSourcePatchDir.", OutputDir);
			}
			return new DirectoryReference(Full.Substring(0, Idx) + "/Intermediate/SimplyStreamSourcePatches/" + Full.Substring(Idx + Needle.Length));
		}

		FileItem CreatePatchedSceneRendering(FileItem OriginalFile, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			string Source = File.ReadAllText(OriginalFile.Location.FullName);
			int First = Source.IndexOf(FFTBloomAnchor, StringComparison.Ordinal);
			if (First < 0 || Source.IndexOf(FFTBloomAnchor, First + 1, StringComparison.Ordinal) >= 0)
			{
				throw new BuildException(
					"SimplyStream FFT-bloom build-time patch: expected exactly one occurrence of the anchor in {0} but found {1}. " +
					"The engine source drifted — update FFTBloomAnchor/FFTBloomPatched in SimplyStreamToolChain.cs " +
					"(see the [SimplyStream build-time engine patch] comment) or the per-frame DefaultBloomKernel " +
					"sync-load spam returns silently.",
					OriginalFile.Location, First < 0 ? "none" : "more than one");
			}
			// #line keeps diagnostics + debug info on the original path; the in-line replacement below does
			// not change the file's line count, so all line numbers stay aligned.
			string Patched = "#line 1 \"" + OriginalFile.Location.FullName.Replace('\\', '/') + "\"\n" +
				Source.Replace(FFTBloomAnchor, FFTBloomPatched);
			FileReference PatchedPath = FileReference.Combine(GetSourcePatchDir(OutputDir), "SceneRendering.simplystream-fftbloom.cpp");
			return Graph.CreateIntermediateTextFile(PatchedPath, Patched);
		}

		FileItem CreatePatchedDistanceFieldStreaming(FileItem OriginalFile, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			string Source = File.ReadAllText(OriginalFile.Location.FullName);
			string[] Anchors = { DistanceFieldInitialMipQueueAnchor, DistanceFieldReadinessAnchor, DistanceFieldCleanupAnchor };
			foreach (string Anchor in Anchors)
			{
				int First = Source.IndexOf(Anchor, StringComparison.Ordinal);
				if (First < 0 || Source.IndexOf(Anchor, First + 1, StringComparison.Ordinal) >= 0)
				{
					throw new BuildException(
						"SimplyStream distance-field upload build-time patch: expected exactly one occurrence of an anchor in {0}. " +
						"The engine source drifted; update the DistanceField* anchors in SimplyStreamToolChain.cs.",
						OriginalFile.Location);
				}
			}

			string Patched = "#line 1 \"" + OriginalFile.Location.FullName.Replace('\\', '/') + "\"\n" +
				Source.Replace(DistanceFieldInitialMipQueueAnchor, DistanceFieldInitialMipQueuePatched)
					.Replace(DistanceFieldReadinessAnchor, DistanceFieldReadinessPatched)
					.Replace(DistanceFieldCleanupAnchor, DistanceFieldCleanupPatched);
			FileReference PatchedPath = FileReference.Combine(GetSourcePatchDir(OutputDir), "DistanceFieldStreaming.simplystream-bounded-upload.cpp");
			return Graph.CreateIntermediateTextFile(PatchedPath, Patched);
		}

		/// <summary>
		/// Swap RenderGraphBuilder.cpp, RenderGraphValidation.cpp, and ShaderCodeArchive.cpp (compiled
		/// directly or through a unity blob) for SimplyStream-patched copies. The graph sources use a
		/// composable access counter during graph execution and external uniform-buffer initialization;
		/// the shader archive routes preload completion off the parallel-render worker pool.
		/// The source anchor is intentionally exact so an upstream engine change fails the build instead of
		/// silently dropping either RenderCore fix.
		/// </summary>
		IEnumerable<FileItem> PatchRenderCoreSources(IEnumerable<FileItem> InputFiles, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			FileItem? PatchedBuilderItem = null;
			FileItem? PatchedValidationItem = null;
			FileItem? PatchedShaderArchiveItem = null;
			List<FileItem> Output = new List<FileItem>();
			foreach (FileItem InputFile in InputFiles)
			{
				string FileName = InputFile.Location.GetFileName();
				if (FileName.Equals("RenderGraphBuilder.cpp", StringComparison.OrdinalIgnoreCase) &&
					InputFile.Location.FullName.Replace('\\', '/').Contains("/Runtime/RenderCore/Private/"))
				{
					PatchedBuilderItem ??= CreatePatchedRenderGraphBuilder(InputFile, OutputDir, Graph);
					Output.Add(PatchedBuilderItem);
					continue;
				}
				if (FileName.Equals("RenderGraphValidation.cpp", StringComparison.OrdinalIgnoreCase) &&
					InputFile.Location.FullName.Replace('\\', '/').Contains("/Runtime/RenderCore/Private/"))
				{
					PatchedValidationItem ??= CreatePatchedRenderGraphValidation(InputFile, OutputDir, Graph);
					Output.Add(PatchedValidationItem);
					continue;
				}
				if (FileName.Equals("ShaderCodeArchive.cpp", StringComparison.OrdinalIgnoreCase) &&
					InputFile.Location.FullName.Replace('\\', '/').Contains("/Runtime/RenderCore/Private/ShaderLibrary/"))
				{
					PatchedShaderArchiveItem ??= CreatePatchedShaderCodeArchive(InputFile, OutputDir, Graph);
					Output.Add(PatchedShaderArchiveItem);
					continue;
				}

				if (FileName.StartsWith("Module.RenderCore", StringComparison.OrdinalIgnoreCase))
				{
					string[] BlobLines = File.ReadAllLines(InputFile.Location.FullName);
					bool bRewrote = false;
					for (int LineIdx = 0; LineIdx < BlobLines.Length; ++LineIdx)
					{
						string Trimmed = BlobLines[LineIdx].TrimStart();
						if (!Trimmed.StartsWith("#include", StringComparison.Ordinal))
						{
							continue;
						}
						int Q1 = Trimmed.IndexOf('"');
						int Q2 = Trimmed.LastIndexOf('"');
						if (Q1 < 0 || Q2 <= Q1)
						{
							continue;
						}
						string IncludePath = Trimmed.Substring(Q1 + 1, Q2 - Q1 - 1).Replace('\\', '/');
						FileItem? IncludeItem = null;
						if (IncludePath.EndsWith("Runtime/RenderCore/Private/RenderGraphBuilder.cpp", StringComparison.OrdinalIgnoreCase))
						{
							FileItem OriginalItem = FileItem.GetItemByFileReference(FileReference.Combine(
								Unreal.EngineDirectory, "Source", "Runtime", "RenderCore", "Private", "RenderGraphBuilder.cpp"));
							PatchedBuilderItem ??= CreatePatchedRenderGraphBuilder(OriginalItem, OutputDir, Graph);
							IncludeItem = PatchedBuilderItem;
						}
						else if (IncludePath.EndsWith("Runtime/RenderCore/Private/RenderGraphValidation.cpp", StringComparison.OrdinalIgnoreCase))
						{
							FileItem OriginalItem = FileItem.GetItemByFileReference(FileReference.Combine(
								Unreal.EngineDirectory, "Source", "Runtime", "RenderCore", "Private", "RenderGraphValidation.cpp"));
							PatchedValidationItem ??= CreatePatchedRenderGraphValidation(OriginalItem, OutputDir, Graph);
							IncludeItem = PatchedValidationItem;
						}
						else if (IncludePath.EndsWith("Runtime/RenderCore/Private/ShaderLibrary/ShaderCodeArchive.cpp", StringComparison.OrdinalIgnoreCase))
						{
							FileItem OriginalItem = FileItem.GetItemByFileReference(FileReference.Combine(
								Unreal.EngineDirectory, "Source", "Runtime", "RenderCore", "Private", "ShaderLibrary", "ShaderCodeArchive.cpp"));
							PatchedShaderArchiveItem ??= CreatePatchedShaderCodeArchive(OriginalItem, OutputDir, Graph);
							IncludeItem = PatchedShaderArchiveItem;
						}
						if (IncludeItem == null)
						{
							continue;
						}
						BlobLines[LineIdx] = "#include \"" + IncludeItem.Location.FullName.Replace('\\', '/') + "\"";
						bRewrote = true;
					}
					if (bRewrote)
					{
						FileReference NewBlobPath = FileReference.Combine(OutputDir, FileName.Replace(".cpp", ".simplystream-rendercore.cpp"));
						FileItem NewBlobItem = Graph.CreateIntermediateTextFile(NewBlobPath, string.Join("\n", BlobLines));
						Output.Add(NewBlobItem);
						continue;
					}
				}
				Output.Add(InputFile);
			}
			return Output;
		}

		FileItem CreatePatchedRenderGraphBuilder(FileItem OriginalFile, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			string Source = File.ReadAllText(OriginalFile.Location.FullName);
			int StateFirst = Source.IndexOf(RDGValidationStateAnchor, StringComparison.Ordinal);
			int ExecuteBeginFirst = Source.IndexOf(RDGExecuteAccessBeginAnchor, StringComparison.Ordinal);
			int ExecuteSetupEndFirst = Source.IndexOf(RDGExecuteAccessSetupEndAnchor, StringComparison.Ordinal);
			int ExecuteEndFirst = Source.IndexOf(RDGExecuteAccessEndAnchor, StringComparison.Ordinal);
			int DefinitionFirst = Source.IndexOf(RDGAccessCounterDefinitionAnchor, StringComparison.Ordinal);
			if (StateFirst < 0 || Source.IndexOf(RDGValidationStateAnchor, StateFirst + 1, StringComparison.Ordinal) >= 0 ||
				ExecuteBeginFirst < 0 || Source.IndexOf(RDGExecuteAccessBeginAnchor, ExecuteBeginFirst + 1, StringComparison.Ordinal) >= 0 ||
				ExecuteSetupEndFirst < 0 || Source.IndexOf(RDGExecuteAccessSetupEndAnchor, ExecuteSetupEndFirst + 1, StringComparison.Ordinal) >= 0 ||
				ExecuteEndFirst < 0 || Source.IndexOf(RDGExecuteAccessEndAnchor, ExecuteEndFirst + 1, StringComparison.Ordinal) >= 0 ||
				DefinitionFirst < 0 || Source.IndexOf(RDGAccessCounterDefinitionAnchor, DefinitionFirst + 1, StringComparison.Ordinal) >= 0)
			{
				throw new BuildException(
					"SimplyStream RDG validation-state build-time patch: expected exactly one occurrence of each anchor in {0}. " +
					"The engine source drifted — update the RDG validation anchors in SimplyStreamToolChain.cs.",
					OriginalFile.Location);
			}
			string Patched = "#line 1 \"" + OriginalFile.Location.FullName.Replace('\\', '/') + "\"\n" +
				Source.Replace(RDGAccessCounterDefinitionAnchor, RDGAccessCounterDefinitionPatched)
					.Replace(RDGValidationStateAnchor, RDGValidationStatePatched)
					.Replace(RDGExecuteAccessBeginAnchor, RDGExecuteAccessBeginPatched)
					.Replace(RDGExecuteAccessSetupEndAnchor, RDGExecuteAccessSetupEndPatched)
					.Replace(RDGExecuteAccessEndAnchor, RDGExecuteAccessEndPatched);
			FileReference PatchedPath = FileReference.Combine(GetSourcePatchDir(OutputDir), "RenderGraphBuilder.simplystream-rdg-validation.cpp");
			return Graph.CreateIntermediateTextFile(PatchedPath, Patched);
		}

		FileItem CreatePatchedShaderCodeArchive(FileItem OriginalFile, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			string Source = File.ReadAllText(OriginalFile.Location.FullName);
			int ThreadAnchorFirst = Source.IndexOf(ShaderPreloadTaskThreadAnchor, StringComparison.Ordinal);
			if (ThreadAnchorFirst < 0 || Source.IndexOf(ShaderPreloadTaskThreadAnchor, ThreadAnchorFirst + 1, StringComparison.Ordinal) >= 0)
			{
				throw new BuildException(
					"SimplyStream shader-preload task-thread build-time patch: expected exactly one occurrence of the anchor in {0}. " +
					"The engine source drifted — update ShaderPreloadTaskThreadAnchor/ShaderPreloadTaskThreadPatched in SimplyStreamToolChain.cs.",
					OriginalFile.Location);
			}
			string Patched = "#line 1 \"" + OriginalFile.Location.FullName.Replace('\\', '/') + "\"\n" +
				Source.Replace(ShaderPreloadTaskThreadAnchor, ShaderPreloadTaskThreadPatched);
			FileReference PatchedPath = FileReference.Combine(GetSourcePatchDir(OutputDir), "ShaderCodeArchive.simplystream-preload-rhi.cpp");
			return Graph.CreateIntermediateTextFile(PatchedPath, Patched);
		}

		FileItem CreatePatchedRenderGraphValidation(FileItem OriginalFile, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			string Source = File.ReadAllText(OriginalFile.Location.FullName);
			int DeclarationFirst = Source.IndexOf(RDGValidationDeclarationAnchor, StringComparison.Ordinal);
			int CheckFirst = Source.IndexOf(RDGValidationCheckAnchor, StringComparison.Ordinal);
			if (DeclarationFirst < 0 || Source.IndexOf(RDGValidationDeclarationAnchor, DeclarationFirst + 1, StringComparison.Ordinal) >= 0 ||
				CheckFirst < 0 || Source.IndexOf(RDGValidationCheckAnchor, CheckFirst + 1, StringComparison.Ordinal) >= 0)
			{
				throw new BuildException(
					"SimplyStream RDG validation-check build-time patch: expected exactly one occurrence of each anchor in {0}. " +
					"The engine source drifted — update the RDG validation anchors in SimplyStreamToolChain.cs.",
					OriginalFile.Location);
			}
			string Patched = "#line 1 \"" + OriginalFile.Location.FullName.Replace('\\', '/') + "\"\n" +
				Source.Replace(RDGValidationDeclarationAnchor, RDGValidationDeclarationPatched)
					.Replace(RDGValidationCheckAnchor, RDGValidationCheckPatched);
			FileReference PatchedPath = FileReference.Combine(GetSourcePatchDir(OutputDir), "RenderGraphValidation.simplystream-rdg-access.cpp");
			return Graph.CreateIntermediateTextFile(PatchedPath, Patched);
		}

		IEnumerable<FileItem> PatchIoStoreOnDemandSources(IEnumerable<FileItem> InputFiles, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			FileItem? PatchedItem = null;
			List<FileItem> Output = new List<FileItem>();
			foreach (FileItem InputFile in InputFiles)
			{
				string FileName = InputFile.Location.GetFileName();
				if (FileName.Equals("OnDemandIoStore.cpp", StringComparison.OrdinalIgnoreCase) &&
					InputFile.Location.FullName.Replace('\\', '/').Contains("/Runtime/Experimental/IoStore/OnDemand/Private/"))
				{
					PatchedItem ??= CreatePatchedIoStoreOnDemand(InputFile, OutputDir, Graph);
					Output.Add(PatchedItem);
					continue;
				}
				if (FileName.StartsWith("Module.IoStoreOnDemand", StringComparison.OrdinalIgnoreCase))
				{
					string[] BlobLines = File.ReadAllLines(InputFile.Location.FullName);
					bool bRewrote = false;
					for (int LineIdx = 0; LineIdx < BlobLines.Length; ++LineIdx)
					{
						string Trimmed = BlobLines[LineIdx].TrimStart();
						if (!Trimmed.StartsWith("#include", StringComparison.Ordinal))
						{
							continue;
						}
						int Q1 = Trimmed.IndexOf('"');
						int Q2 = Trimmed.LastIndexOf('"');
						if (Q1 < 0 || Q2 <= Q1)
						{
							continue;
						}
						string IncludePath = Trimmed.Substring(Q1 + 1, Q2 - Q1 - 1).Replace('\\', '/');
						if (!IncludePath.EndsWith("Runtime/Experimental/IoStore/OnDemand/Private/OnDemandIoStore.cpp", StringComparison.OrdinalIgnoreCase))
						{
							continue;
						}
						FileItem OriginalItem = FileItem.GetItemByFileReference(FileReference.Combine(
							Unreal.EngineDirectory, "Source", "Runtime", "Experimental", "IoStore", "OnDemand", "Private", "OnDemandIoStore.cpp"));
						PatchedItem ??= CreatePatchedIoStoreOnDemand(OriginalItem, OutputDir, Graph);
						BlobLines[LineIdx] = "#include \"" + PatchedItem.Location.FullName.Replace('\\', '/') + "\"";
						bRewrote = true;
					}
					if (bRewrote)
					{
						FileReference NewBlobPath = FileReference.Combine(OutputDir, FileName.Replace(".cpp", ".simplystream-ias-diag.cpp"));
						Output.Add(Graph.CreateIntermediateTextFile(NewBlobPath, string.Join("\n", BlobLines)));
						continue;
					}
				}
				Output.Add(InputFile);
			}
			return Output;
		}

		FileItem CreatePatchedIoStoreOnDemand(FileItem OriginalFile, DirectoryReference OutputDir, IActionGraphBuilder Graph)
		{
			string Source = File.ReadAllText(OriginalFile.Location.FullName);
			foreach (string Anchor in new[] {
				IasPlatformMemoryIncludeAnchor,
				IasConstructorDelegateAnchor,
				IasInitializeEntryAnchor,
				IasInstallCacheStatusAnchor,
				IasHostDelegateAnchor,
				IasShippingPackageStreamingAnchor,
			})
			{
				int First = Source.IndexOf(Anchor, StringComparison.Ordinal);
				if (First < 0 || Source.IndexOf(Anchor, First + 1, StringComparison.Ordinal) >= 0)
				{
					throw new BuildException(
						"SimplyStream IoStoreOnDemand build-time patch: expected exactly one occurrence of an anchor in {0}. " +
						"The engine source drifted; update the IAS diagnostic anchors in SimplyStreamToolChain.cs.",
						OriginalFile.Location);
				}
			}
			string Patched = "#line 1 \"" + OriginalFile.Location.FullName.Replace('\\', '/') + "\"\n" +
				Source.Replace(IasPlatformMemoryIncludeAnchor, IasPlatformMemoryIncludePatched)
					.Replace(IasConstructorDelegateAnchor, IasConstructorDelegatePatched)
					.Replace(IasInitializeEntryAnchor, IasInitializeEntryPatched)
					.Replace(IasInstallCacheStatusAnchor, IasInstallCacheStatusPatched)
					.Replace(IasHostDelegateAnchor, IasHostDelegatePatched)
					.Replace(IasShippingPackageStreamingAnchor, IasShippingPackageStreamingPatched);
			FileReference PatchedPath = FileReference.Combine(GetSourcePatchDir(OutputDir), "OnDemandIoStore.simplystream.cpp");
			return Graph.CreateIntermediateTextFile(PatchedPath, Patched);
		}

		public override FileItem LinkFiles(LinkEnvironment LinkEnvironment, bool bBuildImportLibraryOnly, IActionGraphBuilder Graph)
		{
			FileItem OutputFile;
			FileReference ToolPath = (LinkEnvironment.bIsBuildingLibrary) ? Info.Archiver : Info.Clang;
			string ToolVersion = (LinkEnvironment.bIsBuildingLibrary) ? Info.ArchiverVersionString : Info.ClangVersionString;

			Action LinkAction = Graph.CreateAction(ActionType.Link);

			// response file contents
			List<string> ReponseLines = new List<string>();
			ReponseLines.Add(GetLinkArguments(LinkEnvironment));

			OutputFile = FileItem.GetItemByFileReference(LinkEnvironment.OutputFilePath);
			Console.WriteLine("Compiling OutputFile.AbsolutePath. {0}", OutputFile.AbsolutePath);
			// Non-Development configs append "-SimplyStream-<Config>" after the target name.
			if (LinkEnvironment.OutputFilePath.GetFileName().Contains("Server") || buildForNode)
			{
				OutputFile = FileItem.GetItemByFileReference(LinkEnvironment.OutputFilePath.ChangeExtension(".mjs"));
				ReponseLines.Add(string.Format(" -sEXPORT_ES6=1 -sMODULARIZE=1 -o \"{0}\"", OutputFile.AbsolutePath));
			}
			else
			{
				Console.WriteLine("Compiling game wasm. {0}", OutputFile.AbsolutePath);
				ReponseLines.Add(string.Format(" -o \"{0}\"", OutputFile.AbsolutePath));
			}

			LinkAction.ProducedItems.Add(OutputFile);
			ReponseLines.Add(string.Format(" -o \"{0}\"", OutputFile.AbsolutePath));

			//FileItem OutputLink = FileItem.GetItemByPath(LinkEnvironment.OutputFilePath.FullName.Replace(".js", libExt).Replace(".html", libExt));
			//LinkAction.ProducedItems.Add(OutputLink);

			LinkAction.bCanExecuteRemotelyWithXGE = false;
			LinkAction.bCanExecuteInUBA = false;


			LinkAction.CommandDescription = "Link";
			LinkAction.WorkingDirectory = Unreal.EngineSourceDirectory;
			LinkAction.CommandPath = ToolPath;
			LinkAction.CommandVersion = ToolVersion;
			LinkAction.CommandArguments = "-v";
			List<string> InputFileNames = new List<string>();
			foreach (FileItem InputFile in LinkEnvironment.InputFiles)
			{
				ReponseLines.Add($" \"{InputFile}\"");
				LinkAction.PrerequisiteItems.Add(InputFile);
			}
			foreach (FileReference InputFile in LinkEnvironment.Libraries)
			{
				if (InputFile.HasExtension(".js"))
				{
					ReponseLines.Add($" --js-library \"{InputFile}\"");
				}
				else
				{
					ReponseLines.Add($" \"{InputFile}\"");
				}
				LinkAction.PrerequisiteItems.Add(FileItem.GetItemByFileReference(InputFile));
			}

			LinkAction.StatusDescription = Path.GetFileName(OutputFile.AbsolutePath);

			FileReference ResponseFileName = GetResponseFileName(LinkEnvironment, OutputFile);

			// this is needed when using EMCC_DEBUG_SAVE
			if (!FileReference.Exists(ResponseFileName))
			{
				DirectoryReference.CreateDirectory(ResponseFileName.Directory);
			}
			FileItem ResponseFileItem = Graph.CreateIntermediateTextFile(ResponseFileName, ReponseLines);

			LinkAction.CommandArguments += $" @\"{ResponseFileName}\"";
			LinkAction.PrerequisiteItems.Add(ResponseFileItem);

			// wndr 5.8/wasm: simplystream.js (--pre-js), simplystream.html (--shell-file) and the setjmp shim
			// (--js-library) are woven into the .js glue at LINK time, but they are referenced only by PATH in the
			// link args / response file — their CONTENT is not a tracked input. Without registering them as explicit
			// prerequisites, UBT will NOT re-link when only the runtime shell changes (the .inl-incremental-miss
			// trap), so an edited simplystream.js silently never enters the deployed bundle. Track them so any shell
			// edit always re-links and re-weaves.
			foreach (string ShellRel in new[] {
				"/../Platforms/SimplyStream/simplystream.js",
				"/../Platforms/SimplyStream/simplystream.html",
				"/../Platforms/SimplyStream/Source/Runtime/Core/Private/SimplyStreamSetjmpShim.js",
				"/../Platforms/SimplyStream/Source/Runtime/Sockets/Private/SimplyStreamGetaddrinfoShim.js",
			})
			{
				FileReference ShellRef = new FileReference(Directory.GetCurrentDirectory() + ShellRel);
				if (FileReference.Exists(ShellRef))
				{
					LinkAction.PrerequisiteItems.Add(FileItem.GetItemByFileReference(ShellRef));
				}
			}

			return OutputFile;
		}

		public override void ModifyBuildProducts(ReadOnlyTargetRules Target, UEBuildBinary Binary, IEnumerable<string> Libraries, IEnumerable<UEBuildBundleResource> BundleResources, Dictionary<FileReference, BuildProductType> BuildProducts)
		{
			Console.WriteLine("ModifyBuildProducts SimplyStreamToolChain with: buildForNode = " + buildForNode + ", Binary = " + Binary.OutputFilePath);
			if (Target.Type == TargetType.Server || buildForNode)
			{
				Console.WriteLine("ModifyBuildProducts SimplyStreamToolChain: Changing extension to .mjs from {Binary.OutputFilePath}");
				BuildProducts.Remove(Binary.OutputFilePath);
				BuildProducts.Add(Binary.OutputFilePath.ChangeExtension("mjs"), BuildProductType.RequiredResource);
			}
		}
	};
}
