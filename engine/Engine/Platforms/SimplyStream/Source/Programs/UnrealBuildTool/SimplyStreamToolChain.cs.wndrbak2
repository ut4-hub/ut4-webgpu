				"      {\"type\": \"file\", \"name\": \"Misc.inl\", \"external-contents\": \"" + HttpMiscShadow.FullName.Replace("\\", "/") + "\"},\n" +
				"      {\"type\": \"file\", \"name\": \"Activity.inl\", \"external-contents\": \"" + HttpActivityShadow.FullName.Replace("\\", "/") + "\"},\n" +
				"      {\"type\": \"file\", \"name\": \"Peer.inl\", \"external-contents\": \"" + HttpPeerShadow.FullName.Replace("\\", "/") + "\"},\n" +
				"      {\"type\": \"file\", \"name\": \"Test.inl\", \"external-contents\": \"" + HttpTestShadow.FullName.Replace("\\", "/") + "\"}\n" +
				"    ]},\n" +
				"    {\"type\": \"directory\", \"name\": \"" + JournaledCacheSource.Directory.FullName.Replace("\\", "/") + "\", \"contents\": [\n" +
				"      {\"type\": \"file\", \"name\": \"JournaledCache.cpp\", \"external-contents\": \"" + JournaledCacheShadow.FullName.Replace("\\", "/") + "\"}\n" +
				"    ]},\n" +
				"    {\"type\": \"directory\", \"name\": \"" + ChaosImplicitSource.Directory.FullName.Replace("\\", "/") + "\", \"contents\": [\n" +
				"      {\"type\": \"file\", \"name\": \"ImplicitObjectBVH.cpp\", \"external-contents\": \"" + ChaosImplicitShadow.FullName.Replace("\\", "/") + "\"}\n" +
				"    ]}\n" +
				"  ]\n" +
				"}\n";
			if (!FileReference.Exists(VfsOverlay) || File.ReadAllText(VfsOverlay.FullName) != OverlayText)
			{
				File.WriteAllText(VfsOverlay.FullName, OverlayText);
			}
			bWasmShadowHeadersGenerated = true;
			return ShadowDir;
		}

		// IncludeRelPath mirrors how the header is #included (e.g. "Math/UnrealMathNeon.h" or "AtomicQueue.h"),
		// so the patched copy resolves before the real one on the include search path.
		void ShadowPatch(DirectoryReference ShadowDir, bool bSystem, string EngineRelPath, string IncludeRelPath, Dictionary<string, string> Replacements, bool bRequireAllReplacements = false)
		{
			FileReference Src = FileReference.Combine(Unreal.EngineSourceDirectory, EngineRelPath);
			if (!FileReference.Exists(Src))
			{
				if (bRequireAllReplacements)
				{
					throw new BuildException($"Required SimplyStream shadow source is missing: {Src.FullName}");
				}
				return;
			}
			string Text = File.ReadAllText(Src.FullName);
			foreach (KeyValuePair<string, string> R in Replacements)
			{
				if (bRequireAllReplacements && !Text.Contains(R.Key, StringComparison.Ordinal))
				{
					throw new BuildException($"Required SimplyStream shadow anchor was not found in {Src.FullName}: {R.Key}");
				}
				Text = Text.Replace(R.Key, R.Value);
			}
			// System (ThirdParty) headers go in a `sys` subdir mapped via -isystem so their pre-existing
			// warnings (e.g. -Wundef on `#if _MSC_VER`) stay suppressed; Core headers go in the -iquote root.
			DirectoryReference TargetRoot = bSystem ? DirectoryReference.Combine(ShadowDir, "sys") : ShadowDir;
			FileReference Dst = FileReference.Combine(TargetRoot, IncludeRelPath);
			Directory.CreateDirectory(Dst.Directory.FullName);
			if (!FileReference.Exists(Dst) || File.ReadAllText(Dst.FullName) != Text)
			{
				File.WriteAllText(Dst.FullName, Text);
			}
		}

		// wndr 5.8/wasm: a shadow that does NOT copy the engine header but #includes it (by absolute path, so it
		// dedupes with the real header via #pragma-once file identity) and appends extra content. Used to inject
		// declarations a #pragma-once header needs (e.g. HairStrands explicit StaticType specializations) without
		// double-defining everything in the real header.
		void ShadowWrap(DirectoryReference ShadowDir, bool bSystem, string EngineRelPath, string IncludeRelPath, string AppendContent)
		{
			FileReference Src = FileReference.Combine(Unreal.EngineSourceDirectory, EngineRelPath);
			if (!FileReference.Exists(Src))
			{
				return;
			}
			string Text = "#pragma once\n#include \"" + Src.FullName.Replace("\\", "/") + "\"\n" + AppendContent;
			DirectoryReference TargetRoot = bSystem ? DirectoryReference.Combine(ShadowDir, "sys") : ShadowDir;
			FileReference Dst = FileReference.Combine(TargetRoot, IncludeRelPath);
			Directory.CreateDirectory(Dst.Directory.FullName);
			if (!FileReference.Exists(Dst) || File.ReadAllText(Dst.FullName) != Text)
			{
				File.WriteAllText(Dst.FullName, Text);
			}
		}

		public void AddIncludePath(ref string Arguments, DirectoryReference IncludePath)
		{
			if(IncludePath.IsUnderDirectory(Unreal.EngineDirectory))
			{
				Arguments += string.Format(" -I\"{0}\"", IncludePath.MakeRelativeTo(Unreal.EngineSourceDirectory));
			}
			else
			{
				Arguments += string.Format(" -I\"{0}\"", IncludePath);
			}
		}

		protected override CPPOutput CompileCPPFiles(CppCompileEnvironment CompileEnvironment, IEnumerable<FileItem> InputFiles, DirectoryReference OutputDir, string ModuleName, IActionGraphBuilder Graph)
		{
			// WORKAROUND: On Mac hosts, clang's SLP vectorizer emits `v128.load64_zero`
			// with an i32 address inside ZSTD's HUF_decompress4X1_usingDTable_internal_fast_c_loop
			// (pure-C fast path). Binaryen's --memory64-lowering pass (invoked when
			// memoryMode=Memory64_Emulated) fails to promote that address to i64, producing
			// a wasm-validator error. Windows-host clang does not make the same SLP decision,
			// so Windows builds of the identical source never hit this. Disable the SLP
			// vectorizer just for WndrZSTD, just on Mac hosts — preserves explicit SIMD in
			// xxhash.h and all auto-vectorization in every other module.
			if (ModuleName == "WndrZSTD" && BuildHostPlatform.Current.Platform == UnrealTargetPlatform.Mac)
			{
				CompileEnvironment = new CppCompileEnvironment(CompileEnvironment);
				CompileEnvironment.AdditionalArguments += " -fno-slp-vectorize";
			}

			// IP protection: force proprietary modules to finalized wasm objects (not LTO
			// bitcode). Append the complete negative override LAST so Clang does not apply
			// whole-program vtable transforms to a finalized object. Other modules are untouched.
			if (NoLtoModules.Contains(ModuleName))
			{
				CompileEnvironment = new CppCompileEnvironment(CompileEnvironment);
				CompileEnvironment.AdditionalArguments +=
					" -fno-lto -fno-whole-program-vtables -fno-force-emit-vtables";
			}

			// Platform releases preserve the producer Intermediate. Bump this epoch whenever a Core source-shadow
			// hook is added or removed so UBT cannot reuse an object previously produced through a different input
			// path but written to the same output slot. The define is intentionally unused: it invalidates the
			// compile action while leaving the stock Core source and generated IR unchanged.
			if (ModuleName == "Core")
			{
				CompileEnvironment = new CppCompileEnvironment(CompileEnvironment);
				CompileEnvironment.AdditionalArguments += $" -DSIMPLYSTREAM_CORE_OBJECT_EPOCH={Memory32CompatibilityEpoch}";
			}

			// Unity blobs are generated through asynchronous WriteFileIfChanged tasks. The patches below
			// inspect those files immediately, so wait for the planned contents to reach disk instead of
			// accidentally cloning a stale blob from the previous build graph.
			if ((ModuleName == "Renderer" || ModuleName == "RenderCore" || ModuleName == "IoStoreOnDemand") && Graph is TargetMakefileBuilder MakefileBuilder)
			{
				MakefileBuilder.WaitOnWriteTasks();
			}

			// [SimplyStream build-time engine patch] FFT-bloom kernel load loop. We never edit engine
			// sources; the platform toolchain patches this ONE translation unit at build time instead.
			// SceneRendering.cpp gates the FFT kernel-texture load on `BloomMethod == BM_FFT` alone —
			// it never consults DoesPlatformSupportFFTBloom. SimplyStream declares bSupportsFFTBloom=false
			// (WGSL workgroup limits) and deliberately excludes /Engine/EngineMaterials/DefaultBloomKernel
			// from staging ([ExcludeContentForMobile]), so any view whose post-process volume selects
			// convolution bloom made the renderer SYNC-LOAD-RETRY the missing 4MB kernel EVERY FRAME
			// (per-frame "FlushAsyncLoading(N): 1 QueuedPackages" spam + a per-frame hitch). Dead-gating
			// the block is exactly correct for this toolchain: it only ever compiles SimplyStream (wasm)
			// targets, where FFT bloom can never run. Fails the BUILD loudly if the engine snippet drifts.
			// Stock distance-field streaming also forwards every always-loaded lowest mip before consulting
			// its per-frame upload budget. Large maps can therefore request a power-of-two 1GB staging buffer
			// in wasm and bind it beyond WebGPU's storage-buffer limit. Queue those mips through the budgeted
			// request path instead; streamed bulk requests retain their existing I/O ownership semantics.
			if (ModuleName == "Renderer")
			{
				InputFiles = PatchRendererSources(InputFiles, OutputDir, Graph);
			}

			// [SimplyStream build-time engine patch] Make RenderCore's RHI validation access windows
			// composable. The process-global bool cannot represent overlapping graph execution and temporary
			// uniform-buffer scopes: one scope can restore false while another graph's parallel setup tasks
			// still need access, causing false failures in FinalizeResources and CreateUniformBuffers.
			// Also route legacy shader-preload completion tasks to the separate RHI thread. Otherwise RDG
			// parallel-pass tasks can occupy every generic worker and then deadlock waiting for preload tasks
			// queued to that same exhausted pool.
			if (ModuleName == "RenderCore")
			{
				InputFiles = PatchRenderCoreSources(InputFiles, OutputDir, Graph);
			}

			// [SimplyStream build-time engine patch] Preserve precise Shipping startup boundaries around the
			// OnDemand store's delegate additions, and keep package streaming enabled in Shipping. Stock IAS
			// requires install handles in Shipping, but SimplyStream is a stateless CDN streaming platform: the
			// mounted package store must expose cooked packages and fetch their chunks only when LoadPackage asks.
			if (ModuleName == "IoStoreOnDemand")
			{
				InputFiles = PatchIoStoreOnDemandSources(InputFiles, OutputDir, Graph);
			}

			CPPOutput Result = base.CompileCPPFiles(CompileEnvironment, InputFiles, OutputDir, ModuleName, Graph);
			return Result;
		}

		const string FFTBloomAnchor = "if (ViewInfo->FinalPostProcessSettings.BloomMethod == EBloomMethod::BM_FFT && ViewInfo->ViewState != nullptr)";
		const string FFTBloomPatched = "if (false /* [SimplyStream build-time patch] FFT bloom unsupported (bSupportsFFTBloom=false) and DefaultBloomKernel is excluded from staging; without this gate the renderer sync-load-retries the missing kernel every frame. Patched by SimplyStreamToolChain.cs */ && ViewInfo->FinalPostProcessSettings.BloomMethod == EBloomMethod::BM_FFT && ViewInfo->ViewState != nullptr)";
		const string DistanceFieldInitialMipQueueAnchor =
			"\t// At this point DistanceFieldAssetMipAdds contains only lowest resolution mip adds which are always loaded\n" +
			"\t// Forward these to the Requests to Upload list, with a null BulkData\n" +
			"\tfor (FDistanceFieldAssetMipId AssetMipAdd : DistanceFieldAssetMipAdds)\n" +
			"\t{\n" +
			"\t\tconst FDistanceFieldAssetState& AssetState = AssetStateArray[AssetMipAdd.AssetId];\n" +
			"\t\tconst int32 ReversedMipIndex = AssetMipAdd.ReversedMipIndex;\n" +
			"\t\tcheck(ReversedMipIndex == 0);\n" +
			"\t\tconst int32 MipIndex = AssetState.BuiltData->Mips.Num() - ReversedMipIndex - 1;\n" +
			"\t\tconst FSparseDistanceFieldMip& MipBuiltData = AssetState.BuiltData->Mips[MipIndex];\n" +
			"\t\tTextureUploadBytes += MipBuiltData.NumDistanceFieldBricks * BrickSizeBytes;\n\n" +
			"\t\tFDistanceFieldReadRequest NewReadRequest;\n" +
			"\t\tNewReadRequest.AssetSetId = AssetMipAdd.AssetId;\n" +
			"\t\tNewReadRequest.BuiltDataId = AssetState.BuiltData->GetId();\n" +
			"\t\tNewReadRequest.ReversedMipIndex = AssetMipAdd.ReversedMipIndex;\n" +
			"\t\tNewReadRequest.NumDistanceFieldBricks = MipBuiltData.NumDistanceFieldBricks;\n" +
			"\t\tNewReadRequest.AlwaysLoadedDataPtr = AssetState.BuiltData->AlwaysLoadedMip.GetData();\n" +
			"\t\tNewReadRequest.BulkSize = AssetState.BuiltData->AlwaysLoadedMip.Num();\n" +
			"\t\tReadRequestsToUpload.Add(MoveTemp(NewReadRequest));\n" +
			"\t}";
		const string DistanceFieldInitialMipQueuePatched =
			"\t// [SimplyStream build-time patch] Queue always-loaded lowest mips with streamed mips so the existing\n" +
			"\t// per-frame texture upload limit also bounds WebGPU staging-buffer size and storage binding range.\n" +
			"\tTArray<FDistanceFieldAssetMipId> InitialMipAdds = MoveTemp(DistanceFieldAssetMipAdds);\n" +
			"\tDistanceFieldAssetMipAdds.Reset();\n" +
			"\tfor (FDistanceFieldAssetMipId AssetMipAdd : InitialMipAdds)\n" +
			"\t{\n" +
			"\t\tconst FDistanceFieldAssetState& AssetState = AssetStateArray[AssetMipAdd.AssetId];\n" +
			"\t\tconst int32 ReversedMipIndex = AssetMipAdd.ReversedMipIndex;\n" +
			"\t\tcheck(ReversedMipIndex == 0);\n" +
			"\t\tconst int32 MipIndex = AssetState.BuiltData->Mips.Num() - ReversedMipIndex - 1;\n" +
			"\t\tconst FSparseDistanceFieldMip& MipBuiltData = AssetState.BuiltData->Mips[MipIndex];\n\n" +
			"\t\tFDistanceFieldReadRequest NewReadRequest;\n" +
			"\t\tNewReadRequest.AssetSetId = AssetMipAdd.AssetId;\n" +
			"\t\tNewReadRequest.BuiltDataId = AssetState.BuiltData->GetId();\n" +
			"\t\tNewReadRequest.ReversedMipIndex = AssetMipAdd.ReversedMipIndex;\n" +
			"\t\tNewReadRequest.NumDistanceFieldBricks = MipBuiltData.NumDistanceFieldBricks;\n" +
			"\t\tNewReadRequest.AlwaysLoadedDataPtr = AssetState.BuiltData->AlwaysLoadedMip.GetData();\n" +
			"\t\tNewReadRequest.BulkSize = AssetState.BuiltData->AlwaysLoadedMip.Num();\n" +
			"\t\tReadRequests.Add(MoveTemp(NewReadRequest));\n" +
			"\t}";
		const string DistanceFieldReadinessAnchor =
			"#if !WITH_EDITOR\n" +
			"\t\tif (ReadRequest.AsyncRequest)\n" +
