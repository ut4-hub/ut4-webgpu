		string GetLinkArguments(LinkEnvironment LinkEnvironment)
		{
			string Result = "";
			Result += " -sDISABLE_DEPRECATED_FIND_EVENT_TARGET_BEHAVIOR=1";
			Result += " -sTEXTDECODER=1";


			if (useUBsan && useAsan)
			{
				Result += " -fsanitize=address,undefined -DFORCE_ANSI_ALLOCATOR=1 -fno-omit-frame-pointer";
			}
			else if (useUBsan && useLsan)
			{
				Result += " -fsanitize=undefined,leak";
			}
			else if (useUBsan)
			{
				Result += " -fsanitize=undefined";
			}
			else if (useAsan)
			{
				Result += " -fsanitize=address -DFORCE_ANSI_ALLOCATOR=1 -fno-omit-frame-pointer";
			}
			else if (useLsan)
			{
				Result += " -fsanitize=leak";
			}

			Result += " -sEVAL_CTORS=0"; // should likely by 1 when EVAL_CTORS supports threads

			Result += " -Wl,--gc-sections";

			if (!LinkEnvironment.bCreateDebugInfo || (maximumOptimizations && LinkEnvironment.Configuration == CppConfiguration.Shipping))
			{
				Result += " -Wl,--strip-debug";
			}

			if (LinkEnvironment.bPGOOptimize)
			{
				//
				// Clang emits warnings for each compiled object file that doesn't have a matching entry in the profile data.
				// This can happen when the profile data is older than the binaries we're compiling.
				//
				// Disable these warnings. They are far too verbose.
				//
				Result += " -Wno-profile-instr-out-of-date";
				Result += " -Wno-profile-instr-unprofiled";

				Result += String.Format(" -fprofile-use=\"{0}.profdata\"", Path.Combine(LinkEnvironment.PGODirectory!, LinkEnvironment.PGOFilenamePrefix!).Replace("\\", "/"));
			}
			else if (LinkEnvironment.bPGOProfile)
			{
				// Android supports only LLVM IR-based for instrumentation-based PGO.
				Result += " -fprofile-generate";
				//  for sampling-based profile collection to generate minimal debug information:
				Result += " -gline-tables-only";
			}

			//Result += " -Wl,-no-pie";
			if (LinkEnvironment.Configuration == CppConfiguration.Debug || LinkEnvironment.Configuration == CppConfiguration.Development)
			{
				Result += " -sSTACK_OVERFLOW_CHECK=1"; // 2 requires binayen opts which we can't use with dwarf5
				Result += " -sASSERTIONS=1";
				Result += " -sGL_ASSERTIONS=0";
				Result += " -sGL_DEBUG=0";
				Result += " -O1";
			}
			else
			{
				if (maximumOptimizations)
				{
					Result += " -Wl,-O3";
					// NOTE: no --icf here — wasm-ld has no ICF support (ELF/COFF LLD feature); passing
					// -Wl,--icf=all hard-fails every Shipping link ("unknown argument"). LTO + mergefunc
					// below cover the same ground.
					Result += " -O3";
					Result += " -mllvm -passes=mergefunc";
					//Result += " -mno-bulk-memory-opt -mno-bulk-memory";
				}
				else
				{
					//Result += " --profiling-funcs";
					Result += " -O1";
				}
				//js code needs to be properly written to supporty the closure compiler, look here for a possible perf gain. https://developers.google.com/closure/compiler/docs/api-tutorial3
				//Result += " --closure 1";
				//Result += " --profiling-funcs";
			}

			if (enableDebug == true)
			{
				//Result += " -gline-tables-only";
				if (enableDwarf5 == true)
				{
					Result += " -gdwarf-5";
					Result += " -sERROR_ON_WASM_CHANGES_AFTER_LINK";
				}
				else
				{
					Result += " -g";
				}
				Result += " -gseparate-dwarf=" + SimplyStreamSDKInfo.DebugUUID + ".debug.wasm";
				Result += " -sSEPARATE_DWARF_URL=http://127.0.0.1/" + SimplyStreamSDKInfo.DebugUUID + ".debug.wasm";
				//Result += " -sSEPARATE_DWARF_URL=file://" + SimplyStreamSDKInfo.DebugUUID + ".debug.wasm";
				Result += " -sREVERSE_DEPS=all";
			}

			if (profilerMode.Equals("cpu", StringComparison.InvariantCultureIgnoreCase))
			{
				Result += " --cpuprofiler";
			}
			else if (profilerMode.Equals("memory", StringComparison.InvariantCultureIgnoreCase))
			{
				// wndr-note: USE_OFFSET_CONVERTER was removed in emscripten 5.0
				// (the wasm offset converter is gone). Memory profiler still works
				// without it; __builtin_return_address callers need a different
				// strategy on 5.x.
				Result += " -sMALLOC=dlmalloc --memoryprofiler";
			}
			else if (profilerMode.Equals("thread", StringComparison.InvariantCultureIgnoreCase))
			{
				if (enableMultithreading)
				{
					Result += " --threadprofiler";
				}
			}


			if (enableShippingAssertions)
			{
				Result += " -sWARN_UNALIGNED=1";
				Result += " -sASSERTIONS=1"; // (2 was diag-only 2026-08-19)
				Result += " -g2"; // keep function names in the wasm name section — symbolized stacks named the real recursion site
				//Result += " -sGL_ASSERTIONS";
				if (enableDebug)
				{
					Result += " -sSTACK_OVERFLOW_CHECK=1";
				}
				else
				{
					// DIAG 2026-08-19 (silent worker recursion hunt): level 2
					// instruments EVERY function prologue and aborts WHILE the
					// recursion is still on the stack — with -g2 the abort JS
					// stack names the repeating function (this is how the
					// checkStackCookie-at-entry failure mode hid the culprit).
					// enableDwarf5=false so the binaryen pass is usable.
					// Revert to 1 after the recursion is named.
					Result += " -sSTACK_OVERFLOW_CHECK=1"; // (=2 was diag-only 2026-08-19: per-function check never tripped -> not stack descent)
				}
			}

			if (enableSAFE_HEAP && (LinkEnvironment.Configuration == CppConfiguration.Debug || LinkEnvironment.Configuration == CppConfiguration.Development))
			{
				Result += " -sSAFE_HEAP=1"; //2 for wasm only
				Result += " -g2"; // DIAG: keep function names in the wasm name section for symbolized stacks
				//Result += " -sSAFE_HEAP_LOG=1";
			}

			if (enableShippingAssertions || useUBsan || useAsan || useLsan || enableSAFE_HEAP)
			{
				Result += " --profiling-funcs";
			}

			if (useUBsan || useAsan || useLsan)
			{
				Result += " -fsanitize-recover=all";
			}

			if (enableTracing)
			{
				Result += " --tracing";
			}
			if (LinkEnvironment.Configuration == CppConfiguration.Shipping)
			{
				// wndr (names-on-server): preserve function names in a private function-index map without
				// --profiling-funcs, which would put the same names back into the shipped wasm. AutomationTool
				// rejects deployment if this map is absent or name/debug metadata survives the strip flags.
				Result += " --emit-symbol-map";
				if (ltoMode.Equals("thin", StringComparison.InvariantCultureIgnoreCase) && !maximumOptimizations)
				{
					Result += " -flto=thin";
					Result += " --thinlto-cache-dir=./thinlto_cache";
					Result += " -Wl,--lto-O3";
				}
				else if (ltoMode.Equals("full", StringComparison.InvariantCultureIgnoreCase) || maximumOptimizations) // determine if this is a net win, if not then dont enable it with maximumOptimizations
				{
					Result += " -flto";
					Result += " -Wl,--lto-O3";
				}
				Result += " --strip-debug --strip-dwarf --strip-producers";
				Result += " --merge-similar-functions --duplicate-function-elimination --inlining-optimizing --once-reduction";
			}
			Result += " -sINITIAL_MEMORY=" + initialMemoryMB + "MB";
			Result += " -sALLOW_MEMORY_GROWTH=1";
			Result += " -sMAXIMUM_MEMORY=" + maximumMemoryMB + "MB";
			// wndr: preload ICU icudt64l so FICUInternationalization::Initialize finds it in the wasm MEMFS (PreInit Fatal otherwise)
			Result += " --preload-file \"/mnt/vms/ss-build/UnrealEngine/Engine/Content/Internationalization/icudt64l@Engine/Content/Internationalization/icudt64l\"";

			// wndr: preload the .uproject so PreInit project-descriptor load finds it in MEMFS
			Result += " --preload-file \"/mnt/vms/ss-build/UnrealEngine/UnrealTournament/UnrealTournament.uproject@UnrealTournament/UnrealTournament.uproject\"";
			if (enableMultithreading)
			{
				//reserve this many threads.
				// wndr 2026-06-21: UE spawns a FIXED ~25-30 pthreads (game/render/RHI, audio x2, file-IO x2, IO
				// dispatcher, async loading, message router, media ticker, HTTP, online, output-redirector,
				// GIOThreadPool 2-4, LowLevelTasks workers 4, queued pools, ...) — this count is NOT core-bound
				// (NumberOf*WorkerThreadsToSpawn cap at 2-4). With the old pool=8 / =num_logical_cores, the pool was
				// exceeded and overflow threads were created ON-DEMAND (STRICT=0). On-demand creation needs the main
				// thread to instantiate each Worker; under render load that stalls, so a thread that must service
				// work queued to GIOThreadPool (e.g. FShaderCodeArchive shader-code reads during the instanced base
				// pass) never actually starts -> FShaderCodeArchive::WaitForPreload never completes -> the render
				// thread + RDG workers deadlock (game thread then blocks in FlushRenderingCommands). Pre-create a
				// pool that comfortably covers UE's whole thread set so no critical thread is on-demand. Net memory
				// is ~unchanged (these threads get created either way; DELAY_LOAD keeps startup non-blocking).
				if (mt_lowthreads)
				{
					Result += " -sPTHREAD_POOL_SIZE=32";
				} else
				{
					Result += " -sPTHREAD_POOL_SIZE=48";
				}

				//0 == allow more threads at runtime
				//1 == warning if thread pool is exhausted (default)
				//2 == error if thread pool is exhausted
				//why 0 is chosen == create more threads when they are needed
				Result += " -sPTHREAD_POOL_SIZE_STRICT=0";

				//0 == wait on thread pool before starting main (default)
				//1 == do not wait on thread pool
				//why 1 is chosen == faster startup time
				Result += " -sPTHREAD_POOL_DELAY_LOAD=1";

				//1 is default
				//Result += " -sALLOW_BLOCKING_ON_MAIN_THREAD=0";
			}

			Result += " -sUSE_WEBGPU=0";

			if (enableMultithreading)
			{
				//Result += " -sPROXY_TO_PTHREAD";
				//Result += " -sUSE_PTHREADS=1";
				Result += " -pthread";
						if (!LinkEnvironment.OutputFilePath.GetFileName().Contains("Server")/* && !buildForNode*/)
						{
							Result += " -sOFFSCREENCANVAS_SUPPORT=1"; // -s OFFSCREENCANVASES_TO_PTHREAD='#canvas' -s OFFSCREEN_FRAMEBUFFER=1
						}
			}

			// The HTML page template precreates the WebGL context, so instruct the runtime to hook into that if available.
			Result += " -sGL_PREINITIALIZED_CONTEXT=1";

			Result += " -sEXPORTED_RUNTIME_METHODS=\"['UTF8ToString', 'ccall']\"";
			Result += " -sEXPORTED_FUNCTIONS=\"['_free', '_malloc', '__emscripten_thread_crashed', '_emscripten_proxy_execute_queue', '_emscripten_proxy_finish', '_main', '_on_fatal', '_emscripten_is_main_browser_thread', '_emscripten_webgl_make_context_current', '_memset', '_ntohs', '_htons']\"";
			//Result += " -s NO_EXIT_RUNTIME=1";

			//Result += " -sSAFE_HEAP=1"; //2 for wasm only

			//Result += " --profiling-funcs";
			//Result += " -g";

			Result += " -v";
			//Result += " -s LLD_REPORT_UNDEFINED";
			//Result += " -s CASE_INSENSITIVE_FS=1";
			//Result += " -s FORCE_FILESYSTEM=1";
			//Result += " -s FILESYSTEM=0"; //would be nice but needs work
			//var stack_size = 5;

			//Result += " -s TOTAL_STACK=" + stack_size + "MB";
			// STACKFIX 2026-08-18: worker pthreads overflowed the 1MB default
			// ~11s after boot (checkStackCookie abort in invokeEntryPoint —
			// OnlineSubsystem/blueprint-context init chains on a worker). UE
			// call chains want multi-MB stacks; native UE uses 8MB workers.
			Result += " -sSTACK_SIZE=8MB";
			Result += " -sDEFAULT_PTHREAD_STACK_SIZE=8MB";
			Result += " -sWASM_BIGINT";
			// DawnRHI wasm device acquisition: main2 runs on a worker and must
			// acquire its own WebGPU device (per-thread emdawnwebgpu objects). We
			// pump the worker event loop with emscripten_sleep during init. JSPI
			// (native VM stack switching) services that with NO whole-program
			// instrumentation (-sASYNCIFY=1 hung/crawled the 765MB boot). Browser
			// must have JSPI enabled (--enable-experimental-webassembly-jspi).
			Result += " -sJSPI";
			Result += " -sFETCH=1";
			//Result += " -sDYNCALLS=1";
			//Result += " --proxy-to-worker";
			//Result += " -lidbfs.js";
			//Result += " -lpthread.js";
			Result += " -lhtml5_webgl.js";
			// STOCK-EMSDK BRING-UP: link driver runs in C mode; force C++ so emcc auto-links the
			// correct noexcept/mt/memory64 libc++ variant. Without this stock emcc 6.x links NO libc++.
			Result += " -sDEFAULT_TO_CXX";
			//Result += " -s LZ4=1";
			Result += " -lwebsocket.js";
			// wndr 5.8/wasm: setjmp/longjmp shim. We keep -sSUPPORT_LONGJMP=0 (instrumented longjmp hurts perf); this
			// js-library resolves the setjmp/longjmp imports that stock engine code (PngImageWrapper libpng error
			// handling, JPEG/FreeType) pulls in — setjmp()->0 (happy path) / longjmp()->abort. Without it the app aborts
			// at startup with "missing function: setjmp" the first time a PNG/etc. is decoded.
			Result += " --js-library \"" + Directory.GetCurrentDirectory() + "/../Platforms/SimplyStream/Source/Runtime/Core/Private/SimplyStreamSetjmpShim.js\"";
			// wndr 5.8/wasm: getaddrinfo MEMORY64 fix. Passed AFTER the stock library so this definition wins (same
			// override mechanism as the setjmp shim). Stock emscripten getaddrinfo stores a JS null/string into the
			// ai_canonname POINTER field; under -sMEMORY64+-sWASM_BIGINT that becomes BigInt(null) which throws and
			// crashes the wasm the moment UE netcode resolves a server hostname (MP join). See the shim's header.
			Result += " --js-library \"" + Directory.GetCurrentDirectory() + "/../Platforms/SimplyStream/Source/Runtime/Sockets/Private/SimplyStreamGetaddrinfoShim.js\"";
			Result += " --shell-file \"" + Directory.GetCurrentDirectory() + "/../Platforms/SimplyStream/simplystream.html\"";
			if (LinkEnvironment.OutputFilePath.GetFileName().Contains("Server") || buildForNode)
			{
				//Result += " -sENVIRONMENT=node";
				//Result += " --extern-pre-js \"" + Directory.GetCurrentDirectory() + "/../Platforms/SimplyStream/shell2_server.js\"";
			}
			else
			{
				Result += " -sENVIRONMENT=web,worker";
			}
			Result += " --pre-js \"" + Directory.GetCurrentDirectory() + "/../Platforms/SimplyStream/simplystream.js\"";
			//Result += " --bind";

			if (LinkEnvironment.bIsBuildingDLL)
			{
				//Result += " -s SIDE_MODULE=2";
				//Console.WriteLine("Compiling side module");
			}
			else
			{
				//Result += " -s MAIN_MODULE=2";
				//Console.WriteLine("Compiling main module");
			}
			//Result += " -Wl,--fatal-warnings";

			//Result += " --closure 1";
			//Result += " -s IGNORE_CLOSURE_COMPILER_ERRORS=1";
			//enable after closure compiler works
			//Result += " -sSUPPORT_ERRNO=0";
			Result += " -sFETCH_SUPPORT_INDEXEDDB=0";

			//Result += " -s SUPPORT_LONGJMP=1";
			//Console.WriteLine("Using closure compiler");
			Result += " -sERROR_ON_UNDEFINED_SYMBOLS=0";

			Result += $" -sMEMORY64={Memory64Setting}";

			{
				Result += " -sUSE_VORBIS";
				Result += " -sUSE_ZLIB";
				Result += " -sUSE_OGG";
				//Result += " -sUSE_LIBPNG";
				//Result += " -sUSE_HARFBUZZ";
				//Result += " -sUSE_ICU";
				//Result += " -sUSE_FREETYPE";
			}

			if (!profilerMode.Equals("memory", StringComparison.InvariantCultureIgnoreCase))
			{
				//Result += " -sMALLOC=emmalloc mimalloc.o";
				// wndr-note: USE_OFFSET_CONVERTER was removed in emscripten 5.0;
				// the setting no longer exists so passing =0 errors. Default
				// behaviour on 5.x is what the =0 path used to ask for.
			}

			return Result;
		}

		static string GetLibArguments(LinkEnvironment LinkEnvironment)
		{
			string Result = "";

			return Result;
		}

		// wndr 5.8/wasm: build-time shadow-patching of stock engine headers (see GetCompileArguments_Global).
		// We copy the *current* engine header into an Intermediate shadow dir, ReplaceInline the inline-asm
		// that emscripten can't build, and -iquote that dir so it resolves before the real header. No engine
		// source on disk is modified, and the patch is regenerated from the live source each build.
		static bool bWasmShadowHeadersGenerated = false;
		DirectoryReference GenerateWasmShadowHeaders()
		{
			DirectoryReference ShadowDir = DirectoryReference.Combine(Unreal.EngineDirectory, "Intermediate", "Build", "SimplyStream", $"ShadowIncludeMemory32Epoch{Memory32CompatibilityEpoch}");
			if (bWasmShadowHeadersGenerated)
			{
				return ShadowDir;
			}
			// UnrealMathNeon.h ("Math/..."): VectorGet/SetControlRegister read/write the ARM FPCR via inline asm
			// (mrs/msr), called unconditionally by FScopedFTZFloatMode. wasm has no FPCR -> neutralize (get->0,
			// set->no-op); the NEON math path then compiles and FTZ becomes a harmless no-op.
			ShadowPatch(ShadowDir, false, "Runtime/Core/Public/Math/UnrealMathNeon.h", "Math/UnrealMathNeon.h", new Dictionary<string, string>
			{
				{ "__asm__ volatile(\"mrs %0, fpcr\" : \"=r\"(Value));", "Value = 0; /* wndr wasm: no FPCR */" },
				{ "__asm__ volatile(\"msr fpcr, %0\" : : \"r\"(State64));", "(void)State64; /* wndr wasm: no FPCR */" },
			});
			// AtomicQueue.h (ThirdParty, <>-included): spin-yield uses the ARM `isb` inline asm under
			// PLATFORM_CPU_ARM_FAMILY, which emscripten can't assemble; wasm has no pause/yield -> no-op.
			ShadowPatch(ShadowDir, true, "ThirdParty/AtomicQueue/AtomicQueue.h", "AtomicQueue.h", new Dictionary<string, string>
			{
				{ "__asm__ __volatile__(\"isb\");", "((void)0); /* wndr wasm: no ARM isb */" },
			});
			// Crc.cpp: MemCrc32ArmHW uses ARM __builtin_arm_crc32b/d under `#if defined(__clang__) && PLATFORM_CPU_ARM_FAMILY`.
			// It's compiled but never selected on wasm (DETECT_HW_CRC32_SUPPORT_IN_RUNTIME==0 and __ARM_FEATURE_CRYPTO is
			// undefined), so force the guard off; the portable table-based FCrc::MemCrc32Func is used instead (identical CRC
			// values). Forcing it off (rather than stubbing the builtins) also avoids an unused-static-function error.
			// Although it's a .cpp, UE's unity blobs pull it in via a quoted, include-path-relative #include
			// ("Runtime/Core/Private/Misc/Crc.cpp"), so the -iquote header shadow resolves it before the engine copy.
			ShadowPatch(ShadowDir, false, "Runtime/Core/Private/Misc/Crc.cpp", "Runtime/Core/Private/Misc/Crc.cpp", new Dictionary<string, string>
			{
				{ "#if defined(__clang__) && PLATFORM_CPU_ARM_FAMILY", "#if defined(__clang__) && PLATFORM_CPU_ARM_FAMILY && !defined(__EMSCRIPTEN__)" },
			});
			// RigLogic trimd/Platform.h (included as "trimd/Platform.h"): with TRIMD_PLATFORM_ARM forced on (see the
			// compat shim), trimd takes its ARM/NEON path, but its ARM getCPUFeatures() uses getauxval(AT_HWCAP) which
			// emscripten lacks. Add an emscripten branch that reports NEON (wasm-simd128 provides NEON via SIMDe) so
			// RigLogic selects its NEON specialization (trimd::neon) — NO scalar fallback.
			ShadowPatch(ShadowDir, false, "../Plugins/Animation/RigLogic/Source/RigLogicLib/Public/trimd/Platform.h", "trimd/Platform.h", new Dictionary<string, string>
			{
				// (a) platform-includes block: skip the Linux <sys/auxv.h> CPU-feature include on emscripten.
				{ "#include \"trimd/PlatformWindows.h\"\n        #else\n            #include <sys/auxv.h>", "#include \"trimd/PlatformWindows.h\"\n        #elif defined(__EMSCRIPTEN__)\n            /* wndr wasm: NEON via SIMDe; no CPU-feature detection includes */\n        #else\n            #include <sys/auxv.h>" },
				// (b) getCPUFeatures block: report NEON (wasm-simd128 provides it via SIMDe) instead of the getauxval path.
				{ "        #else\n            #ifdef __arm__\n                // ARM-32bit", "        #elif defined(__EMSCRIPTEN__)\ninline CPUFeatures getCPUFeatures() {\n    CPUFeatures flags = {};\n    flags.NEON = true;  /* wndr wasm: wasm-simd128 provides NEON via SIMDe */\n    flags.FP16 = true;\n    return flags;\n}\n        #else\n            #ifdef __arm__\n                // ARM-32bit" },
			});
			// HairStrandsVertexFactory.h: clang rejects specializing StaticType (via IMPLEMENT_TEMPLATE_VERTEX_FACTORY_TYPE
			// in the .cpp) after it was implicitly instantiated. In a unity build, GroomAsset.cpp (bundled earlier in the
			// SAME TU) takes &FHairStrandsVertexFactory::StaticType, implicitly instantiating it before the .cpp
			// specializes it. Fix by declaring the explicit specializations in the header so nobody implicitly
			// instantiates. (MSVC tolerates this; clang does not.) No SIMD involved. Use a WRAPPER shadow that #includes
			// the real header (deduped with it by #pragma-once file-identity, avoiding a redefinition) then appends the
			// declarations — a copied shadow would be a distinct file and double-define the class.
			ShadowWrap(ShadowDir, false, "../Plugins/Runtime/HairStrands/Source/HairStrandsCore/Public/HairStrandsVertexFactory.h", "HairStrandsVertexFactory.h",
				"template<> FVertexFactoryType FHairStrandsVertexFactory::StaticType;\ntemplate<> FVertexFactoryType FLinearSweptSpheresHairStrandsVertexFactory::StaticType;\n");
			// ACL/RTM rtm/math.h (pulled in via <rtm/quatf.h> -> "rtm/math.h"): emscripten defines __SSE2__ (under
			// -msimd128), so RTM auto-selects its SSE2 impl (rtm::vector4f == __m128) while UE forces NEON
			// (VectorRegister4f == float32x4_t) — the two SIMDe families don't interconvert, so ACL's
			// `Rotation = rtm_quat` / `VectorSet_W0(rtm_vec)` fail. Force RTM to NEON on emscripten so its types match
			// UE's (both float32x4_t). No scalar fallback — keeps ACL vectorized.
			// bSystem:true -> served via -isystem (the shadow `sys` dir is the FIRST -isystem, added before base), so it
			// wins over the real rtm/math.h for BOTH quoted ("rtm/math.h") and angle (<rtm/math.h>) includes regardless
			// of include order. (With -iquote it worked in isolation but lost in the full TU when something reached the
			// real header first; the shadow's detection is guarded by `#if !defined(RTM_NO_INTRINSICS)` and got skipped.)
			ShadowPatch(ShadowDir, true, "../Plugins/Animation/ACLPlugin/Source/ThirdParty/acl/external/rtm/includes/rtm/math.h", "rtm/math.h", new Dictionary<string, string>
			{
				{ "#elif defined(__SSE2__) || defined(RTM_ARCH_X86) || defined(RTM_ARCH_X64)", "#elif (defined(__SSE2__) || defined(RTM_ARCH_X86) || defined(RTM_ARCH_X64)) && !defined(__EMSCRIPTEN__)" },
				{ "#elif defined(RTM_ARCH_ARM)", "#elif defined(RTM_ARCH_ARM) || defined(__EMSCRIPTEN__)" },
			});
			// AES.cpp: at -O3 the loop vectorizer can't further auto-vectorize the already-NEON ARM AES routines and
			// emits -Wpass-failed (an optimizer remark, not a code defect; the failing loop is in inlined AES code so a
			// per-loop pragma can't pin it). Wrap the two `target("aes")` blocks in a diagnostic-ignored region so the
			// remark is silenced for *just* those AES functions; -Wpass-failed stays active everywhere else.
			ShadowPatch(ShadowDir, false, "Runtime/Core/Private/Misc/AES.cpp", "Runtime/Core/Private/Misc/AES.cpp", new Dictionary<string, string>
			{
				{ "#pragma clang attribute push (__attribute__((target(\"aes\"))), apply_to=function)", "#pragma clang attribute push (__attribute__((target(\"aes\"))), apply_to=function)\n#pragma clang diagnostic push\n#pragma clang diagnostic ignored \"-Wpass-failed\"" },
				{ "#pragma clang attribute pop", "#pragma clang diagnostic pop\n#pragma clang attribute pop" },
			});
			// NameTypes.h: FLazyName stores either a pointer or a packed uint64 in the same union. With a native
			// wasm32 pointer, the stock literal constructors initialize only the low four bytes; their by-value ABI
			// then copies all eight union bytes, and Resolve() can mistake indeterminate high bits for IsNameFlag.
			// Zero the full union before activating the pointer member. Keep the stock initializer for MEMORY64=1/2.
			DirectoryReference NameTypesVfsDir = DirectoryReference.Combine(ShadowDir, "vfs");
			ShadowPatch(NameTypesVfsDir, false, "Runtime/Core/Public/UObject/NameTypes.h", "NameTypes.h", new Dictionary<string, string>
			{
				{
					": Either{.AnsiLiteral = Literal}\n\t\t, Number(ParseNumber(Literal, N - 1))\n\t\t, LiteralType(ELiteralType::AnsiLiteral)\n\t{\n\t}",
					"#if defined(__EMSCRIPTEN__) && MEMORY64 == 0\n\t\t: Either{.PackedName = 0}\n#else\n\t\t: Either{.AnsiLiteral = Literal}\n#endif\n\t\t, Number(ParseNumber(Literal, N - 1))\n\t\t, LiteralType(ELiteralType::AnsiLiteral)\n\t{\n#if defined(__EMSCRIPTEN__) && MEMORY64 == 0\n\t\tEither.AnsiLiteral = Literal;\n#endif\n\t}"
				},
				{
					": Either{.Utf8Literal = Literal}\n\t\t, Number(ParseNumber(Literal, N - 1))\n\t\t, LiteralType(ELiteralType::Utf8Literal)\n\t{\n\t}",
					"#if defined(__EMSCRIPTEN__) && MEMORY64 == 0\n\t\t: Either{.PackedName = 0}\n#else\n\t\t: Either{.Utf8Literal = Literal}\n#endif\n\t\t, Number(ParseNumber(Literal, N - 1))\n\t\t, LiteralType(ELiteralType::Utf8Literal)\n\t{\n#if defined(__EMSCRIPTEN__) && MEMORY64 == 0\n\t\tEither.Utf8Literal = Literal;\n#endif\n\t}"
				},
				{
					": Either{.WideLiteral = Literal}\n\t\t, Number(ParseNumber(Literal, N - 1))\n\t\t, LiteralType(ELiteralType::WideLiteral)\n\t{\n\t}",
