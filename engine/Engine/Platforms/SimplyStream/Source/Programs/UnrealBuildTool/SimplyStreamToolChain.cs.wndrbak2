					"#if SIMPLYSTREAM_MEMORY32\n\tif (InVertexFactoryParameters.IsNull())\n\t{\n\t\tWriter.WriteNullPointer();\n\t\treturn;\n\t}\n#endif\n\tconst FVertexFactoryType* VertexFactoryType = GetVertexFactoryType(Writer.TryGetPrevPointerTable());\n#if SIMPLYSTREAM_MEMORY32\n\tcheckf(VertexFactoryType, TEXT(\"Converted mesh-material shader has non-null vertex-factory parameters but no resolved vertex-factory type\"));\n\tconst FTypeLayoutDesc* VertexFactoryParameterLayout = VertexFactoryType->GetShaderParameterLayout(GetFrequency());\n\tif (!VertexFactoryParameterLayout)\n\t{\n\t\t// An unregistered frequency has no parameter constructor or bindings. Cross-layout\n\t\t// conversion can expose non-zero archived padding here; normalize it to target null.\n\t\tWriter.WriteNullPointer();\n\t\treturn;\n\t}\n\tInVertexFactoryParameters.WriteMemoryImageWithDerivedType(Writer, VertexFactoryParameterLayout);\n#else\n\tInVertexFactoryParameters.WriteMemoryImageWithDerivedType(Writer, VertexFactoryType->GetShaderParameterLayout(GetFrequency()));\n#endif"
