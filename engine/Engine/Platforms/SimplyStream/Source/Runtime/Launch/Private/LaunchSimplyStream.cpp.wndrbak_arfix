static void ApplyWndrRDGDiagnosticOverrides()
{
	struct FOverride
	{
		const TCHAR* Argument;
		const TCHAR* CVarName;
	};

	const FOverride Overrides[] =
	{
		{ TEXT("-WndrRDGValidation="), TEXT("r.RDG.Validation") },
		{ TEXT("-WndrRDGParallelExecute="), TEXT("r.RDG.ParallelExecute") },
	};

	for (const FOverride& Override : Overrides)
	{
		int32 Value = 0;
		if (!FParse::Value(GCmdLine, Override.Argument, Value))
		{
			continue;
		}

		if (IConsoleVariable* CVar = IConsoleManager::Get().FindConsoleVariable(Override.CVarName))
		{
			CVar->Set(Value, ECVF_SetByCommandline);
			FPlatformMisc::LowLevelOutputDebugStringf(TEXT("[WndrDoctor] startup override %s=%d\n"), Override.CVarName, Value);
		}
	}
}

// wndr Issue-2 mitigation (2026-08-16): the first WORLD frame (frame ~5-8, right when
// FSceneRenderer first runs — the menu never exercises these paths) consistently parks
// the game thread in an UNTIMED ParkingLot wait (heartbeat blockSite=6) before any
// submit/present. The prime suspects are the renderer's task-graph fan-outs whose
// completion the game thread waits on untimed (visibility tasks, parallel mesh-draw
// -command setup, RDG parallel setup, async scene-culling updates) — on this
// -onethread wasm config the awaited TaskGraph-worker task can fail to complete.
// Force those paths synchronous on the (single) render/game thread; on wasm they are
// perf-neutral-to-positive anyway (cross-worker bounces are expensive). The site-6
// probe (SimplyStreamPlatformManualResetEvent.h) still stack-dumps any survivor.
static void ApplyWndrWasmSyncRenderOverrides()
{
	const TCHAR* CVarsToZero[] =
	{
		TEXT("r.Visibility.TaskSchedule"),          // visibility task graph -> render-thread schedule
		TEXT("r.MeshDrawCommands.ParallelPassSetup"), // no setup task -> no WaitForSetupTask park
		TEXT("r.RDG.ParallelSetup"),                // RDG pass setup inline
		TEXT("r.SceneCulling.Async.Update"),        // scene-culling hierarchy update inline
		TEXT("r.SceneCulling.Async.Query"),         // scene-culling queries inline
		TEXT("r.AsyncCreateLightPrimitiveInteractions"), // LPI creation inline
		// Frame-19 deadlock (SceneVisibilityPrivate.h(602) DynamicMeshElements):
		// parallel GDME creates RHI buffers on task workers -> emdawnwebgpu
		// per-thread assert -> dead worker -> unsignaled task event. Root fix is
		// GSupportsParallelRenderingTasksWithSeparateRHIThread=false in
		// FDawnDynamicRHI::Init(); these are belt-and-braces.
		TEXT("r.Visibility.DynamicMeshElements.Parallel"),
		TEXT("r.Visibility.DynamicMeshElements.NumMainViewTasks"),
		// Hardware occlusion culling: DawnRHI has no real render queries (its
		// stubs report "everything visible"); turn the whole pass off.
		TEXT("r.AllowOcclusionQueries"),
		// WNDR 2026-08-19 (worker-death survival): async font lazy loads run
		// FAsyncLoadFontFaceData on a POOL worker doing IoStore file IO — the
		// known-fragile off-main-thread path, and the FONTCYCLE guard only
		// covers the synchronous GetFontFace route. Force fonts to load
		// synchronously on the calling thread.
		TEXT("Slate.Font.AsyncLazyLoad"),
	};
	for (const TCHAR* Name : CVarsToZero)
	{
		if (IConsoleVariable* CVar = IConsoleManager::Get().FindConsoleVariable(Name))
		{
			CVar->Set(0, ECVF_SetByCommandline);
			FPlatformMisc::LowLevelOutputDebugStringf(TEXT("[WndrDoctor] wasm sync-render override %s=0\n"), Name);
		}
		else
		{
			FPlatformMisc::LowLevelOutputDebugStringf(TEXT("[WndrDoctor] wasm sync-render override SKIPPED (missing CVar) %s\n"), Name);
		}
	}
}

