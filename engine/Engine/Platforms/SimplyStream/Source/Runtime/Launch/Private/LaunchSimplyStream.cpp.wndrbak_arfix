#if PLATFORM_WASM
static void SimplyStream_MountIoStoreContainers()
{
	if (!FIoDispatcher::IsInitialized())
	{
		UE_LOG(LogInit, Error, TEXT("[wndr] IoStore mount: FIoDispatcher NOT initialized"));
		return;
	}
	UE_LOG(LogInit, Display, TEXT("[wndr] IoStore mount: platform file BEFORE force = %s"), FPlatformFileManager::Get().GetPlatformFile().GetName());
	// PreInit may have re-wrapped the platform file with IAS PathPak (OpenRead fails
	// with no platform server). Force the physical POSIX file so container reads hit MEMFS.
	UE_LOG(LogInit, Display, TEXT("[wndr] IoStore mount: forcing physical platform file"));
	FPlatformFileManager::Get().SetPlatformFile(IPlatformFile::GetPlatformPhysical());
	UE_LOG(LogInit, Display, TEXT("[wndr] IoStore mount: physical=%s current-after-force=%s"), IPlatformFile::GetPlatformPhysical().GetName(), FPlatformFileManager::Get().GetPlatformFile().GetName());
	// Force IoStore to NOT memory-map the .utoc (OpenMappedEx path is unpatched on MEMFS);
	// use OpenRead instead, which our wasm direct exact-case open() fix handles.
	if (IConsoleVariable* CVarMM = IConsoleManager::Get().FindConsoleVariable(TEXT("IoStore.AllowMemoryMappedUtoc"))) { CVarMM->Set(false); }
	FIoDispatcher& IoD = FIoDispatcher::Get();
	static TSharedPtr<UE::IoStore::IFileIoDispatcherBackend> Backend = UE::IoStore::MakeFileIoDispatcherBackend();
	IoD.Mount(Backend.ToSharedRef());
	static TSharedRef<FFilePackageStoreBackend> PkgStore = MakeShared<FFilePackageStoreBackend>();
	FPackageStore::Get().Mount(PkgStore);
	const TCHAR* Tocs[] = {
		TEXT("/UnrealTournament/Content/Paks/global.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent2.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent3.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent4.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent5.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent6.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent7.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent8.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent9.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent10.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent11.utoc"),
		TEXT("/UnrealTournament/Content/Paks/utcontent12.utoc"),
	};
	for (const TCHAR* Toc : Tocs)
	{
		UE_LOG(LogInit, Display, TEXT("[wndr] calling Backend->Mount %s"), Toc);
		TIoStatusOr<FIoContainerHeader> St = Backend->Mount(Toc, 0, FGuid(), FAES::FAESKey());
		UE_LOG(LogInit, Display, TEXT("[wndr] Backend->Mount returned for %s ok=%d"), Toc, (int)St.IsOk());
		if (St.IsOk())
		{
			FIoContainerHeader* Hdr = new FIoContainerHeader(St.ConsumeValueOrDie());
			UE_LOG(LogInit, Display, TEXT("[wndr] calling PkgStore->Mount for %s"), Toc);
			PkgStore->Mount(Hdr, 0);
			UE_LOG(LogInit, Display, TEXT("[wndr] PkgStore->Mount done for %s"), Toc);
			UE_LOG(LogInit, Display, TEXT("[wndr] mounted IoStore container %s"), Toc);
		}
		else
		{
			UE_LOG(LogInit, Error, TEXT("[wndr] IoStore mount FAILED %s :: %s"), Toc, *St.Status().ToString());
		}
	}
}
#endif

KEEP_IN_MODULE void SIMPLYSTREAM_Init() {
	ApplyWndrRDGDiagnosticOverrides();
	ApplyWndrWasmSyncRenderOverrides();
#if PLATFORM_WASM
	if (GEngineLoop.PreInitPreStartupScreen(GCmdLine) == 0)
	{
		SimplyStream_MountIoStoreContainers();
		GEngineLoop.PreInitPostStartupScreen(GCmdLine);
	}
#else
	GEngineLoop.PreInit(0, NULL, GCmdLine);
#endif
	DoSimplyStreamInitCp1();
	GEngineLoop.Init();
	DoSimplyStreamInitCp2();
	DoSimplyStreamInit();
	emscripten_set_beforeunload_callback(0, beforeunload_callback);
}


