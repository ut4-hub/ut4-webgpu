KEEP_IN_MODULE int main2(int argc, char** argv) {
	FTaskTagScope Scope(ETaskTag::EGameThread);
	GCmdLine[0] = 0;
	setlocale(LC_ALL, "C.UTF-8");

	FCString::Strcpy(GCmdLine, TEXT(" "));
	for (int Option = 1; Option < GSimplyStreamArgc; Option++) {
		FCString::Strcat(GCmdLine, TEXT("  "));
		FCString::Strcat(GCmdLine, ANSI_TO_TCHAR(GSimplyStreamArgv[Option]));
	}
	FCString::Strcat(GCmdLine, ANSI_TO_TCHAR(" -stdout"));

	/* wndr standalone: closed SimplyStreamMain() blocks the game thread on the platform host before PreInit; skip it (set WNDR_RUN_SS_MAIN to restore) */
	if (getenv("WNDR_RUN_SS_MAIN")) { SimplyStreamMain(); }
	else {
		/* wndr standalone: the JS loader calls main() directly, bypassing emscripten's run-dep-gated run(),
		   so the .data package (ICU + startup content) may not be mounted when this game thread reaches
		   ICU init. SimplyStreamMain() normally waited for it; replicate the wait by polling the VFS. */
		struct stat st; int waited = 0; const char* p = "/Engine/Content/Internationalization/icudt64l";
		while (stat(p, &st) != 0 && waited < 30000) { usleep(2000); waited += 2; }
		fprintf(stderr, "[wndr] ICU-data wait: %s after %dms\\n", (stat(p,&st)==0)?"MOUNTED":"TIMEOUT", waited);
	}
	{ struct stat su; const char* pu="/UnrealTournament/UnrealTournament.uproject"; int wu=0; while(stat(pu,&su)!=0 && wu<30000){usleep(2000);wu+=2;} fprintf(stderr,"[wndr] uproject wait: %s after %dms size=%ld\\n",(stat(pu,&su)==0)?"MOUNTED":"TIMEOUT",wu,(long)su.st_size); } { char _cwd[256]; getcwd(_cwd,sizeof(_cwd)); struct stat _sr; int _rr=stat("../../../UnrealTournament/UnrealTournament.uproject",&_sr); struct stat _sd; int _rd=stat("/UnrealTournament/Binaries",&_sd); fprintf(stderr,"[wndr] cwd=%s relstat=%d binstat=%d\n",_cwd,_rr,_rd); }
	// wndr wasm standalone: the IAS PathPak resolver installs itself as the top platform file and
	// fails reads with no platform server; force the physical (FUnix) file so UE reads hit the working MEMFS.
	FPlatformFileManager::Get().SetPlatformFile(IPlatformFile::GetPlatformPhysical());
	fprintf(stderr, "[wndr] forced physical platform file before PreInit\n");
	// OffscreenCanvas transferred to this worker reports ~0 size; set it to the declared
	// size BEFORE PreInit/RHIInit so the WebGPU surface + game window are full-size.
	emscripten_set_canvas_element_size("#canvas", 1280, 720);
	fprintf(stderr, "[wndr] set canvas element size 1280x720\n");
	SIMPLYSTREAM_Init();
	emscripten_exit_with_live_runtime();
	return 0;
}

