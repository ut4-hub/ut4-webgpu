#if PLATFORM_WASM
	// WNDR tick-wide delete fence (2026-08-20): suppress ALL deferred-delete flushes for the WHOLE
	// tick (game tick + render), so RestartPlayer's respawn teardown (a ~47k-resource batch) frees
	// NOTHING mid-tick -> no inline DeleteResources/Submit_Close executor cascade -> no re-entrant
	// double-destruct OOB. RHIEndFrame drains everything ONCE (controlled, non-re-entrant) then
	// clears the fence -> suppress-during-tick + flush-once-per-frame, so nothing leaks.
	{ extern RHI_API bool GWndrSuppressDeleteFlush; GWndrSuppressDeleteFlush = true; }
#endif
	WndrMarkGameTickEnter();
	GEngineLoop.Tick();
	WndrMarkGameTickEngineDone();
	DoSimplyStreamTick();
	WndrMarkGameTickPlatformDone();
}
