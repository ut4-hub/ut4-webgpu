void SIMPLYSTREAM_frameSync();
// The main loop is rAF-driven; browsers stop rAF entirely for hidden documents, and the
// game thread (a pthread, NOT suspended) then blocks forever on the main-thread frame
// service — a tab switch mid-session wedges the game permanently (observed live via CDP:
// visibilityState=hidden, rAF count 0, presented-frame counter frozen). While hidden,
// drive the loop on a timer (browser clamps it — that is fine); resume rAF when visible.
static EM_BOOL SIMPLYSTREAM_onVisibilityChanged(int, const EmscriptenVisibilityChangeEvent* E, void*)
{
	if (E->hidden) { emscripten_set_main_loop_timing(EM_TIMING_SETTIMEOUT, 100); }
	else { emscripten_set_main_loop_timing(EM_TIMING_RAF, 0); }
	return EM_TRUE;
}
EMSCRIPTEN_KEEPALIVE int main(int argc, char** argv) {
	// wndr: capture before the PROXY_TO_PTHREAD hand-off. DEEP-COPY argv to the
	// heap first: the argv strings the JS loader hands main() are not guaranteed
	// to outlive main()'s frame on THIS thread, but the game-thread pthread reads
	// them later (main2's ANSI_TO_TCHAR loop) — reading the originals raced and
	// intermittently crashed boot with "memory access out of bounds" in
	// strlen <- TStringConversion <- main2.
	GSimplyStreamArgc = argc;
	if (argc > 0 && argv) {
		char** CopiedArgv = (char**)malloc(sizeof(char*) * (size_t)argc);
		for (int i = 0; i < argc; ++i) { CopiedArgv[i] = argv[i] ? strdup(argv[i]) : nullptr; }
		GSimplyStreamArgv = CopiedArgv;
	} else {
		GSimplyStreamArgc = 0;
		GSimplyStreamArgv = nullptr;
	}
	pthread_attr_t attr;
	pthread_attr_init(&attr);
	pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
	pthread_attr_setstacksize(&attr, emscripten_stack_get_base() - emscripten_stack_get_end());
	// Transfer the page canvas to the engine thread so DawnRHI can create a WebGPU
	// surface there. WebGPU objects are per-thread; device + all rendering live on
	// this thread, so the canvas must too (else wgpuInstanceCreateSurface finds none).
	emscripten_pthread_attr_settransferredcanvases(&attr, "#canvas");
	pthread_t thread;
	int rc = pthread_create(&thread, &attr, _main_thread, NULL);
	pthread_attr_destroy(&attr);
	emscripten_set_visibilitychange_callback(nullptr, EM_FALSE, SIMPLYSTREAM_onVisibilityChanged);
	emscripten_set_main_loop(SIMPLYSTREAM_frameSync, 0, true);
	emscripten_exit_with_live_runtime();
	return rc;
}
