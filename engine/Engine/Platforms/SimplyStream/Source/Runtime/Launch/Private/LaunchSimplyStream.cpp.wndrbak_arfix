// Field-freeze self-heal (2026-07-05): trace evidence shows the second-join freeze is the
// game thread polling FFrameEndSync's render-command fence forever while the RENDER thread
// sleeps in its task-queue stall wait with the fence task undelivered — a lost task-queue
// wakeup. The [WndrHeartbeat] monitor calls this on stall; if the game recovers, the lost
// wake is confirmed (and players get a ~15s hitch instead of a dead tab).
extern "C" EMSCRIPTEN_KEEPALIVE void wndr_kick_named_threads() {
	if (FTaskGraphInterface::IsRunning()) {
		FTaskGraphInterface::Get().WakeNamedThread(ENamedThreads::GetRenderThread());
		FTaskGraphInterface::Get().WakeNamedThread(ENamedThreads::GameThread);
	}
}
