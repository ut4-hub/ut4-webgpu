void FDawnCommandContext::RHISetShaderParameters(FRHIComputeShader* ComputeShader, TConstArrayView<uint8> InParametersData, TConstArrayView<FRHIShaderParameter> InParameters, TConstArrayView<FRHIShaderParameterResource> InResourceParameters, TConstArrayView<FRHIShaderParameterResource> InBindlessParameters)
{
	// no-op: DawnRHI runs no compute; compute shader parameters are ignored.
}

// Derive the shader-side uniform-buffer name from the layout debug name:
// FViewUniformShaderParameters -> View, FMobileBasePassUniformParameters ->
// MobileBasePass, FSlateViewUniformParameters -> SlateView. This is the name
// the cooked WGSL var carries (see the bridge's WNDR rename pass), so the
// draw-time static-UB match can bind it exactly.
static FString DawnDeriveShaderUBName(const FString& DebugName)
{
	FString N = DebugName;
	if (N.Len() > 1 && N[0] == TEXT('F') && FChar::IsUpper(N[1])) { N.RightChopInline(1); }
	static const TCHAR* const Suffixes[] = { TEXT("UniformShaderParameters"), TEXT("UniformParameters"), TEXT("ShaderParameters"), TEXT("Parameters") };
	for (const TCHAR* Sfx : Suffixes) { if (N.EndsWith(Sfx, ESearchCase::CaseSensitive)) { N.LeftChopInline(FCString::Strlen(Sfx)); break; } }
	return N;
}

void FDawnCommandContext::RHISetStaticUniformBuffers(const FUniformBufferStaticBindings& InUniformBuffers)
{
	for (int32 i = 0; i < InUniformBuffers.GetUniformBufferCount(); ++i)
	{
		if (FRHIUniformBuffer* UB = InUniformBuffers.GetUniformBuffer(i))
		{
			StaticUBsByName.Add(UB->GetLayout().GetDebugName(), UB);
			{ const FString DKey = DawnDeriveShaderUBName(UB->GetLayout().GetDebugName()); if (!DKey.IsEmpty()) StaticUBsByName.Add(DKey, UB); }
			{ const FString _n=UB->GetLayout().GetDebugName(); const bool _v=_n.Contains(TEXT("View"))&&!_n.Contains(TEXT("Slate")); static uint32 _su=0; if(_v||_su++<8) UE_LOG(LogTemp, Warning, TEXT("STATICUB set name=%s size=%u"), *_n, UB->GetLayout().ConstantBufferSize); }
		}
	}
}

void FDawnCommandContext::RHISetStaticUniformBuffer(FUniformBufferStaticSlot Slot, FRHIUniformBuffer* UniformBuffer)
{
	if (UniformBuffer)
	{
		StaticUBsByName.Add(UniformBuffer->GetLayout().GetDebugName(), UniformBuffer);
		{ const FString DKey = DawnDeriveShaderUBName(UniformBuffer->GetLayout().GetDebugName()); if (!DKey.IsEmpty()) StaticUBsByName.Add(DKey, UniformBuffer); }
	}
}

