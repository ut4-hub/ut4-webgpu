#include "DawnCommandContext.h"
#include "DawnDynamicRHI.h"
#include "DawnResources.h"

FDawnCommandContext::FDawnCommandContext(FDawnDynamicRHI* InOwner)
	: Owner(InOwner)
{
}

FDawnCommandContext::~FDawnCommandContext()
{
	if (ActiveRenderPass) { wgpuRenderPassEncoderRelease(ActiveRenderPass); }
	if (CommandEncoder) { wgpuCommandEncoderRelease(CommandEncoder); }
}

void FDawnCommandContext::EnsureCommandEncoder()
{
	if (!CommandEncoder)
	{
		WGPUCommandEncoderDescriptor Desc = {};
		CommandEncoder = wgpuDeviceCreateCommandEncoder(Owner->GetDevice(), &Desc);
	}
}

// ============================================================================
// REAL: minimum draw path (set pipeline, set vertex buffer, viewport, draw)
// ============================================================================

void FDawnCommandContext::RHISetStreamSource(uint32 StreamIndex, FRHIBuffer* VertexBuffer, uint32 Offset)
{
	// Stage 1: single vertex stream (index 0).
	BoundVertexBuffer = static_cast<FDawnBuffer*>(VertexBuffer);
	BoundVertexBufferOffset = Offset;
}

void FDawnCommandContext::RHISetViewport(float MinX, float MinY, float MinZ, float MaxX, float MaxY, float MaxZ)
{
	if (ActiveRenderPass)
	{
		wgpuRenderPassEncoderSetViewport(ActiveRenderPass, MinX, MinY, MaxX - MinX, MaxY - MinY, MinZ, MaxZ);
	}
}

void FDawnCommandContext::RHISetScissorRect(bool bEnable, uint32 MinX, uint32 MinY, uint32 MaxX, uint32 MaxY)
{
	if (ActiveRenderPass)
	{
		if (bEnable)
		{
			wgpuRenderPassEncoderSetScissorRect(ActiveRenderPass, MinX, MinY, MaxX - MinX, MaxY - MinY);
		}
		else if (CurrentRTWidth > 0 && CurrentRTHeight > 0)
		{
			// Reset to the full render target -- Slate disables the scissor after
			// clipping an element; leaving a stale small scissor clips everything
			// after it to a tiny rect (the whole UI collapsed to a corner).
			wgpuRenderPassEncoderSetScissorRect(ActiveRenderPass, 0, 0, CurrentRTWidth, CurrentRTHeight);
		}
	}
}

void FDawnCommandContext::RHISetGraphicsPipelineState(FRHIGraphicsPipelineState* GraphicsState, uint32 StencilRef, bool bApplyAdditionalState)
{
	checkf(ActiveRenderPass, TEXT("DawnRHI Stage 1: RHISetGraphicsPipelineState must be called between RHIBeginRenderPass/RHIEndRenderPass"));
	FDawnGraphicsPipelineState* PSO = static_cast<FDawnGraphicsPipelineState*>(GraphicsState);
	wgpuRenderPassEncoderSetPipeline(ActiveRenderPass, PSO->Pipeline);
	CurrentPSO = PSO;
	// New shader/PSO: drop the previous draw's accumulated bind-group entries + transient UBs.
	PendingBindEntries.Reset();
	for (WGPUBuffer UB : PendingTransientUBs) { wgpuBufferRelease(UB); }
	PendingTransientUBs.Reset();
}

void FDawnCommandContext::FlushPendingBindGroups()
{
	if (!CurrentPSO || !ActiveRenderPass || CurrentPSO->BindGroupLayouts.Num() == 0) { return; }
	{
		static TSet<void*> _seenPSO; static uint32 _pn=0;
		if (!_seenPSO.Contains((void*)CurrentPSO) && _pn < 80)
		{
			_seenPSO.Add((void*)CurrentPSO); _pn++;
			FString VN, PN;
			if (CurrentPSO->VertexShader) for (const FDawnShaderBinding& B : CurrentPSO->VertexShader->Bindings) { VN += B.Name; VN += TEXT(","); }
			if (CurrentPSO->PixelShader)  for (const FDawnShaderBinding& B : CurrentPSO->PixelShader->Bindings)  { PN += B.Name; PN += TEXT(","); }
			UE_LOG(LogDawnRHI, Warning, TEXT("PSODRAW #%u pres=%d VS[%s] PS[%s]"), _pn, bCurRTPresentable?1:0, *VN, *PN);
		}
	}
	// Build the per-group reflected layout (binding + kind + name) from VS+PS.
	TMap<uint32, TArray<FDawnShaderBinding>> LayoutByGroup;
	auto AddLayout = [&](const TArray<FDawnShaderBinding>& Bs)
	{
		for (const FDawnShaderBinding& B : Bs)
		{
			TArray<FDawnShaderBinding>& L = LayoutByGroup.FindOrAdd(B.Group);
			bool bDup=false; for (const FDawnShaderBinding& X : L) { if (X.Binding==B.Binding) { bDup=true; break; } }
			if (!bDup) { L.Add(B); }
		}
	};
	if (CurrentPSO->VertexShader) { AddLayout(CurrentPSO->VertexShader->Bindings); }
	if (CurrentPSO->PixelShader)  { AddLayout(CurrentPSO->PixelShader->Bindings); }
	for (const TPair<uint32, TArray<FDawnShaderBinding>>& LG : LayoutByGroup)
	{
		const uint32 Group = LG.Key;
		if (Group >= (uint32)CurrentPSO->BindGroupLayouts.Num()) { continue; }
		const TMap<uint32, WGPUBindGroupEntry>* Pending = PendingBindEntries.Find(Group);
		TArray<WGPUBindGroupEntry> Entries;
		for (const FDawnShaderBinding& B : LG.Value)
		{
			if (Pending) { if (const WGPUBindGroupEntry* E = Pending->Find(B.Binding)) { Entries.Add(*E); continue; } }
			// Static UB (View/SlateView/etc) matched by name for still-empty uniform buffers.
			if (B.Kind == EDawnShaderBindingKind::UniformBuffer && StaticUBsByName.Num() > 0)
			{
				FRHIUniformBuffer* Found = nullptr;
				for (const TPair<FString, FRHIUniformBuffer*>& P : StaticUBsByName)
					if (!B.Name.IsEmpty() && B.Name.Equals(P.Key, ESearchCase::CaseSensitive)) { Found = P.Value; break; }
				if (Found) { FDawnUniformBuffer* DUB = static_cast<FDawnUniformBuffer*>(Found); if (DUB->Buffer) { WGPUBindGroupEntry E={}; E.binding=B.Binding; E.buffer=DUB->Buffer; E.size=DUB->GetLayout().ConstantBufferSize; Entries.Add(E); { const bool _v=B.Name.Contains(TEXT("View"))&&!B.Name.Contains(TEXT("Slate")); static uint32 _si=0; if(_v||_si++<16) UE_LOG(LogDawnRHI, Warning, TEXT("STATICINJECT bind=%u name=%s size=%u"), B.Binding, *B.Name, (uint32)E.size); } continue; } }
			}
		}
		if (Entries.Num() != LG.Value.Num())
		{
			static uint32 _bi=0;
			if (_bi++ < 600)
			{
				UE_LOG(LogDawnRHI, Warning, TEXT("BGINCOMPLETE grp=%u have=%d need=%d staticUB=%d"), Group, Entries.Num(), LG.Value.Num(), StaticUBsByName.Num());
				for (const FDawnShaderBinding& B : LG.Value)
				{
					bool bHave = (Pending && Pending->Find(B.Binding));
					UE_LOG(LogDawnRHI, Warning, TEXT("   BGImiss bind=%u kind=%d name=%s filled=%d"), B.Binding, (int)B.Kind, *B.Name, bHave?1:0);
				}
			}
			continue;
		}
		WGPUBindGroupDescriptor BgDesc = {};
		BgDesc.layout = CurrentPSO->BindGroupLayouts[Group];
		BgDesc.entryCount = Entries.Num();
		BgDesc.entries = Entries.GetData();
		WGPUBindGroup BindGroup = wgpuDeviceCreateBindGroup(Owner->GetDevice(), &BgDesc);
		if (BindGroup) { wgpuRenderPassEncoderSetBindGroup(ActiveRenderPass, Group, BindGroup, 0, nullptr); wgpuBindGroupRelease(BindGroup); }
	}
}

void FDawnCommandContext::RHIDrawPrimitive(uint32 BaseVertexIndex, uint32 NumPrimitives, uint32 NumInstances)
{
	checkf(ActiveRenderPass, TEXT("DawnRHI Stage 1: RHIDrawPrimitive requires an active render pass"));
	FlushPendingBindGroups();
	if (BoundVertexBuffer)
	{
		wgpuRenderPassEncoderSetVertexBuffer(ActiveRenderPass, 0, BoundVertexBuffer->Buffer, BoundVertexBufferOffset, WGPU_WHOLE_SIZE);
	}
	// Stage 1 only wires up triangle lists (matches FGraphicsPipelineStateInitializer::PrimitiveType == PT_TriangleList).
	const uint32 VertexCount = NumPrimitives * 3;
	wgpuRenderPassEncoderDraw(ActiveRenderPass, VertexCount, NumInstances, BaseVertexIndex, 0);
}

void FDawnCommandContext::RHIBeginRenderPass(const FRHIRenderPassInfo& InInfo, const TCHAR* InName)
{
	EnsureCommandEncoder();

	FDawnTexture* ColorTex = static_cast<FDawnTexture*>(InInfo.ColorRenderTargets[0].RenderTarget);
	if (ColorTex) { CurrentRTWidth = (uint32)ColorTex->GetDesc().Extent.X; CurrentRTHeight = (uint32)ColorTex->GetDesc().Extent.Y; }
	bCurRTPresentable = ColorTex && EnumHasAnyFlags(ColorTex->GetDesc().Flags, ETextureCreateFlags::Presentable);
	{ static uint32 _rp=0; if((_rp++%120)==0) UE_LOG(LogTemp, Warning, TEXT("RTDIAG: render target %ux%u"), CurrentRTWidth, CurrentRTHeight); }
	if (ColorTex) { const bool bPresentable = EnumHasAnyFlags(ColorTex->GetDesc().Flags, ETextureCreateFlags::Presentable); static uint32 _bt=0; static uint32 _pres=0; if (bPresentable) { if(_pres++<8) UE_LOG(LogTemp, Warning, TEXT("RPTGT-BACKBUFFER %ux%u tex=%p (pass=%u)"), CurrentRTWidth, CurrentRTHeight, (void*)ColorTex->Texture, _bt); } else if ((_bt%400)==0) { UE_LOG(LogTemp, Warning, TEXT("RPTGT-intermediate %ux%u tex=%p"), CurrentRTWidth, CurrentRTHeight, (void*)ColorTex->Texture); } _bt++; }
	checkf(ColorTex && ColorTex->View, TEXT("DawnRHI Stage 1: RHIBeginRenderPass requires ColorRenderTargets[0]"));

	WGPURenderPassColorAttachment ColorAttach = {};
	ColorAttach.view = ColorTex->RTView ? ColorTex->RTView : ColorTex->View;
	// Honour the render pass's real load action. Slate composites the UI in MANY passes
	// (first clears, the rest LOAD to preserve prior batches); the old always-Clear
	// erased every previous pass -> only the final pass survived -> black screen.
	const ERenderTargetLoadAction ColorLoadAction = GetLoadAction(InInfo.ColorRenderTargets[0].Action);
	ColorAttach.loadOp = (ColorLoadAction == ERenderTargetLoadAction::ELoad) ? WGPULoadOp_Load : WGPULoadOp_Clear;
	ColorAttach.storeOp = WGPUStoreOp_Store;
	ColorAttach.clearValue = { 0.0, 0.0, 0.0, 1.0 };
	ColorAttach.depthSlice = WGPU_DEPTH_SLICE_UNDEFINED;

	WGPURenderPassDescriptor RpDesc = {};
	RpDesc.colorAttachmentCount = 1;
	RpDesc.colorAttachments = &ColorAttach;

	WGPURenderPassDepthStencilAttachment DepthAttach = {};
	FDawnTexture* DepthTex = static_cast<FDawnTexture*>(InInfo.DepthStencilRenderTarget.DepthStencilTarget);
	if (DepthTex && DepthTex->View)
	{
		DepthAttach.view = DepthTex->RTView ? DepthTex->RTView : DepthTex->View;
		DepthAttach.depthLoadOp = WGPULoadOp_Clear;
		DepthAttach.depthStoreOp = WGPUStoreOp_Store;
		DepthAttach.depthClearValue = 1.0f;
		DepthAttach.depthReadOnly = false;
		RpDesc.depthStencilAttachment = &DepthAttach;
	}

	ActiveRenderPass = wgpuCommandEncoderBeginRenderPass(CommandEncoder, &RpDesc);
}

void FDawnCommandContext::RHIEndRenderPass()
{
	checkf(ActiveRenderPass, TEXT("DawnRHI: RHIEndRenderPass without a matching RHIBeginRenderPass"));
	wgpuRenderPassEncoderEnd(ActiveRenderPass);
	wgpuRenderPassEncoderRelease(ActiveRenderPass);
	ActiveRenderPass = nullptr;
}

void FDawnCommandContext::SubmitToQueue()
{
	if (CommandEncoder)
	{
		WGPUCommandBufferDescriptor CbDesc = {};
		WGPUCommandBuffer CmdBuf = wgpuCommandEncoderFinish(CommandEncoder, &CbDesc);
		wgpuQueueSubmit(Owner->GetQueue(), 1, &CmdBuf);
		wgpuCommandBufferRelease(CmdBuf);
		wgpuCommandEncoderRelease(CommandEncoder);
		CommandEncoder = nullptr;
	}
}

// ============================================================================
// Stub bodies (checkNoEntry) for everything a bare triangle never hits —
// compute, transitions/barriers, UAVs, breadcrumbs, indexed/indirect draws,
// depth-bounds, texture copy, legacy bound-shader-state path.
// ============================================================================

void FDawnCommandContext::RHISetComputePipelineState(FRHIComputePipelineState* ComputePipelineState)
{
	// no-op: DawnRHI runs no compute (mobile compute shaders don't cross-compile to WGSL); the pass is skipped.
}

void FDawnCommandContext::RHIDispatchComputeShader(uint32 ThreadGroupCountX, uint32 ThreadGroupCountY, uint32 ThreadGroupCountZ)
{
	// no-op: DawnRHI runs no compute; the dispatch is skipped (its output buffers keep their prior/cleared contents).
}

void FDawnCommandContext::RHIDispatchIndirectComputeShader(FRHIBuffer* ArgumentBuffer, uint32 ArgumentOffset)
{
	// no-op: DawnRHI runs no compute; indirect dispatch skipped.
}

void FDawnCommandContext::RHIBeginTransitions(TArrayView<const FRHITransition*> Transitions)
{
	// no-op (WebGPU manages barriers automatically; others are non-essential to the UI render path)
}

void FDawnCommandContext::RHIEndTransitions(TArrayView<const FRHITransition*> Transitions)
{
	// no-op (WebGPU manages barriers automatically; others are non-essential to the UI render path)
}

