			// per-draw set; better its real data than a zero dummy).
			if (PendE) { WndrLMCount(B.Name, 0); Entries.Add(*PendE); continue; }
			// UBRESTABLE fill (black-world + collapsed-bots ROOT-CAUSE fix):
			// this binding's resource lives in a bound uniform buffer's
			// RESOURCE TABLE (material albedo Material_Texture2D_0(+Sampler),
			// LightmapResourceCluster_LightMapTexture, MobileReflection-
			// Capture_Texture, GPUSkinVFBase_Common_BoneMatrices, ...). Match
			// the reflected WGSL name "<UBShaderName>_<Member>" against the
			// captured tables of this draw's pending UBs (then static UBs)
			// and bind the real resource — BEFORE falling to the black/zero
			// dummy that made the world black and the bots collapse.
			{
				WGPUBindGroupEntry E = {};
				E.binding = B.Binding;
				bool bResFilled = false;
				auto TryUBTable = [&](FRHIUniformBuffer* UBRHI) -> bool
				{
					if (!UBRHI) { return false; }
					FDawnUniformBuffer* DUB = static_cast<FDawnUniformBuffer*>(UBRHI);
					if (DUB->ShaderName.IsEmpty() || DUB->ResTable.Num() == 0) { return false; }
					if (!B.Name.StartsWith(DUB->ShaderName + TEXT("_"), ESearchCase::CaseSensitive)) { return false; }
					const FString Suffix = B.Name.Mid(DUB->ShaderName.Len() + 1);
					for (const FDawnUniformBuffer::FTableEntry& TE : DUB->ResTable)
					{
						if (!TE.Resource || !TE.WgslName.Equals(Suffix, ESearchCase::CaseSensitive)) { continue; }
						switch (B.Kind)
						{
						case EDawnShaderBindingKind::Texture:
						{
							FDawnTexture* Tex = nullptr;
							if (TE.MemberType == (uint8)UBMT_TEXTURE) { Tex = static_cast<FDawnTexture*>(DawnResolveTex((FRHITexture*)TE.Resource.GetReference())); } // wndr TEXREF-fix-1
							else if (TE.MemberType == (uint8)UBMT_SRV)
							{
								FDawnShaderResourceView* SRV = static_cast<FDawnShaderResourceView*>((FRHIShaderResourceView*)TE.Resource.GetReference());
								if (SRV->TextureView) { E.textureView = SRV->TextureView; }
							}
							if (Tex && Tex->View)
							{
								// Same dimension guard as BINDFIX: a wrong-dim view
								// fails CreateBindGroup and kills the pass.
								WGPUTextureViewDimension ActualDim = WGPUTextureViewDimension_2D;
								switch (Tex->GetDesc().Dimension)
								{
								case ETextureDimension::Texture2DArray:   ActualDim = WGPUTextureViewDimension_2DArray;   break;
								case ETextureDimension::Texture3D:        ActualDim = WGPUTextureViewDimension_3D;        break;
								case ETextureDimension::TextureCube:      ActualDim = WGPUTextureViewDimension_Cube;      break;
								case ETextureDimension::TextureCubeArray: ActualDim = WGPUTextureViewDimension_CubeArray; break;
								default: break;
								}
								if (ActualDim == B.TexViewDim) { E.textureView = Tex->View; }
							}
							break;
						}
						case EDawnShaderBindingKind::Sampler:
							if (TE.MemberType == (uint8)UBMT_SAMPLER)
							{
								FDawnSamplerState* Samp = static_cast<FDawnSamplerState*>((FRHISamplerState*)TE.Resource.GetReference());
								if (Samp && Samp->Sampler && !B.bComparisonSampler) { E.sampler = Samp->Sampler; }
							}
							break;
						case EDawnShaderBindingKind::UniformBuffer:
							// var<storage> members (bone matrices) arrive as SRVs.
							if (TE.MemberType == (uint8)UBMT_SRV)
							{
								FDawnShaderResourceView* SRV = static_cast<FDawnShaderResourceView*>((FRHIShaderResourceView*)TE.Resource.GetReference());
								if (SRV->Buffer) { E.buffer = SRV->Buffer; E.size = SRV->BufferSize ? SRV->BufferSize : WGPU_WHOLE_SIZE; }
							}
							break;
						default:
							break;
						}
						break; // name matched — use this entry's outcome either way
					}
					return (E.textureView != nullptr) || (E.sampler != nullptr) || (E.buffer != nullptr);
				};
				// OWNER pairing (exact, per-draw): the resource's OWNING uniform
				// buffer is the one bound at this group's prefix-matching UB
				// binding (e.g. "Material_Texture2D_0" -> the UB pending at the
				// binding reflected as "Material"). Resolve its FDawnUniformBuffer
				// through the WGPUBuffer registry and use ITS captured table —
				// this cannot pick another material's albedo.
				{
					extern FDawnUniformBuffer* DawnUBRegistryFind(void* WgpuBuf);
					for (const FDawnShaderBinding& UBB : LG.Value)
					{
						if (UBB.Kind != EDawnShaderBindingKind::UniformBuffer || UBB.Name.IsEmpty()) { continue; }
						if (!B.Name.StartsWith(UBB.Name + TEXT("_"), ESearchCase::CaseSensitive)) { continue; }
						const WGPUBindGroupEntry* OwnerE = Pending ? Pending->Find(UBB.Binding) : nullptr;
						if (OwnerE && OwnerE->buffer)
						{
							if (FDawnUniformBuffer* OwnerUB = DawnUBRegistryFind((void*)OwnerE->buffer))
							{
								if (TryUBTable(OwnerUB)) { bResFilled = true; }
							}
						}
						break; // only one UB name can prefix this binding
					}
				}
				// Newest first: with several materials cycling on one PSO, this
				// draw's own UBs are the most recently recorded.
				if (!bResFilled)
				for (int32 UBIdx = PendingUBRefs.Num() - 1; UBIdx >= 0; --UBIdx)
				{
					if (TryUBTable(PendingUBRefs[UBIdx].GetReference())) { bResFilled = true; break; }
				}
				// wndr LM-fix-2: LightmapResourceCluster_* via this draw's delivered PLB.
				if (!bResFilled && B.Name.StartsWith(TEXT("LightmapResourceCluster_"), ESearchCase::CaseSensitive))
				{
					for (int32 UBIdx = PendingUBRefs.Num() - 1; UBIdx >= 0 && !bResFilled; --UBIdx)
					{
						FDawnUniformBuffer* PD = static_cast<FDawnUniformBuffer*>(PendingUBRefs[UBIdx].GetReference());
						if (PD && PD->ShaderName == TEXT("PrecomputedLighting"))
						{
							if (FRHIUniformBuffer* Cl = WndrFindLMCluster(PD)) { if (TryUBTable(Cl)) { bResFilled = true; } }
						}
					}
				}
				if (!bResFilled)
				{
					for (const TPair<FString, FRHIUniformBuffer*>& P : StaticUBsByName)
					{
						if (TryUBTable(P.Value)) { bResFilled = true; break; }
					}
				}
				// MATMISS diag: a Material_* binding about to fall to the dummy —
				// print WHY (how many candidate UBs, their shader names/table sizes).
				if (!bResFilled && B.Name.StartsWith(TEXT("Material_"), ESearchCase::CaseSensitive))
				{
					static uint32 _mm2 = 0; ++_mm2;
					if (GDawnVerboseBindLog && (_mm2 <= 16 || (_mm2 % 2000) == 0))
					{
						printf("DAWNBG MATMISS bind=%u name=%s pendUBs=%d:", B.Binding, TCHAR_TO_UTF8(*B.Name), PendingUBRefs.Num());
						for (int32 Mi = FMath::Max(0, PendingUBRefs.Num() - 6); Mi < PendingUBRefs.Num(); ++Mi)
						{
							FDawnUniformBuffer* MU = static_cast<FDawnUniformBuffer*>(PendingUBRefs[Mi].GetReference());
							printf(" [%s|%d]", TCHAR_TO_UTF8(*MU->ShaderName), MU->ResTable.Num());
						}
						printf(" deliv=");
						for (const FString& D : UBDelivRing) { printf("(%s)", TCHAR_TO_UTF8(*D)); }
						printf("\n");
						fflush(stdout);
					}
				}
				if (bResFilled)
				{
					static uint32 _uf = 0; ++_uf;
					if (GDawnVerboseBindLog && (_uf <= 24 || (_uf % 5000) == 0)) { printf("DAWNBG UBRESBIND grp=%u bind=%u name=%s (n=%u)\n", Group, B.Binding, TCHAR_TO_UTF8(*B.Name), _uf); fflush(stdout); }
					WndrLMCount(B.Name, 2);
					Entries.Add(E);
					continue;
				}
			}
			// Step 3 (fallback-material visibility): neither the draw's own
			// parameters nor a static UB provided this binding — typically a
			// fallback material whose Material/Primitive UBs + textures came
			// in as null (SPNULLRES). Fill it with a shared dummy matching the
			// reflected layout entry so the group is COMPLETE and the draw
			// issues instead of being skipped. See the dummy providers above
			// FlushPendingBindGroups for the layout-matching rules.
			{
				WGPUBindGroupEntry E = {};
				E.binding = B.Binding;
				bool bFilled = false;
				switch (B.Kind)
				{
				case EDawnShaderBindingKind::UniformBuffer:
					// Also covers var<storage,...> bindings (recorded with
					// Kind==UniformBuffer + BufBindingType carrying the storage
					// distinction) — the dummy has Uniform|Storage usage.
					if (B.Name.Contains(TEXT("Precomputed")))
					{
						// WNDR task-A (2026-08-20): lightmap-less world-static draws present a
						// DUMMY (zero) PrecomputedLightingBuffer -> mobile LQ decode yields black
						// -> walls invisible. Bind an engine-default + ambient buffer instead.
						E.buffer = GetDawnAmbientLightmapBuffer(Owner->GetDevice(), Owner->GetQueue());
						E.size = 240; // sizeof(FPrecomputedLightingUniformParameters)
					}
					else
					{
						E.buffer = GetDawnDummyBuffer(Owner->GetDevice(), Owner->GetQueue());
						E.size = GDawnDummyBufferSize;
					}
					bFilled = (E.buffer != nullptr);
					// DUMMYUB printf (black-world lighting hunt): NAME every
					// uniform/storage binding that falls to the zero dummy — a
					// PrecomputedLighting/LightmapResourceCluster name here means
					// real lightmap samples get multiplied by zero scale/bias.
					{
						static uint32 _dub = 0;
						const bool bGun = B.Name.Contains(TEXT("BoneMatrices")) || B.Name.Contains(TEXT("LightMap")) || B.Name.Contains(TEXT("Lightmap")) || B.Name.Contains(TEXT("Precomputed")) || B.Name.Contains(TEXT("SkyLight")) || B.Name.Contains(TEXT("Reflection")) || B.Name.Contains(TEXT("IndirectLighting")) || B.Name.Contains(TEXT("DirectionalLight"));
						static uint32 _gunub = 0;
						if (GDawnVerboseBindLog && (bFilled && (_dub++ < 60 || (bGun && (++_gunub <= 20 || (_gunub % 500) == 0))))) { printf("DAWNBG DUMMYUB grp=%u bind=%u name=%s%s\n", Group, B.Binding, TCHAR_TO_UTF8(*B.Name), bGun ? " <-GUN" : ""); fflush(stdout); }
#if PLATFORM_WASM
						// WNDR task-A (2026-08-20): UNGATED wall-lighting forensic. If a Precomputed/SkyLight/
						// IndirectLighting/Reflection UB is DUMMY (zero), world-static (wall/BSP) draws get no
						// GI/ambient -> render at flat ambient ~ fog color -> "invisible". Bounded.
						{ static uint32 _wl = 0; if (bFilled && bGun && (B.Name.Contains(TEXT("Precomputed")) || B.Name.Contains(TEXT("SkyLight")) || B.Name.Contains(TEXT("IndirectLighting")) || B.Name.Contains(TEXT("Reflection"))) && _wl++ < 30) { printf("WNDR WALLLIGHT DUMMY-UB name=%s (world lighting UB is zero -> flat/unlit)\n", TCHAR_TO_UTF8(*B.Name)); fflush(stdout); } }
#endif
					}
					break;
				case EDawnShaderBindingKind::Texture:
#if PLATFORM_WASM
					// wndr LMMISS diag: why does a LightmapResourceCluster texture fall to dummy?
					if (B.Name.Contains(TEXT("LightmapResourceCluster")))
					{
						static uint32 _lmm = 0;
						if (_lmm++ < 12)
						{
							printf("WNDR LMMISS bind=%u name=%s wantDim=%d pendingUBs=%d:", B.Binding, TCHAR_TO_UTF8(*B.Name), (int)B.TexViewDim, PendingUBRefs.Num());
							for (const TRefCountPtr<FRHIUniformBuffer>& R : PendingUBRefs)
							{
								FDawnUniformBuffer* D = static_cast<FDawnUniformBuffer*>(R.GetReference());
								if (!D) { continue; }
								printf(" [%s sn=%s tbl=%d", TCHAR_TO_UTF8(*D->GetLayout().GetDebugName()), TCHAR_TO_UTF8(*D->ShaderName), D->ResTable.Num());
								if (D->ShaderName.Contains(TEXT("Lightmap")))
								{
									for (const FDawnUniformBuffer::FTableEntry& TE : D->ResTable)
									{
										int Dim = -1;
										if (TE.Resource && TE.MemberType == (uint8)UBMT_TEXTURE) { FRHITexture* _rt = DawnResolveTex((FRHITexture*)TE.Resource.GetReference()); Dim = _rt ? (int)_rt->GetDesc().Dimension : -2; }
										printf(" {%s t=%d res=%d dim=%d}", TCHAR_TO_UTF8(*TE.WgslName), (int)TE.MemberType, TE.Resource ? 1 : 0, Dim);
									}
								}
								printf("]");
							}
							printf("\n"); fflush(stdout);
						}
					}
#endif
					E.textureView = GetDawnDummyTextureView(Owner->GetDevice(), B.TexViewDim, B.TexSampleType, Owner->GetQueue());
					bFilled = (E.textureView != nullptr);
					// DUMMYFILL printf (lighting hunt): NAME every texture binding
					// that ends up dummy-filled — a lightmap/skylight name here is
					// the black-world smoking gun.
					{
						static uint32 _dfp = 0;
						const bool bGunT = B.Name.Contains(TEXT("LightMap")) || B.Name.Contains(TEXT("Lightmap")) || B.Name.Contains(TEXT("SkyLight")) || B.Name.Contains(TEXT("Reflection")) || B.Name.Contains(TEXT("Material_Texture"));
						static uint32 _guntx = 0;
						if (GDawnVerboseBindLog && (bFilled && (_dfp++ < 60 || (bGunT && (++_guntx <= 20 || (_guntx % 500) == 0))))) { printf("DAWNBG DUMMYTEX grp=%u bind=%u dim=%d st=%d name=%s%s\n", Group, B.Binding, (int)B.TexViewDim, (int)B.TexSampleType, TCHAR_TO_UTF8(*B.Name), bGunT ? " <-GUN" : ""); fflush(stdout); }
#if PLATFORM_WASM
						// WNDR task-A: UNGATED — a dummy LIGHTMAP/SKYLIGHT texture means world-static draws
						// sample no baked light -> flat. Bounded.
						{ static uint32 _wlt = 0; if (bFilled && (B.Name.Contains(TEXT("LightMap")) || B.Name.Contains(TEXT("Lightmap")) || B.Name.Contains(TEXT("SkyLight"))) && _wlt++ < 30) { printf("WNDR WALLLIGHT DUMMY-TEX name=%s (baked lightmap/skylight is dummy -> flat/unlit)\n", TCHAR_TO_UTF8(*B.Name)); fflush(stdout); } }
#endif
					}
					break;
				case EDawnShaderBindingKind::Sampler:
					E.sampler = GetDawnDummySampler(Owner->GetDevice(), B.bComparisonSampler);
					bFilled = (E.sampler != nullptr);
					break;
				default:
					break; // Unknown kind: leave unfilled -> safety-net skip below
				}
				if (bFilled)
				{
					static uint32 _df = 0;
					WndrLMCount(B.Name, 3);
					if (DAWNRHI_VERBOSE_DIAG && _df++ < 40) { UE_LOG(LogDawnRHI, Warning, TEXT("DUMMYFILL grp=%u bind=%u kind=%d dim=%d st=%d cmp=%d name=%s"), Group, B.Binding, (int)B.Kind, (int)B.TexViewDim, (int)B.TexSampleType, B.bComparisonSampler?1:0, *B.Name); }
					Entries.Add(E);
					continue;
				}
			}
		}
		if (Entries.Num() != LG.Value.Num())
		{
			static uint32 _bi=0;
			if (_bi++ < 600)
			{
				UE_LOG(LogDawnRHI, Warning, TEXT("BGINCOMPLETE grp=%u have=%d need=%d staticUB=%d"), Group, Entries.Num(), LG.Value.Num(), StaticUBsByName.Num());
				for (const FDawnShaderBinding& B : LG.Value)
				{
					bool bHave = (Pending && Pending->Find(B.Binding));
					UE_LOG(LogDawnRHI, Warning, TEXT("   BGImiss bind=%u kind=%d name=%s filled=%d"), B.Binding, (int)B.Kind, *B.Name, bHave?1:0);
				}
			}
			bAllGroupsComplete = false;
			continue;
		}
		// NULLHANDLE validation (the getJsObject ASSERT-abort fix): every entry
		// handle must be non-null AND currently registered live — the emdawn
		// glue hard-aborts on unregistered ids (observed with materials
		// referencing the engine-rejected FastBlueNoise texture). Bad entries
		// are re-dummied by reflected kind; if that fails the draw is skipped.
		// Never hand a null/stale handle to wgpuDeviceCreateBindGroup.
		{
			bool bEntriesOk = true;
			for (WGPUBindGroupEntry& E : Entries)
			{
				void* H = E.sampler ? (void*)E.sampler : (E.textureView ? (void*)E.textureView : (void*)E.buffer);
				if (DawnLiveHandleCheck(H)) { continue; }
				const FDawnShaderBinding* RB = nullptr;
				for (const FDawnShaderBinding& Bi : LG.Value) { if (Bi.Binding == E.binding) { RB = &Bi; break; } }
				static uint32 _nh = 0; ++_nh;
				if (GDawnVerboseBindLog && (_nh <= 16 || (_nh % 2000) == 0)) { printf("DAWNBG NULLHANDLE grp=%u bind=%u h=%p name=%s -> %s (n=%u)\n", Group, E.binding, H, RB ? TCHAR_TO_UTF8(*RB->Name) : "?", RB ? "dummy" : "skip", _nh); fflush(stdout); }
				bool bSub = false;
				if (RB)
				{
					WGPUBindGroupEntry NewE = {};
					NewE.binding = E.binding;
					switch (RB->Kind)
					{
					case EDawnShaderBindingKind::UniformBuffer:
						NewE.buffer = GetDawnDummyBuffer(Owner->GetDevice(), Owner->GetQueue());
						NewE.size = GDawnDummyBufferSize;
						bSub = (NewE.buffer != nullptr);
						break;
					case EDawnShaderBindingKind::Texture:
						NewE.textureView = GetDawnDummyTextureView(Owner->GetDevice(), RB->TexViewDim, RB->TexSampleType, Owner->GetQueue());
						bSub = (NewE.textureView != nullptr);
						break;
					case EDawnShaderBindingKind::Sampler:
						NewE.sampler = GetDawnDummySampler(Owner->GetDevice(), RB->bComparisonSampler);
						bSub = (NewE.sampler != nullptr);
						break;
					default:
						break;
					}
					if (bSub) { E = NewE; }
				}
				if (!bSub) { bEntriesOk = false; break; }
			}
			if (!bEntriesOk)
			{
				bAllGroupsComplete = false;
				continue;
			}
		}
		// BGLIMIT belt-and-braces: pre-flight the entry counts against the
		// device per-stage limits before calling CreateBindGroup — an
		// over-limit group hard-aborts inside the emdawn JS glue (the
		// 18-texture-material ~15s black-screen crash). Conservative (totals
		// vs per-stage limits): a skipped draw beats a dead game.
		{
			extern uint32 GDawnLimitMaxSamplersPerStage, GDawnLimitMaxSampledTexPerStage;
			uint32 NumSmp = 0, NumTex = 0;
			for (const WGPUBindGroupEntry& E : Entries)
			{
				if (E.sampler) { ++NumSmp; }
				else if (E.textureView) { ++NumTex; }
			}
			if (NumSmp > GDawnLimitMaxSamplersPerStage || NumTex > GDawnLimitMaxSampledTexPerStage)
			{
				static uint32 _bgo = 0; ++_bgo;
				if (_bgo <= 12 || (_bgo % 2000) == 0) { printf("DAWNBG BGLIMIT grp=%u samplers=%u tex=%u over device limits (s=%u t=%u) — draw skipped (n=%u)\n", Group, NumSmp, NumTex, GDawnLimitMaxSamplersPerStage, GDawnLimitMaxSampledTexPerStage, _bgo); fflush(stdout); }
				bAllGroupsComplete = false;
				continue;
			}
		}
		WGPUBindGroupDescriptor BgDesc = {};
		BgDesc.layout = CurrentPSO->BindGroupLayouts[Group];
		BgDesc.entryCount = Entries.Num();
		BgDesc.entries = Entries.GetData();
#if PLATFORM_WASM
		const double _wndrC0 = emscripten_get_now();
#endif
		WGPUBindGroup BindGroup = wgpuDeviceCreateBindGroup(Owner->GetDevice(), &BgDesc);
#if PLATFORM_WASM
		GWndrCreateBGMs += emscripten_get_now() - _wndrC0; ++GWndrCreateCalls;
#endif
		if (BindGroup) { wgpuRenderPassEncoderSetBindGroup(ActiveRenderPass, Group, BindGroup, 0, nullptr); wgpuBindGroupRelease(BindGroup); }
	}
	return bAllGroupsComplete;
}

void FDawnCommandContext::RHIDrawPrimitive(uint32 BaseVertexIndex, uint32 NumPrimitives, uint32 NumInstances)
{
	checkf(ActiveRenderPass, TEXT("DawnRHI Stage 1: RHIDrawPrimitive requires an active render pass"));
	// Inert PSO (null Pipeline): no pipeline is set on the encoder — issuing a
	// draw would be a Dawn validation error. Skip the draw entirely.
	if (!CurrentPSO || !CurrentPSO->Pipeline) { static uint32 _sk=0; if(_sk++<8) UE_LOG(LogDawnRHI, Warning, TEXT("DawnRHI: skipping RHIDrawPrimitive on inert PSO")); return; }
	// Incomplete bind group (fallback material passing null Material/Primitive
	// UBs / textures — see SPNULLRES): issuing the draw anyway is a Dawn
	// validation error ("No bind group set at group index 0") that INVALIDATES
	// THE WHOLE COMMAND BUFFER — every good draw in it is discarded (black
	// screen). Skip the draw; the encoder/pass state is untouched at this
	// point (vertex buffer is only set after the flush), and the pending
	// bind-entry accumulation is left exactly as a real draw would leave it
	// (it persists across draws of the same PSO and is reset on PSO change).
#if PLATFORM_WASM
	// WNDR perf (2026-08-20): PendingUBRefs is reset only on PSO change, but a same-PSO batch
	// (e.g. every fallback-material primitive during texture streaming) accumulates one UB per
	// draw, and every unresolved (dummy) binding then rescans the WHOLE list -> O(N^2), the 30-75s
	// frame spikes. Each SubmitDraw re-delivers its own UBs, so drop them after this draw builds
	// its bind group: the next draw resupplies what it needs and the walk stays O(1) in batch size.
	const bool _wndrFlushOk = FlushPendingBindGroups();
	WndrFrameHeldUBs.Append(PendingUBRefs); PendingUBRefs.Reset(); // hold refs alive to frame end; empty the walk list
	if (!_wndrFlushOk)
#else
	if (!FlushPendingBindGroups())
#endif
	{
		static uint32 _bgs=0; ++_bgs;
		if (_bgs<=8 || (_bgs%500)==0) { UE_LOG(LogDawnRHI, Warning, TEXT("BGSKIPDRAW: RHIDrawPrimitive skipped on incomplete bind group (n=%u) — command buffer stays valid"), _bgs); }
		return;
	}
	// PRIMTYPE fix: derive the vertex count from the PSO's primitive type (the
	// old NumPrimitives*3 over-asked line-list draws — see the helper above).
	// FRAGLESS guard: a fragment-less (depth-only) pipeline in a pass WITH a
	// color attachment is a Dawn attachment-compat error -> skip this draw.
	if (CurrentPSO->bFragmentless && bCurPassHasColor) { ++GDawnFrameSkips; static uint32 _fs=0; ++_fs; if (_fs<=8||(_fs%2000)==0){ UE_LOG(LogDawnRHI, Warning, TEXT("FRAGSKIP: depth-only PSO drawn in a color pass — draw skipped (n=%u)"), _fs); } return; }
	const uint32 VertexCount = DawnVertexCountForPrimitives(CurrentPSO->PrimitiveType, NumPrimitives);
	if (!BindVertexStreams(BaseVertexIndex, VertexCount, 0, FMath::Max<uint32>(NumInstances, 1))) { ++GDawnFrameSkips; return; }
	wgpuRenderPassEncoderDraw(ActiveRenderPass, VertexCount, NumInstances, BaseVertexIndex, 0);
	if (bCurRTPresentable && bCurPassHasColor) { ++GDawnFrameDrawsBB; } else { ++GDawnFrameDrawsInt; }
}

void FDawnCommandContext::RHIBeginRenderPass(const FRHIRenderPassInfo& InInfo, const TCHAR* InName)
{
	EnsureCommandEncoder();
#if PLATFORM_WASM
	// WNDR frame-wide resource-delete fence (2026-08-20): defer ALL deferred-delete flushes for the
	// duration of the frame render, so NO resource (from any release path) is torn down while draws
	// reference it (RHIResources.h:189 abort). Cleared at RHIEndFrame after submit; deletions run then.
	{ extern RHI_API bool GWndrSuppressDeleteFlush; GWndrSuppressDeleteFlush = true; }
#endif

	FDawnTexture* ColorTex = static_cast<FDawnTexture*>(InInfo.ColorRenderTargets[0].RenderTarget);
	if (ColorTex) { CurrentRTWidth = (uint32)ColorTex->GetDesc().Extent.X; CurrentRTHeight = (uint32)ColorTex->GetDesc().Extent.Y; }
	bCurRTPresentable = ColorTex && EnumHasAnyFlags(ColorTex->GetDesc().Flags, ETextureCreateFlags::Presentable);
	if (DAWNRHI_VERBOSE_DIAG) { static uint32 _rp=0; if((_rp++%120)==0) UE_LOG(LogTemp, Warning, TEXT("RTDIAG: render target %ux%u"), CurrentRTWidth, CurrentRTHeight); }
	if (DAWNRHI_VERBOSE_DIAG) if (ColorTex) { const bool bPresentable = EnumHasAnyFlags(ColorTex->GetDesc().Flags, ETextureCreateFlags::Presentable); static uint32 _bt=0; static uint32 _pres=0; if (bPresentable) { if(_pres++<8) UE_LOG(LogTemp, Warning, TEXT("RPTGT-BACKBUFFER %ux%u tex=%p (pass=%u)"), CurrentRTWidth, CurrentRTHeight, (void*)ColorTex->Texture, _bt); } else if ((_bt%400)==0) { UE_LOG(LogTemp, Warning, TEXT("RPTGT-intermediate %ux%u tex=%p"), CurrentRTWidth, CurrentRTHeight, (void*)ColorTex->Texture); } _bt++; }
	// wndr: allow DEPTH-ONLY render passes (custom-depth / depth pre-pass have NO color target,
	// only depth). The old checkf(ColorTex) aborted the game ("RHIBeginRenderPass requires
	// ColorRenderTargets[0]") once weapon/effect custom-depth passes started running -> ~frame-605
	// mid-match crash. A WebGPU render pass is valid with 0 color attachments as long as it has depth.
	FDawnTexture* WndrDepthProbe = static_cast<FDawnTexture*>(InInfo.DepthStencilRenderTarget.DepthStencilTarget);
	const bool bWndrHasColor = (ColorTex != nullptr && ColorTex->View != nullptr);
	checkf(bWndrHasColor || (WndrDepthProbe && WndrDepthProbe->View), TEXT("DawnRHI: RHIBeginRenderPass needs at least a color or depth target"));

	WGPURenderPassColorAttachment ColorAttach = {};
	if (bWndrHasColor)
	{
	ColorAttach.view = ColorTex->RTView ? ColorTex->RTView : ColorTex->View;
	// Honour the render pass's real load action. Slate composites the UI in MANY passes
	// (first clears, the rest LOAD to preserve prior batches); the old always-Clear
	// erased every previous pass -> only the final pass survived -> black screen.
	const ERenderTargetLoadAction ColorLoadAction = GetLoadAction(InInfo.ColorRenderTargets[0].Action);
	ColorAttach.loadOp = (ColorLoadAction == ERenderTargetLoadAction::ELoad) ? WGPULoadOp_Load : WGPULoadOp_Clear;
	ColorAttach.storeOp = WGPUStoreOp_Store;
#if PLATFORM_WASM
	{ static uint32 _lo=0; if(bCurRTPresentable) { ++_lo; if (_lo<=80 || (_lo%997)==0) UE_LOG(LogDawnRHI, Warning, TEXT("RPLOADOP bb loadOp=%s tex=%p n=%u"), ColorAttach.loadOp==WGPULoadOp_Clear?TEXT("CLEAR"):TEXT("LOAD"), (void*)ColorTex->Texture, _lo); } }
#endif
	ColorAttach.clearValue = { 0.0, 0.0, 0.0, 1.0 };
	ColorAttach.depthSlice = WGPU_DEPTH_SLICE_UNDEFINED;
	}

	WGPURenderPassDescriptor RpDesc = {};
	RpDesc.colorAttachmentCount = bWndrHasColor ? 1 : 0;
	RpDesc.colorAttachments = bWndrHasColor ? &ColorAttach : nullptr;

	WGPURenderPassDepthStencilAttachment DepthAttach = {};
	FDawnTexture* DepthTex = static_cast<FDawnTexture*>(InInfo.DepthStencilRenderTarget.DepthStencilTarget);
	if (DepthTex && DepthTex->View)
	{
		DepthAttach.view = DepthTex->RTView ? DepthTex->RTView : DepthTex->View;
		DepthAttach.depthLoadOp = WGPULoadOp_Clear;
		DepthAttach.depthStoreOp = WGPUStoreOp_Store;
		// Reversed-Z (UE default): the depth buffer must clear to the UE-requested value
		// (0.0 = far for reversed-Z), NOT a hardcoded 1.0. With 1.0 + the GreaterEqual test,
		// every scene fragment fails depth -> nothing rasterizes -> black world behind the UI.
		DepthAttach.depthClearValue = 0.0f; // reversed-Z far plane (UE default); was 1.0 -> depth-rejected all scene geometry -> black
		DepthAttach.depthReadOnly = false;
		RpDesc.depthStencilAttachment = &DepthAttach;
	}

	// FRAGLESS + FRAMESUM: remember whether this pass has a color attachment
	// and count the pass by kind.
	bCurPassHasColor = bWndrHasColor;
	if (!bWndrHasColor) { ++GDawnFramePassesDepthOnly; }
	else if (bCurRTPresentable)
	{
		++GDawnFramePassesBB;
		if (ColorAttach.loadOp == WGPULoadOp_Clear)
		{
			++GDawnFrameBBClears;
			if (GDawnFrameDrawsBB > 0) { ++GDawnFrameBBClearAfterDraw; } // something wipes an already-drawn backbuffer
		}
	}
	else { ++GDawnFramePassesInt; }

	ActiveRenderPass = wgpuCommandEncoderBeginRenderPass(CommandEncoder, &RpDesc);
}

void FDawnCommandContext::RHIEndRenderPass()
{
	checkf(ActiveRenderPass, TEXT("DawnRHI: RHIEndRenderPass without a matching RHIBeginRenderPass"));
	wgpuRenderPassEncoderEnd(ActiveRenderPass);
	wgpuRenderPassEncoderRelease(ActiveRenderPass);
	ActiveRenderPass = nullptr;
}

void FDawnCommandContext::SubmitToQueue()
{
	{ static uint32 _sq=0, _sn=0; if (CommandEncoder) { if(++_sq<=16||(_sq%300)==0){ printf("WNDR SUBMITQ n=%u ENCODER-VALID\n", _sq); fflush(stdout);} } else { if(++_sn<=16){ printf("WNDR SUBMITQ NULL-ENCODER n=%u\n", _sn); fflush(stdout);} } }
	if (CommandEncoder)
	{
		// Issue-2 visibility: prove in the console whether frame submits happen
		// at all before/around the blockSite=6 game-thread park.
		if (DAWNRHI_VERBOSE_DIAG) { static uint32 _sub=0; ++_sub; if (_sub<=8 || (_sub%300)==0) { UE_LOG(LogDawnRHI, Warning, TEXT("DAWNSUBMIT n=%u"), _sub); } }
		WGPUCommandBufferDescriptor CbDesc = {};
		WGPUCommandBuffer CmdBuf = wgpuCommandEncoderFinish(CommandEncoder, &CbDesc);
		wgpuQueueSubmit(Owner->GetQueue(), 1, &CmdBuf);
		wgpuCommandBufferRelease(CmdBuf);
		wgpuCommandEncoderRelease(CommandEncoder);
		CommandEncoder = nullptr;
	}
}

