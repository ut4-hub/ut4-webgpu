void FDawnCommandContext::RHICopyToStagingBuffer(FRHIBuffer* /*SourceBufferRHI*/, FRHIStagingBuffer* DestinationStagingBufferRHI, uint32 /*InOffset*/, uint32 InNumBytes)
{
	// No GPU->CPU readback in DawnRHI: hand back a zero-filled buffer of the
	// requested size so GPUMessage-style readbacks report empty (correct: no
	// GPU compute ran to write anything). Prevents the readback-poll hang.
	void* Ptr = DestinationStagingBufferRHI->Lock(0, InNumBytes);
	if (Ptr && InNumBytes)
	{
		FMemory::Memzero(Ptr, InNumBytes);
	}
	DestinationStagingBufferRHI->Unlock();
}

