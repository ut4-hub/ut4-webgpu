FDawnCommandContext::~FDawnCommandContext()
{
	if (ActiveRenderPass) { wgpuRenderPassEncoderRelease(ActiveRenderPass); }
	if (CommandEncoder) { wgpuCommandEncoderRelease(CommandEncoder); }
}

void FDawnCommandContext::EnsureCommandEncoder()
{
	if (!CommandEncoder)
	{
		WGPUCommandEncoderDescriptor Desc = {};
		CommandEncoder = wgpuDeviceCreateCommandEncoder(Owner->GetDevice(), &Desc);
	}
}

// ============================================================================
// REAL: minimum draw path (set pipeline, set vertex buffer, viewport, draw)
// ============================================================================

// PRIMTYPE fix: vertices (== indices) consumed by NumPrimitives of the PSO's
// primitive type. The old hardcoded NumPrimitives*3 broke every non-triangle-
// list draw: a 4-line PT_LineList batched-elements draw (8 verts, exactly-
// sized 512-byte buffer) asked Dawn for 12 vertices -> validation error ->
// the WHOLE frame's command buffer invalid -> presentedFrame=-1 freeze.
// Mirrors RHIUtilities.h GetVertexCountForPrimitiveCount for the types this
// RHI's pipelines can express.
static uint32 DawnVertexCountForPrimitives(uint32 PrimitiveType, uint32 NumPrimitives)
{
	switch (PrimitiveType)
	{
	case PT_TriangleStrip: return NumPrimitives ? NumPrimitives + 2 : 0;
	case PT_LineList:      return NumPrimitives * 2;
	case PT_PointList:     return NumPrimitives;
	case PT_TriangleList:
	default:               return NumPrimitives * 3;
	}
}

void FDawnCommandContext::RHISetStreamSource(uint32 StreamIndex, FRHIBuffer* VertexBuffer, uint32 Offset)
{
	// Multi-stream vertex input (black-world fix): store each stream's buffer
	// in its own slot; the draw path binds every slot the current PSO's
	// vertex-buffer layouts declare (slot index == StreamIndex). See
	// RHICreateGraphicsPipelineState's per-stream WGPUVertexBufferLayout
	// build — the old single "last set wins as slot 0" member made mesh
	// positions read from the tangent/UV stream -> off-screen geometry.
	if (DAWNRHI_VERBOSE_DIAG)
	{
		static uint32 _tot=0, _nz=0; ++_tot; if (StreamIndex != 0 && VertexBuffer) { ++_nz; }
		if (_nz && (_nz<=12 || (_nz%2000)==0)) { UE_LOG(LogDawnRHI, Warning, TEXT("VTXSTREAM nonzero-stream set: idx=%u buf=%p off=%u (nonzero=%u of %u total)"), StreamIndex, (void*)VertexBuffer, Offset, _nz, _tot); }
	}
	if (StreamIndex < MaxVertexStreams)
	{
		BoundVertexBuffers[StreamIndex] = static_cast<FDawnBuffer*>(VertexBuffer);
		BoundVertexBufferOffsets[StreamIndex] = Offset;
	}
}

// VTXPADFIX: shared zero-filled VERTEX buffer backing the pipeline's stride-0
// dummy attribute stream (FDawnGraphicsPipelineState::DummyVertexStreamSlot).
// With arrayStride 0 Dawn only requires offset + formatSize (<= 16 bytes for
// float32x4) to fit inside the bound buffer, so 64 bytes covers every padded
// attribute; every vertex reads zeros.
static WGPUBuffer GetDawnDummyVertexBuffer(WGPUDevice Device, WGPUQueue Queue)
{
	static WGPUBuffer Buffer = nullptr;
	if (!Buffer)
	{
		WGPUBufferDescriptor BD = {};
		BD.usage = WGPUBufferUsage_Vertex | WGPUBufferUsage_CopyDst;
		BD.size = 64;
		Buffer = wgpuDeviceCreateBuffer(Device, &BD);
		if (Buffer)
		{
			uint8 Zeros[64] = {};
			wgpuQueueWriteBuffer(Queue, Buffer, 0, Zeros, sizeof(Zeros));
		}
	}
	return Buffer;
}

// Bind every vertex-buffer slot the current PSO's layouts declare. Returns
// false (draw must be skipped) when a declared slot has no bound buffer —
// issuing the draw anyway would be a Dawn "vertex buffer not set" validation
// error that invalidates the WHOLE command buffer (see the BGSKIPDRAW
// rationale in RHIDrawPrimitive).
bool FDawnCommandContext::BindVertexStreams(uint32 FirstVertex, uint32 NumVertices, uint32 FirstInstance, uint32 NumInstances)
{
	if (!CurrentPSO) { return true; }
	const uint32 Mask = CurrentPSO->VertexStreamMask;
	for (uint32 Slot = 0; Slot < MaxVertexStreams && (Mask >> Slot) != 0; ++Slot)
	{
		if (!(Mask & (1u << Slot))) { continue; }
		// VTXPADFIX: the pipeline's stride-0 dummy attribute stream (padding
		// for shader-consumed locations the vertex declaration omitted) is
		// never fed by RHISetStreamSource — bind the shared zero buffer.
		if (CurrentPSO->DummyVertexStreamSlot == (int32)Slot)
		{
			WGPUBuffer DummyVB = GetDawnDummyVertexBuffer(Owner->GetDevice(), Owner->GetQueue());
			if (DummyVB)
			{
				wgpuRenderPassEncoderSetVertexBuffer(ActiveRenderPass, Slot, DummyVB, 0, WGPU_WHOLE_SIZE);
				continue;
			}
		}
		FDawnBuffer* Buf = BoundVertexBuffers[Slot];
		if (Buf && Buf->Buffer)
		{
			// VTXRANGE guard (defensive net under the PRIMTYPE/INSTSTEP fixes):
			// a draw whose vertex/instance range exceeds the bound buffer is a
			// Dawn validation error that invalidates the WHOLE command buffer
			// — every draw that frame discarded, presentedFrame=-1 freeze.
			// Skip just this draw instead. Lower-bounds Dawn's exact check
			// ((first+count-1)*stride + last-attribute-end) with +1 so a
			// legitimately tail-truncated buffer is never falsely skipped.
			const uint32 Stride = CurrentPSO->StreamStrides[Slot];
			const bool bInstanceStep = (CurrentPSO->InstanceStreamMask >> Slot) & 1u;
			const uint32 First = bInstanceStep ? FirstInstance : FirstVertex;
			const uint32 Count = bInstanceStep ? NumInstances : NumVertices;
			const uint32 Offset = BoundVertexBufferOffsets[Slot];
			if (Stride > 0 && Count > 0)
			{
				const uint64 Avail = (Buf->WgpuSize > Offset) ? (uint64)(Buf->WgpuSize - Offset) : 0;
				const uint64 Required = (uint64)(First + Count - 1) * Stride + 1;
				if (Required > Avail)
				{
					static uint32 _vr=0; ++_vr;
					if (_vr<=12 || (_vr%2000)==0) { UE_LOG(LogDawnRHI, Warning, TEXT("VTXRANGE: draw needs >%llu bytes at slot %u (%s stride=%u first=%u count=%u) but bound range is %llu (bufSize=%u off=%u) — draw skipped, command buffer stays valid (n=%u)"), (unsigned long long)Required, Slot, bInstanceStep ? TEXT("instance") : TEXT("vertex"), Stride, First, Count, (unsigned long long)Avail, Buf->WgpuSize, Offset, _vr); }
					return false;
				}
			}
			wgpuRenderPassEncoderSetVertexBuffer(ActiveRenderPass, Slot, Buf->Buffer, BoundVertexBufferOffsets[Slot], WGPU_WHOLE_SIZE);
		}
		else
		{
			static uint32 _vm=0; ++_vm;
			if (_vm<=12 || (_vm%2000)==0) { UE_LOG(LogDawnRHI, Warning, TEXT("VTXMISS: PSO wants vertex stream slot %u but none is bound (n=%u) — draw skipped"), Slot, _vm); }
			return false;
		}
	}
	return true;
}

void FDawnCommandContext::RHISetViewport(float MinX, float MinY, float MinZ, float MaxX, float MaxY, float MaxZ)
{
	if (ActiveRenderPass)
	{
		wgpuRenderPassEncoderSetViewport(ActiveRenderPass, MinX, MinY, MaxX - MinX, MaxY - MinY, MinZ, MaxZ);
	}
}

void FDawnCommandContext::RHISetScissorRect(bool bEnable, uint32 MinX, uint32 MinY, uint32 MaxX, uint32 MaxY)
{
	if (ActiveRenderPass)
	{
		if (bEnable)
		{
			wgpuRenderPassEncoderSetScissorRect(ActiveRenderPass, MinX, MinY, MaxX - MinX, MaxY - MinY);
		}
		else if (CurrentRTWidth > 0 && CurrentRTHeight > 0)
		{
			// Reset to the full render target -- Slate disables the scissor after
			// clipping an element; leaving a stale small scissor clips everything
			// after it to a tiny rect (the whole UI collapsed to a corner).
			wgpuRenderPassEncoderSetScissorRect(ActiveRenderPass, 0, 0, CurrentRTWidth, CurrentRTHeight);
		}
	}
}

void FDawnCommandContext::RHISetGraphicsPipelineState(FRHIGraphicsPipelineState* GraphicsState, uint32 StencilRef, bool bApplyAdditionalState)
{
	checkf(ActiveRenderPass, TEXT("DawnRHI Stage 1: RHISetGraphicsPipelineState must be called between RHIBeginRenderPass/RHIEndRenderPass"));
	FDawnGraphicsPipelineState* PSO = static_cast<FDawnGraphicsPipelineState*>(GraphicsState);
	// INERT PSO (Pipeline == nullptr: fallback material whose VS/PS never
	// cooked, or pipeline creation failed — see RHICreateGraphicsPipelineState).
	// Never hand Dawn a null pipeline handle; record the PSO as current so the
	// draw path sees the null Pipeline and skips those draws.
	if (PSO && PSO->Pipeline)
	{
		wgpuRenderPassEncoderSetPipeline(ActiveRenderPass, PSO->Pipeline);
		bStripAltPipelineBound = false; // STRIPIDX: primary (Uint16-strip) variant bound
	}
	else
	{
		static uint32 _inertSetLogs = 0;
		if (_inertSetLogs++ < 8) { UE_LOG(LogDawnRHI, Warning, TEXT("DawnRHI: inert PSO set (null Pipeline) — draws until the next real PSO are skipped")); }
	}
	CurrentPSO = PSO;
	// New shader/PSO: drop the previous draw's accumulated bind-group entries + transient UBs.
	PendingBindEntries.Reset();
	PendingUBRefs.Reset(); // UBRESTABLE
	UBDelivRing.Reset();   // UBDELIV ring (delivery hunt)
	for (WGPUBuffer UB : PendingTransientUBs) { wgpuBufferRelease(UB); }
	PendingTransientUBs.Reset();
}

// ============================================================================
// Dummy fallback resources (fallback-material visibility).
//
// ~97% of DM-Chill's base-pass materials are "fallback" materials whose
// mobile-forward HLSL translation failed -> null shader maps -> the mesh draw
// passes NULL Material/Primitive uniform buffers and material textures into
// RHISetShaderParameters (SPNULLRES skips them). Those bindings then stay
// unfilled, the @group's bind group is incomplete, FlushPendingBindGroups
// returns false, and the draw is skipped.
//
// These lazily-created, cached, SHARED dummies fill any binding neither the
// draw (PendingBindEntries) nor the static-UB name match provided, keyed off
// the SAME reflected fields (Kind/TexViewDim/TexSampleType/bComparisonSampler/
// BufBindingType) the bind-group LAYOUT entry was built from at PSO-create
// time (AppendShaderBindings in DawnDynamicRHI.cpp), so each dummy matches its
// layout entry exactly and passes WebGPU validation. The geometry then issues
// with zeroed params instead of not at all.
// Never freed: one buffer + a handful of 1x1 textures + 2 samplers for the
// process lifetime, shared by every draw that needs them.
// ============================================================================

// 65536 covers any UE uniform buffer's minBindingSize and equals the default
// maxUniformBufferBindingSize limit (binding size == limit is valid).
static const uint64 GDawnDummyBufferSize = 65536;

// One zero-filled buffer serves every missing buffer binding: it carries BOTH
// Uniform and Storage usage, so it validates against layout entries of type
// Uniform, ReadOnlyStorage and Storage alike (BufBindingType is baked into the
// LAYOUT; the bind-group entry just needs a buffer with a compatible usage).
static WGPUBuffer GetDawnDummyBuffer(WGPUDevice Device, WGPUQueue Queue)
{
	static WGPUBuffer Buffer = nullptr;
	static bool bTried = false;
	if (!bTried)
	{
		bTried = true;
		WGPUBufferDescriptor BD = {};
		BD.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_Storage | WGPUBufferUsage_CopyDst;
		BD.size = GDawnDummyBufferSize;
		Buffer = wgpuDeviceCreateBuffer(Device, &BD);
		DawnLiveHandleAdd((void*)Buffer); // LIVEHANDLE
		if (Buffer)
		{
			// WebGPU zero-initializes anyway; write zeros explicitly so the
			// contents are guaranteed regardless of implementation.
			TArray<uint8> Zeros;
			Zeros.SetNumZeroed((int32)GDawnDummyBufferSize);
			wgpuQueueWriteBuffer(Queue, Buffer, 0, Zeros.GetData(), GDawnDummyBufferSize);
		}
	}
	return Buffer;
}

// WNDR task-A (walls fix 2026-08-20): ambient PrecomputedLightingBuffer.
// Lightmap-less / uncooked-GI maps (Chill etc.) present world-static (wall/BSP)
// draws with a DUMMY (zero) PrecomputedLightingBuffer. The mobile LQ lightmap
// decode is LogRGB = tex*LightMapScale + LightMapAdd (log space); with a zero UB
// that is all-zero -> Color=0 -> walls render black -> invisible in fog. Bind
// engine-default scale/bias PLUS a non-zero LightMapAdd[0] so even a zero lightmap
// texture decodes to a flat ambient (~0.42). Layout must match
// FPrecomputedLightingUniformParameters (15 * float4 = 240 bytes).
static WGPUBuffer GetDawnAmbientLightmapBuffer(WGPUDevice Device, WGPUQueue Queue)
{
	static WGPUBuffer Buffer = nullptr;
	static bool bTried = false;
	if (!bTried)
	{
		bTried = true;
		const float A = 0.59f; // WNDR brighten3 2026-08-20: exp2(16A-8)*0.6 ~= 1.63 ambient; paired w/ PreExposure=1.0 (no 0.18 crush)
		const float Data[15 * 4] = {
			1,1,1,1,       // StaticShadowMapMasks
			0,0,0,0,       // InvUniformPenumbraSizes
			1,1,0,0,       // LightMapCoordinateScaleBias
			1,1,0,0,       // ShadowMapCoordinateScaleBias
			1,1,1,1,       // LightMapScale[0]
			1,1,1,1,       // LightMapScale[1]
			A,A,A,0,       // LightMapAdd[0]  -> flat ambient w/ zero lightmap tex
			0,0,0,0.6f,    // LightMapAdd[1]  -> constant directionality 0.6
			0,0,0,0,       // LightmapVTPackedPageTableUniform[0]
			0,0,0,0,       // LightmapVTPackedPageTableUniform[1]
			0,0,0,0,       // LightmapVTPackedUniform[0]
			0,0,0,0,       // LightmapVTPackedUniform[1]
			0,0,0,0,       // LightmapVTPackedUniform[2]
			0,0,0,0,       // LightmapVTPackedUniform[3]
			0,0,0,0,       // LightmapVTPackedUniform[4]
		};
		WGPUBufferDescriptor BD = {};
		BD.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_Storage | WGPUBufferUsage_CopyDst;
		BD.size = sizeof(Data);
		Buffer = wgpuDeviceCreateBuffer(Device, &BD);
		DawnLiveHandleAdd((void*)Buffer); // LIVEHANDLE
		if (Buffer)
		{
			wgpuQueueWriteBuffer(Queue, Buffer, 0, Data, sizeof(Data));
		}
	}
	return Buffer;
}

// Filtering (linear) sampler for plain `sampler` bindings; comparison
// (compare=Less) sampler for `sampler_comparison` (shadow PCF) bindings — a
// filtering sampler in a Comparison layout slot is rejected, and vice versa.
static WGPUSampler GetDawnDummySampler(WGPUDevice Device, bool bComparison)
{
	static WGPUSampler Samplers[2] = { nullptr, nullptr };
	static bool bTried[2] = { false, false };
	const int32 Idx = bComparison ? 1 : 0;
	if (!bTried[Idx])
	{
		bTried[Idx] = true;
		WGPUSamplerDescriptor SD = {};
		SD.addressModeU = WGPUAddressMode_ClampToEdge;
		SD.addressModeV = WGPUAddressMode_ClampToEdge;
		SD.addressModeW = WGPUAddressMode_ClampToEdge;
		SD.magFilter = WGPUFilterMode_Linear;
		SD.minFilter = WGPUFilterMode_Linear;
		SD.mipmapFilter = WGPUMipmapFilterMode_Linear;
		SD.lodMinClamp = 0.0f;
		SD.lodMaxClamp = 32.0f;
		SD.maxAnisotropy = 1;
		if (bComparison) { SD.compare = WGPUCompareFunction_Less; }
		Samplers[Idx] = wgpuDeviceCreateSampler(Device, &SD);
		DawnLiveHandleAdd((void*)Samplers[Idx]); // LIVEHANDLE
	}
	return Samplers[Idx];
}

// 1x1 dummy texture VIEW matching the reflected view dimension + sample type
// (both must match the layout entry exactly or bind-group creation fails with
// the "binding dimension"/"sample type" validation errors). Format by sample
// type: Float/UnfilterableFloat -> RGBA8Unorm (float-filterable),
// Depth -> Depth32Float, Uint -> RGBA8Uint, Sint -> RGBA8Sint.
// Dimension: 2D/2DArray -> 1-layer 2D texture; Cube/CubeArray -> 6-layer 2D
// texture with a cube(-array) view; 3D -> 1x1x1 3D; 1D -> 1x1 1D.
// Contents are zero (WebGPU zero-init) — sampling returns 0.
static WGPUTextureView GetDawnDummyTextureView(WGPUDevice Device, WGPUTextureViewDimension Dim, WGPUTextureSampleType SampleType, WGPUQueue Queue = nullptr)
{
	static TMap<uint64, WGPUTextureView> Cache; // nullptr cached too (negative result)
	const uint64 Key = ((uint64)Dim << 32) | (uint64)SampleType;
	if (WGPUTextureView* Found = Cache.Find(Key)) { return *Found; }

	WGPUTextureFormat Format;
	switch (SampleType)
	{
	case WGPUTextureSampleType_Depth: Format = WGPUTextureFormat_Depth32Float; break;
	case WGPUTextureSampleType_Uint:  Format = WGPUTextureFormat_RGBA8Uint;    break;
	case WGPUTextureSampleType_Sint:  Format = WGPUTextureFormat_RGBA8Sint;    break;
	default:                          Format = WGPUTextureFormat_RGBA8Unorm;   break; // Float / UnfilterableFloat
	}

	uint32 Layers = 1;
	WGPUTextureDimension TexDim = WGPUTextureDimension_2D;
	switch (Dim)
	{
	case WGPUTextureViewDimension_1D:        TexDim = WGPUTextureDimension_1D; break;
	case WGPUTextureViewDimension_3D:        TexDim = WGPUTextureDimension_3D; break;
	case WGPUTextureViewDimension_Cube:
	case WGPUTextureViewDimension_CubeArray: Layers = 6; break;
	default: break; // 2D / 2DArray: single layer
	}
	// Depth formats only exist as 2D textures — a depth 1D/3D binding has no
	// valid dummy; return null so the caller's skip-on-incomplete safety net
	// skips that one draw instead of tripping validation.
	if (Format == WGPUTextureFormat_Depth32Float && TexDim != WGPUTextureDimension_2D)
	{
		Cache.Add(Key, nullptr);
		return nullptr;
	}

	WGPUTextureDescriptor TD = {};
	TD.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
	TD.dimension = TexDim;
	TD.size = { 1, 1, (TexDim == WGPUTextureDimension_2D) ? Layers : 1 };
	TD.format = Format;
	TD.mipLevelCount = 1;
	TD.sampleCount = 1;
	WGPUTexture Tex = wgpuDeviceCreateTexture(Device, &TD);
	WGPUTextureView View = nullptr;
	// FULLBRIGHT dummies (world-lighting experiment 2026-08-18): fill
	// float-class dummy textures with WHITE instead of leaving WebGPU's
	// zero-init. A dummy-filled LIGHTMAP then contributes ~fullbright instead
	// of multiplying the world to black (zero GI = the black world revealed
	// when FOGZERO removed the haze). Uint/Sint/Depth dummies stay zero.
	// (Cleanup 2026-08-18: white fill reverted to spec zero-init — it was a
	// lighting diagnostic; real materials/lightmaps now bind and upload.)
	if (false && Tex && Queue && Format == WGPUTextureFormat_RGBA8Unorm)
	{
		const uint32 WriteLayers = (TexDim == WGPUTextureDimension_2D) ? Layers : 1u;
		const uint8 White[4] = { 128, 128, 128, 255 };
		for (uint32 L = 0; L < WriteLayers; ++L)
		{
			WGPUTexelCopyTextureInfo DstInfo = {};
			DstInfo.texture = Tex;
			DstInfo.mipLevel = 0;
			DstInfo.origin = { 0, 0, L };
			DstInfo.aspect = WGPUTextureAspect_All;
			WGPUTexelCopyBufferLayout SrcLayout = {};
			SrcLayout.offset = 0;
			SrcLayout.bytesPerRow = 256; // min alignment; single texel row
			SrcLayout.rowsPerImage = 1;
			WGPUExtent3D WriteSize = { 1, 1, 1 };
			wgpuQueueWriteTexture(Queue, &DstInfo, White, sizeof(White), &SrcLayout, &WriteSize);
		}
	}
	if (Tex)
	{
		WGPUTextureViewDescriptor VD = {};
		VD.format = Format;
		VD.dimension = Dim;
		VD.baseMipLevel = 0;
		VD.mipLevelCount = 1;
		VD.baseArrayLayer = 0;
		VD.arrayLayerCount = (TexDim == WGPUTextureDimension_2D) ? Layers : 1;
		VD.aspect = WGPUTextureAspect_All;
		View = wgpuTextureCreateView(Tex, &VD);
		DawnLiveHandleAdd((void*)View); // LIVEHANDLE
	}
	Cache.Add(Key, View);
	return View;
}


// wndr LMCOUNT: Src 0=REAL(per-draw) 1=STATIC 2=RESTABLE 3=DUMMY
static void WndrLMCount(const FString& Name, int Src)
{
	const bool bPLB = Name.Contains(TEXT("Precomputed"));
	const bool bLMT = Name.Contains(TEXT("LightmapResourceCluster")) || Name.Contains(TEXT("LightMapTexture"));
	if (!bPLB && !bLMT) { return; }
	static uint64 C[2][4] = {}; static uint64 N = 0;
	++C[bPLB ? 0 : 1][Src];
	if ((++N % 4000) == 1)
	{
		printf("WNDR LMCOUNT n=%llu PLB real=%llu static=%llu restable=%llu dummy=%llu | LMTEX real=%llu static=%llu restable=%llu dummy=%llu\n",
			(unsigned long long)N, C[0][0], C[0][1], C[0][2], C[0][3], C[1][0], C[1][1], C[1][2], C[1][3]);
		fflush(stdout);
	}
}

// wndr LM-fix-2: PrecomputedLightingBuffer UB -> its LightmapResourceCluster UB.
static FCriticalSection GWndrLMAssocLock;
static TMap<void*, TRefCountPtr<FRHIUniformBuffer>> GWndrLMAssoc;
extern "C" void WndrDawnAssocLightmapCluster(void* PrecomputedLightingUB, void* ClusterUB)
{
	if (!PrecomputedLightingUB || !ClusterUB) { return; }
	FScopeLock Lock(&GWndrLMAssocLock);
	TRefCountPtr<FRHIUniformBuffer>& Slot = GWndrLMAssoc.FindOrAdd(PrecomputedLightingUB);
	if (Slot.GetReference() != (FRHIUniformBuffer*)ClusterUB) { Slot = (FRHIUniformBuffer*)ClusterUB; }
}
static FRHIUniformBuffer* WndrFindLMCluster(FRHIUniformBuffer* PLB)
{
	FScopeLock Lock(&GWndrLMAssocLock);
	const TRefCountPtr<FRHIUniformBuffer>* F = GWndrLMAssoc.Find((void*)PLB);
	return F ? F->GetReference() : nullptr;
}
bool FDawnCommandContext::FlushPendingBindGroups()
{
