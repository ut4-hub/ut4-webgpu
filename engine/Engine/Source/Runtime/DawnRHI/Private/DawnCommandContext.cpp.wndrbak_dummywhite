	if (CurrentPSO->PixelShader)  { AddLayout(CurrentPSO->PixelShader->Bindings); }
	for (const TPair<uint32, TArray<FDawnShaderBinding>>& LG : LayoutByGroup)
	{
		const uint32 Group = LG.Key;
		if (Group >= (uint32)CurrentPSO->BindGroupLayouts.Num()) { continue; }
		// BGLIMIT belt-and-braces: never hand a null layout to CreateBindGroup
		// (JS-glue abort, not a validation error).
		if (!CurrentPSO->BindGroupLayouts[Group])
		{
			static uint32 _nl = 0; ++_nl;
			if (_nl <= 8 || (_nl % 2000) == 0) { printf("DAWNBG BGLIMIT-NULLLAYOUT grp=%u draw skipped (n=%u)\n", Group, _nl); fflush(stdout); }
