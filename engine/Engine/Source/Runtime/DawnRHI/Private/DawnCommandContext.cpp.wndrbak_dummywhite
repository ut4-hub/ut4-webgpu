void FDawnCommandContext::RHIDrawIndexedPrimitive(FRHIBuffer* IndexBufferRHI, int32 BaseVertexIndex, uint32 FirstInstance, uint32 NumVertices, uint32 StartIndex, uint32 NumPrimitives, uint32 NumInstances)
{
	// Inert PSO (null Pipeline): skip the draw — see RHIDrawPrimitive.
	if (!CurrentPSO || !CurrentPSO->Pipeline) { ++GDawnFrameSkips; static uint32 _sk=0; ++_sk; if (_sk<=8 || (_sk%2000)==0) { printf("DAWNBG SKIPDRAW inert-PSO n=%u prims=%u\n", _sk, NumPrimitives); fflush(stdout); } return; }
	// Incomplete bind group: skip the draw so the Dawn "No bind group set"
	// validation error doesn't invalidate the whole command buffer and discard
	// the good draws with it (see RHIDrawPrimitive for the full rationale).
#if PLATFORM_WASM
	const bool _wndrFlushOk = FlushPendingBindGroups();
	WndrFrameHeldUBs.Append(PendingUBRefs); PendingUBRefs.Reset(); // hold refs alive to frame end; empty the walk list — see RHIDrawPrimitive
	if (!_wndrFlushOk)
#else
	if (!FlushPendingBindGroups())
#endif
	{
		static uint32 _bgs=0; ++_bgs;
		if (_bgs<=8 || (_bgs%500)==0) { UE_LOG(LogDawnRHI, Warning, TEXT("BGSKIPDRAW: RHIDrawIndexedPrimitive skipped on incomplete bind group (n=%u) — command buffer stays valid"), _bgs); }
		return;
	}
	if (DAWNRHI_VERBOSE_DIAG) { static uint32 dP=0,dI=0; if(bCurRTPresentable) dP++; else dI++; if(((dP+dI)%3000)==0) UE_LOG(LogTemp, Warning, TEXT("DRAWTGT backbuffer-draws=%u intermediate-draws=%u"), dP, dI); }
	checkf(ActiveRenderPass, TEXT("DawnRHI: RHIDrawIndexedPrimitive requires an active render pass"));
	// VTXRANGE: indexed draws — Dawn validates only INSTANCE-step buffer
	// ranges at encode (vertex indices aren't known), so pass NumVertices=0.
	if (CurrentPSO->bFragmentless && bCurPassHasColor) { ++GDawnFrameSkips; static uint32 _fsi=0; ++_fsi; if (_fsi<=8||(_fsi%2000)==0){ UE_LOG(LogDawnRHI, Warning, TEXT("FRAGSKIP: depth-only PSO indexed-drawn in a color pass — draw skipped (n=%u)"), _fsi); } return; }
	if (!BindVertexStreams(0, 0, FirstInstance, FMath::Max<uint32>(NumInstances, 1))) { ++GDawnFrameSkips; return; }
	// POSDUMP (speck diagnostic): for the first 4 MULTI-stream draws (mesh
	// vertex factories; Slate is single-stream), print every bound stream
	// slot's buffer handle/offset/size (slot 0 must be DISTINCT from 1/2/3)
	// and the slot-0 POSITION bytes as float3 @ stride 12 from the CPU-side
	// upload snapshot. Real mesh-local positions span tens-hundreds of units
	// and VARY per vertex; ~0/identical/[0,1]-normalized values mean the
	// wrong buffer is in slot 0.
	if (DAWNRHI_VERBOSE_DIAG)
	{
		extern const TArray<uint8>* DawnDiagGetVBSnapshot(void* WgpuBuf);
		static uint32 _posd = 0;
		const uint32 Mask = CurrentPSO->VertexStreamMask;
		if (_posd < 4 && (Mask & ~1u) != 0)
		{
			++_posd;
			UE_LOG(LogDawnRHI, Warning, TEXT("POSDUMP draw#%u mask=0x%x baseVtx=%d startIdx=%u prims=%u inst=%u"), _posd, Mask, BaseVertexIndex, StartIndex, NumPrimitives, NumInstances);
			for (uint32 S = 0; S < MaxVertexStreams && (Mask >> S) != 0; ++S)
			{
				if (!(Mask & (1u << S))) { continue; }
				FDawnBuffer* B = BoundVertexBuffers[S];
				UE_LOG(LogDawnRHI, Warning, TEXT("POSDUMP  slot%u buf=%p off=%u wgpuSize=%u"), S, B ? (void*)B->Buffer : nullptr, BoundVertexBufferOffsets[S], B ? B->WgpuSize : 0);
			}
			FDawnBuffer* P = BoundVertexBuffers[0];
			const TArray<uint8>* Snap = P ? DawnDiagGetVBSnapshot((void*)P->Buffer) : nullptr;
			if (Snap)
			{
				const uint32 Off = BoundVertexBufferOffsets[0];
				if (Off + 12 <= (uint32)Snap->Num())
				{
					const float* F = (const float*)(Snap->GetData() + Off);
					const int32 NV = FMath::Min<int32>(((uint32)Snap->Num() - Off) / 12, 6);
					for (int32 V = 0; V < NV; ++V) { UE_LOG(LogDawnRHI, Warning, TEXT("POSDUMP  v%d pos=[%.2f %.2f %.2f]"), V, F[V*3+0], F[V*3+1], F[V*3+2]); }
				}
				else { UE_LOG(LogDawnRHI, Warning, TEXT("POSDUMP  slot0 offset %u beyond %d-byte snapshot"), Off, Snap->Num()); }
			}
			else { UE_LOG(LogDawnRHI, Warning, TEXT("POSDUMP  slot0 NO SNAPSHOT (null buffer or filled via an unhooked path)")); }
			// Contrast: slot 1 (UV stream) head, raw floats — if slot 0's values
			// look like THESE, the streams are crossed.
			if ((Mask & 2u) && BoundVertexBuffers[1])
			{
				if (const TArray<uint8>* S1 = DawnDiagGetVBSnapshot((void*)BoundVertexBuffers[1]->Buffer))
				{
					if (S1->Num() >= 24) { const float* F = (const float*)S1->GetData(); UE_LOG(LogDawnRHI, Warning, TEXT("POSDUMP  slot1 raw f[0..5]=[%g %g %g %g %g %g]"), F[0],F[1],F[2],F[3],F[4],F[5]); }
				}
			}
		}
	}
	// CLIPPROBE (invisible-world fork test): CPU-replicate the VS position
	// math for sampled multi-stream (world-mesh) draws — see DawnDynamicRHI.cpp.
	if ((CurrentPSO->VertexStreamMask & ~1u) != 0 && NumPrimitives >= 50 && BoundVertexBuffers[0])
	{
		extern void DawnDiagClipProbe(void* Slot0WgpuBuf, uint32 Slot0Offset, uint32 Stride, uint32 NumPrims);
		DawnDiagClipProbe((void*)BoundVertexBuffers[0]->Buffer, BoundVertexBufferOffsets[0], CurrentPSO->StreamStrides[0], NumPrimitives);
	}
	FDawnBuffer* IndexBuffer = static_cast<FDawnBuffer*>(IndexBufferRHI);
	const WGPUIndexFormat IndexFormat = (IndexBuffer->GetStride() == 2) ? WGPUIndexFormat_Uint16 : WGPUIndexFormat_Uint32;
	// STRIPIDX: WebGPU bakes stripIndexFormat into strip pipelines, and an
	// indexed strip draw whose bound index format mismatches (or a strip
	// pipeline with Undefined) is a Dawn validation error that invalidates the
	// WHOLE command buffer — trail/ribbon particle draws froze the game
	// in-match. Bind the PSO variant matching THIS draw's index width; if the
	// matching variant doesn't exist, skip just this draw (STRIPSKIP guard).
	if (CurrentPSO->PrimitiveType == PT_TriangleStrip)
	{
		if (IndexFormat == WGPUIndexFormat_Uint32)
		{
			if (!CurrentPSO->PipelineStrip32)
			{
				static uint32 _ss=0; ++_ss;
				if (_ss<=12 || (_ss%2000)==0) { UE_LOG(LogDawnRHI, Warning, TEXT("STRIPSKIP: 32-bit indexed strip draw but the PSO has no Uint32 strip variant — draw skipped, command buffer stays valid (n=%u)"), _ss); }
				return;
			}
			if (!bStripAltPipelineBound)
			{
				wgpuRenderPassEncoderSetPipeline(ActiveRenderPass, CurrentPSO->PipelineStrip32);
				bStripAltPipelineBound = true;
			}
		}
		else if (bStripAltPipelineBound)
		{
			wgpuRenderPassEncoderSetPipeline(ActiveRenderPass, CurrentPSO->Pipeline);
			bStripAltPipelineBound = false;
		}
	}
	wgpuRenderPassEncoderSetIndexBuffer(ActiveRenderPass, IndexBuffer->Buffer, IndexFormat, 0, WGPU_WHOLE_SIZE);
	// POSDUMP2 (sliver hunt, printf edition): for the first multi-stream mesh
	// draws print the slot-0 (position) buffer identity + the actual float3
	// data captured at its upload. Real mesh-local positions vary and span
	// tens-hundreds of units; zeros/garbage = the upload or binding is wrong.
	{
		extern const TArray<uint8>* DawnDiagGetVBSnapshot(void* WgpuBuf);
		static uint32 _pd2 = 0;
		if (_pd2 < 8 && CurrentPSO && (CurrentPSO->VertexStreamMask & ~1u) != 0 && NumPrimitives >= 50)
		{
			++_pd2;
			FDawnBuffer* B0 = BoundVertexBuffers[0];
			const TArray<uint8>* Snap = B0 ? DawnDiagGetVBSnapshot((void*)B0->Buffer) : nullptr;
			printf("DAWNBG POSDUMP2 #%u mask=0x%x baseVtx=%d startIdx=%u prims=%u idxStride=%u slot0buf=%p off=%u size=%u snap=%d\n",
				_pd2, CurrentPSO->VertexStreamMask, BaseVertexIndex, StartIndex, NumPrimitives,
				IndexBuffer->GetStride(), B0 ? (void*)B0->Buffer : nullptr, B0 ? BoundVertexBufferOffsets[0] : 0,
				B0 ? B0->WgpuSize : 0, Snap ? Snap->Num() : -1);
			if (Snap && Snap->Num() >= 24)
			{
				const float* F = (const float*)Snap->GetData();
				printf("DAWNBG POSDUMP2 #%u v0=[%.2f %.2f %.2f] v1=[%.2f %.2f %.2f]\n", _pd2, F[0], F[1], F[2], F[3], F[4], F[5]);
			// WNDR per-draw: this draw's ACTUAL bound primitive UB transform.
			{ extern FDawnUniformBuffer* GWndrBoundPrimUB;
			  if (GWndrBoundPrimUB && GWndrBoundPrimUB->LastUploadBytes.Num() >= 92) {
			    const float* P = (const float*)GWndrBoundPrimUB->LastUploadBytes.GetData();
			    printf("DAWNBG PERDRAWUB #%u posHigh=[%.1f %.1f %.1f] trans=[%.1f %.1f %.1f] diag=[%.2f %.2f %.2f] (vert0=[%.2f %.2f %.2f])\n",
			      _pd2, P[4],P[5],P[6], P[20],P[21],P[22], P[8],P[13],P[18], F[0],F[1],F[2]); fflush(stdout);
			  } else { printf("DAWNBG PERDRAWUB #%u NO-BOUND-UB (vert0=[%.2f %.2f %.2f])\n", _pd2, F[0],F[1],F[2]); fflush(stdout); } }
			}
			fflush(stdout);
		}
	}
	// PRIMTYPE fix: indices per primitive follow the PSO's primitive type
	// (same formula as vertices) — was hardcoded *3.
	const uint32 IndexCount = DawnVertexCountForPrimitives(CurrentPSO->PrimitiveType, NumPrimitives);
	wgpuRenderPassEncoderDrawIndexed(ActiveRenderPass, IndexCount, FMath::Max<uint32>(NumInstances, 1), StartIndex, BaseVertexIndex, FirstInstance);
	if (bCurRTPresentable && bCurPassHasColor) { ++GDawnFrameDrawsBB; } else { ++GDawnFrameDrawsInt; }
}

