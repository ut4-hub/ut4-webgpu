void FDawnCommandContext::RHISetShaderParameters(FRHIGraphicsShader* Shader, TConstArrayView<uint8> InParametersData, TConstArrayView<FRHIShaderParameter> InParameters, TConstArrayView<FRHIShaderParameterResource> InResourceParameters, TConstArrayView<FRHIShaderParameterResource> InBindlessParameters)
{
	// Stage 2 fallback / multi-@group fix (this session): when the bound PSO
	// carries real reflection data (FDawnVertexShader/FDawnPixelShader::
	// Bindings — see DawnResources.h/RHICreateGraphicsPipelineState in
	// DawnDynamicRHI.cpp), each FRHIShaderParameterResource::Index is a real
	// flattened WGSL @binding number, but NOT necessarily @group(0) — a
	// caller (like DawnRHITestMain's real-shader render path) can pass
	// resources belonging to more than one real @group in a single call, so
	// this now looks up each resource's real Group by its Binding number
	// (scanning the bound VS+PS's reflected ::Bindings — flattened binding
	// numbers are unique across a whole cooked shader, see HANDOFF.md
	// "Update 12", so this is unambiguous) and issues one
	// wgpuRenderPassEncoderSetBindGroup call per real group actually
	// touched, against CurrentPSO->BindGroupLayouts[Group] (one layout per
	// group — see the NOTE in DawnResources.h). Falls back to the old
	// single-@group(0) behaviour (trusting Param.Index directly, no lookup)
	// when the PSO has no reflection data at all, matching the Stage 1/2
	// hand-authored WGSL paths' fixed convention.
	// Inert PSO (null Pipeline — fallback material without cooked shaders):
	// its draws are skipped, so its parameters are irrelevant; it also has no
	// BindGroupLayouts (and possibly null VertexShader/PixelShader), so the
	// checkf below and FindGroupForBinding would abort/crash. Bail out early.
	if (CurrentPSO && !CurrentPSO->Pipeline) { return; }
	checkf(CurrentPSO && CurrentPSO->BindGroupLayouts.Num() > 0, TEXT("DawnRHI: RHISetShaderParameters requires RHISetGraphicsPipelineState to have run first"));
	if (InResourceParameters.Num() == 0 && InParametersData.Num() == 0)
	{
		return;
	}
	// Route each stage's resources to its OWN bind group: VS->group 0, PS->group 1
	// (the PS WGSL was remapped to @group(1) at create time). This stops the PS
	// bind-group from overwriting the VS's at @group(0) and losing the transform.
	[[maybe_unused]] const uint32 StageGroup = (Shader->GetFrequency() == SF_Pixel) ? 1u : 0u;
	if (DAWNRHI_VERBOSE_DIAG) { static uint32 _e=0; if(_e++<80){ UE_LOG(LogTemp, Warning, TEXT("SPFULL freq=%d res=%d params=%d pdata=%d"), (int)Shader->GetFrequency(), InResourceParameters.Num(), InParameters.Num(), InParametersData.Num()); for(const FRHIShaderParameterResource& R:InResourceParameters){ UE_LOG(LogTemp, Warning, TEXT("   SPFULLres idx=%u type=%d"), R.Index, (int)R.Type); } } }

	[[maybe_unused]] auto FindGroupForBinding = [this](uint32 Binding) -> uint32
	{
		for (const FDawnShaderBinding& B : CurrentPSO->VertexShader->Bindings)
		{
			if (B.Binding == Binding) { return B.Group; }
		}
		for (const FDawnShaderBinding& B : CurrentPSO->PixelShader->Bindings)
		{
			if (B.Binding == Binding) { return B.Group; }
		}
		return 0; // no reflection data (or an unreflected binding) -- Stage 2 fixed convention is always @group(0)
	};

	// BINDLESSPARAMS diag (material-albedo delivery hunt): a bindless-cooked
	// shader may deliver its textures through InBindlessParameters instead of
	// InResourceParameters — if the albedo arrives here, the fix is to fold
	// these into the same binding path.
	if (InBindlessParameters.Num() > 0)
	{
		static uint32 _blp = 0; ++_blp;
		if (_blp <= 16 || (_blp % 4000) == 0)
		{
			printf("DAWNBG BINDLESSPARAMS n=%d freq=%d:", InBindlessParameters.Num(), (int)Shader->GetFrequency());
			for (int32 Bi = 0; Bi < FMath::Min(InBindlessParameters.Num(), 8); ++Bi)
			{
				printf(" [idx=%u type=%d res=%p]", InBindlessParameters[Bi].Index, (int)InBindlessParameters[Bi].Type, (void*)InBindlessParameters[Bi].Resource);
			}
			printf(" (n=%u)\n", _blp);
			fflush(stdout);
		}
	}
	TMap<uint32, TArray<WGPUBindGroupEntry>> EntriesByGroup;
	// SRVREBIND order-based storage mapping (players/guns fix 2026-08-20): the GPUSkin base-pass
	// VS has >=2 LIVE storage SRVs (BoneMatrices + PreviousBoneMatrices) delivered as loose
	// ResourceView params carrying param-map Indices (no @binding, no name). The old
	// NumStorage==1 heuristic only rebound when exactly ONE storage binding existed, so with 2 it
	// left the current-pose BoneMatrices SRV mis-indexed -> kind-dropped -> dummy ZERO buffer ->
	// every bone matrix 0 -> skinned verts collapse to origin -> players + 1P weapons INVISIBLE.
	// Fix: map the k-th mis-indexed storage SRV to the k-th UNCLAIMED reflected storage binding,
	// ascending by @binding (= UB struct order: BoneMatrices, then PreviousBoneMatrices).
	TArray<uint32> SortedStorageBindings;
	bool bStorageBindingsComputed = false;
	int32 NumStorageSrvAssigned = 0;
	for (const FRHIShaderParameterResource& Param : InResourceParameters)
	{
		// WNDR: a material draw can pass a NULL resource (a texture/SRV param that
		// falls back to a null default, e.g. materials whose HLSL-stage translation
		// failed and use the default material). Dereferencing it via the static_cast
		// below is an OOB crash. Skip it -> that binding stays unfilled (BGINCOMPLETE
		// drops the group harmlessly) instead of crashing the whole render.
		// UBDELIV ring (material-UB delivery hunt): record EVERY uniform-buffer
		// delivery — including NULLs, which the SPNULLRES skip below silently
		// hides — so MATMISS can print exactly what this PSO scope received.
		if (Param.Type == FRHIShaderParameterResource::EType::UniformBuffer && UBDelivRing.Num() < 48)
		{
			FString D = FString::Printf(TEXT("%u:"), Param.Index);
			if (!Param.Resource) { D += TEXT("NULL"); }
			else { D += static_cast<FDawnUniformBuffer*>(Param.Resource)->GetLayout().GetDebugName(); }
			UBDelivRing.Add(MoveTemp(D));
		}
		if (Param.Resource == nullptr) { static uint32 _nr=0; if(DAWNRHI_VERBOSE_DIAG && _nr++<24) UE_LOG(LogDawnRHI, Warning, TEXT("SPNULLRES idx=%u type=%d SKIP"), Param.Index, (int)Param.Type); continue; }
		WGPUBindGroupEntry Entry = {};
		Entry.binding = Param.Index;
		switch (Param.Type)
		{
		case FRHIShaderParameterResource::EType::UniformBuffer:
		{
			FDawnUniformBuffer* UB = static_cast<FDawnUniformBuffer*>(Param.Resource);
			Entry.buffer = UB->Buffer;
			Entry.size = UB->GetLayout().ConstantBufferSize;
			// UBRESTABLE: source of member resources at bind time (dedupe
			// consecutive re-adds across draws). Record ALL delivered UBs —
			// empty tables are skipped by TryUBTable but their names make the
			// MATMISS delivery diagnosis truthful.
			if (PendingUBRefs.Num() == 0 || PendingUBRefs.Last().GetReference() != UB) { PendingUBRefs.Add(UB); }
			// UBREBIND (black-world ROOT-CAUSE fix): mesh draws deliver their
			// per-draw uniform buffers (Primitive/Material/MobileDirectionalLight/
			// MobileReflectionCapture/...) through FRHIBatchedShaderParameters::
			// SetShaderUniformBuffer, whose Index is the PARAMETER-MAP position —
			// NOT the WGSL @binding number (proved live: the 384-byte
			// MobileDirectionalLight UB arrived at Index 0 and landed on
			// @binding(0), which is View(6752B) -> Dawn size error; and PRIMTRACE
			// showed Primitive real=0, dummy-zeroed -> LocalToWorld==0 -> every
			// scene vertex at origin -> black world). The UB's layout debug name
			// derives the exact WGSL var name (same rule as the static-UB inject),
			// so rebind each arriving UB to the reflected binding(s) carrying that
			// name — BOTH stages' (VS and PS reflect separate vars/bindings for a
			// shared UB; each gets an entry).
			if (CurrentPSO && (CurrentPSO->VertexShader || CurrentPSO->PixelShader))
			{
				const FString UBN = DawnDeriveShaderUBName(UB->GetLayout().GetDebugName());
				if (!UBN.IsEmpty())
				{
					const FDawnShaderBinding* Primary = nullptr;
					auto MatchStage = [&](const TArray<FDawnShaderBinding>& Bs)
					{
						for (const FDawnShaderBinding& B : Bs)
						{
							if (B.Kind != EDawnShaderBindingKind::UniformBuffer || !(B.Name.Equals(UBN, ESearchCase::CaseSensitive) || B.Name.Equals(UBN + TEXT("Buffer"), ESearchCase::CaseSensitive))) { continue; } // wndr LM-fix-1: PrecomputedLightingBuffer
							if (!Primary)
							{
								Primary = &B;
							}
							else if (B.Binding != Primary->Binding)
							{
								// Second stage's own binding for the same UB: add its entry directly.
								WGPUBindGroupEntry E2 = Entry;
								E2.binding = B.Binding;
								EntriesByGroup.FindOrAdd(B.Group).Add(E2);
							}
							break; // at most one match per stage's binding list
						}
					};
					if (CurrentPSO->VertexShader) { MatchStage(CurrentPSO->VertexShader->Bindings); }
					if (CurrentPSO->PixelShader)  { MatchStage(CurrentPSO->PixelShader->Bindings); }
					if (Primary && Primary->Binding != Param.Index)
					{
						static uint32 _rb=0;
						if (DAWNRHI_VERBOSE_DIAG && _rb++ < 32) { UE_LOG(LogDawnRHI, Warning, TEXT("UBREBIND %s: param idx=%u -> wgsl bind=%u grp=%u size=%u"), *UBN, Param.Index, Primary->Binding, Primary->Group, (uint32)Entry.size); }
						Entry.binding = Primary->Binding;
					}
					// UBDROP (the "bound with size 240 ... requires 608" frame-
					// poison fix): a UB whose derived name matches NO reflected
					// binding in EITHER stage does not belong to this pipeline's
					// interface (vertex-factory UBs whose layout name differs
					// from the WGSL var, stage-mismatched deliveries, ...).
					// Under the sequential-slot cook its raw Param.Index is a
					// meaningless small number that lands on an UNRELATED
					// binding — a min-binding-size validation error there
					// invalidates the WHOLE command buffer (frozen present).
					// Drop it: the real binding stays empty and the static/
					// resource-table/dummy fill provides a size-valid resource.
					if (!Primary && !UBN.IsEmpty())
					{
						static uint32 _ud = 0; ++_ud;
						if (GDawnVerboseBindLog && (_ud <= 16 || (_ud % 2000) == 0)) { printf("DAWNBG UBDROP name=%s idx=%u size=%u — no reflected binding, dropped (n=%u)\n", TCHAR_TO_UTF8(*UBN), Param.Index, (uint32)Entry.size, _ud); fflush(stdout); }
						continue; // do not place it at a raw index
					}
				}
			}
			break;
		}
		case FRHIShaderParameterResource::EType::Texture:
		{
			FDawnTexture* Tex = static_cast<FDawnTexture*>(DawnResolveTex(static_cast<FRHITexture*>(Param.Resource))); // wndr TEXREF-fix-1
			if (!Tex) { continue; } // empty slot -> dummy-fill
			Entry.textureView = Tex->View;
			// BINDFIX (frame-3 CreateBindGroup hang): validate the texture
			// against the reflected layout slot at this binding number. A view
			// of the wrong DIMENSION (cube texture on a texture_2d slot, or
			// vice versa) or wrong SAMPLE TYPE (depth/unfilterable-float
			// texture on a filterable Float slot) fails CreateBindGroup and
			// kills the whole pass. Skip the param instead — the slot stays
			// empty and FlushPendingBindGroups dummy-fills it with a view that
			// exactly matches the layout.
			if (CurrentPSO && (CurrentPSO->VertexShader || CurrentPSO->PixelShader))
			{
				const FDawnShaderBinding* RB = nullptr;
				auto FindRB = [&](const TArray<FDawnShaderBinding>& Bs) { for (const FDawnShaderBinding& Bi : Bs) { if (Bi.Binding == Param.Index) { RB = &Bi; break; } } };
				if (CurrentPSO->VertexShader) { FindRB(CurrentPSO->VertexShader->Bindings); }
				if (!RB && CurrentPSO->PixelShader) { FindRB(CurrentPSO->PixelShader->Bindings); }
				if (RB && RB->Kind == EDawnShaderBindingKind::Texture)
				{
					const FRHITextureDesc& TD = Tex->GetDesc();
					WGPUTextureViewDimension ActualDim = WGPUTextureViewDimension_2D;
					switch (TD.Dimension)
					{
					case ETextureDimension::Texture2DArray:   ActualDim = WGPUTextureViewDimension_2DArray;   break;
					case ETextureDimension::Texture3D:        ActualDim = WGPUTextureViewDimension_3D;        break;
					case ETextureDimension::TextureCube:      ActualDim = WGPUTextureViewDimension_Cube;      break;
					case ETextureDimension::TextureCubeArray: ActualDim = WGPUTextureViewDimension_CubeArray; break;
					default: break;
					}
					const bool bDepthFmt = (TD.Format == PF_DepthStencil || TD.Format == PF_ShadowDepth || TD.Format == PF_D24 || TD.Format == PF_R32_FLOAT);
					const bool bFloat32Fmt = (TD.Format == PF_R32_FLOAT || TD.Format == PF_G32R32F || TD.Format == PF_A32B32G32R32F);
					const char* Why = nullptr;
					if (ActualDim != RB->TexViewDim) { Why = "dim"; }
					else if (RB->TexSampleType == WGPUTextureSampleType_Float && (bDepthFmt || bFloat32Fmt)) { Why = "sampletype"; }
					else if (RB->TexSampleType == WGPUTextureSampleType_Depth && !bDepthFmt) { Why = "notdepth"; }
					if (Why)
					{
						static uint32 _dm = 0;
						if (_dm++ < 40)
						{
							printf("DAWNBG TEXMISMATCH(%s) bind=%u name=%s wantDim=%d wantST=%d actualDim=%d fmt=%d %ux%u SKIP->dummy\n",
								Why, Param.Index, TCHAR_TO_UTF8(*RB->Name), (int)RB->TexViewDim, (int)RB->TexSampleType,
								(int)ActualDim, (int)TD.Format, TD.Extent.X, TD.Extent.Y);
							fflush(stdout);
						}
						continue;
					}
				}
			}
			if (DAWNRHI_VERBOSE_DIAG) { static uint32 _tc=0; if(_tc++<24){ const FRHITextureDesc& D=Tex->GetDesc(); UE_LOG(LogDawnRHI, Warning, TEXT("TEXBIND bind=%u fmt=%d %ux%u mips=%u view=%d"), Param.Index, (int)D.Format, D.Extent.X, D.Extent.Y, D.NumMips, Tex->View?1:0); } }
			if (DAWNRHI_VERBOSE_DIAG) if (Tex->GetDesc().Format == PF_A8 && CurrentPSO && CurrentPSO->PixelShader) { static bool _dumped=false; if(!_dumped){ _dumped=true; const FString& W=CurrentPSO->PixelShader->WGSLSource; int32 from=0; int32 n=0; while(n<8){ int32 idx=W.Find(TEXT("textureSample"), ESearchCase::CaseSensitive, ESearchDir::FromStart, from); if(idx==INDEX_NONE) break; UE_LOG(LogDawnRHI, Warning, TEXT("WGSLSAMP[%d]: %s"), n, *W.Mid(idx, 180)); from=idx+13; ++n; } int32 ri=W.Find(TEXT("return"), ESearchCase::CaseSensitive, ESearchDir::FromEnd); if(ri!=INDEX_NONE){ UE_LOG(LogDawnRHI, Warning, TEXT("WGSLRET: %s"), *W.Mid(ri, 160)); } UE_LOG(LogDawnRHI, Warning, TEXT("WGSLLEN=%d"), W.Len()); } }
			break;
		}
		case FRHIShaderParameterResource::EType::Sampler:
		{
			FDawnSamplerState* Sampler = static_cast<FDawnSamplerState*>(Param.Resource);
			Entry.sampler = Sampler->Sampler;
			break;
		}
		case FRHIShaderParameterResource::EType::ResourceView:
		{
			FDawnShaderResourceView* SRV = static_cast<FDawnShaderResourceView*>(Param.Resource);
			if (DAWNRHI_VERBOSE_DIAG) { static uint32 _sc=0; if(_sc++<24) UE_LOG(LogDawnRHI, Warning, TEXT("SRVBIND bind=%u texview=%d buf=%d"), Param.Index, SRV->TextureView?1:0, SRV->Buffer?1:0); }
			if (SRV->TextureView)
			{
				Entry.textureView = SRV->TextureView;
			}
			else
			{
				Entry.buffer = SRV->Buffer;
				// SRVSIZE: size 0 in a WGPUBindGroupEntry means "0 bytes" and
				// fails CreateBindGroup — an unset BufferSize must mean the
				// whole buffer.
				Entry.size = SRV->BufferSize ? SRV->BufferSize : WGPU_WHOLE_SIZE;
				// SRVREBIND (bots-collapse fix, same disease UBREBIND cured for
				// uniform buffers): mesh-draw batched parameters deliver
				// FRHIShaderParameterResource::Index as the PARAMETER-MAP
				// position, NOT the WGSL @binding. The GPUSkin bone-matrix SRV
				// (WGSL: var<storage, read> GPUSkinVFBase_Common_BoneMatrices
				// @binding(4)) therefore landed on the wrong slot, was
				// kind-dropped, and the layout slot was dummy-filled with the
				// ZERO buffer -> every bone matrix zero -> all skinned vertices
				// collapse to one point (the "sliver" bots). SRVs carry no name
				// at the RHI boundary, so rebind by KIND: if Param.Index does
				// not hit a reflected STORAGE-buffer binding for this stage but
				// exactly ONE such binding exists, that binding is the target.
				if (CurrentPSO && (CurrentPSO->VertexShader || CurrentPSO->PixelShader))
				{
					const TArray<FDawnShaderBinding>* StageBs = (Shader->GetFrequency() == SF_Pixel)
						? (CurrentPSO->PixelShader  ? &CurrentPSO->PixelShader->Bindings  : nullptr)
						: (CurrentPSO->VertexShader ? &CurrentPSO->VertexShader->Bindings : nullptr);
					if (StageBs)
					{
						// Build the assignable storage-binding pool once per RHISetShaderParameters call:
						// all storage bindings for this stage, ascending, MINUS any a ResourceView param
						// already targets directly (correctly indexed -> leave those alone).
						if (!bStorageBindingsComputed)
						{
							bStorageBindingsComputed = true;
							TArray<uint32> AllStorage;
							for (const FDawnShaderBinding& Bi : *StageBs)
							{
								if (Bi.Kind == EDawnShaderBindingKind::UniformBuffer && Bi.BufBindingType != WGPUBufferBindingType_Uniform)
								{
									AllStorage.Add(Bi.Binding);
								}
							}
							AllStorage.Sort();
							for (uint32 B : AllStorage)
							{
								bool bClaimed = false;
								for (const FRHIShaderParameterResource& P2 : InResourceParameters)
								{
									if (P2.Type == FRHIShaderParameterResource::EType::ResourceView && P2.Index == B) { bClaimed = true; break; }
								}
								if (!bClaimed) { SortedStorageBindings.Add(B); }
							}
						}
						// Does Param.Index already land ON a storage binding? Then it is correct -> keep it.
						bool bIndexIsStorage = false;
						for (const FDawnShaderBinding& Bi : *StageBs)
						{
							if (Bi.Binding == Param.Index && Bi.Kind == EDawnShaderBindingKind::UniformBuffer && Bi.BufBindingType != WGPUBufferBindingType_Uniform)
							{
								bIndexIsStorage = true; break;
							}
						}
						// k-th mis-indexed storage SRV -> k-th unclaimed storage binding (struct order).
						if (!bIndexIsStorage && NumStorageSrvAssigned < SortedStorageBindings.Num())
						{
							const uint32 Target = SortedStorageBindings[NumStorageSrvAssigned];
							Entry.binding = Target;
							++NumStorageSrvAssigned;
							static uint32 _srb = 0; ++_srb;
							// SKINDIAG: for GPUSkin base-pass draws, name the param->binding mapping and
							// whether the SRV buffer is real vs null (null/dummy => bone matrices zero).
							const bool bSkin = CurrentPSO->VertexShader && CurrentPSO->VertexShader->WGSLSource.Contains(TEXT("GPUSkinVFBase"));
							if (_srb <= 16 || bSkin || (_srb % 2000) == 0)
							{
								printf("DAWNBG SRVREBIND idx=%u -> bind=%u srvBuf=%s k=%d/%d%s\n",
									Param.Index, Target, SRV->Buffer ? "real" : "NULL",
									NumStorageSrvAssigned - 1, SortedStorageBindings.Num(),
									bSkin ? " [GPUSkinVFBase]" : "");
								fflush(stdout);
							}
						}
					}
				}
			}
			break;
		}
		case FRHIShaderParameterResource::EType::UnorderedAccessView:
		{
			FDawnUnorderedAccessView* UAV = static_cast<FDawnUnorderedAccessView*>(Param.Resource);
			if (UAV->TextureView)
			{
				Entry.textureView = UAV->TextureView;
			}
			else
			{
				Entry.buffer = UAV->Buffer;
				Entry.size = UAV->BufferSize;
			}
			break;
		}
		default:
			checkf(false, TEXT("DawnRHI Stage 2: unsupported shader parameter resource type %d"), (int32)Param.Type);
			continue;
		}
		// Use Entry.binding (possibly name-rebound above), not Param.Index.
		const uint32 Group = FindGroupForBinding(Entry.binding);
		EntriesByGroup.FindOrAdd(Group).Add(Entry);
	}

	// Loose global parameters ($Globals): UE passes the packed global-constant bytes as
	// InParametersData, with a per-member layout in InParameters (BufferIndex = the target
	// uniform-buffer @binding, ByteOffset = source offset in InParametersData, BaseIndex =
	// destination offset within the CB, ByteSize = size). Pack each BufferIndex into a
	// transient uniform buffer and bind it -- without this the shader's $Globals CB binding
	// is never provided, Dawn rejects the whole bind group ("Number of entries did not
	// match"), and (even if it didn't) the vertex transform / draw constants are missing.
	TArray<WGPUBuffer> TransientUBs;
	if (InParametersData.Num() > 0 && InParameters.Num() > 0)
	{
		TMap<uint16, uint32> BufSizes;
		for (const FRHIShaderParameter& P : InParameters)
		{
			uint32& Sz = BufSizes.FindOrAdd(P.BufferIndex);
			Sz = FMath::Max(Sz, (uint32)P.BaseIndex + (uint32)P.ByteSize);
		}
		for (const TPair<uint16, uint32>& BS : BufSizes)
		{
			// Over-allocate: UE reports only the members it set, but the shaders WGSL
			// uniform-buffer struct is padded larger (e.g. 48 used -> 64 required). A larger
			// buffer satisfies WebGPUs minBindingSize; the tail is zero-filled.
			const uint32 CbSize = Align(BS.Value + 256u, 16u);
			TArray<uint8> Cpu;
			Cpu.SetNumZeroed(CbSize);
			for (const FRHIShaderParameter& P : InParameters)
			{
				if (P.BufferIndex != BS.Key) { continue; }
				if ((uint32)P.ByteOffset + P.ByteSize <= (uint32)InParametersData.Num() && (uint32)P.BaseIndex + P.ByteSize <= CbSize)
				{
					FMemory::Memcpy(Cpu.GetData() + P.BaseIndex, InParametersData.GetData() + P.ByteOffset, P.ByteSize);
				}
			}
			if (DAWNRHI_VERBOSE_DIAG) { static uint32 _g=0; if(_g++<2 && CbSize>=64){ const float* F=(const float*)Cpu.GetData(); const int N=(int)(CbSize/4); for(int r=0;r<N && r<20;r+=4){ UE_LOG(LogTemp, Warning, TEXT("GLOBALSDIAG bind=%u fl%d [%.4f %.4f %.4f %.4f]"), (uint32)BS.Key, r, F[r],F[r+1],F[r+2],F[r+3]); } } }
			WGPUBufferDescriptor BD = {};
			BD.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
			BD.size = CbSize;
			WGPUBuffer UB = wgpuDeviceCreateBuffer(Owner->GetDevice(), &BD);
			wgpuQueueWriteBuffer(Owner->GetQueue(), UB, 0, Cpu.GetData(), CbSize);
			TransientUBs.Add(UB);
			WGPUBindGroupEntry E = {};
			E.binding = BS.Key;
			E.buffer = UB;
			E.size = CbSize;
			EntriesByGroup.FindOrAdd(FindGroupForBinding(BS.Key)).Add(E);
		}
	}

	// Accumulate this call's entries into the pending set (keyed by binding so a later
	// stage's call extends rather than replaces). The bind group is created at DRAW time in
	// FlushPendingBindGroups() from ALL the accumulated VS+PS calls.
	for (const TPair<uint32, TArray<WGPUBindGroupEntry>>& Pair : EntriesByGroup)
	{
		TMap<uint32, WGPUBindGroupEntry>& Dst = PendingBindEntries.FindOrAdd(Pair.Key);
		for (const WGPUBindGroupEntry& E : Pair.Value) { Dst.Add(E.binding, E); }
	}
	for (WGPUBuffer UB : TransientUBs) { PendingTransientUBs.Add(UB); }
}

