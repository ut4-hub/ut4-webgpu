// Default OFF: wasm console logging is expensive (printf -> JS console) and
// some probes do per-draw work. Flip to 1 to re-arm every probe; all the
// diagnostic code is kept compiled-out/dead-code-eliminated, not deleted.
#ifndef DAWNRHI_VERBOSE_DIAG
#define DAWNRHI_VERBOSE_DIAG 0
#endif

// FRAMESUM (invisible-world hunt): per-frame render-pass/draw accounting,
// always on, printed every 300th frame from RHIEndFrame. Answers definitively
// which targets the world draws land on: bb = presentable (swapchain),
// int = intermediate (SceneColor etc.). Single-threaded RHI -> plain globals.
uint32 GDawnFramePassesBB = 0, GDawnFramePassesInt = 0, GDawnFramePassesDepthOnly = 0;
uint32 GDawnFrameDrawsBB = 0, GDawnFrameDrawsInt = 0, GDawnFrameSkips = 0;
// OVERWRITE hunt: how many bb passes CLEAR, and does any bb CLEAR arrive
// AFTER the frame already drew on the backbuffer (i.e. something wipes the
// rendered scene before the HUD draws)?
uint32 GDawnFrameBBClears = 0, GDawnFrameBBClearAfterDraw = 0;
#if PLATFORM_WASM
#include <emscripten.h>
// WNDR perf profile (2026-08-20): distinguish bind-table WALK vs wgpuDeviceCreateBindGroup cost.
double GWndrBindTotalMs = 0.0, GWndrCreateBGMs = 0.0; uint32 GWndrBindCalls = 0, GWndrCreateCalls = 0;
#endif
#if PLATFORM_WASM
// WNDR 2026-08-20: gate the high-frequency per-bind/per-draw DAWNBG logging flood (~200M prints,
// millions of wasm<->JS crossings/sec). Default OFF; flip to true only to re-diagnose bind issues.
bool GDawnVerboseBindLog = false; // shared; extern in DawnDynamicRHI.cpp
#endif
void DawnDiagFrameSummaryTick()
{
	static uint32 _fr = 0; ++_fr;
	if (_fr <= 8 || (_fr % 300) == 0)
	{
		printf("DAWNBG FRAMESUM f=%u passes(bb=%u int=%u depthOnly=%u) draws(bb=%u int=%u) skips=%u bbClears=%u bbClearAfterDraw=%u\n",
			_fr, GDawnFramePassesBB, GDawnFramePassesInt, GDawnFramePassesDepthOnly, GDawnFrameDrawsBB, GDawnFrameDrawsInt, GDawnFrameSkips, GDawnFrameBBClears, GDawnFrameBBClearAfterDraw);
		fflush(stdout);
	}
#if PLATFORM_WASM
	if (_fr <= 40) { printf("DAWNBG PERFPROF f=%u bindLoopMs=%.1f createBGMs=%.1f walkMs=%.1f bindCalls=%u createCalls=%u\n", _fr, GWndrBindTotalMs, GWndrCreateBGMs, GWndrBindTotalMs-GWndrCreateBGMs, GWndrBindCalls, GWndrCreateCalls); fflush(stdout); }
	GWndrBindTotalMs = GWndrCreateBGMs = 0.0; GWndrBindCalls = GWndrCreateCalls = 0;
#endif
	GDawnFramePassesBB = GDawnFramePassesInt = GDawnFramePassesDepthOnly = 0;
	GDawnFrameDrawsBB = GDawnFrameDrawsInt = GDawnFrameSkips = 0;
	GDawnFrameBBClears = GDawnFrameBBClearAfterDraw = 0;
}

