			// PRIMSRC (sliver investigation, printf edition — UE_LOG is
			// stripped): what actually fills the Primitive binding at draw
			// time? REAL per-draw UB (the folded one), STATIC name-injected,
			// or DUMMY zeros (which would collapse all geometry).
			// FOGSRC: same source-tracking for the MobileBasePass UB (carries the
			// fog inscattering params — dummy/misbound here = the blue haze).
			if (B.Kind == EDawnShaderBindingKind::UniformBuffer && B.Name == TEXT("MobileBasePass"))
			{
				bool bStaticHit = false;
				for (const TPair<FString, FRHIUniformBuffer*>& P : StaticUBsByName)
					if (B.Name.Equals(P.Key, ESearchCase::CaseSensitive)) { bStaticHit = true; break; }
				const char* Src = (PendE && !(bStaticFirst && bStaticHit)) ? "REAL" : (bStaticHit ? "STATIC" : (PendE ? "REAL" : "DUMMY"));
				static uint32 _ft = 0;
				if (GDawnVerboseBindLog && (++_ft <= 8 || (_ft % 2000) == 0))
				{
					printf("DAWNBG FOGSRC grp=%u bind=%u src=%s pendSize=%u pendBuf=%p\n", Group, B.Binding, Src, PendE ? (uint32)PendE->size : 0u, PendE ? (void*)PendE->buffer : nullptr);
					fflush(stdout);
				}
			}
			if (B.Kind == EDawnShaderBindingKind::UniformBuffer && B.Name == TEXT("Primitive"))
			{
				// WNDR per-draw probe: remember the ACTUAL primitive UB bound to the next draw.
				extern FDawnUniformBuffer* DawnUBRegistryFind(void* WgpuBuf);
				extern FDawnUniformBuffer* GWndrBoundPrimUB;
				GWndrBoundPrimUB = (PendE && PendE->buffer) ? DawnUBRegistryFind((void*)PendE->buffer) : nullptr;
				bool bStaticHit = false;
				for (const TPair<FString, FRHIUniformBuffer*>& P : StaticUBsByName)
					if (B.Name.Equals(P.Key, ESearchCase::CaseSensitive)) { bStaticHit = true; break; }
				const char* Src = (PendE && !(bStaticFirst && bStaticHit)) ? "REAL" : (bStaticHit ? "STATIC" : (PendE ? "REAL" : "DUMMY"));
				static uint32 _pt = 0, _cr = 0, _cs = 0, _cd = 0;
				if (Src[0] == 'R') { ++_cr; } else if (Src[0] == 'S') { ++_cs; } else { ++_cd; }
				++_pt;
				if (GDawnVerboseBindLog && (_pt <= 12 || (_pt % 2000) == 0))
				{
					printf("DAWNBG PRIMSRC grp=%u bind=%u src=%s pendSize=%u | totals real=%u static=%u dummy=%u\n",
						Group, B.Binding, Src, PendE ? (uint32)PendE->size : 0u, _cr, _cs, _cd);
					fflush(stdout);
				}
			}
			// PRIMTRACE (black-world investigation): with GPUScene disabled the
			// mobile base-pass VS reads LocalToWorld from the Primitive UNIFORM
			// BUFFER (GetPrimitiveDataFromUniformBuffer, SceneData.ush) — if
			// that binding is dummy-filled (zeros), LocalToWorld==0 collapses
			// every vertex to the origin. Classify the source of the
			// Primitive/View bindings per flush: real per-draw entry, static
			// name match, or dummy.
			if (DAWNRHI_VERBOSE_DIAG && B.Kind == EDawnShaderBindingKind::UniformBuffer && (B.Name == TEXT("Primitive") || (B.Name == TEXT("View"))))
			{
				const bool bPrim = (B.Name == TEXT("Primitive"));
				bool bStaticHit = false;
				for (const TPair<FString, FRHIUniformBuffer*>& P : StaticUBsByName)
					if (B.Name.Equals(P.Key, ESearchCase::CaseSensitive)) { bStaticHit = true; break; }
				const TCHAR* Src = (PendE && !(bStaticFirst && bStaticHit)) ? TEXT("REAL-perdraw") : (bStaticHit ? TEXT("STATIC") : (PendE ? TEXT("REAL-perdraw") : TEXT("DUMMY-ZERO")));
				static uint32 _ptPrimReal=0,_ptPrimStat=0,_ptPrimDummy=0,_ptViewReal=0,_ptViewStat=0,_ptViewDummy=0,_ptn=0;
				uint32& C = bPrim ? (FCString::Strcmp(Src,TEXT("DUMMY-ZERO"))==0 ? _ptPrimDummy : (FCString::Strcmp(Src,TEXT("STATIC"))==0 ? _ptPrimStat : _ptPrimReal))
				                  : (FCString::Strcmp(Src,TEXT("DUMMY-ZERO"))==0 ? _ptViewDummy : (FCString::Strcmp(Src,TEXT("STATIC"))==0 ? _ptViewStat : _ptViewReal));
				++C; ++_ptn;
				if (_ptn <= 24 || (_ptn % 500) == 0)
				{
					UE_LOG(LogDawnRHI, Warning, TEXT("PRIMTRACE %s grp=%u bind=%u src=%s suspect=%d | totals Prim real=%u stat=%u dummy=%u / View real=%u stat=%u dummy=%u"),
						*B.Name, Group, B.Binding, Src, bSuspectNumbering?1:0, _ptPrimReal, _ptPrimStat, _ptPrimDummy, _ptViewReal, _ptViewStat, _ptViewDummy);
				}
				// PRIMBUFS (sliver investigation): how many DISTINCT WGPUBuffer
				// handles ever occupy the Primitive binding? 1 distinct handle =
				// every draw shares one UB (identity/zeros -> everything renders
				// in local space at the world origin = the sliver); many = draws
				// carry their own per-primitive UBs and the fault is elsewhere.
				if (bPrim && PendE && PendE->buffer)
				{
					static TSet<void*> _bufs; static uint32 _pb=0;
					if (_bufs.Num() < 4096) { _bufs.Add((void*)PendE->buffer); }
					if ((++_pb % 2000) == 0 || _pb <= 3) { UE_LOG(LogDawnRHI, Warning, TEXT("PRIMBUFS distinct=%d latest=%p size=%llu (n=%u)"), _bufs.Num(), (void*)PendE->buffer, (unsigned long long)PendE->size, _pb); }
				}
			}
			if (PendE && !bStaticFirst) { WndrLMCount(B.Name, 0); Entries.Add(*PendE); continue; }
