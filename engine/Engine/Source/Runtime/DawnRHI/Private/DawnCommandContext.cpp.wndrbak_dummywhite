	struct FWndrBindTimer { double t0; FWndrBindTimer(){ t0 = emscripten_get_now(); } ~FWndrBindTimer(){ GWndrBindTotalMs += emscripten_get_now() - t0; ++GWndrBindCalls; } } _wndrBindTimer;
