							Group, B.Binding, TCHAR_TO_UTF8(*B.Name), (int)B.Kind, (int)B.TexViewDim, (int)B.TexSampleType,
							(void*)PendE->textureView, (void*)PendE->buffer, (void*)PendE->sampler, (uint32)PendE->size);
