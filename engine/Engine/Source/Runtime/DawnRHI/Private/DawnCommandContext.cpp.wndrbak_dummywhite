			// (and, in suspect groups, ahead of a possibly-misnumbered pending entry).
			if (B.Kind == EDawnShaderBindingKind::UniformBuffer && StaticUBsByName.Num() > 0)
			{
				FRHIUniformBuffer* Found = nullptr;
				for (const TPair<FString, FRHIUniformBuffer*>& P : StaticUBsByName)
					if (!B.Name.IsEmpty() && B.Name.Equals(P.Key, ESearchCase::CaseSensitive)) { Found = P.Value; break; }
				if (Found) { FDawnUniformBuffer* DUB = static_cast<FDawnUniformBuffer*>(Found); if (DUB->Buffer) { WGPUBindGroupEntry E={}; E.binding=B.Binding; E.buffer=DUB->Buffer; E.size=DUB->GetLayout().ConstantBufferSize; WndrLMCount(B.Name, 1); Entries.Add(E); { static uint32 _sj=0; ++_sj; if (_sj<=16 || (_sj%4000)==0) { printf("DAWNBG STATICUB grp=%u bind=%u name=%s size=%u buf=%p\n", Group, B.Binding, TCHAR_TO_UTF8(*B.Name), (uint32)E.size, (void*)DUB->Buffer); fflush(stdout); } }{ const bool _v=B.Name.Contains(TEXT("View"))&&!B.Name.Contains(TEXT("Slate")); static uint32 _si=0; if(DAWNRHI_VERBOSE_DIAG && (_v||_si++<16)) UE_LOG(LogDawnRHI, Warning, TEXT("STATICINJECT bind=%u name=%s size=%u"), B.Binding, *B.Name, (uint32)E.size); } { static uint32 _uo=0; if(DAWNRHI_VERBOSE_DIAG && PendE && _uo++<24) UE_LOG(LogDawnRHI, Warning, TEXT("UBOVERRIDE grp=%u bind=%u name=%s: static UB (size=%u) replaces misnumbered per-draw entry (size=%u)"), Group, B.Binding, *B.Name, (uint32)E.size, (uint32)PendE->size); } continue; } }
