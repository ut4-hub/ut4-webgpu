			// BINDFIX (frame-3 CreateBindGroup hang): a pending entry whose
			// resource KIND does not match the reflected layout slot (e.g. a
			// buffer or sampler landing on a TEXTURE binding via a colliding
			// binding number) fails wgpuDeviceCreateBindGroup — the pass is
			// never built, the render thread never submits, screen stays
			// black. Drop the mismatched entry here so the dummy-fill below
			// provides a layout-matching resource instead.
			if (PendE)
			{
				bool bKindOk = true;
				switch (B.Kind)
				{
				case EDawnShaderBindingKind::Texture:       bKindOk = (PendE->textureView != nullptr); break;
				case EDawnShaderBindingKind::Sampler:       bKindOk = (PendE->sampler != nullptr); break;
				case EDawnShaderBindingKind::UniformBuffer: bKindOk = (PendE->buffer != nullptr); break;
