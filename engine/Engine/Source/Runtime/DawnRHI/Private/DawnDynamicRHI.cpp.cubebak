static WGPUShaderModule CompileWGSL(WGPUDevice Device, const FRHICreateShaderDesc& CreateShaderDesc, const TCHAR* DebugLabel, bool bRemapPixelGroup = false)
{
	// Stage 1 shader contract (ours, not SimplyStream's): Code is UTF-8 WGSL
	// source text. Stage 3 replaces the *producer* of this text (hand-authored
	// -> HLSL->SPIR-V->WGSL via ShaderConductor+Tint) without changing this
	// consumer. Pass the bytes straight through with an explicit length —
	// no TCHAR round-trip, no reliance on WGPU_STRLEN's null-termination
	// assumption (an earlier version round-tripped through FString/UTF8CHAR
	// and fed Dawn's WGSL parser a corrupted/mis-terminated buffer).
	WGPUShaderSourceWGSL WgslDesc = {};
	WgslDesc.chain.sType = WGPUSType_ShaderSourceWGSL;
	// Code.Num() is the FULL FShaderCode buffer = WGSL text + UE trailing optional-data
	// blob. Feeding the whole thing to the WGSL parser makes it read garbage past the
	// shader end ("invalid character found"). Use the actual code size (minus optional data).
	FShaderCodeReader WgslCodeReader(CreateShaderDesc.Code);
	const size_t WgslCodeLen = (size_t)WgslCodeReader.GetActualShaderCodeSize();
	const char* WgslCodePtr = reinterpret_cast<const char*>(CreateShaderDesc.Code.GetData());
	TArray<uint8> RemapBuf;
	if (bRemapPixelGroup)
	{
		// Raw-byte @group(0)->@group(1) remap (same byte length; avoids a lossy TCHAR
		// round-trip that corrupts the WGSL). Only the single digit after '(' changes.
		RemapBuf.Append(reinterpret_cast<const uint8*>(WgslCodePtr), (int32)WgslCodeLen);
		for (int32 i = 0; i + 8 < RemapBuf.Num(); )
		{
			if (RemapBuf[i] == (uint8)'@' && FMemory::Memcmp(&RemapBuf[i], "@group(0", 8) == 0 && (RemapBuf[i+8] == (uint8)')' || RemapBuf[i+8] == (uint8)'u'))
			{
				RemapBuf[i+7] = (uint8)'1';
				i += 8;
			}
			else { ++i; }
		}
		WgslCodePtr = reinterpret_cast<const char*>(RemapBuf.GetData());
	}
	WgslDesc.code = { WgslCodePtr, WgslCodeLen };

	WGPUShaderModuleDescriptor ModuleDesc = {};
	ModuleDesc.nextInChain = &WgslDesc.chain;

	auto LabelUtf8 = StringCast<UTF8CHAR>(DebugLabel);
	ModuleDesc.label = { reinterpret_cast<const char*>(LabelUtf8.Get()), WGPU_STRLEN };

	return wgpuDeviceCreateShaderModule(Device, &ModuleDesc);
}

// Milestone step 1/2: real cooked WGSL keeps the real UE shader's own entry
// point name (e.g. "ScreenPassVS"/"CopyRectPS"), NOT the Stage 1 fixed
// "vs_main"/"fs_main" convention (see FDawnVertexShader/FDawnPixelShader
// ::EntryPoint in DawnResources.h). Scan for the real @vertex/@fragment
// attribute's following "fn <Name>(" -- this is real WGSL grammar (the
// attribute always immediately precedes the function it decorates), not a
// guess. Falls back to the old fixed name if not found, so the still-
// supported Stage 1/2 hand-authored WGSL paths (whose source has no
// @vertex/@fragment attribute at all -- see GVertexWGSL/GPixelWGSL in
// DawnRHITestMain.cpp) are unaffected.
static FString ParseWgslEntryPoint(const FString& Wgsl, const TCHAR* Attribute, const TCHAR* FallbackName)
{
	int32 AttrIdx = Wgsl.Find(Attribute);
	if (AttrIdx == INDEX_NONE)
	{
		return FallbackName;
	}
	int32 FnIdx = Wgsl.Find(TEXT("fn "), ESearchCase::CaseSensitive, ESearchDir::FromStart, AttrIdx);
	if (FnIdx == INDEX_NONE)
	{
		return FallbackName;
	}
	int32 NameStart = FnIdx + 3;
	int32 ParenIdx = Wgsl.Find(TEXT("("), ESearchCase::CaseSensitive, ESearchDir::FromStart, NameStart);
	if (ParenIdx == INDEX_NONE || ParenIdx <= NameStart)
	{
		return FallbackName;
	}
	return Wgsl.Mid(NameStart, ParenIdx - NameStart).TrimStartAndEnd();
}

// Parse @group(G) @binding(B) var[<addrspace>] name : type; declarations out of the
// cooked WGSL so the PSO bind-group layout matches EXACTLY what each shader declares
// (the old fixed {UB@0,Tex@1,Sampler@2} table mismatched real Slate shaders -> Dawn
// "Number of entries did not match" -> nothing drew). Runtime-side reflection; the
// WGSL is well-formed tint output.
static void ParseWgslBindings(const FString& Wgsl, TArray<FDawnShaderBinding>& Out)
{
	int32 Pos = 0;
	while (true)
	{
		int32 G = Wgsl.Find(TEXT("@group("), ESearchCase::CaseSensitive, ESearchDir::FromStart, Pos);
		if (G == INDEX_NONE) { break; }
		Pos = G + 7;
		int32 GEnd = Wgsl.Find(TEXT(")"), ESearchCase::CaseSensitive, ESearchDir::FromStart, Pos);
		if (GEnd == INDEX_NONE) { break; }
		const uint32 Group = (uint32)FCString::Atoi(*Wgsl.Mid(Pos, GEnd - Pos));
		int32 B = Wgsl.Find(TEXT("@binding("), ESearchCase::CaseSensitive, ESearchDir::FromStart, GEnd);
		if (B == INDEX_NONE) { break; }
		int32 BStart = B + 9;
		int32 BEnd = Wgsl.Find(TEXT(")"), ESearchCase::CaseSensitive, ESearchDir::FromStart, BStart);
		if (BEnd == INDEX_NONE) { break; }
		const uint32 Binding = (uint32)FCString::Atoi(*Wgsl.Mid(BStart, BEnd - BStart));
		// Declaration body: from here to the next ';'.
		int32 Semi = Wgsl.Find(TEXT(";"), ESearchCase::CaseSensitive, ESearchDir::FromStart, BEnd);
		if (Semi == INDEX_NONE) { break; }
		const FString Decl = Wgsl.Mid(BEnd, Semi - BEnd);
		Pos = Semi;
		EDawnShaderBindingKind Kind;
		if (Decl.Contains(TEXT("texture_"), ESearchCase::CaseSensitive)) { Kind = EDawnShaderBindingKind::Texture; }
		else if (Decl.Contains(TEXT(": sampler"), ESearchCase::CaseSensitive) || Decl.Contains(TEXT(":sampler"), ESearchCase::CaseSensitive) || Decl.Contains(TEXT("sampler_"), ESearchCase::CaseSensitive)) { Kind = EDawnShaderBindingKind::Sampler; }
		else if (Decl.Contains(TEXT("var<uniform>"), ESearchCase::CaseSensitive)) { Kind = EDawnShaderBindingKind::UniformBuffer; }
		else if (Decl.Contains(TEXT("var<storage"), ESearchCase::CaseSensitive)) { Kind = EDawnShaderBindingKind::UniformBuffer; }
		else { continue; } // unknown resource kind at this group/binding - skip (don't fabricate)
		bool bDup = false;
		for (const FDawnShaderBinding& E : Out) { if (E.Group == Group && E.Binding == Binding) { bDup = true; break; } }
		// Variable name: the identifier after 'var'/'var<...>' and before ':'.
		FString VarName;
		{
			int32 VarPos = Decl.Find(TEXT("var"), ESearchCase::CaseSensitive);
			if (VarPos != INDEX_NONE)
			{
				int32 Q = VarPos + 3;
				if (Q < Decl.Len() && Decl[Q] == TEXT('<')) { int32 C = Decl.Find(TEXT(">"), ESearchCase::CaseSensitive, ESearchDir::FromStart, Q); if (C != INDEX_NONE) { Q = C + 1; } }
				while (Q < Decl.Len() && FChar::IsWhitespace(Decl[Q])) { ++Q; }
				int32 NameStart = Q;
				while (Q < Decl.Len() && (FChar::IsAlnum(Decl[Q]) || Decl[Q] == TEXT('_'))) { ++Q; }
				VarName = Decl.Mid(NameStart, Q - NameStart);
			}
		}
		if (!bDup) { FDawnShaderBinding NB; NB.Group = Group; NB.Binding = Binding; NB.Kind = Kind; NB.Name = VarName; Out.Add(NB); }
	}
}

FPixelShaderRHIRef FDawnDynamicRHI::RHICreatePixelShader(const FRHICreateShaderDesc& CreateShaderDesc)
{
	FDawnPixelShader* Shader = new FDawnPixelShader();
	UE_LOG(LogDawnRHI, Warning, TEXT("PSNEW ptr=%p bindings=%d"), (void*)Shader, Shader->Bindings.Num());
	{ FShaderCodeReader R(CreateShaderDesc.Code); Shader->WGSLSource = FUTF8ToTCHAR(reinterpret_cast<const ANSICHAR*>(CreateShaderDesc.Code.GetData()), (int32)R.GetActualShaderCodeSize()).Get(); }
	// Remap the PS to @group(1) so its resources do NOT collide with the VS @group(0)
	// @binding(0) (independent HLSL->WGSL compilation gives both stages a @group(0)
	// @binding(0) uniform buffer; merged, the PS gamma overwrote the VS ViewProjection).
	Shader->EntryPoint = ParseWgslEntryPoint(Shader->WGSLSource, TEXT("@fragment"), TEXT("fs_main"));
	ParseWgslBindings(Shader->WGSLSource, Shader->Bindings);
	Shader->ShaderModule = CompileWGSL(Device, CreateShaderDesc, TEXT("DawnRHI.PixelShader"));
	checkf(Shader->ShaderModule, TEXT("DawnRHI: pixel shader WGSL compile failed"));
	return Shader;
}

FVertexShaderRHIRef FDawnDynamicRHI::RHICreateVertexShader(const FRHICreateShaderDesc& CreateShaderDesc)
{
	FDawnVertexShader* Shader = new FDawnVertexShader();
	UE_LOG(LogDawnRHI, Warning, TEXT("VSNEW ptr=%p bindings=%d"), (void*)Shader, Shader->Bindings.Num());
	{ FShaderCodeReader R(CreateShaderDesc.Code); Shader->WGSLSource = FUTF8ToTCHAR(reinterpret_cast<const ANSICHAR*>(CreateShaderDesc.Code.GetData()), (int32)R.GetActualShaderCodeSize()).Get(); }
	Shader->EntryPoint = ParseWgslEntryPoint(Shader->WGSLSource, TEXT("@vertex"), TEXT("vs_main"));
	ParseWgslBindings(Shader->WGSLSource, Shader->Bindings);
	Shader->ShaderModule = CompileWGSL(Device, CreateShaderDesc, TEXT("DawnRHI.VertexShader"));
	checkf(Shader->ShaderModule, TEXT("DawnRHI: vertex shader WGSL compile failed"));
	return Shader;
}

FGraphicsPipelineStateRHIRef FDawnDynamicRHI::RHICreateGraphicsPipelineState(const FGraphicsPipelineStateInitializer& Initializer)
{
	FDawnVertexShader* VS = static_cast<FDawnVertexShader*>(Initializer.BoundShaderState.VertexShaderRHI);
	FDawnPixelShader* PS = static_cast<FDawnPixelShader*>(Initializer.BoundShaderState.PixelShaderRHI);
	FDawnVertexDeclaration* VertexDecl = static_cast<FDawnVertexDeclaration*>(Initializer.BoundShaderState.VertexDeclarationRHI);
	checkf(VS && PS, TEXT("DawnRHI: PSO requires vertex+pixel shaders (Stage 1 scope)"));
	UE_LOG(LogDawnRHI, Warning, TEXT("PSOUSE vs=%p ps=%p vsB=%d psB=%d vsMod=%p psMod=%p vsSrc=%d"), (void*)VS, (void*)PS, VS->Bindings.Num(), PS->Bindings.Num(), (void*)VS->ShaderModule, (void*)PS->ShaderModule, VS->WGSLSource.Len());
	{ FRHIVertexShader* VSb = Initializer.BoundShaderState.VertexShaderRHI; FRHIPixelShader* PSb = Initializer.BoundShaderState.PixelShaderRHI; UE_LOG(LogDawnRHI, Warning, TEXT("PSOFREQ vsFreq=%d psFreq=%d"), VSb?(int)VSb->GetFrequency():-1, PSb?(int)PSb->GetFrequency():-1); }

	// Vertex buffer layout (single stream 0) derived from the vertex declaration.
	TArray<WGPUVertexAttribute> Attributes;
	uint64 Stride = 0;
	if (VertexDecl)
	{
		for (const FVertexElement& Elem : VertexDecl->Elements)
		{
			WGPUVertexAttribute Attr = {};
			Attr.format = DawnVertexFormatFromElementType((EVertexElementType)Elem.Type.GetValue());
			Attr.offset = Elem.Offset;
			Attr.shaderLocation = Elem.AttributeIndex;
			Attributes.Add(Attr);
			Stride = FMath::Max<uint64>(Stride, Elem.Stride);
			{ static uint32 _vd=0; if(_vd++<24) UE_LOG(LogTemp, Warning, TEXT("VTXDIAG type=%d off=%u stride=%u attr=%u wgpufmt=%d"), (int)Elem.Type.GetValue(), (uint32)Elem.Offset, (uint32)Elem.Stride, (uint32)Elem.AttributeIndex, (int)Attr.format); }
		}
		{ static uint32 _vs=0; if(_vs++<6) UE_LOG(LogTemp, Warning, TEXT("VTXDIAG === computed arrayStride=%llu attrs=%d"), (unsigned long long)Stride, Attributes.Num()); }
	}

	WGPUVertexBufferLayout BufferLayout = {};
	BufferLayout.arrayStride = Stride;
	BufferLayout.stepMode = WGPUVertexStepMode_Vertex;
	BufferLayout.attributeCount = Attributes.Num();
	BufferLayout.attributes = Attributes.GetData();

	// Blend state: WITHOUT this ColorTarget.blend stays null -> opaque write, so
	// any alpha-blended draw (Slate text emits rgb=white, alpha=glyph-coverage) loses
	// its coverage and paints solid white quads. Translate the RHI blend state
	// (Initializer.BlendState -> FDawnBlendState) to a WGPUBlendState. Opaque states
	// (One/Zero/Add) round-trip to an equivalent no-op blend, so always set it.
	auto ToWgpuFactor = [](EBlendFactor F) -> WGPUBlendFactor
	{
		switch (F)
		{
		case BF_Zero:                      return WGPUBlendFactor_Zero;
		case BF_One:                       return WGPUBlendFactor_One;
		case BF_SourceColor:               return WGPUBlendFactor_Src;
		case BF_InverseSourceColor:        return WGPUBlendFactor_OneMinusSrc;
		case BF_SourceAlpha:               return WGPUBlendFactor_SrcAlpha;
		case BF_InverseSourceAlpha:        return WGPUBlendFactor_OneMinusSrcAlpha;
		case BF_DestAlpha:                 return WGPUBlendFactor_DstAlpha;
		case BF_InverseDestAlpha:          return WGPUBlendFactor_OneMinusDstAlpha;
		case BF_DestColor:                 return WGPUBlendFactor_Dst;
		case BF_InverseDestColor:          return WGPUBlendFactor_OneMinusDst;
		case BF_ConstantBlendFactor:       return WGPUBlendFactor_Constant;
		case BF_InverseConstantBlendFactor:return WGPUBlendFactor_OneMinusConstant;
		case BF_Source1Color:              return WGPUBlendFactor_Src1;
		case BF_InverseSource1Color:       return WGPUBlendFactor_OneMinusSrc1;
		case BF_Source1Alpha:              return WGPUBlendFactor_Src1Alpha;
		case BF_InverseSource1Alpha:       return WGPUBlendFactor_OneMinusSrc1Alpha;
		default:                           return WGPUBlendFactor_One;
		}
	};
	auto ToWgpuOp = [](EBlendOperation O) -> WGPUBlendOperation
	{
		switch (O)
		{
		case BO_Add:             return WGPUBlendOperation_Add;
		case BO_Subtract:        return WGPUBlendOperation_Subtract;
		case BO_ReverseSubtract: return WGPUBlendOperation_ReverseSubtract;
		case BO_Min:             return WGPUBlendOperation_Min;
		case BO_Max:             return WGPUBlendOperation_Max;
		default:                 return WGPUBlendOperation_Add;
		}
	};
	FBlendStateInitializerRHI::FRenderTarget RT0;
	if (FDawnBlendState* BS = static_cast<FDawnBlendState*>(Initializer.BlendState))
	{
		RT0 = BS->Initializer.RenderTargets[0];
	}
	WGPUBlendState BlendState = {};
	BlendState.color.operation = ToWgpuOp(RT0.ColorBlendOp);
	BlendState.color.srcFactor = ToWgpuFactor(RT0.ColorSrcBlend);
	BlendState.color.dstFactor = ToWgpuFactor(RT0.ColorDestBlend);
	BlendState.alpha.operation = ToWgpuOp(RT0.AlphaBlendOp);
	BlendState.alpha.srcFactor = ToWgpuFactor(RT0.AlphaSrcBlend);
	BlendState.alpha.dstFactor = ToWgpuFactor(RT0.AlphaDestBlend);
	WGPUColorWriteMask WriteMask = WGPUColorWriteMask_None;
	if (RT0.ColorWriteMask & CW_RED)   { WriteMask |= WGPUColorWriteMask_Red; }
	if (RT0.ColorWriteMask & CW_GREEN) { WriteMask |= WGPUColorWriteMask_Green; }
	if (RT0.ColorWriteMask & CW_BLUE)  { WriteMask |= WGPUColorWriteMask_Blue; }
	if (RT0.ColorWriteMask & CW_ALPHA) { WriteMask |= WGPUColorWriteMask_Alpha; }
	{ static uint32 _bd=0; if(_bd++<8) UE_LOG(LogDawnRHI, Warning, TEXT("BLENDDIAG cOp=%d cSrc=%d cDst=%d aSrc=%d aDst=%d mask=%d"), (int)RT0.ColorBlendOp, (int)RT0.ColorSrcBlend, (int)RT0.ColorDestBlend, (int)RT0.AlphaSrcBlend, (int)RT0.AlphaDestBlend, (int)RT0.ColorWriteMask); }

	WGPUColorTargetState ColorTarget = {};
	ColorTarget.format = DawnTextureFormatFromPixelFormat((EPixelFormat)Initializer.RenderTargetFormats[0]);
	ColorTarget.writeMask = WriteMask;
	ColorTarget.blend = &BlendState;

	WGPUFragmentState FragState = {};
	FragState.module = PS->ShaderModule;
	auto FsEntry = StringCast<UTF8CHAR>(*PS->EntryPoint);
	FragState.entryPoint = { reinterpret_cast<const char*>(FsEntry.Get()), (size_t)FsEntry.Length() };
	FragState.targetCount = 1;
	FragState.targets = &ColorTarget;

	// Milestone step 1 (+ this session's multi-@group fix): reflection-driven
	// bind group layout(s), one WGPUBindGroupLayout PER real reflected
	// FDawnShaderBinding::Group value (not just @group(0) — see the NOTE on
	// FDawnGraphicsPipelineState::BindGroupLayouts in DawnResources.h for why
	// this changed and what's actually been exercised by real content so
	// far). If either shader carries real reflected bindings
	// (FDawnVertexShader/FDawnPixelShader::Bindings, populated from the real
	// cooked SPIR-V — see DawnResources.h/DawnShaderCompiler.cpp), build the
	// layout(s) from THAT (real @group/@binding numbers, real resource
	// kinds) instead of the old fixed {UB@0,Texture@1,Sampler@2} table.
	// Falls back to the fixed single-@group(0) table only when neither
	// shader has reflection data — the Stage 1/2 hand-authored WGSL test
	// paths (DawnRHITestMain's synthetic scene_vs/scene_ps) still rely on
	// that fixed convention by construction and never populate ::Bindings.
	TMap<uint32, TArray<WGPUBindGroupLayoutEntry>> EntriesByGroup;
	auto AppendShaderBindings = [&EntriesByGroup](const TArray<FDawnShaderBinding>& Bindings, WGPUShaderStage Stage)
	{
		for (const FDawnShaderBinding& B : Bindings)
		{
			TArray<WGPUBindGroupLayoutEntry>& LayoutEntries = EntriesByGroup.FindOrAdd(B.Group);

			// Multiple shader stages can reflect the SAME @group/@binding
			// (e.g. a uniform buffer read by both VS and PS) — merge visibility
			// instead of adding a duplicate WGPUBindGroupLayoutEntry (Dawn
			// rejects a layout with two entries at the same binding number).
			bool bMerged = false;
			for (WGPUBindGroupLayoutEntry& Existing : LayoutEntries)
			{
				if (Existing.binding == B.Binding)
				{
					Existing.visibility |= Stage;
					bMerged = true;
					break;
				}
			}
			if (bMerged)
			{
				continue;
			}
			WGPUBindGroupLayoutEntry Entry = {};
			Entry.binding = B.Binding;
			Entry.visibility = Stage;
			switch (B.Kind)
			{
			case EDawnShaderBindingKind::UniformBuffer:
				Entry.buffer.type = WGPUBufferBindingType_Uniform;
				break;
			case EDawnShaderBindingKind::Texture:
				Entry.texture.sampleType = WGPUTextureSampleType_Float;
				Entry.texture.viewDimension = WGPUTextureViewDimension_2D;
				break;
			case EDawnShaderBindingKind::Sampler:
				Entry.sampler.type = WGPUSamplerBindingType_Filtering;
				break;
			default:
				continue; // unclassified resource kind — do not fabricate a layout entry
			}
			LayoutEntries.Add(Entry);
		}
	};
	// TEST (2026-08-15): shader reflection was never implemented (Bindings is
	// never populated) yet it reads as a garbage Num() -> forcing the intended
	// fixed {UB@0,Tex@1,Sampler@2} fallback. If this renders, garbage Bindings
	// was the sole blocker; if it still crashes, corruption is broader.
	AppendShaderBindings(VS->Bindings, WGPUShaderStage_Vertex);
	AppendShaderBindings(PS->Bindings, WGPUShaderStage_Fragment);
	{ static uint32 _vb=0; if(_vb++<3){ for(const FDawnShaderBinding&B:VS->Bindings) UE_LOG(LogTemp, Warning, TEXT("VBIND vs grp=%u bind=%u kind=%d"), B.Group, B.Binding, (int)B.Kind); for(const FDawnShaderBinding&B:PS->Bindings) UE_LOG(LogTemp, Warning, TEXT("VBIND ps grp=%u bind=%u kind=%d"), B.Group, B.Binding, (int)B.Kind); } }
	UE_LOG(LogDawnRHI, Warning, TEXT("PSODIAG vsB=%d psB=%d groups=%d"), VS->Bindings.Num(), PS->Bindings.Num(), EntriesByGroup.Num());
	for (const TPair<uint32, TArray<WGPUBindGroupLayoutEntry>>& P : EntriesByGroup) { for (const WGPUBindGroupLayoutEntry& E : P.Value) { UE_LOG(LogDawnRHI, Warning, TEXT("PSODIAG   grp=%u binding=%u"), P.Key, E.binding); } }

	if (EntriesByGroup.Num() == 0)
	{
		// No reflection data on either shader — fall back to Stage 2's
		// original fixed convention (see the NOTE on
		// FDawnGraphicsPipelineState::BindGroupLayouts in DawnResources.h).
		WGPUBindGroupLayoutEntry FixedLayoutEntries[3] = {};
		FixedLayoutEntries[0].binding = 0;
		FixedLayoutEntries[0].visibility = WGPUShaderStage_Vertex | WGPUShaderStage_Fragment;
		FixedLayoutEntries[0].buffer.type = WGPUBufferBindingType_Uniform;
		FixedLayoutEntries[1].binding = 1;
		FixedLayoutEntries[1].visibility = WGPUShaderStage_Fragment;
		FixedLayoutEntries[1].texture.sampleType = WGPUTextureSampleType_Float;
		FixedLayoutEntries[1].texture.viewDimension = WGPUTextureViewDimension_2D;
		FixedLayoutEntries[2].binding = 2;
		FixedLayoutEntries[2].visibility = WGPUShaderStage_Fragment;
		FixedLayoutEntries[2].sampler.type = WGPUSamplerBindingType_Filtering;
		EntriesByGroup.Add(0).Append(FixedLayoutEntries, 3);
	}

	// WGPUPipelineLayoutDescriptor::bindGroupLayouts is positional — index i
	// in that array IS @group(i) as far as Dawn/the shader is concerned — so
	// every group index from 0 up to the highest real reflected group must
	// have an entry, even if some intermediate group index was never
	// reflected by either shader (an empty WGPUBindGroupLayout, 0 entries,
	// is valid and simply means "nothing bound at this group").
	uint32 MaxGroup = 0;
	for (const TPair<uint32, TArray<WGPUBindGroupLayoutEntry>>& Pair : EntriesByGroup)
	{
		MaxGroup = FMath::Max(MaxGroup, Pair.Key);
	}

	TArray<WGPUBindGroupLayout> BindGroupLayouts;
	BindGroupLayouts.SetNum(MaxGroup + 1);
	for (uint32 Group = 0; Group <= MaxGroup; ++Group)
	{
		const TArray<WGPUBindGroupLayoutEntry>* GroupEntries = EntriesByGroup.Find(Group);
		WGPUBindGroupLayoutDescriptor BglDesc = {};
		if (GroupEntries)
		{
			BglDesc.entryCount = GroupEntries->Num();
			BglDesc.entries = GroupEntries->GetData();
		}
		BindGroupLayouts[Group] = wgpuDeviceCreateBindGroupLayout(Device, &BglDesc);
	}

	WGPUPipelineLayoutDescriptor PlDesc = {};
	PlDesc.bindGroupLayoutCount = BindGroupLayouts.Num();
	PlDesc.bindGroupLayouts = BindGroupLayouts.GetData();
	WGPUPipelineLayout PipelineLayout = wgpuDeviceCreatePipelineLayout(Device, &PlDesc);

	WGPUDepthStencilState DepthStencil = {};
	bool bHasDepth = Initializer.DepthStencilTargetFormat != PF_Unknown;
	if (bHasDepth)
	{
		FDawnDepthStencilState* DSState = static_cast<FDawnDepthStencilState*>(Initializer.DepthStencilState);
		DepthStencil.format = DawnDepthStencilFormat();
		DepthStencil.depthWriteEnabled = DSState ? (DSState->Initializer.bEnableDepthWrite ? WGPUOptionalBool_True : WGPUOptionalBool_False) : WGPUOptionalBool_True;
		DepthStencil.depthCompare = DSState ? DawnCompareFunctionFromRHI(DSState->Initializer.DepthTest) : WGPUCompareFunction_LessEqual;
		DepthStencil.stencilFront.compare = WGPUCompareFunction_Always;
		DepthStencil.stencilBack.compare = WGPUCompareFunction_Always;
		DepthStencil.stencilReadMask = 0xFF;
		DepthStencil.stencilWriteMask = 0xFF;
	}

	WGPURenderPipelineDescriptor PipeDesc = {};
	PipeDesc.layout = PipelineLayout;
	PipeDesc.vertex.module = VS->ShaderModule;
	auto VsEntry = StringCast<UTF8CHAR>(*VS->EntryPoint);
	PipeDesc.vertex.entryPoint = { reinterpret_cast<const char*>(VsEntry.Get()), (size_t)VsEntry.Length() };
	if (Attributes.Num() > 0)
	{
		PipeDesc.vertex.bufferCount = 1;
		PipeDesc.vertex.buffers = &BufferLayout;
	}
	PipeDesc.primitive.topology = WGPUPrimitiveTopology_TriangleList;
	PipeDesc.multisample.count = 1;
	PipeDesc.multisample.mask = 0xFFFFFFFF;
	PipeDesc.fragment = &FragState;
	if (bHasDepth)
	{
		PipeDesc.depthStencil = &DepthStencil;
	}

	WGPURenderPipeline Pipeline = wgpuDeviceCreateRenderPipeline(Device, &PipeDesc);
	checkf(Pipeline, TEXT("DawnRHI: render pipeline creation failed"));

	FDawnGraphicsPipelineState* PSO = new FDawnGraphicsPipelineState();
	PSO->Pipeline = Pipeline;
	PSO->VertexShader = VS;
	PSO->PixelShader = PS;
	PSO->BindGroupLayouts = MoveTemp(BindGroupLayouts);
	PSO->PipelineLayout = PipelineLayout;
	return PSO;
}

FRHIBufferInitializer FDawnDynamicRHI::RHICreateBufferInitializer(FRHICommandListBase& RHICmdList, const FRHIBufferCreateDesc& InCreateDesc)
{
	// RHIValidation asserts every resource is created with a known initial
	// ERHIAccess state (matches VulkanRHI's FVulkanDynamicRHI::CreateBuffer,
	// which calls DetermineInitialState() before constructing the resource).
	FRHIBufferCreateDesc CreateDesc = InCreateDesc;
	CreateDesc.DetermineInitialState();

	TRefCountPtr<FDawnBuffer> NewBuffer = new FDawnBuffer(CreateDesc);

	WGPUBufferUsage Usage = WGPUBufferUsage_CopyDst;
	if (EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::VertexBuffer)) { Usage |= WGPUBufferUsage_Vertex; }
	if (EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::IndexBuffer))  { Usage |= WGPUBufferUsage_Index; }
	if (EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::UniformBuffer)) { Usage |= WGPUBufferUsage_Uniform; }

	WGPUBufferDescriptor BufDesc = {};
	BufDesc.usage = Usage;
	BufDesc.size = Align(FMath::Max<uint32>(CreateDesc.Size, 4), 4u);
	BufDesc.mappedAtCreation = true;

	WGPUBuffer Buffer = wgpuDeviceCreateBuffer(Device, &BufDesc);
	checkf(Buffer, TEXT("DawnRHI: buffer creation failed"));
	NewBuffer->Buffer = Buffer;
	NewBuffer->WgpuSize = (uint32)BufDesc.size;

	void* WritableData = wgpuBufferGetMappedRange(Buffer, 0, BufDesc.size);

	// NOTE: FRHIBufferInitializer::FFinalizeCallback is `protected` — only
	// nameable from a derived type (FDawnBufferInitializerHelper). From this
	// (non-derived) function we pass a bare lambda as the constructor
	// argument instead of spelling the protected alias out ourselves; it
	// converts implicitly at the call site.
	return FDawnBufferInitializerHelper(RHICmdList, NewBuffer.GetReference(), WritableData, BufDesc.size,
		[NewBuffer](FRHICommandListBase&) mutable -> FBufferRHIRef
		{
			wgpuBufferUnmap(NewBuffer->Buffer);
			return FBufferRHIRef(NewBuffer);
		});
}

void* FDawnDynamicRHI::RHILockBuffer(FRHICommandListBase& RHICmdList, FRHIBuffer* BufferRHI, uint32 Offset, uint32 Size, EResourceLockMode LockMode)
{
	// WebGPU buffer mapping is asynchronous (needs an event-loop pump), so CPU
	// access uses a staging allocation. Writes upload via wgpuQueueWriteBuffer on
	// unlock; read locks are zero-filled best-effort (init-time resources lock
	// write-only, which this handles exactly).
	FDawnBuffer* Buffer = static_cast<FDawnBuffer*>(BufferRHI);
	const uint64 Alloc = Align((uint64)FMath::Max<uint32>(Size, 4u), 4u);
	Buffer->LockOffset = Offset;
	Buffer->LockSize = Size;
	Buffer->LockStaging = FMemory::Malloc(Alloc);
	if (LockMode == RLM_ReadOnly)
	{
		FMemory::Memzero(Buffer->LockStaging, Alloc);
	}
	return Buffer->LockStaging;
}

void FDawnDynamicRHI::RHIUnlockBuffer(FRHICommandListBase& RHICmdList, FRHIBuffer* BufferRHI)
{
	FDawnBuffer* Buffer = static_cast<FDawnBuffer*>(BufferRHI);
	if (!Buffer->LockStaging)
	{
		return;
	}
	if (Buffer->Buffer && Buffer->LockSize > 0)
	{
		uint64 WriteSize = Align((uint64)Buffer->LockSize, 4u);
		if (Buffer->LockOffset + WriteSize > Buffer->WgpuSize)
		{
			WriteSize = (Buffer->WgpuSize > Buffer->LockOffset) ? (Buffer->WgpuSize - Buffer->LockOffset) : 0;
			WriteSize &= ~3ull; // keep 4-byte aligned
		}
		if (WriteSize > 0)
		{
			wgpuQueueWriteBuffer(Queue, Buffer->Buffer, Buffer->LockOffset, Buffer->LockStaging, (size_t)WriteSize);
		}
	}
	FMemory::Free(Buffer->LockStaging);
	Buffer->LockStaging = nullptr;
}

FRHITextureInitializer FDawnDynamicRHI::RHICreateTextureInitializer(FRHICommandListBase& RHICmdList, const FRHITextureCreateDesc& InCreateDesc)
{
	// Same DetermineInitialState() requirement as RHICreateBufferInitializer above.
	FRHITextureCreateDesc CreateDesc = InCreateDesc;
	if (CreateDesc.InitialState == ERHIAccess::Unknown)
	{
		CreateDesc.SetInitialState(RHIGetDefaultResourceState(CreateDesc.Flags, false));
	}

	UE_LOG(LogDawnRHI, Warning, TEXT("TEXDIAG entry: thread=%u gt=%d rt=%d"), FPlatformTLS::GetCurrentThreadId(), (int32)IsInGameThread(), (int32)IsInRenderingThread()); UE_LOG(LogDawnRHI, Warning, TEXT("TEXDIAG e2: fmt=%d %dx%d flags=0x%llx"), (int32)CreateDesc.Format, CreateDesc.Extent.X, CreateDesc.Extent.Y, (uint64)CreateDesc.Flags);
	TRefCountPtr<FDawnTexture> NewTexture = new FDawnTexture(CreateDesc);

	const bool bIsDepthStencil = EnumHasAnyFlags(CreateDesc.Flags, ETextureCreateFlags::DepthStencilTargetable);

	WGPUTextureUsage Usage = WGPUTextureUsage_CopySrc | WGPUTextureUsage_CopyDst;
	if (bIsDepthStencil)
	{
		Usage |= WGPUTextureUsage_RenderAttachment;
	}
	if (EnumHasAnyFlags(CreateDesc.Flags, ETextureCreateFlags::RenderTargetable))
	{
		Usage |= WGPUTextureUsage_RenderAttachment;
	}
	if (EnumHasAnyFlags(CreateDesc.Flags, ETextureCreateFlags::ShaderResource) || !bIsDepthStencil)
	{
		// Default non-depth textures to sampleable: most UE textures (incl. Slate's
		// font atlas, whose create desc omits an explicit ShaderResource flag) are
		// sampled, and WebGPU requires the usage bit up-front at creation.
		Usage |= WGPUTextureUsage_TextureBinding;
	}

	WGPUTextureDescriptor TexDesc = {};
	TexDesc.usage = Usage;
	TexDesc.dimension = WGPUTextureDimension_2D;
	TexDesc.size = { (uint32)CreateDesc.Extent.X, (uint32)CreateDesc.Extent.Y, 1 };
	TexDesc.format = bIsDepthStencil ? DawnDepthStencilFormat() : DawnTextureFormatFromPixelFormat(CreateDesc.Format);
	// Clamp mip count to what WebGPU allows for these dimensions
	// (floor(log2(max(w,h)))+1). A NumMips larger than the extent supports makes
	// the full-mip TextureView invalid -> "mip level count (N) is invalid" ->
	// invalid command buffer -> crash.
	{
		const uint32 _MaxDim = FMath::Max<uint32>(TexDesc.size.width, TexDesc.size.height);
		const uint32 _MaxMips = _MaxDim > 0 ? ((uint32)FMath::FloorLog2(_MaxDim) + 1u) : 1u;
		TexDesc.mipLevelCount = FMath::Clamp<uint32>((uint32)CreateDesc.NumMips, 1u, _MaxMips);
	}
	TexDesc.sampleCount = 1;

	UE_LOG(LogDawnRHI, Warning, TEXT("TEXDIAG desc: usage=0x%x wgpuFmt=%d dim=%d size=%ux%u mip=%u samp=%u ds=%d"), (uint32)TexDesc.usage, (int32)TexDesc.format, (int32)TexDesc.dimension, TexDesc.size.width, TexDesc.size.height, TexDesc.mipLevelCount, TexDesc.sampleCount, (int32)bIsDepthStencil);
	WGPUTexture Texture = wgpuDeviceCreateTexture(Device, &TexDesc);
	UE_LOG(LogDawnRHI, Warning, TEXT("TEXDIAG created: wgpuTex=%p wgpuFmt=%d"), (void*)Texture, (int32)TexDesc.format);
	checkf(Texture, TEXT("DawnRHI: texture creation failed"));
	NewTexture->Texture = Texture;
	NewTexture->View = wgpuTextureCreateView(Texture, nullptr);
	// Render-pass attachments require a single-mip view (WebGPU forbids binding a
	// multi-mip view as a color/depth attachment). Keep the full-mip View for
	// sampling; build a dedicated single-mip RTView for RT/depth binding.
	if (EnumHasAnyFlags(CreateDesc.Flags, ETextureCreateFlags::RenderTargetable | ETextureCreateFlags::DepthStencilTargetable))
	{
		WGPUTextureViewDescriptor _RtvDesc = {};
		_RtvDesc.format = TexDesc.format;
		_RtvDesc.dimension = WGPUTextureViewDimension_2D;
		_RtvDesc.baseMipLevel = 0;
		_RtvDesc.mipLevelCount = 1;
		_RtvDesc.baseArrayLayer = 0;
		_RtvDesc.arrayLayerCount = 1;
		_RtvDesc.aspect = WGPUTextureAspect_All;
		NewTexture->RTView = wgpuTextureCreateView(Texture, &_RtvDesc);
	}

	// Initial pixel data (Stage 2: sampled textures, e.g. a material/UI
	// texture). GetSubresourceCallback hands the caller a CPU-side staging
	// buffer to WriteData() into; FinalizeCallback uploads it via
	// wgpuQueueWriteTexture and frees the staging memory. WebGPU has no
	// buffer-style mappedAtCreation for textures, so this (rather than the
	// buffer path's direct-mapped-pointer trick) is the correct shape here.
	const uint32 Width = (uint32)CreateDesc.Extent.X;
	const uint32 Height = (uint32)CreateDesc.Extent.Y;
	// Block-aware staging size (handles wide formats like RGBA16F/RGBA32F and
	// BC/DXT compressed, not just 4-byte RGBA8). A hardcoded 4 bpp overflowed the
	// staging buffer for wider formats -> heap corruption on free.
	const FPixelFormatInfo& InitFmt = GPixelFormats[CreateDesc.Format];
	const uint32 NumBlocksX = FMath::DivideAndRoundUp(Width, (uint32)FMath::Max<int32>(1, InitFmt.BlockSizeX));
	const uint32 NumBlocksY = FMath::DivideAndRoundUp(Height, (uint32)FMath::Max<int32>(1, InitFmt.BlockSizeY));
	const uint32 RowPitch = NumBlocksX * (uint32)InitFmt.BlockBytes;
	const uint64 StagingSize = (uint64)RowPitch * NumBlocksY;
	const bool bInitCompressed = InitFmt.BlockSizeX > 1; // Apple WebGPU has no BC support
	TSharedPtr<TArray<uint8>> Staging = MakeShared<TArray<uint8>>();

	// NOTE: same protected-typedef situation as FFinalizeCallback above —
	// FGetSubresourceCallback can't be named from this (non-derived)
	// function, so both lambdas below are passed as bare arguments rather
	// than assigned to a named variable of that type first.
	WGPUQueue QueueCopy = Queue;
	return FDawnTextureInitializerHelper(RHICmdList, NewTexture.GetReference(),
		[NewTexture, Staging, Width, Height, RowPitch, NumBlocksY, bInitCompressed, QueueCopy](FRHICommandListBase&) mutable -> FTextureRHIRef
		{
			if (Staging->Num() > 0 && !bInitCompressed)
			{
				WGPUTexelCopyTextureInfo Dst = {};
				Dst.texture = NewTexture->Texture;
				WGPUTexelCopyBufferLayout Layout = {};
				Layout.bytesPerRow = RowPitch;
				Layout.rowsPerImage = NumBlocksY;
				WGPUExtent3D Size = { Width, Height, 1 };
				wgpuQueueWriteTexture(QueueCopy, &Dst, Staging->GetData(), Staging->Num(), &Layout, &Size);
			}
			return FTextureRHIRef(NewTexture);
		},
		[Staging, StagingSize, RowPitch](FRHITextureInitializer::FSubresourceIndex) -> FRHITextureSubresourceInitializer
		{
			Staging->SetNumUninitialized((int64)StagingSize);
			FRHITextureSubresourceInitializer SubresourceInit;
			SubresourceInit.Data = Staging->GetData();
			SubresourceInit.Size = StagingSize;
			SubresourceInit.Stride = RowPitch;
			return SubresourceInit;
		});
}

uint32 FDawnDynamicRHI::RHIComputeMemorySize(FRHITexture* TextureRHI)
{
	if (!TextureRHI) { return 0; }
	const FRHITextureDesc& Desc = TextureRHI->GetDesc();
	return Desc.Extent.X * Desc.Extent.Y * 4;
}

void FDawnDynamicRHI::RHIReadSurfaceData(FRHITexture* Texture, FIntRect Rect, TArray<FColor>& OutData, FReadSurfaceDataFlags InFlags)
{
	FDawnTexture* Tex = static_cast<FDawnTexture*>(Texture);
	checkf(Tex && Tex->Texture, TEXT("DawnRHI: RHIReadSurfaceData needs a valid Dawn texture"));

	const uint32 Width = Rect.Width();
	const uint32 Height = Rect.Height();
	const uint32 BytesPerRow = Align(Width * 4, 256);

	WGPUBufferDescriptor BufDesc = {};
	BufDesc.usage = WGPUBufferUsage_CopyDst | WGPUBufferUsage_MapRead;
	BufDesc.size = BytesPerRow * Height;
	WGPUBuffer ReadbackBuf = wgpuDeviceCreateBuffer(Device, &BufDesc);

	WGPUCommandEncoderDescriptor EncDesc = {};
	WGPUCommandEncoder Encoder = wgpuDeviceCreateCommandEncoder(Device, &EncDesc);

	WGPUTexelCopyTextureInfo SrcTex = {};
	SrcTex.texture = Tex->Texture;
	SrcTex.origin = { (uint32)Rect.Min.X, (uint32)Rect.Min.Y, 0 };
	WGPUTexelCopyBufferInfo DstBuf = {};
	DstBuf.buffer = ReadbackBuf;
	DstBuf.layout.bytesPerRow = BytesPerRow;
	DstBuf.layout.rowsPerImage = Height;
	WGPUExtent3D CopySize = { Width, Height, 1 };
	wgpuCommandEncoderCopyTextureToBuffer(Encoder, &SrcTex, &DstBuf, &CopySize);

	WGPUCommandBufferDescriptor CbDesc = {};
	WGPUCommandBuffer CmdBuf = wgpuCommandEncoderFinish(Encoder, &CbDesc);
	wgpuQueueSubmit(Queue, 1, &CmdBuf);
	wgpuCommandEncoderRelease(Encoder);
	wgpuCommandBufferRelease(CmdBuf);

	bool bMapped = false;
	WGPUBufferMapCallbackInfo MapCbInfo = {};
	MapCbInfo.mode = WGPUCallbackMode_AllowSpontaneous;
	MapCbInfo.callback = [](WGPUMapAsyncStatus, WGPUStringView, void* Userdata1, void*)
	{
		*reinterpret_cast<bool*>(Userdata1) = true;
	};
	MapCbInfo.userdata1 = &bMapped;
	WGPUFuture MapFuture = wgpuBufferMapAsync(ReadbackBuf, WGPUMapMode_Read, 0, BufDesc.size, MapCbInfo);
	(void)MapFuture;
	for (int32 i = 0; i < 200000 && !bMapped; ++i)
	{
#if DAWNRHI_WASM
		emscripten_sleep(1);
#else
		WGPUFutureWaitInfo WaitInfo = {};
		WaitInfo.future = MapFuture;
		wgpuInstanceWaitAny(Instance, 1, &WaitInfo, 1000000);
#endif
	}
	checkf(bMapped, TEXT("DawnRHI: readback buffer never mapped"));

	const uint8* Mapped = reinterpret_cast<const uint8*>(wgpuBufferGetConstMappedRange(ReadbackBuf, 0, BufDesc.size));
	OutData.SetNumUninitialized(Width * Height);
	for (uint32 Y = 0; Y < Height; ++Y)
	{
		const uint8* Row = Mapped + Y * BytesPerRow;
		for (uint32 X = 0; X < Width; ++X)
		{
			OutData[Y * Width + X] = FColor(Row[X * 4 + 0], Row[X * 4 + 1], Row[X * 4 + 2], Row[X * 4 + 3]);
		}
	}
	wgpuBufferUnmap(ReadbackBuf);
	wgpuBufferRelease(ReadbackBuf);
}

void FDawnDynamicRHI::RHIBlockUntilGPUIdle()
{
	WaitForQueueIdle(Instance, Queue);
}

