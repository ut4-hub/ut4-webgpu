FShaderResourceViewRHIRef FDawnDynamicRHI::RHICreateShaderResourceView(class FRHICommandListBase& RHICmdList, FRHIViewableResource* Resource, FRHIViewDesc const& ViewDesc)
{
	FDawnShaderResourceView* SRV = new FDawnShaderResourceView(Resource, ViewDesc);
	if (ViewDesc.Common.ViewType == FRHIViewDesc::EViewType::TextureSRV)
	{
		FDawnTexture* Tex = static_cast<FDawnTexture*>(static_cast<FRHITexture*>(Resource));
		SRV->TextureView = Tex ? Tex->View : nullptr;
	}
	else
	{
		FDawnBuffer* Buf = static_cast<FDawnBuffer*>(static_cast<FRHIBuffer*>(Resource));
		if (Buf) { SRV->Buffer = Buf->Buffer; SRV->BufferSize = Buf->WgpuSize; }
	}
	return SRV;
}

FUnorderedAccessViewRHIRef FDawnDynamicRHI::RHICreateUnorderedAccessView(class FRHICommandListBase& RHICmdList, FRHIViewableResource* Resource, FRHIViewDesc const& ViewDesc)
{
	FDawnUnorderedAccessView* UAV = new FDawnUnorderedAccessView(Resource, ViewDesc);
	if (ViewDesc.Common.ViewType == FRHIViewDesc::EViewType::TextureUAV)
	{
		FDawnTexture* Tex = static_cast<FDawnTexture*>(static_cast<FRHITexture*>(Resource));
		UAV->TextureView = Tex ? Tex->View : nullptr;
	}
	else
	{
		FDawnBuffer* Buf = static_cast<FDawnBuffer*>(static_cast<FRHIBuffer*>(Resource));
		if (Buf) { UAV->Buffer = Buf->Buffer; UAV->BufferSize = Buf->WgpuSize; }
	}
	return UAV;
}

FRHILockTextureResult FDawnDynamicRHI::RHILockTexture(FRHICommandListImmediate& RHICmdList, const FRHILockTextureArgs& Arguments)
{
	// Write path: hand back a CPU staging allocation for the requested mip; the
	// matching RHIUnlockTexture uploads it via wgpuQueueWriteTexture. (Read locks
	// would need async mapping; write is what texture streaming/UI updates use.)
	FDawnTexture* Tex = static_cast<FDawnTexture*>(Arguments.Texture);
	const FRHITextureDesc& Desc = Tex->GetDesc();
	const FPixelFormatInfo& FmtInfo = GPixelFormats[Desc.Format];
	const uint32 MipW = FMath::Max<uint32>(1u, (uint32)Desc.Extent.X >> Arguments.MipIndex);
	const uint32 MipH = FMath::Max<uint32>(1u, (uint32)Desc.Extent.Y >> Arguments.MipIndex);
	// Block-aware size (handles BC/DXT compressed formats, not just 4-byte RGBA/BGRA).
	const uint32 NumBlocksX = FMath::DivideAndRoundUp(MipW, (uint32)FmtInfo.BlockSizeX);
	const uint32 NumBlocksY = FMath::DivideAndRoundUp(MipH, (uint32)FmtInfo.BlockSizeY);
	const uint32 Stride = NumBlocksX * (uint32)FmtInfo.BlockBytes;
	const uint64 Size = (uint64)Stride * NumBlocksY;
	Tex->LockStaging = FMemory::Malloc(FMath::Max<uint64>(Size, 4));
	Tex->LockMip = Arguments.MipIndex;
	Tex->LockW = MipW; Tex->LockH = MipH; Tex->LockStride = Stride; Tex->LockSize = Size;
	Tex->LockRows = NumBlocksY; Tex->LockBlockX = (uint32)FmtInfo.BlockSizeX;
	FRHILockTextureResult Result;
	Result.Data = Tex->LockStaging;
	Result.Stride = Stride;
	Result.ByteCount = Size;
	return Result;
}

void FDawnDynamicRHI::RHIUnlockTexture(FRHICommandListImmediate& RHICmdList, const FRHILockTextureArgs& Arguments)
{
	FDawnTexture* Tex = static_cast<FDawnTexture*>(Arguments.Texture);
	if (!Tex->LockStaging)
	{
		return;
	}
	if (Tex->Texture && Tex->LockSize > 0)
	{
		WGPUTexelCopyTextureInfo Dst = {};
		Dst.texture = Tex->Texture;
		Dst.mipLevel = Tex->LockMip;
		WGPUTexelCopyBufferLayout Layout = {};
		Layout.bytesPerRow = Tex->LockStride;
		Layout.rowsPerImage = Tex->LockRows;
		WGPUExtent3D WriteExtent = { Tex->LockW, Tex->LockH, 1 };
		// Skip block-compressed uploads: Apple WebGPU has no BC support, so such
		// textures were created as RGBA8 and their BC data cannot be written.
		if (Tex->LockBlockX <= 1)
		{
			if (Tex->LockStride >= Tex->LockW && Tex->LockW > 0 && Tex->LockH > 0 && (Tex->LockStride / Tex->LockW) == 1) { static uint32 _uc=0; if (_uc++ < 12) { const uint8* B=(const uint8*)Tex->LockStaging; uint32 mn=255,mx=0,nz=0; uint64 sum=0,cnt=0; for (uint32 ry=0; ry<Tex->LockH; ++ry){ const uint8* R=B+(uint64)ry*Tex->LockStride; for (uint32 rx=0; rx<Tex->LockW; ++rx){ uint8 v=R[rx]; mn=FMath::Min<uint32>(mn,v); mx=FMath::Max<uint32>(mx,v); if(v>0)++nz; sum+=v; ++cnt; } } UE_LOG(LogDawnRHI, Warning, TEXT("FONTUNLOCK fmt=%d WxH=%ux%u stride=%u min=%u max=%u avg=%llu nz=%u/%llu"), (int)Tex->GetDesc().Format, Tex->LockW, Tex->LockH, Tex->LockStride, mn, mx, cnt?sum/cnt:0, nz, (unsigned long long)cnt); } }
			if (Tex->GetDesc().Format == PF_A8)
			{
				// A8 has no WebGPU equivalent -> the texture is RGBA8Unorm. Expand the
				// 1-byte coverage into RGBA (all channels = coverage) so the Slate
				// grayscale-font shader (samples .w) reads the glyph coverage, not 1.0.
				const uint32 W = Tex->LockW, H = Tex->LockH;
				TArray<uint8> Rgba; Rgba.SetNumUninitialized((int32)(W * H * 4));
				const uint8* Sp = (const uint8*)Tex->LockStaging;
				for (uint32 y = 0; y < H; ++y)
				{
					const uint8* SR = Sp + (uint64)y * Tex->LockStride;
					uint8* DR = Rgba.GetData() + (uint64)y * W * 4;
					for (uint32 x = 0; x < W; ++x) { const uint8 Cov = SR[x]; DR[x*4+0]=Cov; DR[x*4+1]=Cov; DR[x*4+2]=Cov; DR[x*4+3]=Cov; }
				}
				WGPUTexelCopyBufferLayout L2 = {}; L2.bytesPerRow = W * 4; L2.rowsPerImage = H;
				wgpuQueueWriteTexture(Queue, &Dst, Rgba.GetData(), (size_t)Rgba.Num(), &L2, &WriteExtent);
			}
			else
			{
				wgpuQueueWriteTexture(Queue, &Dst, Tex->LockStaging, (size_t)Tex->LockSize, &Layout, &WriteExtent);
			}
		}
	}
	FMemory::Free(Tex->LockStaging);
	Tex->LockStaging = nullptr;
}

void FDawnDynamicRHI::RHIUpdateTexture2D(FRHICommandListBase& RHICmdList, FRHITexture* Texture, uint32 MipIndex, const struct FUpdateTextureRegion2D& UpdateRegion, uint32 SourcePitch, const uint8* SourceData)
{
	// Slate updates its font atlas and dynamic UI textures through this path every
	// frame; without it the whole front-end stays blank. Upload the dirty region
	// via wgpuQueueWriteTexture.
	FDawnTexture* Tex = static_cast<FDawnTexture*>(Texture);
	if (!Tex || !Tex->Texture || !SourceData || SourcePitch == 0 || UpdateRegion.Width == 0 || UpdateRegion.Height == 0)
	{
		return;
	}
	const FRHITextureDesc& Desc = Tex->GetDesc();
	const FPixelFormatInfo& Fmt = GPixelFormats[Desc.Format];
	if (Fmt.BlockSizeX > 1)
	{
		return; // block-compressed (created as RGBA8 substitute); no CPU BC upload
	}
	const uint32 BlockBytes = (uint32)Fmt.BlockBytes;
	const uint8* Src = SourceData + (uint64)UpdateRegion.SrcY * SourcePitch + (uint64)UpdateRegion.SrcX * BlockBytes;
	WGPUTexelCopyTextureInfo Dst = {};
	Dst.texture = Tex->Texture;
	Dst.mipLevel = MipIndex;
	Dst.origin = { UpdateRegion.DestX, UpdateRegion.DestY, 0 };
	WGPUTexelCopyBufferLayout Layout = {};
	Layout.bytesPerRow = SourcePitch;
	Layout.rowsPerImage = UpdateRegion.Height;
	WGPUExtent3D Size = { UpdateRegion.Width, UpdateRegion.Height, 1 };
	// Tight span WebGPU actually reads: rows are strided by SourcePitch but the LAST
	// row only needs Width*BlockBytes. Using SourcePitch*Height overreads past the
	// source buffer when the region sits at the atlas right/bottom edge (Slate font
	// atlas) -> wasm memory-access-out-of-bounds in wgpuQueueWriteTexture memcpy.
	const size_t DataSize = (size_t)SourcePitch * (size_t)(UpdateRegion.Height - 1) + (size_t)UpdateRegion.Width * (size_t)BlockBytes;
	if (BlockBytes == 1) { static uint32 _fc=0; if (_fc++ < 12) { uint32 mn=255,mx=0,nz=0; uint64 sum=0,cnt=0; for (uint32 ry=0; ry<UpdateRegion.Height; ++ry) { const uint8* R=Src+(uint64)ry*SourcePitch; for (uint32 rx=0; rx<UpdateRegion.Width; ++rx){ uint8 v=R[rx]; mn=FMath::Min<uint32>(mn,v); mx=FMath::Max<uint32>(mx,v); if(v>0)++nz; sum+=v; ++cnt; } } UE_LOG(LogDawnRHI, Warning, TEXT("FONTDIAG fmt=%d WxH=%ux%u min=%u max=%u avg=%llu nonzero=%u/%llu"), (int)Desc.Format, UpdateRegion.Width, UpdateRegion.Height, mn, mx, cnt?sum/cnt:0, nz, (unsigned long long)cnt); } }
	wgpuQueueWriteTexture(Queue, &Dst, Src, DataSize, &Layout, &Size);
}

