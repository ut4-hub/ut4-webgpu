FTextureRHIRef FDawnDynamicRHI::RHIGetViewportBackBuffer(FRHIViewport* ViewportRHI)
{
	FDawnViewport* Viewport = static_cast<FDawnViewport*>(ViewportRHI);
	// Release the surface texture from TWO frames ago now (presented last frame -> GPU done).
	if (Viewport->PrevSurfView) { wgpuTextureViewRelease(Viewport->PrevSurfView); Viewport->PrevSurfView = nullptr; }
	if (Viewport->PrevSurfTex)  { wgpuTextureRelease(Viewport->PrevSurfTex);       Viewport->PrevSurfTex  = nullptr; }
	if (Viewport->Surface)
	{
		WGPUSurfaceTexture SurfTex = {};
		wgpuSurfaceGetCurrentTexture(Viewport->Surface, &SurfTex);
		{ static uint32 _sf=0; if((_sf++%120)==0) UE_LOG(LogTemp, Warning, TEXT("SURFDIAG status=%d tex=%p surface=%p"), (int)SurfTex.status, (void*)SurfTex.texture, (void*)Viewport->Surface); }
		if (SurfTex.texture)
		{
			// PERSISTENT backbuffer: the engine caches the backbuffer ref and renders to it
			// every frame, so keep the SAME FDawnTexture object and just swap in this frame's
			// surface texture. Creating a fresh object each frame left the engine rendering to
			// a stale texture while the surface presented an empty one -> black screen.
			if (!Viewport->BackBuffer.IsValid())
			{
				FRHITextureCreateDesc Desc = FRHITextureCreateDesc::Create2D(TEXT("DawnBackBuffer"), Viewport->Width, Viewport->Height, PF_B8G8R8A8)
					.SetFlags(ETextureCreateFlags::RenderTargetable | ETextureCreateFlags::Presentable);
				Desc.SetInitialState(ERHIAccess::RTV);
				Viewport->BackBuffer = new FDawnTexture(Desc);
			}
			FDawnTexture* BB = static_cast<FDawnTexture*>(Viewport->BackBuffer.GetReference());
			// Defer release of the prior surface texture/view by one frame (avoids submit races).
			Viewport->PrevSurfView = BB->View;
			Viewport->PrevSurfTex  = BB->Texture;
			BB->Texture = SurfTex.texture;
			BB->bOwnsTexture = false; // lifetime managed manually via the PrevSurf* deferral
			BB->View = wgpuTextureCreateView(SurfTex.texture, nullptr);
		}
	}
	return Viewport->BackBuffer.GetReference();
}

FViewportRHIRef FDawnDynamicRHI::RHICreateViewport(void* WindowHandle, uint32 SizeX, uint32 SizeY, bool bIsFullscreen, EPixelFormat PixelFormat)
{
	FDawnViewport* Viewport = new FDawnViewport();
	Viewport->Width = FMath::Max<uint32>(SizeX, 1);
	Viewport->Height = FMath::Max<uint32>(SizeY, 1);
	Viewport->Format = WGPUTextureFormat_BGRA8Unorm;
	// Create a WebGPU surface from the page canvas and configure the swapchain.
	WGPUEmscriptenSurfaceSourceCanvasHTMLSelector CanvasSrc = {};
	CanvasSrc.chain.sType = WGPUSType_EmscriptenSurfaceSourceCanvasHTMLSelector;
	static const char* kCanvasSel = "#canvas";
	CanvasSrc.selector = { kCanvasSel, 7 };
	WGPUSurfaceDescriptor SurfDesc = {};
	SurfDesc.nextInChain = &CanvasSrc.chain;
	Viewport->Surface = wgpuInstanceCreateSurface(Instance, &SurfDesc);
	UE_LOG(LogDawnRHI, Warning, TEXT("DawnRHI: RHICreateViewport %ux%u surface=%p"), Viewport->Width, Viewport->Height, (void*)Viewport->Surface);
	if (Viewport->Surface)
	{
		WGPUSurfaceConfiguration Config = {};
		Config.device = Device;
		Config.format = Viewport->Format;
		Config.usage = WGPUTextureUsage_RenderAttachment;
		Config.width = Viewport->Width;
		Config.height = Viewport->Height;
		Config.alphaMode = WGPUCompositeAlphaMode_Opaque; // canvas ignores menu alpha (was Auto -> composited transparent against black page)
		Config.presentMode = WGPUPresentMode_Fifo;
		wgpuSurfaceConfigure(Viewport->Surface, &Config);
	}
	ActiveViewportRHI = Viewport;
	return Viewport;
}

void FDawnDynamicRHI::RHIEndDrawingViewport(FRHICommandListImmediate& RHICmdList, FRHIViewport* ViewportRHI, FRHIPresentArgs const& PresentArgs)
{
	// Backbuffer rotation/present is driven per-frame from RHIEndFrame on this setup
	// (this viewport present fires only occasionally). Nothing to do here.
	(void)ViewportRHI;
}

void FDawnDynamicRHI::RHIResizeViewport(FRHIViewport* ViewportRHI, uint32 SizeX, uint32 SizeY, bool bIsFullscreen, EPixelFormat PixelFormat)
{
	FDawnViewport* Viewport = static_cast<FDawnViewport*>(ViewportRHI);
	Viewport->Width = FMath::Max<uint32>(SizeX, 1);
	Viewport->Height = FMath::Max<uint32>(SizeY, 1);
	Viewport->BackBuffer.SafeRelease();
	if (Viewport->Surface)
	{
		WGPUSurfaceConfiguration Config = {};
		Config.device = Device;
		Config.format = Viewport->Format;
		Config.usage = WGPUTextureUsage_RenderAttachment;
		Config.width = Viewport->Width;
		Config.height = Viewport->Height;
		Config.alphaMode = WGPUCompositeAlphaMode_Opaque; // canvas ignores menu alpha (was Auto -> composited transparent against black page)
		Config.presentMode = WGPUPresentMode_Fifo;
		wgpuSurfaceConfigure(Viewport->Surface, &Config);
	}
}





