class FDawnGPUFence final : public FRHIGPUFence
{
public:
	explicit FDawnGPUFence(FName InName) : FRHIGPUFence(InName) {}
	virtual void Clear() override {}
	virtual bool Poll() const override { return true; }
	virtual bool Poll(FRHIGPUMask GPUMask) const override { return true; }
	virtual void Wait(FRHICommandListImmediate& RHICmdList, FRHIGPUMask GPUMask) const override {}
};

