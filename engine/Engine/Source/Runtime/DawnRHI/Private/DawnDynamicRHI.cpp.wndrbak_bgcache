// DawnRHI has no real GPU compute or GPU->CPU readback path. GPU buffer readbacks
// (FRHIGPUBufferReadback, used every frame by GPUMessage::FSystem) therefore have
// no GPU-written data to return. Back the staging buffer with a zero-filled CPU
// array: for message/stat readbacks this reads as "no messages", which is correct
// (nothing wrote any). Without this, RHICopyToStagingBuffer/RHIWriteGPUFence/
// RHILockStagingBuffer fall through to check(false) breaks and the game-thread
// readback poll spins forever (frame-1205 hang).
class FDawnStagingBuffer final : public FRHIStagingBuffer
{
public:
	TArray<uint8> Data;
	virtual void* Lock(uint32 Offset, uint32 NumBytes) override
	{
		bIsLocked = true;
		const uint32 Needed = Offset + NumBytes;
		if ((uint32)Data.Num() < Needed)
		{
			Data.SetNumZeroed(Needed);
		}
		return Data.GetData() + Offset;
	}
	virtual void Unlock() override { bIsLocked = false; }
	virtual uint64 GetGPUSizeBytes() const override { return (uint64)Data.Num(); }
};

