static uint32 GDawnDeviceThreadId = 0;
void FDawnDynamicRHI::InitDawnDevice()
{
#if !DAWNRHI_WASM
	// Static linking of Dawn native requires installing the proc table
	// ourselves — standard documented Dawn native usage (dawn/native/DawnNative.h),
	// not anything SimplyStream-specific.
	dawnProcSetProcs(&dawn::native::GetProcs());
#endif

	// Dawn requires explicitly opting in to finite-timeout wgpuInstanceWaitAny()
	// calls via the TimedWaitAny instance feature (an unrequested instance
	// otherwise only supports timeout==0 / timeout==UINT64_MAX waits, and
	// finite polling waits fail with "Timeout waits are either not enabled
	// or not supported"). We poll with short finite timeouts throughout this
	// module (buffer-map / queue-idle waits), so request it up front.
	//
	// DAWNRHI_WASM: emdawnwebgpu's instance does not support requesting
	// TimedWaitAny (DawnRHIWasmProbe's real_shader_wasm.cpp never requests
	// it and never calls wgpuInstanceWaitAny at all — it is purely
	// callback/event-loop driven, matching how every other wasm WebGPU
	// binding works: JS promises only resolve between synchronous C/wasm
	// calls yielding control back to the browser event loop, so a spin-wait
	// inside wasm code would block that very event loop and deadlock
	// instead of ever seeing the callback fire). Left unrequested here.
	// TimedWaitAny is required for BOTH native (finite polling waits) AND wasm/emdawnwebgpu:
	// emdawnwebgpu treats even UINT64_MAX as a finite timed wait (not the infinite sentinel), so
	// wgpuInstanceWaitAny fails 'TimedWaitAny not enabled' without it. On wasm this is only
	// serviceable because main() runs on a worker (PROXY_TO_PTHREAD): the worker blocks on the
	// future's futex while the browser main thread services the WebGPU promise and signals it.
#if DAWNRHI_WASM
	// wasm/emdawnwebgpu, ASYNCIFY build: main2 runs on a worker and emdawnwebgpu
	// WebGPU objects are per-thread with no cross-thread proxying, so we must
	// acquire our OWN adapter+device on THIS thread. emdawnwebgpu rejects the
	// TimedWaitAny feature, so below we pump this worker's event loop with
	// emscripten_sleep (Asyncify) until the AllowSpontaneous callbacks fire
	// instead of calling wgpuInstanceWaitAny.
	WGPUInstanceDescriptor InstanceDesc = {};
	Instance = wgpuCreateInstance(&InstanceDesc);
	checkf(Instance, TEXT("DawnRHI: wgpuCreateInstance failed"));
#else
	WGPUInstanceFeatureName RequiredFeatures[] = { WGPUInstanceFeatureName_TimedWaitAny };
	WGPUInstanceDescriptor InstanceDesc = {};
	InstanceDesc.requiredFeatureCount = 1;
	InstanceDesc.requiredFeatures = RequiredFeatures;
	Instance = wgpuCreateInstance(&InstanceDesc);
	checkf(Instance, TEXT("DawnRHI: wgpuCreateInstance failed"));
#endif

	WGPURequestAdapterOptions AdapterOpts = {};
	AdapterOpts.powerPreference = WGPUPowerPreference_HighPerformance;
#if !DAWNRHI_WASM
	// The browser's WebGPU implementation picks its own backend (Vulkan/
	// Metal/D3D12/ANGLE) internally; there is no such choice to make from
	// wasm — DawnRHIWasmProbe's probes never set backendType and worked
	// correctly against the real GPU via Chrome's own backend selection.
	AdapterOpts.backendType = WGPUBackendType_Vulkan;
#endif

	WGPURequestAdapterCallbackInfo AdapterCbInfo = {};
	AdapterCbInfo.mode = WGPUCallbackMode_AllowSpontaneous;
	AdapterCbInfo.callback = [](WGPURequestAdapterStatus Status, WGPUAdapter InAdapter, WGPUStringView Message, void* Userdata1, void*)
	{
		if (Status == WGPURequestAdapterStatus_Success)
		{
			*reinterpret_cast<WGPUAdapter*>(Userdata1) = InAdapter;
		}
		else
		{
			UE_LOG(LogDawnRHI, Error, TEXT("RequestAdapter failed: %.*s"), (int32)Message.length, ANSI_TO_TCHAR(Message.data));
		}
	};
	AdapterCbInfo.userdata1 = &Adapter;
	WGPUFuture AdapterFuture = wgpuInstanceRequestAdapter(Instance, &AdapterOpts, AdapterCbInfo);
#if DAWNRHI_WASM
	(void)AdapterFuture;
	for (int32 SpinGuard = 0; !Adapter && SpinGuard < 2000; ++SpinGuard) { emscripten_sleep(5); }
#else
	WGPUFutureWaitInfo AdapterWait = {};
	AdapterWait.future = AdapterFuture;
	wgpuInstanceWaitAny(Instance, 1, &AdapterWait, UINT64_MAX);
#endif
	checkf(Adapter, TEXT("DawnRHI: no adapter"));

	WGPUAdapterInfo Info = {};
	wgpuAdapterGetInfo(Adapter, &Info);
	UE_LOG(LogDawnRHI, Log, TEXT("DawnRHI adapter: %.*s / %.*s"),
		(int32)Info.vendor.length, ANSI_TO_TCHAR(Info.vendor.data),
		(int32)Info.device.length, ANSI_TO_TCHAR(Info.device.data));
	wgpuAdapterInfoFreeMembers(Info);

	WGPUDeviceDescriptor DeviceDesc = {};
	// LIMITSFIX (frame-3 stall, DM-Chill): material pixel shaders sample 17
	// textures but a device created without requiredLimits gets the WebGPU
	// DEFAULT limits (16 sampled textures per stage) -> CreateBindGroupLayout
	// fails ("The number of sampled textures (17) ... exceeds the maximum
	// per-stage limit (16)") -> invalid pipeline -> invalid command buffer ->
	// nothing ever submits. Request everything the adapter actually supports.
	// COMPRESSEDFIX: request the compressed-texture features the adapter has —
	// without them BC/ETC2/ASTC textures can't be created and every cooked
	// world texture (albedo/normal/LIGHTMAP) stayed a black RGBA8 substitute.
	static WGPUFeatureName GRequiredFeatures[4];
	size_t NumRequiredFeatures = 0;
	if (wgpuAdapterHasFeature(Adapter, WGPUFeatureName_TextureCompressionBC))   { GRequiredFeatures[NumRequiredFeatures++] = WGPUFeatureName_TextureCompressionBC;   GDawnBCTextureSupport = true; }
	if (wgpuAdapterHasFeature(Adapter, WGPUFeatureName_TextureCompressionETC2)) { GRequiredFeatures[NumRequiredFeatures++] = WGPUFeatureName_TextureCompressionETC2; GDawnETC2TextureSupport = true; }
	if (wgpuAdapterHasFeature(Adapter, WGPUFeatureName_TextureCompressionASTC)) { GRequiredFeatures[NumRequiredFeatures++] = WGPUFeatureName_TextureCompressionASTC; GDawnASTCTextureSupport = true; }
	DeviceDesc.requiredFeatureCount = NumRequiredFeatures;
	DeviceDesc.requiredFeatures = GRequiredFeatures;
	printf("DAWNBG FEATURES bc=%d etc2=%d astc=%d\n", GDawnBCTextureSupport ? 1 : 0, GDawnETC2TextureSupport ? 1 : 0, GDawnASTCTextureSupport ? 1 : 0);
	fflush(stdout);
	WGPULimits AdapterLimits = WGPU_LIMITS_INIT;
	const bool bHaveAdapterLimits = (wgpuAdapterGetLimits(Adapter, &AdapterLimits) == WGPUStatus_Success);
	if (bHaveAdapterLimits)
	{
		AdapterLimits.nextInChain = nullptr;
		DeviceDesc.requiredLimits = &AdapterLimits;
		printf("DAWNBG LIMITS maxSampledTex/stage=%u maxSamplers/stage=%u maxUB/stage=%u maxVB=%u\n",
			AdapterLimits.maxSampledTexturesPerShaderStage, AdapterLimits.maxSamplersPerShaderStage,
			AdapterLimits.maxUniformBuffersPerShaderStage, AdapterLimits.maxVertexBuffers);
		fflush(stdout);
		// BGLIMIT: cache for the PSO-create/bind-group pre-flight checks (an
		// over-limit layout/bind group hard-ABORTS in the emdawn JS glue —
		// the 18-texture material black-screen crash).
		GDawnLimitMaxSamplersPerStage   = AdapterLimits.maxSamplersPerShaderStage;
		GDawnLimitMaxSampledTexPerStage = AdapterLimits.maxSampledTexturesPerShaderStage;
		GDawnLimitMaxUBPerStage         = AdapterLimits.maxUniformBuffersPerShaderStage;
	}
	DeviceDesc.uncapturedErrorCallbackInfo.callback = [](WGPUDevice const*, WGPUErrorType Type, WGPUStringView Message, void*, void*)
	{
		UE_LOG(LogDawnRHI, Error, TEXT("Dawn uncaptured error (type %d): %.*s"), (int32)Type, (int32)Message.length, ANSI_TO_TCHAR(Message.data));
	};
	WGPURequestDeviceCallbackInfo DeviceCbInfo = {};
	DeviceCbInfo.mode = WGPUCallbackMode_AllowSpontaneous;
	DeviceCbInfo.callback = [](WGPURequestDeviceStatus Status, WGPUDevice InDevice, WGPUStringView Message, void* Userdata1, void*)
	{
		if (Status == WGPURequestDeviceStatus_Success)
		{
			*reinterpret_cast<WGPUDevice*>(Userdata1) = InDevice;
		}
		else
		{
			UE_LOG(LogDawnRHI, Error, TEXT("RequestDevice failed: %.*s"), (int32)Message.length, ANSI_TO_TCHAR(Message.data));
		}
	};
	DeviceCbInfo.userdata1 = &Device;
	WGPUFuture DeviceFuture = wgpuAdapterRequestDevice(Adapter, &DeviceDesc, DeviceCbInfo);
#if DAWNRHI_WASM
	(void)DeviceFuture;
	for (int32 SpinGuard = 0; !Device && SpinGuard < 2000; ++SpinGuard) { emscripten_sleep(5); }
#else
	WGPUFutureWaitInfo DeviceWait = {};
	DeviceWait.future = DeviceFuture;
	wgpuInstanceWaitAny(Instance, 1, &DeviceWait, UINT64_MAX);
#endif
	checkf(Device, TEXT("DawnRHI: no device"));

	Queue = wgpuDeviceGetQueue(Device);
	UE_LOG(LogDawnRHI, Warning, TEXT("DEVTHREAD: device acquired on thread=%u main=%d"), FPlatformTLS::GetCurrentThreadId(), (int32)IsInGameThread());
	GDawnDeviceThreadId = FPlatformTLS::GetCurrentThreadId();
}

void FDawnDynamicRHI::Init()
{
	InitDawnDevice();
	CommandContext = MakeUnique<FDawnCommandContext>(this);
	GRHISupportsRHIThread = false;
	GRHISupportsParallelRHIExecute = false;
	// ROOT FIX for the frame-19 game-thread deadlock (blockSite=6 on the
	// SceneVisibilityPrivate.h(602) DynamicMeshElements task event): parallel
	// GDME creates RHI resources on task-WORKER threads
	// (TDynamicBuffer<FVertexBuffer>::InitRHI -> RHICreateBufferInitializer ->
	// wgpuDeviceCreateBuffer), but emdawnwebgpu WebGPU objects are PER-THREAD
	// (the device lives on the game thread) — the worker-side create asserts in
	// the JS glue, the worker dies, and the task event it owed never triggers,
	// deadlocking the game thread's untimed wait. This is the same constraint
	// class as OpenGL, and the engine has a capability flag for exactly it
	// (IsParallelGatherDynamicMeshElementsEnabled() checks it): clear it.
	GSupportsParallelRenderingTasksWithSeparateRHIThread = false;
	// No occlusion/timer render queries on this backend (RHICreateRenderQuery
	// used to checkNoEntry-abort when occlusion culling warmed up ~frame 19).
	// The engine-side occlusion kill switch is r.AllowOcclusionQueries=0 (set
	// in ApplyWndrWasmSyncRenderOverrides); the query objects themselves are
	// benign inert stubs as a second line of defense.
	GRHISupportsExactOcclusionQueries = false;
	GSupportsParallelOcclusionQueries = false;
	GSupportsTimestampRenderQueries = false;
	// NOSTREAM: all content is preloaded into the 12GB wasm heap via IoStore/
	// ContentBootstrap — mip streaming buys nothing and its async cancel/
	// teardown paths are exactly where wasm single-threaded IO is fragile.
	// The engine hard-disables texture streaming when the RHI doesn't support
	// it (ContentStreaming.cpp: !GRHISupportsTextureStreaming forces
	// r.TextureStreaming=0 and never creates FRenderAssetStreamingManager).
	// false is also the RHIGlobals default — set it EXPLICITLY so a future
	// engine-default change can't silently arm the streamer on this backend
	// (RHIAsyncCreateTexture2D et al are still stubs).
	GRHISupportsTextureStreaming = false;
	GRHIAdapterName = TEXT("Dawn (Vulkan)");
	GMaxRHIFeatureLevel = ERHIFeatureLevel::ES3_1;
	// DawnRHI has no compute, but UE still computes dispatch configs (e.g. GPU-scene scatter
	// in UpdateAllPrimitiveSceneInfos) on the CPU; an unset max-dispatch global asserts (div-by-0)
	// -> OOB crash. Set a valid ceiling so the config math is well-formed (the dispatch is a no-op).
	GRHIMaxDispatchThreadGroupsPerDimension = FIntVector(65535, 65535, 65535); // was SM6 (deferred); ES3_1 -> mobile forward renderer (its shaders cross-compile to WGSL; the deferred/compute set does not)
	// TEXDIMS (FastBlueNoise/Background reject fix): DawnRHI never published
	// its texture dimension caps, so the engine-side "exceeds this rhi's
	// maximum dimension" checks rejected any large/array/volume texture
	// (FastBlueNoise_vec2_128x128x64 dither array, 4K Slate backgrounds) —
	// the material then referenced a never-created texture. WebGPU guarantees
	// at least 8192 for 2D/cube, 2048 for 3D, 256 array layers.
	GMaxTextureDimensions = 8192;
	GMaxCubeTextureDimensions = 8192;
	GMaxVolumeTextureDimensions = 2048;
	GMaxTextureArrayLayers = 256;
	// Mark the formats DawnRHI can actually back as Supported, or
	// RHICreateTexture's ValidateResourceDesc aborts ("pixel format ... not
	// supported"). The scene depth buffer (PF_DepthStencil) is the first casualty.
	{
		const EPixelFormat _DawnSupported[] = {
			PF_DepthStencil, PF_ShadowDepth, PF_D24, PF_R32_FLOAT,
			PF_R8G8B8A8, PF_B8G8R8A8, PF_FloatRGBA, PF_FloatRGB, PF_FloatR11G11B10,
			PF_G8, PF_A8, PF_R8, PF_R8G8, PF_R16F, PF_G16, PF_A2B10G10R10,
			PF_R16_UINT, PF_R32_UINT, PF_R16G16B16A16_UINT, PF_R16G16B16A16_UNORM,
			PF_A16B16G16R16, PF_R32G32B32A32_UINT, PF_G16R16, PF_G16R16F, PF_A32B32G32R32F
		};
		for (EPixelFormat _F : _DawnSupported) { GPixelFormats[_F].Supported = true; }
	}
	// SP_WEBGPU_SM5 is a DDPI-INI-registered name (no C++ enumerator); UE assigns
	// it an EShaderPlatform value in the static-platform range (32..47) at startup.
	// Resolve by name rather than hardcoding, so DataDrivenShaderPlatformInfo
	// entries (IsValid, feature bits) and the cooked shader library both line up.
	{
		{
			const TCHAR* P = TEXT("/Engine/Config/SimplyStream/DataDrivenPlatformInfo.ini");
			const TCHAR* P2 = TEXT("/Engine/Platforms/SimplyStream/Config/DataDrivenPlatformInfo.ini");
			FString Content;
			const bool bExists = IFileManager::Get().FileExists(P);
			const bool bExists2 = IFileManager::Get().FileExists(P2);
			const bool bRead = FFileHelper::LoadFileToString(Content, P);
			UE_LOG(LogDawnRHI, Warning, TEXT("DDPI diag: EngineConfigDir=%s"),
				*FPaths::EngineConfigDir());
			UE_LOG(LogDawnRHI, Warning, TEXT("DDPI diag: /Engine/Config exists=%d /Engine/Platforms exists=%d read=%d hasSM5=%d len=%d"),
				(int)bExists, (int)bExists2, (int)bRead, (int)Content.Contains(TEXT("ShaderPlatform SP_WEBGPU_SM5")), Content.Len());
		}
		const EShaderPlatform WebGPUES31 = FGenericDataDrivenShaderPlatformInfo::GetShaderPlatformFromName(TEXT("SP_WEBGPU_ES31"));
		UE_LOG(LogDawnRHI, Warning, TEXT("DawnRHI: SP_WEBGPU_ES31 resolved to %d (valid=%d)"),
			(int32)WebGPUES31,
			WebGPUES31 != SP_NumPlatforms ? (int32)FGenericDataDrivenShaderPlatformInfo::IsValid(WebGPUES31) : -1);
		GMaxRHIShaderPlatform = (WebGPUES31 != SP_NumPlatforms) ? WebGPUES31 : (EShaderPlatform)43;
		// Map the ES3_1 feature level to our WebGPU ES31 platform so GetFeatureLevelShaderPlatform()/
		// the mobile renderer + global shader map all resolve to the cooked SP_WEBGPU_ES31 content.
		GShaderPlatformForFeatureLevel[ERHIFeatureLevel::ES3_1] = GMaxRHIShaderPlatform;
	}
	// Bind the immediate command list's Graphics context now. Needed both by the
	// RHIInit GetContext() validation right after this returns AND by the global
	// render-resource creation below (which records via the immediate context).
	FRHICommandListImmediate::Get().InitializeImmediateContexts();

	// Initialize the global render resources (GWhiteTexture/GBlackTexture/etc.)
	// exactly as every stock RHI backend does at the end of Init(). Without this,
	// FSystemTextures::InitializeCommonTextures dereferences a null GWhiteTexture
	// (its InitRHI never ran) and CreateRenderTarget faults.
	FRenderResource::InitPreRHIResources();

	GIsRHIInitialized = true;
}

void FDawnDynamicRHI::Shutdown()
{
	CommandContext.Reset();
	if (Queue) { wgpuQueueRelease(Queue); Queue = nullptr; }
	if (Device) { wgpuDeviceRelease(Device); Device = nullptr; }
	if (Adapter) { wgpuAdapterRelease(Adapter); Adapter = nullptr; }
	if (Instance) { wgpuInstanceRelease(Instance); Instance = nullptr; }
}

