// LWC FOLD (diagnostic hack, sliver fix candidate): the cooked mobile VS
// IGNORES Primitive.PositionHigh (LWCVS proof: it appears only in the WGSL
// struct decl, never in the position math) and builds world position from
// LocalToRelativeWorld (+PreViewTranslation) alone — but the CPU delivers
// the whole placement in PositionHigh with matrix translation [0,0,0], so
// every primitive rendered at its tile origin (the collapsed sliver). Fold
// PositionHigh into the matrix translation the shader ACTUALLY reads, then
// zero PositionHigh, on a COPY of the contents at upload time:
//   floats[4..6]   = PositionHigh                (byte offset 16)
//   floats[20..22] = LocalToRelativeWorld row 3  (translation; layout row-major
//                    confirmed: PRIMUPDATE diag at floats 8/13/18, trans 20..22)
//   floats[52..54] = PreviousLocalToRelativeWorld row 3 (shares PositionHigh
//                    in GetPrimitiveDataFromUniformBuffer -> fold too)
// Known artifact: RelativeWorldToLocal (floats 24..39) is NOT re-derived, so
// full inverse transforms are off by PositionHigh; its 3x3 (normals) is
// unaffected. Proper fix is a disable-LWC / PositionHigh-aware recook.
// VIEWDUMP (sliver investigation, printf edition): dump the real View UB's
// LWC/translation fields + TranslatedWorldToClip at upload time, keyed by the
// WGPU buffer handle so it can be correlated with the STATICUB injection diag
// in FlushPendingBindGroups (is the WORLD view or a stale/menu view feeding
// the base-pass draws? a degenerate ToClip collapses geometry to lines).
static void DawnDumpViewUB(const FRHIUniformBufferLayout& Layout, const void* Contents, const void* BufHandle)
{
	if (!DAWNRHI_HEAVY_DUMPS) { return; } // stripped 2026-08-18 (OOB suspect + log volume)
	if (!Contents || Layout.ConstantBufferSize < 4096) { return; }
	const FString N = Layout.GetDebugName();
	if (!N.Contains(TEXT("View")) || N.Contains(TEXT("Slate"))) { return; }
	static uint32 _n = 0; ++_n;
	if (_n > 6 && (_n % 400) != 0) { return; }
	const FShaderParametersMetadata* Meta = FindUniformBufferStructByName(TEXT("View"));
	if (!Meta) { printf("DAWNBG VIEWDUMP no metadata\n"); fflush(stdout); return; }
	printf("DAWNBG VIEWDUMP #%u name=%s size=%u buf=%p\n", _n, TCHAR_TO_UTF8(*N), Layout.ConstantBufferSize, BufHandle);
	for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
	{
		const bool bClip = (FCString::Stricmp(M.GetName(), TEXT("TranslatedWorldToClip")) == 0);
		const bool bWant = bClip
			|| FCString::Stricmp(M.GetName(), TEXT("PreViewTranslationHigh")) == 0
			|| FCString::Stricmp(M.GetName(), TEXT("PreViewTranslationLow")) == 0
			|| FCString::Stricmp(M.GetName(), TEXT("ViewTilePosition")) == 0
			|| FCString::Stricmp(M.GetName(), TEXT("RelativeWorldViewOriginHigh")) == 0;
		if (!bWant) { continue; }
		const uint32 Off = M.GetOffset();
		if (Off + (bClip ? 64u : 12u) > Layout.ConstantBufferSize) { continue; }
		const float* F = (const float*)((const uint8*)Contents + Off);
		if (bClip)
		{
			printf("DAWNBG VIEWDUMP  %s@%u [%.4f %.4f %.4f %.4f | %.4f %.4f %.4f %.4f | %.4f %.4f %.4f %.4f | %.2f %.2f %.2f %.2f]\n",
				TCHAR_TO_UTF8(M.GetName()), Off, F[0],F[1],F[2],F[3],F[4],F[5],F[6],F[7],F[8],F[9],F[10],F[11],F[12],F[13],F[14],F[15]);
		}
		else
		{
			printf("DAWNBG VIEWDUMP  %s@%u [%.2f %.2f %.2f]\n", TCHAR_TO_UTF8(M.GetName()), Off, F[0], F[1], F[2]);
		}
	}
	fflush(stdout);
}

// FOGDUMP (blue-haze investigation): dump every Fog-related member of the
// MobileBasePass uniform buffer at upload time — is the flat blue veil real
// authored fog, or garbage/dummy parameters (misbound block)?
static void DawnDumpMobileBasePassUB(const FRHIUniformBufferLayout& Layout, const void* Contents, const void* BufHandle)
{
	if (!DAWNRHI_HEAVY_DUMPS) { return; } // stripped 2026-08-18 (FOGDUMP was the last print before the wasm OOB; layout-vs-contents size skew walk)
	if (!Contents || Layout.ConstantBufferSize < 256) { return; }
	const FString N = Layout.GetDebugName();
	if (!N.Contains(TEXT("MobileBasePass"))) { return; }
	static uint32 _n = 0; ++_n;
	if (_n > 4 && (_n % 400) != 0) { return; }
	const FShaderParametersMetadata* Meta = FindUniformBufferStructByName(TEXT("MobileBasePass"));
	printf("DAWNBG FOGDUMP #%u name=%s size=%u buf=%p meta=%d\n", _n, TCHAR_TO_UTF8(*N), Layout.ConstantBufferSize, BufHandle, Meta ? 1 : 0);
	if (!Meta) { fflush(stdout); return; }
	for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
	{
		// Fog fields live in a nested struct member (FFogUniformParameters Fog);
		// GetMembers() at this level lists the nested STRUCT — recurse one level.
		if (M.GetBaseType() == UBMT_NESTED_STRUCT && M.GetStructMetadata())
		{
			const uint32 Base = M.GetOffset();
			for (const FShaderParametersMetadata::FMember& S : M.GetStructMetadata()->GetMembers())
			{
				const uint32 Off = Base + S.GetOffset();
				if (Off + 16 > Layout.ConstantBufferSize) { continue; }
				const float* F = (const float*)((const uint8*)Contents + Off);
				printf("DAWNBG FOGDUMP  %s.%s@%u [%.4f %.4f %.4f %.4f]\n", TCHAR_TO_UTF8(M.GetName()), TCHAR_TO_UTF8(S.GetName()), Off, F[0], F[1], F[2], F[3]);
			}
		}
		else if (FCString::Strstr(M.GetName(), TEXT("Fog")))
		{
			const uint32 Off = M.GetOffset();
			if (Off + 16 > Layout.ConstantBufferSize) { continue; }
			const float* F = (const float*)((const uint8*)Contents + Off);
			printf("DAWNBG FOGDUMP  %s@%u [%.4f %.4f %.4f %.4f]\n", TCHAR_TO_UTF8(M.GetName()), Off, F[0], F[1], F[2], F[3]);
		}
	}
	fflush(stdout);
}

// FOGZERO (pragmatic blue-haze fix): the MobileBasePass fog block is bound
// with REAL sane params (FOGDUMP), yet the fog factor saturates everywhere —
// suspicion: cook-vs-runtime layout skew inside FMobileBasePassUniformParameters
// (its packing depends on compile-time flags, unlike the verified-matching
// View UB). Until the real input bug is pinned, zero the WHOLE Fog nested
// struct in the uploaded copy: zero density -> fog factor 1 -> scene passes
// through untouched, zero colors -> nothing added, and the BINDING stays
// present (removing it entirely, e.g. r.Fog=0, crashes the base pass).
static bool DawnZeroMobileFog(const FRHIUniformBufferLayout& Layout, const void* Contents, TArray<uint8>& OutMutated)
{
	// WNDR blue-veil dampen (2026-08-20): the mobile exponential-fog inscattering color
	// (Fog.ExponentialFogColorParameter.xyz) + the SkyAtmosphere ambient contribution wash
	// static geometry heavy blue. Disabling fog via r.Fog=0 OOBs a DawnRHI fog-off path, so
	// instead of ZEROING the whole Fog block we SCALE DOWN just the inscattering colors on the
	// uploaded copy: the fog path stays fully bound (no unbound UB -> no OOB), density/params
	// and MinFogOpacity (.w) are preserved, and the scene reads in its own colors. UE's source
	// memory is untouched. Applies to MobileBasePass (nested "Fog") and stand-alone FogStruct.
#ifndef DAWNRHI_FOG_INSCATTER_SCALE
#define DAWNRHI_FOG_INSCATTER_SCALE 0.12f   // fraction of the authored inscattering kept (tunable)
#endif
	if (!Contents) { return false; }
	const FString N = Layout.GetDebugName();
	const FShaderParametersMetadata* FogMeta = nullptr;
	uint32 FogBase = 0;
	if (N.Contains(TEXT("MobileBasePass")))
	{
		const FShaderParametersMetadata* Meta = FindUniformBufferStructByName(TEXT("MobileBasePass"));
		if (!Meta) { return false; }
		for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
		{
			if (M.GetBaseType() == UBMT_NESTED_STRUCT && M.GetStructMetadata() && FCString::Stricmp(M.GetName(), TEXT("Fog")) == 0)
			{
				FogMeta = M.GetStructMetadata();
				FogBase = M.GetOffset();
				break;
			}
		}
	}
	else if (N.Contains(TEXT("FogStruct")))
	{
		FogMeta = FindUniformBufferStructByName(TEXT("FogStruct"));
		FogBase = 0;
	}
	if (!FogMeta) { return false; }

	int32 InscatterOff = -1, SkyAmbOff = -1;
	for (const FShaderParametersMetadata::FMember& M : FogMeta->GetMembers())
	{
		if (FCString::Stricmp(M.GetName(), TEXT("ExponentialFogColorParameter")) == 0) { InscatterOff = (int32)M.GetOffset(); }
		else if (FCString::Stricmp(M.GetName(), TEXT("SkyAtmosphereAmbientContributionColorScale")) == 0) { SkyAmbOff = (int32)M.GetOffset(); }
	}
	if (InscatterOff < 0) { return false; }

	OutMutated.SetNumUninitialized((int32)Layout.ConstantBufferSize);
	FMemory::Memcpy(OutMutated.GetData(), Contents, Layout.ConstantBufferSize);
	const float S = DAWNRHI_FOG_INSCATTER_SCALE;
	auto ScaleXYZ = [&](int32 Off)
	{
		if (Off < 0) { return; }
		const uint32 Abs = FogBase + (uint32)Off;
		if (Abs + 12u > Layout.ConstantBufferSize) { return; }
		float* F = (float*)(OutMutated.GetData() + Abs);
		F[0] *= S; F[1] *= S; F[2] *= S;
	};
	ScaleXYZ(InscatterOff);
	ScaleXYZ(SkyAmbOff);
	static uint32 _fd = 0;
	if (_fd++ < 6) { printf("DAWNBG FOGDAMPEN scale=%.3f inscatterOff=%d skyAmbOff=%d base=%u in %s\n", S, InscatterOff, SkyAmbOff, FogBase, TCHAR_TO_UTF8(*N)); fflush(stdout); }
	return true;
}

// LWC VIEW FOLD (sliver root cause, 2026-08-19): symmetric to the primitive
// PositionHigh fold. The cross-compiled WGSL drops the LWC "High" tile terms
// (Primitive.PositionHigh AND View.PreViewTranslationHigh) -- it reconstructs
// position from LocalToRelativeWorld + PreViewTranslationLow alone. The primitive
// fold makes primitive positions ABSOLUTE (PositionHigh folded into the matrix
// translation), so PreViewTranslation must ALSO be absolute (= -CameraAbsPos) for
// TranslatedPos = abs_world + PreViewTranslation to be view-relative. But
// PreViewTranslationHigh (the far/tile part of -CameraPos) is dropped, so
// PreViewTranslation ~= Low ~= 0 -> abs_world positions (thousands of units) go
// straight into TranslatedWorldToClip unshifted -> collapse to slivers. Fix: fold
// PreViewTranslationHigh into PreViewTranslationLow (and the Prev pair), zero High,
// on the uploaded copy. If the shader DID use High+Low, this preserves High+Low; if
// it drops High, this recovers it.
static bool DawnFoldViewPreViewTranslation(const FRHIUniformBufferLayout& Layout, const void* Contents, TArray<uint8>& OutFolded)
{
	if (!Contents) { return false; }
	const FString N = Layout.GetDebugName();
	if (!N.Contains(TEXT("View")) || N.Contains(TEXT("Slate")) || N.Contains(TEXT("Instanced"))) { return false; }
	if (Layout.ConstantBufferSize < 4096) { return false; }
	const FShaderParametersMetadata* Meta = FindUniformBufferStructByName(TEXT("View"));
	if (!Meta) { return false; }
	int32 PVTH = -1, PVTL = -1, PPVTH = -1, PPVTL = -1;
	int32 PreExpOff = -1, OneOverPreExpOff = -1; // WNDR brighten: kill the Mobile-LDR 0.18 crush
	for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
	{
		const TCHAR* Nm = M.GetName();
		if (FCString::Stricmp(Nm, TEXT("PreViewTranslationHigh")) == 0) { PVTH = (int32)M.GetOffset(); }
		else if (FCString::Stricmp(Nm, TEXT("PreViewTranslationLow")) == 0) { PVTL = (int32)M.GetOffset(); }
		else if (FCString::Stricmp(Nm, TEXT("PrevPreViewTranslationHigh")) == 0) { PPVTH = (int32)M.GetOffset(); }
		else if (FCString::Stricmp(Nm, TEXT("PrevPreViewTranslationLow")) == 0) { PPVTL = (int32)M.GetOffset(); }
		else if (FCString::Stricmp(Nm, TEXT("PreExposure")) == 0) { PreExpOff = (int32)M.GetOffset(); }
		else if (FCString::Stricmp(Nm, TEXT("OneOverPreExposure")) == 0) { OneOverPreExpOff = (int32)M.GetOffset(); }
	}
	if (PVTH < 0 || PVTL < 0) { return false; }
	const uint32 Size = Layout.ConstantBufferSize;
	if ((uint32)(PVTH + 12) > Size || (uint32)(PVTL + 12) > Size) { return false; }
	OutFolded.SetNumUninitialized((int32)Size);
	FMemory::Memcpy(OutFolded.GetData(), Contents, Size);
	uint8* B = OutFolded.GetData();
	auto Fold3 = [B, Size](int32 HOff, int32 LOff)
	{
		if (HOff < 0 || LOff < 0 || (uint32)(HOff + 12) > Size || (uint32)(LOff + 12) > Size) { return; }
		float* H = (float*)(B + HOff); float* L = (float*)(B + LOff);
		L[0] += H[0]; L[1] += H[1]; L[2] += H[2];
		H[0] = 0.f; H[1] = 0.f; H[2] = 0.f;
	};
	const float PreH0 = ((const float*)(B + PVTH))[0], PreL0 = ((const float*)(B + PVTL))[0];
	Fold3(PVTH, PVTL);
	Fold3(PPVTH, PPVTL);
	static uint32 _vf = 0;
	if (_vf++ < 10 || (_vf % 2000) == 0) { const float* L = (const float*)(B + PVTL); printf("DAWNBG VIEWFOLD #%u High0=%.1f oldLow0=%.1f -> newLow=[%.1f %.1f %.1f]\n", _vf, PreH0, PreL0, L[0], L[1], L[2]); fflush(stdout); }
	// WNDR brighten (2026-08-20): Mobile-LDR (r.MobileHDR=False) has NO tonemap exposure pass;
	// exposure is folded into the base pass as OutColor.rgb *= View.PreExposure, and ES3_1 (< SM5)
	// forces PreExposure = 0.18 (middle-grey) -> a flat ~5.5x crush on the WHOLE image, world AND
	// dynamic skinned meshes (players/guns, which the injected lightmap ambient never touches). The
	// original game overcame 0.18 with real directional/sky lighting; this clean-room scene has only
	// flat ambient, so it lands dim. Force PreExposure = OneOverPreExposure = 1.0 to remove the crush
	// (reciprocal pair kept consistent so any multiply/divide elsewhere still cancels; only the
	// base pass's lone multiply nets the 5.5x brighten). Ambient is retuned down to pair with this.
	{
		const float NewPE = 1.0f; // sane baseline (removes Mobile-LDR 0.18 crush); real brightness judged once player is alive
		const float OldPE = (PreExpOff >= 0 && (uint32)(PreExpOff + 4) <= Size) ? *(const float*)(B + PreExpOff) : -1.f;
		if (PreExpOff >= 0 && (uint32)(PreExpOff + 4) <= Size) { *(float*)(B + PreExpOff) = NewPE; }
		if (OneOverPreExpOff >= 0 && (uint32)(OneOverPreExpOff + 4) <= Size) { *(float*)(B + OneOverPreExpOff) = 1.0f / NewPE; }
		static uint32 _pe = 0;
		if (_pe++ < 8) { printf("DAWNBG PREEXPOSE off=%d old=%.4f -> new=%.2f (oneOverOff=%d) viewSize=%u\n", PreExpOff, OldPE, NewPE, OneOverPreExpOff, Size); fflush(stdout); }
	}
	return true;
}

static bool DawnFoldPrimitivePositionHigh(const FRHIUniformBufferLayout& Layout, const void* Contents, TArray<uint8>& OutFolded)
{
	// FOLD RE-ENABLED (2026-08-17): the 08-16 "fold moved nothing" test ran
	// while CreateBindGroup was failing at frame 3 (vertex-stage texture slot
	// mismatch) — NO command buffer ever submitted, so no upload-side change
	// could have moved anything on screen. That test is void. With the
	// bind-group + limits + blend + vertex-pad fixes in, frames present and
	// geometry draws (as slivers at tile origins), which is exactly the
	// PositionHigh-ignored signature this fold addresses.
	if (!Contents) { return false; }
	const uint32 Size = Layout.ConstantBufferSize;
	if (Size < 768 || Size > 1024) { return false; } // FPrimitiveUniformShaderParameters is 816 in this build
	const FString N = Layout.GetDebugName();
	if (!N.Contains(TEXT("Primitive"))) { return false; } // WNDR: Batched exclusion removed 2026-08-19 -- BSP/batched world geometry also carries placement in PositionHigh and was collapsing to origin (slivers)
	const float* Src = (const float*)Contents;
	const float HX = Src[4], HY = Src[5], HZ = Src[6];
	if (HX == 0.f && HY == 0.f && HZ == 0.f) { return false; } // nothing to fold (e.g. identity UB)
	OutFolded.SetNumUninitialized((int32)Size);
	FMemory::Memcpy(OutFolded.GetData(), Contents, Size);
	float* F = (float*)OutFolded.GetData();
	F[20] += HX; F[21] += HY; F[22] += HZ;
	F[52] += HX; F[53] += HY; F[54] += HZ;
	F[4] = 0.f; F[5] = 0.f; F[6] = 0.f;
	static uint32 _fold = 0;
	if (GDawnVerboseBindLog && (_fold++ < 10 || (_fold % 5000) == 0)) { printf("DAWNBG FOLD #%u posHigh=[%.1f %.1f %.1f] + oldTrans=[%.1f %.1f %.1f] -> newTrans=[%.1f %.1f %.1f]\n", _fold, HX, HY, HZ, Src[20], Src[21], Src[22], F[20], F[21], F[22]); fflush(stdout); }
	return true;
}

// UBRESTABLE capture (see FDawnUniformBuffer::ResTable in DawnResources.h for
// the full rationale — this is the black-world/collapsed-bots root cause):
// pull the FRHIResource* members out of the UB Contents blob and give each its
// flattened WGSL member name.
//   (1) Registered metadata (static structs: GPUSkinVFBase, LightmapResource-
//       Cluster, MobileReflectionCapture, ...): exact names by member offset,
//       recursing into nested structs ("Common_BoneMatrices").
//   (2) Material UBs (dynamic FUniformExpressionSet metadata, not in the
//       global registry): names are FORMULAIC (MaterialUniformExpressions.cpp
//       CreateBufferStruct): per-dimension counters "Texture2D_k",
//       "TextureCube_k", "Texture2DArray_k", "VolumeTexture_k" (classified by
//       the actual texture's dimension; type blocks are contiguous), and each
//       sampler member immediately follows its texture as "<texture>Sampler".
extern FString DawnDeriveShaderUBName(const FString& DebugName); // DawnCommandContext.cpp

// LIVEHANDLE registry (getJsObject-abort fix): every WGPU handle that may
// appear in a bind-group entry (texture views, samplers, buffers) registers
// on creation and unregisters on release. FlushPendingBindGroups validates
// each entry against this set before wgpuDeviceCreateBindGroup — a null OR
// STALE handle makes the emdawn JS glue ASSERT-abort (getJsObject), not fail
// validation (the FastBlueNoise ~15s black-screen crash).
static TSet<void*> GDawnLiveHandles;
static FCriticalSection GDawnRegLock; // wndr REGLOCK-1: live-handle set + UB registry are multi-threaded
void DawnLiveHandleAdd(void* H) { if (H) { FScopeLock L(&GDawnRegLock); if (GDawnLiveHandles.Num() < 1000000) { GDawnLiveHandles.Add(H); } } }
void DawnLiveHandleRemove(void* H) { if (H) { FScopeLock L(&GDawnRegLock); GDawnLiveHandles.Remove(H); } }
bool DawnLiveHandleCheck(void* H) { if (!H) { return false; } FScopeLock L(&GDawnRegLock); return GDawnLiveHandles.Contains(H); }

// UBREGISTRY: WGPUBuffer handle -> live FDawnUniformBuffer (see DawnResources.h).
static TMap<void*, FDawnUniformBuffer*> GDawnUBByBuffer;
void DawnUBRegistryRemove(void* WgpuBuf) { if (WgpuBuf) { FScopeLock L(&GDawnRegLock); GDawnUBByBuffer.Remove(WgpuBuf); } }
FDawnUniformBuffer* DawnUBRegistryFind(void* WgpuBuf)
{
	FScopeLock L(&GDawnRegLock); // wndr REGLOCK-1
	FDawnUniformBuffer** Found = WgpuBuf ? GDawnUBByBuffer.Find(WgpuBuf) : nullptr;
	return Found ? *Found : nullptr;
}
static void DawnUBRegistryAdd(FDawnUniformBuffer* UB) { if (UB && UB->Buffer) { { FScopeLock L(&GDawnRegLock); GDawnUBByBuffer.Add((void*)UB->Buffer, UB); } DawnLiveHandleAdd((void*)UB->Buffer); } }

// wndr RDGRES-fix-1: resources pre-resolved on the render thread for a deferred update (index-aligned with Layout.Resources).
static thread_local const TArray<TRefCountPtr<FRHIResource>>* GWndrPreResolvedRes = nullptr;
FCriticalSection GDawnResTableLock; // wndr RESTABLE-lock-1 (ResTable/ShaderName writers vs bind-time readers)
static void DawnCaptureUBResourceTable(FDawnUniformBuffer* UB, const void* Contents)
{
	FScopeLock _ResTableLock(&GDawnResTableLock); // wndr RESTABLE-lock-1
	const FRHIUniformBufferLayout& Layout = UB->GetLayout();
	// WNDR per-draw probe: cache the CPU bytes for Primitive UBs so a draw can read
	// the ACTUAL transform bound to it (not the unreliable global last-upload cache).
	if (Contents && Layout.ConstantBufferSize >= 768 && Layout.ConstantBufferSize <= 1024 && Layout.GetDebugName().Contains(TEXT("Primitive")))
	{
		UB->LastUploadBytes.SetNumUninitialized((int32)Layout.ConstantBufferSize);
		FMemory::Memcpy(UB->LastUploadBytes.GetData(), Contents, Layout.ConstantBufferSize);
	}
	// Always name the UB (even resource-less/empty-contents ones) so the
	// delivery diagnostics (MATMISS) can identify every pending UB.
	if (UB->ShaderName.IsEmpty()) { UB->ShaderName = DawnDeriveShaderUBName(Layout.GetDebugName()); }
	if (Layout.Resources.Num() == 0 || !Contents) { return; }
	UB->ResTable.Reset();
	const FString Derived = DawnDeriveShaderUBName(Layout.GetDebugName());
	TMap<uint32, FString> NamesByOffset;
	// "Material" metadata is created PER MATERIAL under the same name
	// (MaterialUniformExpressions.cpp:976 LayoutName TEXT("Material")); a
	// global-registry lookup can return a DIFFERENT material's member offsets.
	// The formulaic naming below is the deterministic source for material UBs.
	const bool bIsMaterialUB = Derived.Equals(TEXT("Material"), ESearchCase::CaseSensitive) || Derived.Equals(TEXT("MaterialVS"), ESearchCase::CaseSensitive);
	if (!Derived.IsEmpty() && !bIsMaterialUB)
	{
		if (FShaderParametersMetadata* Meta = FindUniformBufferStructByName(*Derived))
		{
			TFunction<void(const FShaderParametersMetadata&, const FString&, uint32)> Walk =
				[&NamesByOffset, &Walk](const FShaderParametersMetadata& M, const FString& Prefix, uint32 Base)
			{
				for (const FShaderParametersMetadata::FMember& Mem : M.GetMembers())
				{
					const EUniformBufferBaseType T = Mem.GetBaseType();
					if (T == UBMT_NESTED_STRUCT || T == UBMT_INCLUDED_STRUCT)
					{
						if (Mem.GetStructMetadata())
						{
							const FString SubPrefix = (T == UBMT_NESTED_STRUCT) ? (Prefix + Mem.GetName() + TEXT("_")) : Prefix;
							Walk(*Mem.GetStructMetadata(), SubPrefix, Base + Mem.GetOffset());
						}
					}
					else if (T == UBMT_TEXTURE || T == UBMT_SAMPLER || T == UBMT_SRV)
					{
						NamesByOffset.Add(Base + Mem.GetOffset(), Prefix + Mem.GetName());
					}
				}
			};
			Walk(*Meta, TEXT(""), 0);
		}
	}
	uint32 NumByClass[4] = {}; // 2D, Cube, 2DArray, Volume
	static const TCHAR* const ClassPrefix[4] = { TEXT("Texture2D"), TEXT("TextureCube"), TEXT("Texture2DArray"), TEXT("VolumeTexture") };
	FString LastFormulaicTexName;
	uint32 NumTailSamplers = 0;
	bool bAnyFormulaic = false;
	for (const FRHIUniformBufferResource& R : Layout.Resources)
	{
		const int32 _ri = (int32)(&R - Layout.Resources.GetData());
		FRHIResource* Res = (GWndrPreResolvedRes && GWndrPreResolvedRes->IsValidIndex(_ri)) ? (*GWndrPreResolvedRes)[_ri].GetReference()
			: GetShaderParameterResourceRHI(Contents, R.MemberOffset, (EUniformBufferBaseType)R.MemberType); // wndr RDGRES-fix-1
		FString Name;
		if (const FString* Found = NamesByOffset.Find((uint32)R.MemberOffset))
		{
			Name = *Found;
		}
		else if (R.MemberType == UBMT_TEXTURE)
		{
			int32 Class = 0;
			if (FRHITexture* Tex = static_cast<FRHITexture*>(Res))
			{
				switch (Tex->GetDesc().Dimension)
				{
				case ETextureDimension::TextureCube: case ETextureDimension::TextureCubeArray: Class = 1; break;
				case ETextureDimension::Texture2DArray: Class = 2; break;
				case ETextureDimension::Texture3D: Class = 3; break;
				default: Class = 0; break;
				}
			}
			Name = FString::Printf(TEXT("%s_%u"), ClassPrefix[Class], NumByClass[Class]++);
			LastFormulaicTexName = Name;
			bAnyFormulaic = true;
		}
		else if (R.MemberType == UBMT_SAMPLER)
		{
			if (!LastFormulaicTexName.IsEmpty())
			{
				Name = LastFormulaicTexName + TEXT("Sampler");
				LastFormulaicTexName.Reset();
			}
			else
			{
				// Standalone samplers past the texture/sampler pairs: the
				// material UB tail is Wrap_WorldGroupSettings then
				// Clamp_WorldGroupSettings (MaterialUniformExpressions.cpp:960).
				static const TCHAR* const TailSamplers[2] = { TEXT("Wrap_WorldGroupSettings"), TEXT("Clamp_WorldGroupSettings") };
				if (NumTailSamplers < 2) { Name = TailSamplers[NumTailSamplers]; }
				++NumTailSamplers;
				bAnyFormulaic = true;
			}
		}
		FDawnUniformBuffer::FTableEntry E;
		E.WgslName = MoveTemp(Name);
		// WNDR resource-lifetime guard (2026-08-20): Res is a RAW pointer read from the UB CPU
		// contents. A material/texture being streamed out or GC-freed mid-frame can be mid-deletion
		// (MarkedForDelete/DeletingBit set, refs==0). Assigning it to the TRefCountPtr AddRefs it ->
		// RHIResources.h:189 assert "Resource is being deleted." and aborts the whole client. Peek
		// IsValid() (not-marked-for-delete AND refs>0, no AddRef); if the resource is dead/dying leave
		// the entry null. TryUBTable skips null entries so the binding dummy-fills -- identical to a
		// fully-freed WGPU handle -- and the deletion proceeds unblocked. (World may show some dummy
		// textures for the freed materials; that is expected and fixed separately.)
		if (Res && Res->IsValid())
		{
			E.Resource = Res;
		}
		E.MemberType = (uint8)R.MemberType;
		UB->ResTable.Add(MoveTemp(E));
	}
	// Material UBs: the WGSL var is named "Material" (FUniformExpressionSet's
	// shader variable name), regardless of the layout's per-material debug
	// name — the formulaic entries are the tell.
	UB->ShaderName = bIsMaterialUB ? TEXT("Material") : ((bAnyFormulaic && NamesByOffset.Num() == 0) ? TEXT("Material") : Derived);
	// MATCAP diag: prove the material capture end-to-end (first 8 material UBs:
	// every entry's type/offset/pointer/name).
	if (bIsMaterialUB)
	{
		static uint32 _mc = 0;
		if (_mc++ < 8)
		{
			printf("DAWNBG MATCAP #%u dbg=%s res=%d size=%u\n", _mc, TCHAR_TO_UTF8(*Layout.GetDebugName()), Layout.Resources.Num(), Layout.ConstantBufferSize);
			for (int32 Ti = 0; Ti < UB->ResTable.Num(); ++Ti)
			{
				printf("DAWNBG MATCAP   [%d] type=%d off=%u ptr=%p name=%s\n", Ti, (int)Layout.Resources[Ti].MemberType, (uint32)Layout.Resources[Ti].MemberOffset, (void*)UB->ResTable[Ti].Resource.GetReference(), TCHAR_TO_UTF8(*UB->ResTable[Ti].WgslName));
			}
			fflush(stdout);
		}
	}
	static uint32 _rt = 0; ++_rt;
	if (GDawnVerboseBindLog && (_rt <= 16 || (_rt % 5000) == 0))
	{
		printf("DAWNBG UBRESTABLE #%u ub=%s entries=%d (dbg=%s)\n", _rt, TCHAR_TO_UTF8(*UB->ShaderName), UB->ResTable.Num(), TCHAR_TO_UTF8(*Layout.GetDebugName()));
		fflush(stdout);
	}
}

FUniformBufferRHIRef FDawnDynamicRHI::RHICreateUniformBuffer(const void* Contents, const FRHIUniformBufferLayout* Layout, EUniformBufferUsage Usage, EUniformBufferValidation Validation)
{
	// UBLAYOUT diag: one line per DISTINCT layout name — which UBs exist, and
	// which carry resource tables (bounded set; answers "was Material ever
	// created, with how many resources, under what debug name").
	{
		static TSet<FString> _seenLayouts;
		if (Layout && _seenLayouts.Num() < 256)
		{
			const FString LN = Layout->GetDebugName();
			if (GDawnVerboseBindLog && (!_seenLayouts.Contains(LN)))
			{
				_seenLayouts.Add(LN);
				printf("DAWNBG UBLAYOUT name=%s res=%d size=%u contents=%d\n", TCHAR_TO_UTF8(*LN), Layout->Resources.Num(), Layout->ConstantBufferSize, Contents ? 1 : 0);
				fflush(stdout);
			}
		}
	}
	FDawnUniformBuffer* UB = new FDawnUniformBuffer(Layout);

	// WebGPU buffers must be a multiple of 4 bytes for wgpuQueueWriteBuffer;
	// UE's constant buffers are already 16-byte aligned in practice, but
	// round up defensively.
	const uint32 Size = Align(FMath::Max<uint32>(Layout->ConstantBufferSize, 4), 4);

	WGPUBufferDescriptor BufDesc = {};
	// Storage as well as Uniform: some WGSL slots the engine fills with a
	// uniform buffer are declared var<storage, read> by the cooked shader
	// (instanced-view / fog data) — the buffer needs the Storage usage bit
	// or the bind group is rejected. Combined Uniform|Storage usage is legal
	// WebGPU; the per-binding layout type governs actual access.
	BufDesc.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_Storage | WGPUBufferUsage_CopyDst;
	BufDesc.size = Size;
	UB->Buffer = wgpuDeviceCreateBuffer(Device, &BufDesc);
	checkf(UB->Buffer, TEXT("DawnRHI: uniform buffer creation failed"));
	DawnUBRegistryAdd(UB); // UBREGISTRY

	// PRIMCREATE (sliver investigation): count EVERY Primitive-layout UB
	// creation, contents or not — real per-primitive UBs are created EMPTY
	// (FPrimitiveSceneProxy::CreateUniformBuffer -> CreateEmptyUniformBuffer-
	// Immediate) and filled later via RHIUpdateUniformBuffer, so the
	// PRIMUB-with-contents dump below never sees them (why only the identity
	// #1 appeared).
	if (DAWNRHI_VERBOSE_DIAG)
	{
		const FString _pn = Layout->GetDebugName();
		if (_pn.Contains(TEXT("Primitive")) && Layout->ConstantBufferSize >= 512)
		{
			static uint32 _pc=0; ++_pc;
			if (_pc <= 8 || (_pc % 500) == 0) { UE_LOG(LogDawnRHI, Warning, TEXT("PRIMCREATE #%u name=%s size=%u contents=%d buf=%p"), _pc, *_pn, Layout->ConstantBufferSize, Contents?1:0, (void*)UB->Buffer); }
		}
	}

	if (Contents && Layout->ConstantBufferSize > 0)
	{
		// LWC FOLD: upload a mutated copy for FPrimitiveUniformShaderParameters
		// (PositionHigh folded into the matrix translation) — see
		// DawnFoldPrimitivePositionHigh above. UE's source memory is untouched.
		{
			TArray<uint8> Folded;
			const void* Upload = DawnFoldViewPreViewTranslation(*Layout, Contents, Folded) ? (const void*)Folded.GetData()
			                   : DawnFoldPrimitivePositionHigh(*Layout, Contents, Folded) ? (const void*)Folded.GetData()
			                   : DawnZeroMobileFog(*Layout, Contents, Folded)              ? (const void*)Folded.GetData()
			                   : Contents;
			wgpuQueueWriteBuffer(Queue, UB->Buffer, 0, Upload, Layout->ConstantBufferSize);
			DawnDumpViewUB(*Layout, Contents, (const void*)UB->Buffer);
			DawnDumpMobileBasePassUB(*Layout, Contents, (const void*)UB->Buffer);
			DawnCaptureUBResourceTable(UB, Contents); // UBRESTABLE
			// CLIPPROBE caches: the exact bytes uploaded to the GPU.
			{
				const FString _cn = (*Layout).GetDebugName();
				const uint32 _cs = (*Layout).ConstantBufferSize;
				if (_cs >= 768 && _cs <= 1024 && _cn.Contains(TEXT("Primitive")) && !_cn.Contains(TEXT("Batched")))
				{
					GDawnLastPrimUBUpload.SetNumUninitialized((int32)_cs);
					FMemory::Memcpy(GDawnLastPrimUBUpload.GetData(), Upload, _cs);
				}
				else if (_cs >= 4096 && _cn.Contains(TEXT("View")) && !_cn.Contains(TEXT("Slate")))
				{
					GDawnLastViewUBData.SetNumUninitialized((int32)_cs);
					FMemory::Memcpy(GDawnLastViewUBData.GetData(), Upload, _cs);
				}
			}

	// LWCDIAG (invisible-world hunt, always-on 3-shot): the authoritative
	// CPU-side Primitive layout (FShaderParametersMetadata offsets — the same
	// definition the cooked HLSL was compiled from) + the live values of the
	// first non-identity Primitive UBs. Compare against the WGSLPRIM struct
	// dump from PSO create: an offset skew between the two IS the world-
	// collapse root cause; matching offsets exonerate the layout and indict
	// the VS's DF math (see LWCVS2 dumps).
	{
		static uint32 _lwcCpu = 0;
		if (_lwcCpu < 3 && Contents && Layout->ConstantBufferSize >= 512 && Layout->ConstantBufferSize <= 1024)
		{
			const FString N = Layout->GetDebugName();
			if (N.Contains(TEXT("Primitive")) && !N.Contains(TEXT("Batched")))
			{
				const float* F = (const float*)Contents;
				if (!(F[4] == 0.f && F[5] == 0.f && F[6] == 0.f)) // skip identity UBs
				{
					++_lwcCpu;
					if (_lwcCpu == 1)
					{
						if (FShaderParametersMetadata* Meta = FindUniformBufferStructByName(TEXT("Primitive")))
						{
							for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
							{
								if (FCString::Strstr(M.GetName(), TEXT("LocalToRelativeWorld")) || FCString::Strstr(M.GetName(), TEXT("PositionHigh")) || FCString::Strstr(M.GetName(), TEXT("RelativeWorld")) || FCString::Strstr(M.GetName(), TEXT("InvNonUniformScale")))
								{
									printf("DAWNBG LWCCPU member %s @byte %u\n", TCHAR_TO_UTF8(M.GetName()), M.GetOffset());
								}
							}
						}
					}
					printf("DAWNBG LWCCPU #%u sz=%u High(f4..6)=[%.1f %.1f %.1f] L2RWrow0(f8..11)=[%.3f %.3f %.3f %.3f] L2RWtrans(f20..22)=[%.1f %.1f %.1f]\n",
						_lwcCpu, Layout->ConstantBufferSize, F[4], F[5], F[6], F[8], F[9], F[10], F[11], F[20], F[21], F[22]);
					fflush(stdout);
				}
			}
		}
	}
		}
		if (DAWNRHI_VERBOSE_DIAG)
		{
			const FString UBName = Layout->GetDebugName();
			static uint32 _ubn=0; if (_ubn++ < 40) { UE_LOG(LogTemp, Warning, TEXT("UBNAME %s size=%u"), *UBName, Layout->ConstantBufferSize); }
			// Dump the View UB matrix rows to check the view/projection transform is sane.
			// LWC-COLLAPSE DIAG: dump named members at UE's OWN metadata offsets
			// (FindUniformBufferStructByName — the same struct definition the
			// cooked HLSL/WGSL was compiled from, so these offsets are the
			// authoritative CPU-side layout). Used for Primitive (LocalTo-
			// RelativeWorld translation + PositionHigh) vs View (PreView-
			// Translation / tile fields) magnitude comparison — a mismatch
			// (e.g. zeroed PreViewTranslation against large world positions,
			// or inconsistent tiles) collapses all geometry to a point.
			auto DumpUBMembers = [&](const TCHAR* MetaName, const TCHAR* Tag, std::initializer_list<const TCHAR*> Wanted)
			{
				FShaderParametersMetadata* Meta = FindUniformBufferStructByName(MetaName);
				if (!Meta) { UE_LOG(LogDawnRHI, Warning, TEXT("%s: no metadata for struct '%s'"), Tag, MetaName); return; }
				const uint32 CbSize = Layout->ConstantBufferSize;
				for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
				{
					for (const TCHAR* W : Wanted)
					{
						if (FCString::Stricmp(M.GetName(), W) != 0) { continue; }
						const uint32 Off = M.GetOffset();
						const uint32 NumF = FMath::Min<uint32>((CbSize > Off) ? (CbSize - Off) / 4 : 0, FCString::Strstr(M.GetName(), TEXT("ToClip")) ? 16 : 4);
						const float* F = (const float*)((const uint8*)Contents + Off);
						switch (NumF)
						{
						case 0: break;
						case 16: UE_LOG(LogDawnRHI, Warning, TEXT("%s %s@%u = [%.3f %.3f %.3f %.3f][%.3f %.3f %.3f %.3f][%.3f %.3f %.3f %.3f][%.3f %.3f %.3f %.3f]"), Tag, M.GetName(), Off, F[0],F[1],F[2],F[3],F[4],F[5],F[6],F[7],F[8],F[9],F[10],F[11],F[12],F[13],F[14],F[15]); break;
						default: UE_LOG(LogDawnRHI, Warning, TEXT("%s %s@%u = [%.3f %.3f %.3f %.3f]"), Tag, M.GetName(), Off, F[0], NumF>1?F[1]:0.f, NumF>2?F[2]:0.f, NumF>3?F[3]:0.f); break;
						}
					}
				}
			};
			if (UBName.Contains(TEXT("Primitive")) && Layout->ConstantBufferSize >= 512)
			{
				// First few catch whatever creates earliest; the periodic re-dump
				// catches live scene primitives. Translation row of the row-major
				// LocalToRelativeWorld = floats 12..14 of the 16 dumped.
				static uint32 _pd=0; ++_pd;
				if (_pd <= 6 || (_pd % 5000) == 0)
				{
					UE_LOG(LogDawnRHI, Warning, TEXT("PRIMUB #%u %s sz=%u"), _pd, *UBName, Layout->ConstantBufferSize);
					DumpUBMembers(TEXT("Primitive"), TEXT("PRIMUB"), { TEXT("LocalToRelativeWorld"), TEXT("PositionHigh"), TEXT("ObjectWorldPositionHighAndRadius"), TEXT("ObjectWorldPositionLow"), TEXT("InvNonUniformScale") });
				}
			}
			if (UBName.Contains(TEXT("View")) && !UBName.Contains(TEXT("Slate")) && Layout->ConstantBufferSize >= 64)
			{
				// First 4 catch boot/menu views; the periodic re-dump catches the
				// LIVE in-game camera (View UBs are recreated per frame) so the
				// WorldToClip can be sanity-checked against the player/warmup cam.
				static uint32 _vw=0; if (_vw++ < 4 || (_vw % 600) == 0) { const float* F=(const float*)Contents;
					UE_LOG(LogTemp, Warning, TEXT("VIEWUB %s sz=%u m[0..15]=[%.3f %.3f %.3f %.3f][%.3f %.3f %.3f %.3f][%.3f %.3f %.3f %.3f][%.3f %.3f %.3f %.3f]"), *UBName, Layout->ConstantBufferSize, F[0],F[1],F[2],F[3],F[4],F[5],F[6],F[7],F[8],F[9],F[10],F[11],F[12],F[13],F[14],F[15]);
					DumpUBMembers(TEXT("View"), TEXT("VIEWUB"), { TEXT("PreViewTranslation"), TEXT("PreViewTranslationHigh"), TEXT("PreViewTranslationLow"), TEXT("ViewTilePosition"), TEXT("RelativeWorldCameraOrigin"), TEXT("ViewOriginHigh"), TEXT("ViewOriginLow"), TEXT("RelativeWorldViewOriginHigh"), TEXT("RelativeWorldViewOriginLow"), TEXT("TranslatedWorldToClip") });
					// One-shot: list every View member whose name mentions the LWC
					// tile/translation machinery, with offsets — shows exactly which
					// fields exist in THIS engine's View struct.
					static bool _lm=false;
					if (!_lm)
					{
						_lm = true;
						if (FShaderParametersMetadata* Meta = FindUniformBufferStructByName(TEXT("View")))
							for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
								if (FCString::Strstr(M.GetName(), TEXT("PreView")) || FCString::Strstr(M.GetName(), TEXT("Tile")) || FCString::Strstr(M.GetName(), TEXT("ViewOrigin")) || FCString::Strstr(M.GetName(), TEXT("CameraOrigin")))
									UE_LOG(LogDawnRHI, Warning, TEXT("VIEWMEMBER %s @%u"), M.GetName(), M.GetOffset());
					}
				}
			}
		}
	}
	return UB;
}

void FDawnDynamicRHI::RHIUpdateUniformBuffer(FRHICommandListBase& RHICmdList, FRHIUniformBuffer* UniformBufferRHI, const void* Contents)
{
	// Slate (and the renderer) push fresh per-frame constants through here; a
	// no-op leaves shaders reading stale/zero uniforms -> nothing visible.
	FDawnUniformBuffer* UB = static_cast<FDawnUniformBuffer*>(UniformBufferRHI);
	// wndr UBRACE-fix-1: run the update (GPU write + ResTable swap) on the RHI
	// thread, in command order, so it never races the bind-time ResTable reads.
	if (UB && UB->Buffer && Contents && !RHICmdList.IsBottomOfPipe())
	{
		const FRHIUniformBufferLayout& L = UB->GetLayout();
		uint32 CopySize = L.ConstantBufferSize;
		for (const FRHIUniformBufferResource& R : L.Resources) { CopySize = FMath::Max<uint32>(CopySize, (uint32)R.MemberOffset + (uint32)sizeof(void*)); }
		void* Copy = RHICmdList.Alloc(CopySize, 16);
		FMemory::Memcpy(Copy, Contents, CopySize);
		TRefCountPtr<FRHIUniformBuffer> Keep(UniformBufferRHI);
		// wndr UBRACE-fix-2: hold counted refs to the contents' resources until the update runs.
		TArray<TRefCountPtr<FRHIResource>> KeepRes;
		for (const FRHIUniformBufferResource& R : L.Resources)
		{
			FRHIResource* Res = GetShaderParameterResourceRHI(Contents, R.MemberOffset, (EUniformBufferBaseType)R.MemberType); // wndr RDGRES-fix-1
			KeepRes.Emplace((Res && Res->IsValid()) ? Res : nullptr); // index-aligned with L.Resources
		}
		RHICmdList.EnqueueLambda(TEXT("DawnUpdateUniformBuffer"), [this, Keep, Copy, KeepRes = MoveTemp(KeepRes)](FRHICommandListBase& Cmd)
		{
			GWndrPreResolvedRes = &KeepRes; // wndr RDGRES-fix-1
			RHIUpdateUniformBuffer(Cmd, Keep.GetReference(), Copy);
			GWndrPreResolvedRes = nullptr;
		});
		return;
	}
	if (UB && UB->Buffer && Contents)
	{
		const uint32 Size = UB->GetLayout().ConstantBufferSize;
		if (Size > 0)
		{
			// LWC FOLD: same PositionHigh->matrix-translation fold as the create
			// path — per-primitive UBs are created EMPTY and get their real data
			// HERE, so this is the site that matters for scene placement.
			{
				TArray<uint8> Folded;
				const void* Upload = DawnFoldViewPreViewTranslation(UB->GetLayout(), Contents, Folded) ? (const void*)Folded.GetData()
				                   : DawnFoldPrimitivePositionHigh(UB->GetLayout(), Contents, Folded) ? (const void*)Folded.GetData()
				                   : DawnZeroMobileFog(UB->GetLayout(), Contents, Folded)              ? (const void*)Folded.GetData()
				                   : Contents;
				wgpuQueueWriteBuffer(Queue, UB->Buffer, 0, Upload, Size);
				DawnDumpViewUB(UB->GetLayout(), Contents, (const void*)UB->Buffer);
				DawnDumpMobileBasePassUB(UB->GetLayout(), Contents, (const void*)UB->Buffer);
				DawnCaptureUBResourceTable(UB, Contents); // UBRESTABLE
			// CLIPPROBE caches: the exact bytes uploaded to the GPU.
			{
				const FString _cn = UB->GetLayout().GetDebugName();
				const uint32 _cs = UB->GetLayout().ConstantBufferSize;
				if (_cs >= 768 && _cs <= 1024 && _cn.Contains(TEXT("Primitive")) && !_cn.Contains(TEXT("Batched")))
				{
					GDawnLastPrimUBUpload.SetNumUninitialized((int32)_cs);
					FMemory::Memcpy(GDawnLastPrimUBUpload.GetData(), Upload, _cs);
				}
				else if (_cs >= 4096 && _cn.Contains(TEXT("View")) && !_cn.Contains(TEXT("Slate")))
				{
					GDawnLastViewUBData.SetNumUninitialized((int32)_cs);
					FMemory::Memcpy(GDawnLastViewUBData.GetData(), Upload, _cs);
				}
			}

			}
			// PRIMUPDATE (sliver investigation): real per-primitive UBs are
			// filled HERE (created empty). Dump PositionHigh (@16 -> floats
			// 4..6), LocalToRelativeWorld (@32 -> floats 8..23: translation
			// row = floats 20..22, diagonal = 8/13/18). If these carry real
			// world positions the CPU side is healthy and the fault is at
			// bind time; if no PRIMUPDATE ever fires, proxies never update
			// (UseGPUScene gating mismatch).
			if (/* LWCDIAG: un-gated 2026-08-18 (CPU-side values at the REAL data site) */ Size >= 512)
			{
				const FString _un = UB->GetLayout().GetDebugName();
				if (_un.Contains(TEXT("Primitive")))
				{
					static uint32 _pu=0; ++_pu;
					if (GDawnVerboseBindLog && (_pu <= 10 || (_pu % 2000) == 0))
					{
						const float* F = (const float*)Contents;
						printf("DAWNBG PRIMUPDATE #%u sz=%u posHigh=[%.1f %.1f %.1f] L2RW-trans=[%.1f %.1f %.1f] diag=[%.2f %.2f %.2f]\n", _pu, Size, F[4],F[5],F[6], F[20],F[21],F[22], F[8],F[13],F[18]);
						fflush(stdout);
					}
					// LWCCPU (fix: the create-path twin never fired — real
					// per-primitive UBs are created EMPTY and filled HERE):
					// one-shot authoritative CPU metadata offsets.
					static bool _lwcOff = false;
					if (!_lwcOff)
					{
						_lwcOff = true;
						if (FShaderParametersMetadata* Meta = FindUniformBufferStructByName(TEXT("Primitive")))
						{
							for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
							{
								if (FCString::Strstr(M.GetName(), TEXT("LocalToRelativeWorld")) || FCString::Strstr(M.GetName(), TEXT("PositionHigh")) || FCString::Strstr(M.GetName(), TEXT("InvNonUniformScale")) || FCString::Strstr(M.GetName(), TEXT("RelativeWorldToLocal")))
								{
									printf("DAWNBG LWCCPU member %s @byte %u\n", (const char*)StringCast<UTF8CHAR>(M.GetName()).Get(), M.GetOffset());
								}
							}
							fflush(stdout);
						}
					}
				}
			}
		}
	}
}

