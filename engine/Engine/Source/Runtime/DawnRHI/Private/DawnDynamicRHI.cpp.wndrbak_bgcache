void FDawnDynamicRHI::RHIGetTextureMemoryStats(FTextureMemoryStats& OutStats)
{
	// MEMSTATS fix (the ~18-minute in-match fatal): this was a checkNoEntry()
	// stub. Its FIRST live call arrived mid-match — GetMaxReflectionCapturesAtSize
	// (ReflectionEnvironmentCapture.cpp) sizing the reflection-capture cubemap
	// array budget-checks through here (GPU benchmark and any texture streamer
	// would too) — and the assert aborted the game; the
	// "Archive destroyed before its proxies" (Archive.cpp:171) fatal that
	// followed was StaticShutdownAfterError tearing down an in-flight
	// async-load archive during the abort, not an independent bug.
	//
	// Report the wasm/browser reality: one unified 12GB heap (Emscripten
	// MAXIMUM_MEMORY on wasm64) shared by CPU and the WebGPU device. Mirrors
	// FVulkanDynamicRHI::RHIGetTextureMemoryStats' shape (baseline fill +
	// hardware totals); generous headroom with zero tracked pressure means no
	// caller ever takes an eviction/teardown path.
	UE::RHICore::FillBaselineTextureMemoryStats(OutStats); // Streaming/NonStreaming sizes + TexturePoolSize from GRHIGlobals tracking
	const int64 UnifiedHeapBytes = 12ll << 30; // 12288 MB
	OutStats.DedicatedVideoMemory  = UnifiedHeapBytes;
	OutStats.DedicatedSystemMemory = UnifiedHeapBytes;
	OutStats.SharedSystemMemory    = UnifiedHeapBytes; // all three >= 0 => AreHardwareStatsValid()
	OutStats.TotalGraphicsMemory   = UnifiedHeapBytes;
	if (OutStats.TexturePoolSize <= 0)
	{
		// This RHI doesn't run a texture pool; expose half the heap as the
		// notional pool so IsUsingLimitedPoolSize() consumers see a large,
		// non-degenerate budget (ComputeAvailableMemorySize() ~= 6GB).
		OutStats.TexturePoolSize = UnifiedHeapBytes / 2;
	}
	// No fragmentation tracking on a browser-managed heap: report the pool as
	// contiguous (Vulkan reports its allocated streaming size here; anything
	// >= a plausible allocation keeps "can I fit X" checks permissive).
	OutStats.LargestContiguousAllocation = OutStats.TexturePoolSize;
}

