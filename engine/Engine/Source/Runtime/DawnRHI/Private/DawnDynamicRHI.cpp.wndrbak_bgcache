#if DAWNRHI_WASM
#include <emscripten.h>
#endif
static void WaitForQueueIdle(WGPUInstance Instance, WGPUQueue Queue)
{
#if DAWNRHI_WASM
	// On wasm the queue work-done callback does not fire during a synchronous
	// game-thread wait (even with a JSPI yield), so blocking for GPU idle here
	// deadlocks / stack-overflows the first frame. The browser synchronises GPU
	// work at present time, so a CPU-side idle wait is unnecessary -- no-op it.
	return;
#endif
	bool bDone = false;
	WGPUQueueWorkDoneCallbackInfo CbInfo = {};
	CbInfo.mode = WGPUCallbackMode_AllowSpontaneous;
	CbInfo.callback = [](WGPUQueueWorkDoneStatus, WGPUStringView, void* Userdata1, void*)
	{
		*reinterpret_cast<bool*>(Userdata1) = true;
	};
	CbInfo.userdata1 = &bDone;
	WGPUFuture F = wgpuQueueOnSubmittedWorkDone(Queue, CbInfo);
	(void)F;
	for (int32 i = 0; i < 200000 && !bDone; ++i)
	{
#if DAWNRHI_WASM
		// wgpuInstanceWaitAny does not yield to the browser event loop on wasm (no
		// PROXY_TO_PTHREAD), so the AllowSpontaneous work-done callback never fires
		// and this wait deadlocks. Yield via JSPI emscripten_sleep so the browser
		// services the callback (same pattern the device acquisition uses).
		emscripten_sleep(1);
#else
		WGPUFutureWaitInfo WaitInfo = {};
		WaitInfo.future = F;
		wgpuInstanceWaitAny(Instance, 1, &WaitInfo, 1000000 /* 1ms */);
#endif
	}
}

