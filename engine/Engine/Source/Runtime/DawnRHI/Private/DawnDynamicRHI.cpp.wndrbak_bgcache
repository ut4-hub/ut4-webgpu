static WGPUShaderModule CompileWGSL(WGPUDevice Device, const FRHICreateShaderDesc& CreateShaderDesc, const TCHAR* DebugLabel, bool bRemapPixelGroup = false, const TArray<uint8>* OverrideUtf8 = nullptr)
{
	// Stage 1 shader contract (ours, not SimplyStream's): Code is UTF-8 WGSL
	// source text. Stage 3 replaces the *producer* of this text (hand-authored
	// -> HLSL->SPIR-V->WGSL via ShaderConductor+Tint) without changing this
	// consumer. Pass the bytes straight through with an explicit length —
	// no TCHAR round-trip, no reliance on WGPU_STRLEN's null-termination
	// assumption (an earlier version round-tripped through FString/UTF8CHAR
	// and fed Dawn's WGSL parser a corrupted/mis-terminated buffer).
	WGPUShaderSourceWGSL WgslDesc = {};
	WgslDesc.chain.sType = WGPUSType_ShaderSourceWGSL;
	// Code.Num() is the FULL FShaderCode buffer = WGSL text + UE trailing optional-data
	// blob. Feeding the whole thing to the WGSL parser makes it read garbage past the
	// shader end ("invalid character found"). Use the actual code size (minus optional data).
	FShaderCodeReader WgslCodeReader(CreateShaderDesc.Code);
	size_t WgslCodeLen = (size_t)WgslCodeReader.GetActualShaderCodeSize();
	const char* WgslCodePtr = reinterpret_cast<const char*>(CreateShaderDesc.Code.GetData());
	// TONEMAPFIX: caller-patched WGSL replaces the cooked bytes (see
	// RHICreatePixelShader's base-pass exposure/Reinhard wrap).
	if (OverrideUtf8 && OverrideUtf8->Num() > 0)
	{
		WgslCodePtr = reinterpret_cast<const char*>(OverrideUtf8->GetData());
		WgslCodeLen = (size_t)OverrideUtf8->Num();
	}
	TArray<uint8> RemapBuf;
	if (bRemapPixelGroup)
	{
		// Raw-byte @group(0)->@group(1) remap (same byte length; avoids a lossy TCHAR
		// round-trip that corrupts the WGSL). Only the single digit after '(' changes.
		RemapBuf.Append(reinterpret_cast<const uint8*>(WgslCodePtr), (int32)WgslCodeLen);
		for (int32 i = 0; i + 8 < RemapBuf.Num(); )
		{
			if (RemapBuf[i] == (uint8)'@' && FMemory::Memcmp(&RemapBuf[i], "@group(0", 8) == 0 && (RemapBuf[i+8] == (uint8)')' || RemapBuf[i+8] == (uint8)'u'))
			{
				RemapBuf[i+7] = (uint8)'1';
				i += 8;
			}
			else { ++i; }
		}
		WgslCodePtr = reinterpret_cast<const char*>(RemapBuf.GetData());
	}
	WgslDesc.code = { WgslCodePtr, WgslCodeLen };

	WGPUShaderModuleDescriptor ModuleDesc = {};
	ModuleDesc.nextInChain = &WgslDesc.chain;

	auto LabelUtf8 = StringCast<UTF8CHAR>(DebugLabel);
	ModuleDesc.label = { reinterpret_cast<const char*>(LabelUtf8.Get()), WGPU_STRLEN };

	return wgpuDeviceCreateShaderModule(Device, &ModuleDesc);
}

// Milestone step 1/2: real cooked WGSL keeps the real UE shader's own entry
// point name (e.g. "ScreenPassVS"/"CopyRectPS"), NOT the Stage 1 fixed
// "vs_main"/"fs_main" convention (see FDawnVertexShader/FDawnPixelShader
// ::EntryPoint in DawnResources.h). Scan for the real @vertex/@fragment
// attribute's following "fn <Name>(" -- this is real WGSL grammar (the
// attribute always immediately precedes the function it decorates), not a
// guess. Falls back to the old fixed name if not found, so the still-
// supported Stage 1/2 hand-authored WGSL paths (whose source has no
// @vertex/@fragment attribute at all -- see GVertexWGSL/GPixelWGSL in
// DawnRHITestMain.cpp) are unaffected.
static FString ParseWgslEntryPoint(const FString& Wgsl, const TCHAR* Attribute, const TCHAR* FallbackName)
{
	int32 AttrIdx = Wgsl.Find(Attribute);
	if (AttrIdx == INDEX_NONE)
	{
		return FallbackName;
	}
	int32 FnIdx = Wgsl.Find(TEXT("fn "), ESearchCase::CaseSensitive, ESearchDir::FromStart, AttrIdx);
	if (FnIdx == INDEX_NONE)
	{
		return FallbackName;
	}
	int32 NameStart = FnIdx + 3;
	int32 ParenIdx = Wgsl.Find(TEXT("("), ESearchCase::CaseSensitive, ESearchDir::FromStart, NameStart);
	if (ParenIdx == INDEX_NONE || ParenIdx <= NameStart)
	{
		return FallbackName;
	}
	return Wgsl.Mid(NameStart, ParenIdx - NameStart).TrimStartAndEnd();
}

// Parse @group(G) @binding(B) var[<addrspace>] name : type; declarations out of the
// cooked WGSL so the PSO bind-group layout matches EXACTLY what each shader declares
// (the old fixed {UB@0,Tex@1,Sampler@2} table mismatched real Slate shaders -> Dawn
// "Number of entries did not match" -> nothing drew). Runtime-side reflection; the
// WGSL is well-formed tint output.
static void ParseWgslBindings(const FString& Wgsl, TArray<FDawnShaderBinding>& Out)
{
	int32 Pos = 0;
	while (true)
	{
		int32 G = Wgsl.Find(TEXT("@group("), ESearchCase::CaseSensitive, ESearchDir::FromStart, Pos);
		if (G == INDEX_NONE) { break; }
		Pos = G + 7;
		int32 GEnd = Wgsl.Find(TEXT(")"), ESearchCase::CaseSensitive, ESearchDir::FromStart, Pos);
		if (GEnd == INDEX_NONE) { break; }
		const uint32 Group = (uint32)FCString::Atoi(*Wgsl.Mid(Pos, GEnd - Pos));
		int32 B = Wgsl.Find(TEXT("@binding("), ESearchCase::CaseSensitive, ESearchDir::FromStart, GEnd);
		if (B == INDEX_NONE) { break; }
		int32 BStart = B + 9;
		int32 BEnd = Wgsl.Find(TEXT(")"), ESearchCase::CaseSensitive, ESearchDir::FromStart, BStart);
		if (BEnd == INDEX_NONE) { break; }
		const uint32 Binding = (uint32)FCString::Atoi(*Wgsl.Mid(BStart, BEnd - BStart));
		// Declaration body: from here to the next ';'.
		int32 Semi = Wgsl.Find(TEXT(";"), ESearchCase::CaseSensitive, ESearchDir::FromStart, BEnd);
		if (Semi == INDEX_NONE) { break; }
		const FString Decl = Wgsl.Mid(BEnd, Semi - BEnd);
		Pos = Semi;
		EDawnShaderBindingKind Kind;
		// Texture-dimension support: the bind-group LAYOUT entry must match the
		// dimension the WGSL declares (Dawn validates layout vs shader at
		// CreateRenderPipeline). Parse it here off the declaration text. Longest
		// prefixes first (texture_cube_array before texture_cube, depth variants
		// before their non-depth base). Anything unrecognised keeps 2D/Float —
		// the previous hardcoded behaviour.
		WGPUTextureViewDimension TexViewDim = WGPUTextureViewDimension_2D;
		WGPUTextureSampleType TexSampleType = WGPUTextureSampleType_Float;
		bool bComparisonSampler = false;
		// Buffer-binding-type support (same class of bug as the texture
		// dimensions above, but for BUFFERS): the layout entry's buffer.type
		// must match the WGSL address space — var<uniform> -> Uniform,
		// var<storage, read> (or bare var<storage>) -> ReadOnlyStorage,
		// var<storage, read_write> -> Storage. Hardcoding Uniform made Dawn
		// reject the mobile fog VS/PS + instanced-stereo Main pipelines
		// ("ReadOnlyStorage is not compatible with ... Uniform").
		WGPUBufferBindingType BufBindingType = WGPUBufferBindingType_Uniform;
		if (Decl.Contains(TEXT("texture_"), ESearchCase::CaseSensitive))
		{
			Kind = EDawnShaderBindingKind::Texture;
			auto Has = [&Decl](const TCHAR* S) { return Decl.Contains(S, ESearchCase::CaseSensitive); };
			if      (Has(TEXT("texture_depth_cube_array"))) { TexViewDim = WGPUTextureViewDimension_CubeArray; TexSampleType = WGPUTextureSampleType_Depth; }
			else if (Has(TEXT("texture_depth_cube")))       { TexViewDim = WGPUTextureViewDimension_Cube;      TexSampleType = WGPUTextureSampleType_Depth; }
			else if (Has(TEXT("texture_depth_2d_array")))   { TexViewDim = WGPUTextureViewDimension_2DArray;   TexSampleType = WGPUTextureSampleType_Depth; }
			else if (Has(TEXT("texture_depth_2d")))         { TexViewDim = WGPUTextureViewDimension_2D;        TexSampleType = WGPUTextureSampleType_Depth; }
			else if (Has(TEXT("texture_cube_array")))       { TexViewDim = WGPUTextureViewDimension_CubeArray; }
			else if (Has(TEXT("texture_cube")))             { TexViewDim = WGPUTextureViewDimension_Cube; }
			else if (Has(TEXT("texture_2d_array")))         { TexViewDim = WGPUTextureViewDimension_2DArray; }
			else if (Has(TEXT("texture_3d")))               { TexViewDim = WGPUTextureViewDimension_3D; }
			else if (Has(TEXT("texture_1d")))               { TexViewDim = WGPUTextureViewDimension_1D; }
			// else: texture_2d / texture_multisampled_2d / anything else -> 2D
			if (TexSampleType != WGPUTextureSampleType_Depth)
			{
				if      (Decl.Contains(TEXT("<u32>"), ESearchCase::CaseSensitive)) { TexSampleType = WGPUTextureSampleType_Uint; }
				else if (Decl.Contains(TEXT("<i32>"), ESearchCase::CaseSensitive)) { TexSampleType = WGPUTextureSampleType_Sint; }
			}
		}
		else if (Decl.Contains(TEXT(": sampler"), ESearchCase::CaseSensitive) || Decl.Contains(TEXT(":sampler"), ESearchCase::CaseSensitive) || Decl.Contains(TEXT("sampler_"), ESearchCase::CaseSensitive))
		{
			Kind = EDawnShaderBindingKind::Sampler;
			bComparisonSampler = Decl.Contains(TEXT("sampler_comparison"), ESearchCase::CaseSensitive);
		}
		else if (Decl.Contains(TEXT("var<uniform>"), ESearchCase::CaseSensitive)) { Kind = EDawnShaderBindingKind::UniformBuffer; }
		else if (Decl.Contains(TEXT("var<storage"), ESearchCase::CaseSensitive))
		{
			Kind = EDawnShaderBindingKind::UniformBuffer; // still a "buffer" binding; the layout type below carries the storage distinction
			BufBindingType = (Decl.Contains(TEXT("read_write"), ESearchCase::CaseSensitive)) ? WGPUBufferBindingType_Storage : WGPUBufferBindingType_ReadOnlyStorage;
		}
		else { continue; } // unknown resource kind at this group/binding - skip (don't fabricate)
		bool bDup = false;
		for (const FDawnShaderBinding& E : Out) { if (E.Group == Group && E.Binding == Binding) { bDup = true; break; } }
		// Variable name: the identifier after 'var'/'var<...>' and before ':'.
		FString VarName;
		{
			int32 VarPos = Decl.Find(TEXT("var"), ESearchCase::CaseSensitive);
			if (VarPos != INDEX_NONE)
			{
				int32 Q = VarPos + 3;
				if (Q < Decl.Len() && Decl[Q] == TEXT('<')) { int32 C = Decl.Find(TEXT(">"), ESearchCase::CaseSensitive, ESearchDir::FromStart, Q); if (C != INDEX_NONE) { Q = C + 1; } }
				while (Q < Decl.Len() && FChar::IsWhitespace(Decl[Q])) { ++Q; }
				int32 NameStart = Q;
				while (Q < Decl.Len() && (FChar::IsAlnum(Decl[Q]) || Decl[Q] == TEXT('_'))) { ++Q; }
				VarName = Decl.Mid(NameStart, Q - NameStart);
			}
		}
		if (!bDup) { FDawnShaderBinding NB; NB.Group = Group; NB.Binding = Binding; NB.Kind = Kind; NB.Name = VarName; NB.TexViewDim = TexViewDim; NB.TexSampleType = TexSampleType; NB.bComparisonSampler = bComparisonSampler; NB.BufBindingType = BufBindingType; Out.Add(NB); }
	}
}

// VTXPADFIX (frame-3 stall): collect the @location(N) VERTEX INPUTS the
// @vertex entry point actually consumes (direct params + members of
// struct-typed params), with the WGSL base type mapped to a compatible
// 4-component vertex format. Dawn requires EVERY shader-consumed attribute
// slot to be present in the VertexState ("Vertex attribute slot 8 used in
// shader ... is not present in the VertexState") — UE vertex declarations
// legitimately omit streams a shader variant reads (e.g. lightmap UVs), so
// the pipeline build pads the missing locations from a stride-0 dummy stream.
// Only the entry point's own inputs are scanned; @location on the OUTPUT
// struct / fragment IO never enters here.
static void ParseWgslVertexInputs(const FString& Wgsl, TMap<uint32, WGPUVertexFormat>& Out)
{
	const int32 VAttr = Wgsl.Find(TEXT("@vertex"), ESearchCase::CaseSensitive);
	if (VAttr == INDEX_NONE) { return; }
	const int32 FnIdx = Wgsl.Find(TEXT("fn "), ESearchCase::CaseSensitive, ESearchDir::FromStart, VAttr);
	if (FnIdx == INDEX_NONE) { return; }
	const int32 Open = Wgsl.Find(TEXT("("), ESearchCase::CaseSensitive, ESearchDir::FromStart, FnIdx);
	if (Open == INDEX_NONE) { return; }
	int32 Depth = 0, Close = INDEX_NONE;
	for (int32 P = Open; P < Wgsl.Len(); ++P)
	{
		const TCHAR C = Wgsl[P];
		if (C == TEXT('(')) { ++Depth; }
		else if (C == TEXT(')')) { --Depth; if (Depth == 0) { Close = P; break; } }
	}
	if (Close == INDEX_NONE) { return; }
	const FString Params = Wgsl.Mid(Open + 1, Close - Open - 1);
	auto BaseFmt = [](const FString& Ty) -> WGPUVertexFormat
	{
		if (Ty.Contains(TEXT("u32"), ESearchCase::CaseSensitive) || Ty.Contains(TEXT("vec2u")) || Ty.Contains(TEXT("vec3u")) || Ty.Contains(TEXT("vec4u"))) { return WGPUVertexFormat_Uint32x4; }
		if (Ty.Contains(TEXT("i32"), ESearchCase::CaseSensitive) || Ty.Contains(TEXT("vec2i")) || Ty.Contains(TEXT("vec3i")) || Ty.Contains(TEXT("vec4i"))) { return WGPUVertexFormat_Sint32x4; }
		return WGPUVertexFormat_Float32x4;
	};
	auto HandleDecl = [&](const FString& M)
	{
		const int32 L = M.Find(TEXT("@location("), ESearchCase::CaseSensitive);
		if (L == INDEX_NONE) { return; }
		const int32 S = L + 10;
		const int32 E = M.Find(TEXT(")"), ESearchCase::CaseSensitive, ESearchDir::FromStart, S);
		if (E == INDEX_NONE) { return; }
		const uint32 Loc = (uint32)FCString::Atoi(*M.Mid(S, E - S));
		const int32 Colon = M.Find(TEXT(":"), ESearchCase::CaseSensitive, ESearchDir::FromStart, E);
		if (Colon == INDEX_NONE) { return; }
		Out.Add(Loc, BaseFmt(M.Mid(Colon + 1)));
	};
	// Split params on top-level commas (attribute parens like @builtin(...) and
	// generics like vec3<f32> keep their commas nested away by depth tracking).
	TArray<FString> Parts;
	{
		int32 D = 0; FString Cur;
		for (const TCHAR C : Params)
		{
			if (C == TEXT('(') || C == TEXT('<')) { ++D; }
			else if (C == TEXT(')') || C == TEXT('>')) { --D; }
			if (C == TEXT(',') && D == 0) { Parts.Add(Cur); Cur.Empty(); }
			else { Cur += C; }
		}
		if (!Cur.TrimStartAndEnd().IsEmpty()) { Parts.Add(Cur); }
	}
	for (const FString& Part : Parts)
	{
		if (Part.Contains(TEXT("@location("), ESearchCase::CaseSensitive)) { HandleDecl(Part); continue; }
		if (Part.Contains(TEXT("@builtin("), ESearchCase::CaseSensitive)) { continue; }
		const int32 Colon = Part.Find(TEXT(":"), ESearchCase::CaseSensitive);
		if (Colon == INDEX_NONE) { continue; }
		const FString TypeName = Part.Mid(Colon + 1).TrimStartAndEnd();
		if (TypeName.IsEmpty()) { continue; }
		int32 SIdx = Wgsl.Find(*FString::Printf(TEXT("struct %s {"), *TypeName), ESearchCase::CaseSensitive);
		if (SIdx == INDEX_NONE) { SIdx = Wgsl.Find(*FString::Printf(TEXT("struct %s{"), *TypeName), ESearchCase::CaseSensitive); }
		if (SIdx == INDEX_NONE) { continue; }
		const int32 BodyStart = Wgsl.Find(TEXT("{"), ESearchCase::CaseSensitive, ESearchDir::FromStart, SIdx);
		if (BodyStart == INDEX_NONE) { continue; }
		const int32 BodyEnd = Wgsl.Find(TEXT("}"), ESearchCase::CaseSensitive, ESearchDir::FromStart, BodyStart);
		if (BodyEnd == INDEX_NONE) { continue; }
		const FString Body = Wgsl.Mid(BodyStart + 1, BodyEnd - BodyStart - 1);
		TArray<FString> Members;
		Body.ParseIntoArray(Members, TEXT(","), true);
		for (const FString& M : Members) { HandleDecl(M); }
	}
}

FPixelShaderRHIRef FDawnDynamicRHI::RHICreatePixelShader(const FRHICreateShaderDesc& CreateShaderDesc)
{
	FDawnPixelShader* Shader = new FDawnPixelShader();
	if (DAWNRHI_VERBOSE_DIAG) UE_LOG(LogDawnRHI, Warning, TEXT("PSNEW ptr=%p bindings=%d"), (void*)Shader, Shader->Bindings.Num());
	{ FShaderCodeReader R(CreateShaderDesc.Code); Shader->WGSLSource = FUTF8ToTCHAR(reinterpret_cast<const ANSICHAR*>(CreateShaderDesc.Code.GetData()), (int32)R.GetActualShaderCodeSize()).Get(); }
	// Remap the PS to @group(1) so its resources do NOT collide with the VS @group(0)
	// @binding(0) (independent HLSL->WGSL compilation gives both stages a @group(0)
	// @binding(0) uniform buffer; merged, the PS gamma overwrote the VS ViewProjection).
	Shader->EntryPoint = ParseWgslEntryPoint(Shader->WGSLSource, TEXT("@fragment"), TEXT("fs_main"));
	ParseWgslBindings(Shader->WGSLSource, Shader->Bindings);
	// FOGPS (blue-haze investigation): dump the fog math of the first PS that
	// reads MobileBasePass fog fields — shows exactly what gets added to the
	// final color and from which members.
	{
		static uint32 _fps = 0;
		const FString& W = Shader->WGSLSource;
		if (_fps < 1 && W.Contains(TEXT("MobileBasePass"), ESearchCase::CaseSensitive) && W.Contains(TEXT("Fog"), ESearchCase::CaseSensitive))
		{
			++_fps;
			printf("DAWNBG FOGPS len=%d\n", W.Len());
			auto DumpHits = [&W](const char* Tag, const TCHAR* Needle, int32 MaxHits, int32 Pre, int32 Ctx)
			{
				int32 From = 0, Nh = 0;
				const int32 NeedleLen = FCString::Strlen(Needle);
				while (Nh < MaxHits)
				{
					int32 Idx = W.Find(Needle, ESearchCase::CaseSensitive, ESearchDir::FromStart, From);
					if (Idx == INDEX_NONE) { break; }
					const int32 Start = FMath::Max(0, Idx - Pre);
					const FString Chunk = W.Mid(Start, Ctx).Replace(TEXT("\n"), TEXT("|"));
					printf("DAWNBG FOGPS %s[%d]: %s\n", Tag, Nh, (const char*)StringCast<UTF8CHAR>(*Chunk).Get());
					From = Idx + NeedleLen; ++Nh;
				}
				if (Nh == 0) { printf("DAWNBG FOGPS %s: NONE\n", Tag); }
				fflush(stdout);
			};
			DumpHits("FOGREAD", TEXT("MobileBasePass.MobileBasePass_Fog"), 12, 40, 220);
			DumpHits("EXPFOG",  TEXT("ExponentialFog"), 8, 60, 240);
			DumpHits("INSCAT",  TEXT("Inscatter"), 8, 60, 240);
			// Layout-skew check: the STRUCT DECL around the first fog member —
			// tint padding member names encode byte offsets (like View_Padding1404),
			// so this reveals the WGSL-side offsets to compare with runtime metadata.
			DumpHits("FOGSTRUCT", TEXT("Fog_ExponentialFogParameters :"), 2, 400, 700);
			// LITPS (black-world lighting hunt): which lighting inputs does the
			// base-pass PS actually read/sample?
			DumpHits("LITLM",  TEXT("LightMap"), 8, 60, 220);
			DumpHits("LITSKY", TEXT("SkyLight"), 6, 60, 220);
			DumpHits("LITDIR", TEXT("DirectionalLight"), 6, 60, 220);
			DumpHits("LITSAMP", TEXT("textureSample"), 10, 40, 200);
			// PSWGSLFULL (one-shot): the ENTIRE base-pass PS, chunked, so the
			// lighting/fog/color chain can be reconstructed offline and a
			// surgical fullbright patch written against exact tint output.
			{
				const int32 ChunkLen = 400;
				for (int32 Ofs = 0; Ofs < W.Len(); Ofs += ChunkLen)
				{
					const FString C = W.Mid(Ofs, ChunkLen).Replace(TEXT("\n"), TEXT("|"));
					printf("DAWNBG PSWGSLFULL %06d %s\n", Ofs, (const char*)StringCast<UTF8CHAR>(*C).Get());
				}
				fflush(stdout);
			}
		}
	}
	// TONEMAPFIX (blown-out image): this ES31 cook has no working tonemapper
	// (FTonemapPS on the fail list) — linear HDR scene color hits the 8-bit
	// target raw: highlights clip white, shadows crush black (confirmed after
	// the BC-texture fix lit the scene). Wrap each base-pass PS's final color
	// in a fixed exposure * Reinhard at WGSL level, no recook. Only entries
	// returning a plain vec4 are patched; others are left untouched + named.
	// FULLBRIGHT gate: 1 = replace base-pass PS output with a direct albedo
	// sample (diagnostic: proved geometry+albedo+BC textures render, TRUNC_*
	// screenshots). 0 = real materials + lighting (the shipping path).
#ifndef DAWNRHI_FULLBRIGHT
#define DAWNRHI_FULLBRIGHT 0
#endif
	TArray<uint8> TonemapPatched;
	bool bUseTonemapPatched = false;
	if (DAWNRHI_FULLBRIGHT && Shader->WGSLSource.Contains(TEXT("MobileBasePass"), ESearchCase::CaseSensitive))
	{
		FString W2 = Shader->WGSLSource;
		const int32 FragIdx = W2.Find(TEXT("@fragment"), ESearchCase::CaseSensitive);
		const int32 FnIdx = (FragIdx != INDEX_NONE) ? W2.Find(TEXT("fn "), ESearchCase::CaseSensitive, ESearchDir::FromStart, FragIdx) : INDEX_NONE;
		const int32 BodyOpen = (FnIdx != INDEX_NONE) ? W2.Find(TEXT("{"), ESearchCase::CaseSensitive, ESearchDir::FromStart, FnIdx) : INDEX_NONE;
		const int32 Arrow = (FnIdx != INDEX_NONE) ? W2.Find(TEXT("->"), ESearchCase::CaseSensitive, ESearchDir::FromStart, FnIdx) : INDEX_NONE;
		const bool bVec4Return = (Arrow != INDEX_NONE && BodyOpen != INDEX_NONE && Arrow < BodyOpen && W2.Mid(Arrow, BodyOpen - Arrow).Contains(TEXT("vec4<f32>")));
		if (bVec4Return)
		{
			// FULLBRIGHT: replace the ENTIRE entry body with a direct albedo
			// sample — bypasses the broken (binary white/black) lighting and
			// the fog add altogether. Albedo = the material's first
			// Material_Texture2D_* binding; UV = the @location(2) interpolant
			// (the mobile base-pass VS packs texcoords there), .xy.
			// Fog-pass PS -> transparent black (no veil); texture-less
			// material -> flat gray.
			const int32 ParenOpen = W2.Find(TEXT("("), ESearchCase::CaseSensitive, ESearchDir::FromStart, FnIdx);
			// Entry params: collect "@location(Nu) name : type" pairs (depth-aware not needed; entry params are flat).
			FString UVExpr;
			{
				int32 P = ParenOpen;
				const int32 ParenClose = (ParenOpen != INDEX_NONE) ? W2.Find(TEXT(")"), ESearchCase::CaseSensitive, ESearchDir::FromStart, W2.Find(TEXT("->"), ESearchCase::CaseSensitive, ESearchDir::FromStart, FnIdx) - 2) : INDEX_NONE;
				FString FirstVecName, Loc2Name; bool bLoc2IsVec2 = false, bFirstIsVec2 = false;
				while (P != INDEX_NONE && P < BodyOpen)
				{
					const int32 L = W2.Find(TEXT("@location("), ESearchCase::CaseSensitive, ESearchDir::FromStart, P);
					if (L == INDEX_NONE || L > BodyOpen) { break; }
					const int32 LE = W2.Find(TEXT(")"), ESearchCase::CaseSensitive, ESearchDir::FromStart, L + 10);
					const int32 LocNum = FCString::Atoi(*W2.Mid(L + 10, LE - L - 10));
					int32 NS = LE + 1;
					while (NS < BodyOpen && (FChar::IsWhitespace(W2[NS]) || W2[NS] == TEXT(')'))) { ++NS; }
					int32 NE = NS;
					while (NE < BodyOpen && (FChar::IsAlnum(W2[NE]) || W2[NE] == TEXT('_'))) { ++NE; }
					const FString PName = W2.Mid(NS, NE - NS);
					const int32 Colon = W2.Find(TEXT(":"), ESearchCase::CaseSensitive, ESearchDir::FromStart, NE);
					const FString PType = (Colon != INDEX_NONE) ? W2.Mid(Colon + 1, 24) : FString();
					const bool bIsVec2 = PType.Contains(TEXT("vec2"));
					const bool bIsVecF = PType.Contains(TEXT("vec2")) || PType.Contains(TEXT("vec4"));
					if (bIsVecF && FirstVecName.IsEmpty()) { FirstVecName = PName; bFirstIsVec2 = bIsVec2; }
					if (LocNum == 2 && bIsVecF && Loc2Name.IsEmpty()) { Loc2Name = PName; bLoc2IsVec2 = bIsVec2; }
					P = LE;
				}
				if (!Loc2Name.IsEmpty()) { UVExpr = Loc2Name + (bLoc2IsVec2 ? TEXT("") : TEXT(".xy")); }
				else if (!FirstVecName.IsEmpty()) { UVExpr = FirstVecName + (bFirstIsVec2 ? TEXT("") : TEXT(".xy")); }
			}
			FString TexName, SampName;
			for (const FDawnShaderBinding& B : Shader->Bindings)
				if (B.Kind == EDawnShaderBindingKind::Texture && B.TexViewDim == WGPUTextureViewDimension_2D && B.Name.StartsWith(TEXT("Material_Texture2D_"))) { TexName = B.Name; break; }
			if (!TexName.IsEmpty())
			{
				const FString Want = TexName + TEXT("Sampler");
				for (const FDawnShaderBinding& B : Shader->Bindings)
					if (B.Kind == EDawnShaderBindingKind::Sampler && B.Name == Want) { SampName = B.Name; break; }
				if (SampName.IsEmpty())
					for (const FDawnShaderBinding& B : Shader->Bindings)
						if (B.Kind == EDawnShaderBindingKind::Sampler && !B.bComparisonSampler) { SampName = B.Name; break; }
			}
			const bool bFogPass = Shader->EntryPoint.Contains(TEXT("Fog"));
			FString NewBody;
			if (bFogPass)                                          { NewBody = TEXT("\n  return vec4<f32>(0.0, 0.0, 0.0, 0.0);\n"); }
			else if (!TexName.IsEmpty() && !SampName.IsEmpty() && !UVExpr.IsEmpty())
			{
				NewBody = FString::Printf(TEXT("\n  return vec4<f32>(textureSample(%s, %s, %s).xyz, 1.0);\n"), *TexName, *SampName, *UVExpr);
			}
			else                                                   { NewBody = TEXT("\n  return vec4<f32>(0.35, 0.35, 0.4, 1.0);\n"); }
			// Entry fn is the LAST function in tint output: its body spans
			// BodyOpen .. the file's final '}'.
			int32 LastBrace = INDEX_NONE;
			for (int32 i = W2.Len() - 1; i > BodyOpen; --i) { if (W2[i] == TEXT('}')) { LastBrace = i; break; } }
			if (LastBrace != INDEX_NONE)
			{
				// Truncate at the entry's closing brace: the cooked buffer's
				// counted tail can carry NULs or non-UTF8 padding bytes that the
				// FString round-trip preserves — tint rejects them ("invalid
				// character found" on the final line, mojibake in the echo) and
				// every affected pipeline (match-start weapon/effect materials)
				// went invalid, poisoning the frame's command buffer -> stall.
				// The entry fn is the last function in tint output; nothing
				// legitimate follows its '}'.
				W2 = W2.Left(BodyOpen + 1) + NewBody + TEXT("}\n");
				auto U8 = StringCast<UTF8CHAR>(*W2);
				TonemapPatched.Append(reinterpret_cast<const uint8*>(U8.Get()), U8.Length());
				// The cooked WGSL carries trailing NUL byte(s) inside its counted
				// size; the FString round-trip preserved them and tint's parser
				// rejects them ("invalid character found" on the final line ->
				// invalid module -> invalid pipelines -> black world). NULs are
				// never legal WGSL — strip every one.
				TonemapPatched.RemoveAll([](uint8 B) { return B == 0; });
				bUseTonemapPatched = true;
				static uint32 _tm = 0;
				if (_tm++ < 24) { printf("DAWNBG FULLBRIGHT PS entry=%s tex=%s samp=%s uv=%s fog=%d\n", (const char*)StringCast<UTF8CHAR>(*Shader->EntryPoint).Get(), TCHAR_TO_UTF8(*TexName), TCHAR_TO_UTF8(*SampName), TCHAR_TO_UTF8(*UVExpr), bFogPass ? 1 : 0); fflush(stdout); }
			}
		}
		else
		{
			static uint32 _ts = 0;
			if (_ts++ < 16) { printf("DAWNBG FULLBRIGHT SKIP non-vec4-return PS entry=%s\n", (const char*)StringCast<UTF8CHAR>(*Shader->EntryPoint).Get()); fflush(stdout); }
		}
	}
	// AMBIENTFLOOR (visible-map stopgap): the real render lights cooked
	// materials correctly (sun glow, lit pickups) but the DEFAULT-material
	// walls (uncooked shader maps: M_CastleWall_MASTER et al) receive zero
	// light -> black. Until those materials are recooked, wrap each base-pass
	// PS's final color with a minimum illumination floor: max(lit, albedo*0.3)
	// (or a flat 0.22 gray for texture-less shaders). Truncation-safe: the
	// wrap REPLACES everything from the final return to EOF (drops the cooked
	// buffer's garbage tail that caused the parse-error stall).
#ifndef DAWNRHI_AMBIENTFLOOR
#define DAWNRHI_AMBIENTFLOOR 1
#endif
	if (DAWNRHI_AMBIENTFLOOR && !bUseTonemapPatched
		&& Shader->WGSLSource.Contains(TEXT("MobileBasePass"), ESearchCase::CaseSensitive)
		&& !Shader->EntryPoint.Contains(TEXT("Fog")))
	{
		FString W2 = Shader->WGSLSource;
		const int32 FragIdx = W2.Find(TEXT("@fragment"), ESearchCase::CaseSensitive);
		const int32 FnIdx = (FragIdx != INDEX_NONE) ? W2.Find(TEXT("fn "), ESearchCase::CaseSensitive, ESearchDir::FromStart, FragIdx) : INDEX_NONE;
		const int32 BodyOpen = (FnIdx != INDEX_NONE) ? W2.Find(TEXT("{"), ESearchCase::CaseSensitive, ESearchDir::FromStart, FnIdx) : INDEX_NONE;
		const int32 Arrow = (FnIdx != INDEX_NONE) ? W2.Find(TEXT("->"), ESearchCase::CaseSensitive, ESearchDir::FromStart, FnIdx) : INDEX_NONE;
		const bool bVec4Return = (Arrow != INDEX_NONE && BodyOpen != INDEX_NONE && Arrow < BodyOpen && W2.Mid(Arrow, BodyOpen - Arrow).Contains(TEXT("vec4<f32>")));
		if (bVec4Return)
		{
			// UV interpolant + albedo texture discovery (same heuristics as the
			// FULLBRIGHT diagnostic above: @location(2) vec4's .xy, first
			// Material_Texture2D_* binding + its sampler).
			FString UVExpr;
			{
				int32 P = W2.Find(TEXT("("), ESearchCase::CaseSensitive, ESearchDir::FromStart, FnIdx);
				FString FirstVecName, Loc2Name; bool bLoc2IsVec2 = false, bFirstIsVec2 = false;
				while (P != INDEX_NONE && P < BodyOpen)
				{
					const int32 L = W2.Find(TEXT("@location("), ESearchCase::CaseSensitive, ESearchDir::FromStart, P);
					if (L == INDEX_NONE || L > BodyOpen) { break; }
					const int32 LE = W2.Find(TEXT(")"), ESearchCase::CaseSensitive, ESearchDir::FromStart, L + 10);
					const int32 LocNum = FCString::Atoi(*W2.Mid(L + 10, LE - L - 10));
					int32 NS = LE + 1;
					while (NS < BodyOpen && (FChar::IsWhitespace(W2[NS]) || W2[NS] == TEXT(')'))) { ++NS; }
					int32 NE = NS;
					while (NE < BodyOpen && (FChar::IsAlnum(W2[NE]) || W2[NE] == TEXT('_'))) { ++NE; }
					const FString PName = W2.Mid(NS, NE - NS);
					const int32 Colon = W2.Find(TEXT(":"), ESearchCase::CaseSensitive, ESearchDir::FromStart, NE);
					const FString PType = (Colon != INDEX_NONE) ? W2.Mid(Colon + 1, 24) : FString();
					const bool bIsVec2 = PType.Contains(TEXT("vec2"));
					const bool bIsVecF = bIsVec2 || PType.Contains(TEXT("vec4"));
					if (bIsVecF && FirstVecName.IsEmpty()) { FirstVecName = PName; bFirstIsVec2 = bIsVec2; }
					if (LocNum == 2 && bIsVecF && Loc2Name.IsEmpty()) { Loc2Name = PName; bLoc2IsVec2 = bIsVec2; }
					P = LE;
				}
				if (!Loc2Name.IsEmpty()) { UVExpr = Loc2Name + (bLoc2IsVec2 ? TEXT("") : TEXT(".xy")); }
				else if (!FirstVecName.IsEmpty()) { UVExpr = FirstVecName + (bFirstIsVec2 ? TEXT("") : TEXT(".xy")); }
			}
			FString TexName, SampName;
			for (const FDawnShaderBinding& B : Shader->Bindings)
				if (B.Kind == EDawnShaderBindingKind::Texture && B.TexViewDim == WGPUTextureViewDimension_2D && B.Name.StartsWith(TEXT("Material_Texture2D_"))) { TexName = B.Name; break; }
			if (!TexName.IsEmpty())
			{
				const FString Want = TexName + TEXT("Sampler");
				for (const FDawnShaderBinding& B : Shader->Bindings)
					if (B.Kind == EDawnShaderBindingKind::Sampler && B.Name == Want) { SampName = B.Name; break; }
				if (SampName.IsEmpty())
					for (const FDawnShaderBinding& B : Shader->Bindings)
						if (B.Kind == EDawnShaderBindingKind::Sampler && !B.bComparisonSampler) { SampName = B.Name; break; }
			}
			const int32 Ret = W2.Find(TEXT("return "), ESearchCase::CaseSensitive, ESearchDir::FromEnd);
			const int32 Semi = (Ret != INDEX_NONE) ? W2.Find(TEXT(";"), ESearchCase::CaseSensitive, ESearchDir::FromStart, Ret) : INDEX_NONE;
			if (Ret > BodyOpen && Semi != INDEX_NONE)
			{
				const FString Expr = W2.Mid(Ret + 7, Semi - Ret - 7);
				FString FloorExpr;
				// Cleanup pass (real materials landed via the PrecomputedAOMask
				// cook fix): gentle MAX floor only — max() lifts sub-floor
				// pixels and cannot wash out properly-lit surfaces (the
				// additive 0.5 experiment did).
				if (!TexName.IsEmpty() && !SampName.IsEmpty() && !UVExpr.IsEmpty())
				{
					FloorExpr = FString::Printf(TEXT("(textureSample(%s, %s, %s).xyz * 0.12)"), *TexName, *SampName, *UVExpr);
				}
				else
				{
					FloorExpr = TEXT("vec3<f32>(0.08, 0.08, 0.09)");
				}
				const FString Repl = FString::Printf(TEXT("let dawn_o = %s;\n  return vec4<f32>(max(dawn_o.xyz, %s), dawn_o.w);\n}\n"), *Expr, *FloorExpr);
				W2 = W2.Left(Ret) + Repl;
				auto U8 = StringCast<UTF8CHAR>(*W2);
				TonemapPatched.Reset();
				TonemapPatched.Append(reinterpret_cast<const uint8*>(U8.Get()), U8.Length());
				TonemapPatched.RemoveAll([](uint8 B) { return B == 0; });
				bUseTonemapPatched = true;
				static uint32 _af = 0;
				if (_af++ < 24) { printf("DAWNBG AMBFLOOR PS entry=%s tex=%s uv=%s\n", (const char*)StringCast<UTF8CHAR>(*Shader->EntryPoint).Get(), TCHAR_TO_UTF8(*TexName), TCHAR_TO_UTF8(*UVExpr)); fflush(stdout); }
			}
		}
	}
	Shader->ShaderModule = CompileWGSL(Device, CreateShaderDesc, TEXT("DawnRHI.PixelShader"), false, bUseTonemapPatched ? &TonemapPatched : nullptr);
	checkf(Shader->ShaderModule, TEXT("DawnRHI: pixel shader WGSL compile failed"));
	return Shader;
}

FVertexShaderRHIRef FDawnDynamicRHI::RHICreateVertexShader(const FRHICreateShaderDesc& CreateShaderDesc)
{
	FDawnVertexShader* Shader = new FDawnVertexShader();
	if (DAWNRHI_VERBOSE_DIAG) UE_LOG(LogDawnRHI, Warning, TEXT("VSNEW ptr=%p bindings=%d"), (void*)Shader, Shader->Bindings.Num());
	{ FShaderCodeReader R(CreateShaderDesc.Code); Shader->WGSLSource = FUTF8ToTCHAR(reinterpret_cast<const ANSICHAR*>(CreateShaderDesc.Code.GetData()), (int32)R.GetActualShaderCodeSize()).Get(); }
	Shader->EntryPoint = ParseWgslEntryPoint(Shader->WGSLSource, TEXT("@vertex"), TEXT("vs_main"));
	ParseWgslBindings(Shader->WGSLSource, Shader->Bindings);
	// LWCVS3 (sliver root-cause, printf edition — UE_LOG is stripped): dump
	// the position math of the first VSs that read the Primitive uniform.
	// Shows (1) which Primitive members the body actually reads, (2) whether
	// PositionHigh ever enters the math, (3) the clip-position chain.
	{
		static uint32 _lwc3 = 0;
		const FString& W = Shader->WGSLSource;
		if (_lwc3 < 2 && W.Contains(TEXT("Primitive."), ESearchCase::CaseSensitive))
		{
			++_lwc3;
			printf("DAWNBG LWCVS3 #%u entry=%s len=%d\n", _lwc3, (const char*)StringCast<UTF8CHAR>(*Shader->EntryPoint).Get(), W.Len());
			auto DumpHits = [&W](const char* Tag, const TCHAR* Needle, int32 MaxHits, int32 Pre, int32 Ctx)
			{
				int32 From = 0, N = 0;
				const int32 NeedleLen = FCString::Strlen(Needle);
				while (N < MaxHits)
				{
					int32 Idx = W.Find(Needle, ESearchCase::CaseSensitive, ESearchDir::FromStart, From);
					if (Idx == INDEX_NONE) { break; }
					const int32 Start = FMath::Max(0, Idx - Pre);
					const FString Chunk = W.Mid(Start, Ctx).Replace(TEXT("\n"), TEXT("|"));
					printf("DAWNBG LWCVS3 %s[%d]: %s\n", Tag, N, (const char*)StringCast<UTF8CHAR>(*Chunk).Get());
					From = Idx + NeedleLen; ++N;
				}
				if (N == 0) { printf("DAWNBG LWCVS3 %s: NONE\n", Tag); }
				fflush(stdout);
			};
			DumpHits("PRIMREAD",   TEXT("Primitive."), 20, 60, 240);
			DumpHits("POSHIGH",    TEXT("PositionHigh"), 6, 100, 300);
			DumpHits("PREVIEWTR",  TEXT("PreViewTranslation"), 4, 100, 300);
			DumpHits("BUILTINPOS", TEXT("@builtin(position)"), 2, 20, 200);
			DumpHits("TOCLIP",     TEXT("ToClip"), 8, 150, 350);      // which clip matrix feeds the position
			DumpHits("CLIPOUT",    TEXT("tint_symbol_1"), 8, 260, 480); // every statement touching the clip output
			// WGSLFULL (one-shot): dump the ENTIRE first Primitive-reading VS in
			// chunks so the whole shader can be reassembled from the console log
			// and the position math analyzed offline (needle dumps keep missing
			// the return-struct construction that writes clip position).
			if (_lwc3 == 1)
			{
				const int32 ChunkLen = 400;
				for (int32 Ofs = 0; Ofs < W.Len(); Ofs += ChunkLen)
				{
					const FString C = W.Mid(Ofs, ChunkLen).Replace(TEXT("\n"), TEXT("|"));
					printf("DAWNBG WGSLFULL %06d %s\n", Ofs, (const char*)StringCast<UTF8CHAR>(*C).Get());
				}
				fflush(stdout);
			}
		}
	}
	Shader->ShaderModule = CompileWGSL(Device, CreateShaderDesc, TEXT("DawnRHI.VertexShader"));
	checkf(Shader->ShaderModule, TEXT("DawnRHI: vertex shader WGSL compile failed"));
	return Shader;
}

FGraphicsPipelineStateRHIRef FDawnDynamicRHI::RHICreateGraphicsPipelineState(const FGraphicsPipelineStateInitializer& Initializer)
{
	FDawnVertexShader* VS = static_cast<FDawnVertexShader*>(Initializer.BoundShaderState.VertexShaderRHI);
	FDawnPixelShader* PS = static_cast<FDawnPixelShader*>(Initializer.BoundShaderState.PixelShaderRHI);
	FDawnVertexDeclaration* VertexDecl = static_cast<FDawnVertexDeclaration*>(Initializer.BoundShaderState.VertexDeclarationRHI);
	// NON-FATAL null-shader path: a PSO can legitimately be requested with a
	// null VS or PS (fallback/default materials whose HLSL-stage translation
	// failed -> null shader map, or a shader that never cooked). Asserting here
	// aborted the WHOLE frame right after the first real world-geometry draws.
	// Instead return an INERT pipeline state (Pipeline == nullptr, no bind
	// group layouts); RHISetGraphicsPipelineState/the draw path detect the
	// null Pipeline and skip those draws — that one material just doesn't
	// render instead of killing the game.
	// FRAGLESS: a null PS with a valid VS and NO color targets is a legitimate
	// DEPTH-ONLY pipeline (depth prepass, CSM shadow depth) — WebGPU supports
	// fragment-less pipelines directly. Only a null VS, or a null PS WITH
	// color targets, is truly uncooked/broken (inert).
	const bool bFragmentless = (VS && !PS && Initializer.RenderTargetsEnabled == 0);
	if ((!VS || !PS) && !bFragmentless)
	{
		static uint32 _inertPsoLogs = 0;
		if (_inertPsoLogs++ < 16)
		{
			UE_LOG(LogDawnRHI, Warning, TEXT("DawnRHI: PSO requested with null %s shader (fallback/uncooked material) — returning INERT PSO, its draws will be skipped (vs=%p ps=%p rt=%u, occurrence %u)"), !VS ? TEXT("vertex") : TEXT("pixel"), (void*)VS, (void*)PS, Initializer.RenderTargetsEnabled, _inertPsoLogs);
		}
		// INERTPSO printf (black-walls hunt): count + kind. Every draw on one
		// of these is SKIPPED — if the map walls/floor land here, they are
		// never rendered at all and only a shader-map recook restores them.
		{
			static uint32 _ip = 0; ++_ip;
			if (_ip <= 24 || (_ip % 200) == 0) { printf("DAWNBG INERTPSO null-%s n=%u\n", !VS ? "VS" : "PS", _ip); fflush(stdout); }
		}
		FDawnGraphicsPipelineState* InertPSO = new FDawnGraphicsPipelineState();
		InertPSO->Pipeline = nullptr;
		InertPSO->VertexShader = VS;
		InertPSO->PixelShader = PS;
		return InertPSO;
	}
	if (DAWNRHI_VERBOSE_DIAG) UE_LOG(LogDawnRHI, Warning, TEXT("PSOUSE vs=%p ps=%p vsB=%d psB=%d vsMod=%p psMod=%p vsSrc=%d"), (void*)VS, (void*)PS, VS->Bindings.Num(), PS->Bindings.Num(), (void*)VS->ShaderModule, (void*)PS->ShaderModule, VS->WGSLSource.Len());
	// LWC-COLLAPSE DIAG (Q3): one-shot dump of the cooked WGSL's Primitive
	// uniform struct head so member order/padding can be compared against the
	// CPU-side metadata offsets (PRIMUB logs) — a layout skew in the
	// SPIR-V->WGSL translation (e.g. translation read as scale) would also
	// collapse geometry.
	// WGSLX (invisible-world hunt round 2): the console pipe DROPS everything
	// after the first newline in a log line, which made the LWCVS2/WGSLPRIM
	// dumps unreadable AND produced a FALSE NEGATIVE ("Primitive.PositionHigh:
	// NO OCCURRENCES" — the WGSL member is prefixed, e.g.
	// Primitive.Primitive_PositionHigh, and contexts lost their tails). Dump
	// the FULL WGSL of the first two Primitive-consuming VSs in newline-free
	// 120-char lines ('~' = newline) — short lines survive the pipe intact.
	// Reassemble offline: grep -o "WGSLX. [0-9]* .*" log | sort | cut/join.
	{
		static uint32 _wx = 0;
		// Round 2: the first two captures were both the GPUSkin (skeletal) VS —
		// exclude bone-matrix shaders so this round captures the WORLD
		// (LocalVertexFactory) vertex shader.
		if (DAWNRHI_HEAVY_DUMPS && _wx < 2 && VS->WGSLSource.Contains(TEXT("var<uniform> Primitive")) && !VS->WGSLSource.Contains(TEXT("BoneMatrices")))
		{
			++_wx;
			FString W = VS->WGSLSource;
			W.ReplaceInline(TEXT("\r"), TEXT(""));
			W.ReplaceInline(TEXT("\n"), TEXT("~"));
			W.ReplaceInline(TEXT("\t"), TEXT(" "));
			printf("DAWNBG WGSLX BEGIN #%u entry=%s len=%d\n", _wx, (const char*)StringCast<UTF8CHAR>(*VS->EntryPoint).Get(), W.Len());
			const int32 Chunk = 120;
			for (int32 Ci = 0; Ci * Chunk < W.Len(); ++Ci)
			{
				printf("WGSLX%u %04d %s\n", _wx, Ci, (const char*)StringCast<UTF8CHAR>(*W.Mid(Ci * Chunk, Chunk)).Get());
			}
			printf("DAWNBG WGSLX END #%u\n", _wx);
			fflush(stdout);
		}
	}
	// WGSLX3 (black-pixel hunt): full dump of the first 2 base-pass PIXEL
	// shaders — trace what happens between the lit color and the final
	// return (fog multiply, exposure, AMBFLOOR wrap placement). Same
	// newline-safe encoding; reassemble with the WGSLP prefix.
	{
		static uint32 _wp = 0;
		if (DAWNRHI_HEAVY_DUMPS && _wp < 2 && PS && PS->WGSLSource.Contains(TEXT("MobileBasePass")) && !PS->EntryPoint.Contains(TEXT("Fog")))
		{
			++_wp;
			FString W = PS->WGSLSource;
			W.ReplaceInline(TEXT("\r"), TEXT(""));
			W.ReplaceInline(TEXT("\n"), TEXT("~"));
			W.ReplaceInline(TEXT("\t"), TEXT(" "));
			printf("DAWNBG WGSLP BEGIN #%u entry=%s len=%d\n", _wp, (const char*)StringCast<UTF8CHAR>(*PS->EntryPoint).Get(), W.Len());
			const int32 Chunk = 120;
			for (int32 Ci = 0; Ci * Chunk < W.Len(); ++Ci)
			{
				printf("WGSLP%u %04d %s\n", _wp, Ci, (const char*)StringCast<UTF8CHAR>(*W.Mid(Ci * Chunk, Chunk)).Get());
			}
			printf("DAWNBG WGSLP END #%u\n", _wp);
			fflush(stdout);
		}
	}
	// LWCDIAG: re-gated 2026-08-18 (served its purpose; log volume).
	{
		static bool _wgslPrim = false;
		if (DAWNRHI_HEAVY_DUMPS && !_wgslPrim)
		{
			const FString& W = VS->WGSLSource;
			int32 VarPos = W.Find(TEXT("var<uniform> Primitive"), ESearchCase::CaseSensitive);
			if (VarPos != INDEX_NONE)
			{
				_wgslPrim = true;
				int32 Colon = W.Find(TEXT(":"), ESearchCase::CaseSensitive, ESearchDir::FromStart, VarPos);
				int32 Semi = (Colon != INDEX_NONE) ? W.Find(TEXT(";"), ESearchCase::CaseSensitive, ESearchDir::FromStart, Colon) : INDEX_NONE;
				FString TypeName = (Colon != INDEX_NONE && Semi != INDEX_NONE) ? W.Mid(Colon + 1, Semi - Colon - 1).TrimStartAndEnd() : FString();
				UE_LOG(LogDawnRHI, Warning, TEXT("WGSLPRIM var type='%s'"), *TypeName);
				int32 SPos = TypeName.IsEmpty() ? INDEX_NONE : W.Find(FString::Printf(TEXT("struct %s"), *TypeName), ESearchCase::CaseSensitive);
				if (SPos != INDEX_NONE)
				{
					int32 End = W.Find(TEXT("}"), ESearchCase::CaseSensitive, ESearchDir::FromStart, SPos);
					const int32 DumpLen = FMath::Min(((End == INDEX_NONE) ? SPos + 2400 : End + 1) - SPos, 2400);
					for (int32 C = 0; C * 600 < DumpLen; ++C)
					{
						UE_LOG(LogDawnRHI, Warning, TEXT("WGSLPRIM[%d] %s"), C, *W.Mid(SPos + C * 600, FMath::Min(600, DumpLen - C * 600)));
					}
				}
			}
		}
	}
	if (DAWNRHI_VERBOSE_DIAG) { FRHIVertexShader* VSb = Initializer.BoundShaderState.VertexShaderRHI; FRHIPixelShader* PSb = Initializer.BoundShaderState.PixelShaderRHI; UE_LOG(LogDawnRHI, Warning, TEXT("PSOFREQ vsFreq=%d psFreq=%d"), VSb?(int)VSb->GetFrequency():-1, PSb?(int)PSb->GetFrequency():-1); }

	// LWC PROOF DUMP (sliver root-cause): the CPU delivers each primitive's
	// placement in the DF HIGH term (PositionHigh=[4600,4600,520] with
	// L2RW-trans=[0,0,0]) — the VS must ADD Primitive.PositionHigh into the
	// world position (DFFastToTranslatedWorld / MakeDFMatrix4x3 in
	// VertexFactoryCommon.ush). Dump verbatim WGSL context around every use
	// of PositionHigh / PreViewTranslation in the first VSs that reference
	// them: if PositionHigh never appears in an ADD into the position math
	// (or not at all), the HLSL->SPIR-V->WGSL translation dropped the LWC
	// high term and everything renders at local origin = the sliver.
	// LWCVS2 (speck root-cause, round 2): dump the ACTUAL FUNCTION-BODY
	// STATEMENTS that determine the vertex position — not struct context.
	// "Primitive." (var-dot-member) only matches body READS of the Primitive
	// uniform (the struct decl's members carry no "Primitive." prefix and the
	// var decl line is "Primitive :"), so: (1) every member the shader
	// actually reads off Primitive — if PositionHigh is absent here, the
	// cross-compile genuinely dropped it; (2) PreViewTranslation expressions —
	// fp32-degraded DF (UE_DF_FORCE_FP32_OPS=1) reads as a simple add/sub,
	// the precise two-sum chain means the define did NOT reach the Dawn
	// compile; (3) the @builtin(position) output member and every statement
	// mentioning it — the expression chain feeding clip position.
	// LWCDIAG: re-gated 2026-08-18 (served its purpose; log volume).
	{
		static uint32 _lwc2 = 0;
		const FString& W = VS->WGSLSource;
		if (DAWNRHI_HEAVY_DUMPS && _lwc2 < 2 && W.Contains(TEXT("Primitive.")))
		{
			++_lwc2;
			UE_LOG(LogDawnRHI, Warning, TEXT("LWCVS2 #%u entry=%s len=%d"), _lwc2, *VS->EntryPoint, W.Len());
			auto DumpHits = [&W](const TCHAR* Needle, int32 MaxHits, int32 Pre, int32 Ctx)
			{
				int32 From = 0, N = 0;
				const int32 NeedleLen = FCString::Strlen(Needle);
				while (N < MaxHits)
				{
					int32 Idx = W.Find(Needle, ESearchCase::CaseSensitive, ESearchDir::FromStart, From);
					if (Idx == INDEX_NONE) { break; }
					const int32 Start = FMath::Max(0, Idx - Pre);
					UE_LOG(LogDawnRHI, Warning, TEXT("LWCVS2 %s[%d]: %s"), Needle, N, *W.Mid(Start, Ctx));
					From = Idx + NeedleLen; ++N;
				}
				if (N == 0) { UE_LOG(LogDawnRHI, Warning, TEXT("LWCVS2 %s: NO OCCURRENCES"), Needle); }
			};
			DumpHits(TEXT("Primitive."), 14, 60, 260);              // every body read of the Primitive uniform
			DumpHits(TEXT("Primitive.PositionHigh"), 4, 120, 340);  // explicit: is the high term ever consumed?
			DumpHits(TEXT("PreViewTranslation"), 6, 120, 360);      // DF math shape: fp32 simple vs precise two-sum
			DumpHits(TEXT("@builtin(position)"), 2, 20, 220);       // output decl -> member name
			// Chase the clip-position member: the identifier after "@builtin(position)"
			// up to ':' names the output; dump every statement mentioning it.
			{
				int32 BIdx = W.Find(TEXT("@builtin(position)"), ESearchCase::CaseSensitive);
				if (BIdx != INDEX_NONE)
				{
					int32 P = BIdx + FCString::Strlen(TEXT("@builtin(position)"));
					while (P < W.Len() && FChar::IsWhitespace(W[P])) { ++P; }
					int32 NameStart = P;
					while (P < W.Len() && (FChar::IsAlnum(W[P]) || W[P] == TEXT('_'))) { ++P; }
					const FString PosName = W.Mid(NameStart, P - NameStart);
					if (!PosName.IsEmpty())
					{
						UE_LOG(LogDawnRHI, Warning, TEXT("LWCVS2 position output member = '%s'"), *PosName);
						DumpHits(*(FString::Printf(TEXT(".%s ="), *PosName)), 4, 200, 420); // assignments feeding clip pos
						DumpHits(*(FString::Printf(TEXT("%s ="), *PosName)), 4, 200, 420);
					}
				}
			}
		}
	}

	// Vertex buffer layouts — MULTI-STREAM (black-world fix): one
	// WGPUVertexBufferLayout PER DISTINCT StreamIndex, with slot index ==
	// StreamIndex (WebGPU binds vertex buffers by slot matching the layout
	// array index; RHISetStreamSource/the draw path bind each stream's buffer
	// to its own slot). The old code flattened the whole declaration into ONE
	// stream-0 layout with arrayStride=max(stride) — mesh vertex factories
	// span 3-4 streams (position s0/stride12, UVs s1/stride8, color
	// s2/stride0=FNullColorVertexBuffer, tangents s3/stride8), so positions
	// were read from the wrong buffer at the wrong stride -> every scene
	// vertex garbage/off-screen -> black world (Slate is single-stream, which
	// is why the HUD always rendered).
	constexpr uint32 MaxVertexStreams = 17; // == FDawnCommandContext::MaxVertexStreams
	TArray<WGPUVertexAttribute> StreamAttributes[MaxVertexStreams];
	uint64 StreamStrides[MaxVertexStreams] = {};
	// INSTSTEP: FVertexElement::bUseInstanceIndex marks a PER-INSTANCE stream
	// (particle sprite/mesh-particle instance data). Vulkan maps it to
	// VK_VERTEX_INPUT_RATE_INSTANCE; ignoring it here made Dawn treat instance
	// buffers as per-vertex (silent wrong reads, and instance-sized buffers
	// validated against VERTEX counts).
	bool StreamInstanced[MaxVertexStreams] = {};
	uint32 VertexStreamMask = 0;
	uint32 NumStreamSlots = 0; // highest used slot + 1
	if (VertexDecl)
	{
		for (const FVertexElement& Elem : VertexDecl->Elements)
		{
			const uint32 Strm = FMath::Min<uint32>(Elem.StreamIndex, MaxVertexStreams - 1);
			WGPUVertexAttribute Attr = {};
			Attr.format = DawnVertexFormatFromElementType((EVertexElementType)Elem.Type.GetValue());
			Attr.offset = Elem.Offset;
			Attr.shaderLocation = Elem.AttributeIndex;
			StreamAttributes[Strm].Add(Attr);
			StreamStrides[Strm] = FMath::Max<uint64>(StreamStrides[Strm], Elem.Stride);
			if (Elem.bUseInstanceIndex) { StreamInstanced[Strm] = true; }
			VertexStreamMask |= (1u << Strm);
			NumStreamSlots = FMath::Max<uint32>(NumStreamSlots, Strm + 1);
			if (DAWNRHI_VERBOSE_DIAG) { static uint32 _vd=0; if(_vd++<24) UE_LOG(LogTemp, Warning, TEXT("VTXDIAG type=%d off=%u stride=%u attr=%u strm=%u wgpufmt=%d"), (int)Elem.Type.GetValue(), (uint32)Elem.Offset, (uint32)Elem.Stride, (uint32)Elem.AttributeIndex, (uint32)Elem.StreamIndex, (int)Attr.format); }
		}
		if (DAWNRHI_VERBOSE_DIAG) { static uint32 _vs=0; if(_vs++<8) UE_LOG(LogTemp, Warning, TEXT("VTXDIAG === multi-stream layout: slots=%u mask=0x%x"), NumStreamSlots, VertexStreamMask); }
	}
	// VTXPADFIX (frame-3 stall): Dawn requires every attribute location the VS
	// consumes to exist in the VertexState ("Vertex attribute slot 8 used in
	// shader ... is not present in the VertexState" invalidated 6 pipelines
	// and with them the whole command buffer). UE vertex declarations
	// legitimately omit streams some shader variants read (e.g. lightmap UV
	// channels), so pad each missing location from a stride-0 dummy stream —
	// the draw path binds a small zero buffer there (every vertex reads
	// zeros, matching D3D/Vulkan null-attribute behaviour closely enough).
	int32 DummyVertexStreamSlot = -1;
	if (VertexDecl && !VS->WGSLSource.IsEmpty())
	{
		TMap<uint32, WGPUVertexFormat> ShaderInputs;
		ParseWgslVertexInputs(VS->WGSLSource, ShaderInputs);
		// ATTRFIX (the invisible-map root cause): Dawn requires each vertex
		// attribute's BASE TYPE CLASS (float/uint/sint) to match the shader
		// input ("Attribute base type (Float for VertexFormat::Unorm8x4) does
		// not match the shader's base type (Uint) in location (4)") — that
		// error made every map-mesh pipeline INVALID, which invalidated the
		// whole per-frame command buffer: 3509 world draws discarded, black
		// world while Slate survived in its own buffer. Reconcile the
		// declaration's format to the reflected WGSL input class, preserving
		// byte width (Unorm8x4 -> Uint8x4 etc); the shader does its own
		// unpacking of the raw components.
		auto ClassOf = [](WGPUVertexFormat X) -> int
		{
			switch (X)
			{
			case WGPUVertexFormat_Uint8x2: case WGPUVertexFormat_Uint8x4:
			case WGPUVertexFormat_Uint16x2: case WGPUVertexFormat_Uint16x4:
			case WGPUVertexFormat_Uint32: case WGPUVertexFormat_Uint32x2:
			case WGPUVertexFormat_Uint32x3: case WGPUVertexFormat_Uint32x4:
				return 1; // uint
			case WGPUVertexFormat_Sint8x2: case WGPUVertexFormat_Sint8x4:
			case WGPUVertexFormat_Sint16x2: case WGPUVertexFormat_Sint16x4:
			case WGPUVertexFormat_Sint32: case WGPUVertexFormat_Sint32x2:
			case WGPUVertexFormat_Sint32x3: case WGPUVertexFormat_Sint32x4:
				return 2; // sint
			default:
				return 0; // float (incl. all *norm / float16 / float32)
			}
		};
		auto Reconcile = [&ClassOf](WGPUVertexFormat Fmt, WGPUVertexFormat WantClassFmt) -> WGPUVertexFormat
		{
			const int Want = ClassOf(WantClassFmt);
			if (ClassOf(Fmt) == Want) { return Fmt; }
			switch (Fmt)
			{
			case WGPUVertexFormat_Unorm8x4: case WGPUVertexFormat_Snorm8x4:
			case WGPUVertexFormat_Uint8x4:  case WGPUVertexFormat_Sint8x4:
				return (Want == 1) ? WGPUVertexFormat_Uint8x4 : (Want == 2) ? WGPUVertexFormat_Sint8x4 : WGPUVertexFormat_Unorm8x4;
			case WGPUVertexFormat_Unorm16x2: case WGPUVertexFormat_Snorm16x2:
			case WGPUVertexFormat_Uint16x2:  case WGPUVertexFormat_Sint16x2: case WGPUVertexFormat_Float16x2:
				return (Want == 1) ? WGPUVertexFormat_Uint16x2 : (Want == 2) ? WGPUVertexFormat_Sint16x2 : WGPUVertexFormat_Unorm16x2;
			case WGPUVertexFormat_Unorm16x4: case WGPUVertexFormat_Snorm16x4:
			case WGPUVertexFormat_Uint16x4:  case WGPUVertexFormat_Sint16x4: case WGPUVertexFormat_Float16x4:
				return (Want == 1) ? WGPUVertexFormat_Uint16x4 : (Want == 2) ? WGPUVertexFormat_Sint16x4 : WGPUVertexFormat_Unorm16x4;
			case WGPUVertexFormat_Float32:   return (Want == 1) ? WGPUVertexFormat_Uint32   : WGPUVertexFormat_Sint32;
			case WGPUVertexFormat_Float32x2: return (Want == 1) ? WGPUVertexFormat_Uint32x2 : WGPUVertexFormat_Sint32x2;
			case WGPUVertexFormat_Float32x3: return (Want == 1) ? WGPUVertexFormat_Uint32x3 : WGPUVertexFormat_Sint32x3;
			case WGPUVertexFormat_Float32x4: return (Want == 1) ? WGPUVertexFormat_Uint32x4 : WGPUVertexFormat_Sint32x4;
			default: return Fmt; // unhandled: leave — the Dawn error will name it
			}
		};
		// WNDR task-B (2026-08-20): component-count helpers. GPUSkin bone-weight attrs (loc5/6/7) are
		// declared with FEWER components than the WGSL VS reads (Float16x2 vs vec4) -> WebGPU pads the
		// missing components (…,0,1) so weight[3] becomes 1 (phantom bone) -> skinned mesh collapses.
		auto CompCount = [](WGPUVertexFormat X) -> int
		{
			switch (X)
			{
			case WGPUVertexFormat_Uint8x2: case WGPUVertexFormat_Sint8x2: case WGPUVertexFormat_Unorm8x2: case WGPUVertexFormat_Snorm8x2:
			case WGPUVertexFormat_Uint16x2: case WGPUVertexFormat_Sint16x2: case WGPUVertexFormat_Unorm16x2: case WGPUVertexFormat_Snorm16x2:
			case WGPUVertexFormat_Float16x2: case WGPUVertexFormat_Float32x2: case WGPUVertexFormat_Uint32x2: case WGPUVertexFormat_Sint32x2:
				return 2;
			case WGPUVertexFormat_Float32x3: case WGPUVertexFormat_Uint32x3: case WGPUVertexFormat_Sint32x3:
				return 3;
			case WGPUVertexFormat_Uint8x4: case WGPUVertexFormat_Sint8x4: case WGPUVertexFormat_Unorm8x4: case WGPUVertexFormat_Snorm8x4:
			case WGPUVertexFormat_Uint16x4: case WGPUVertexFormat_Sint16x4: case WGPUVertexFormat_Unorm16x4: case WGPUVertexFormat_Snorm16x4:
			case WGPUVertexFormat_Float16x4: case WGPUVertexFormat_Float32x4: case WGPUVertexFormat_Uint32x4: case WGPUVertexFormat_Sint32x4:
				return 4;
			case WGPUVertexFormat_Float32: case WGPUVertexFormat_Uint32: case WGPUVertexFormat_Sint32:
				return 1;
			default: return 4;
			}
		};
		auto FmtByteSize = [](WGPUVertexFormat X) -> uint32
		{
			switch (X)
			{
			case WGPUVertexFormat_Uint8x2: case WGPUVertexFormat_Sint8x2: case WGPUVertexFormat_Unorm8x2: case WGPUVertexFormat_Snorm8x2: return 2;
			case WGPUVertexFormat_Uint8x4: case WGPUVertexFormat_Sint8x4: case WGPUVertexFormat_Unorm8x4: case WGPUVertexFormat_Snorm8x4:
			case WGPUVertexFormat_Uint16x2: case WGPUVertexFormat_Sint16x2: case WGPUVertexFormat_Unorm16x2: case WGPUVertexFormat_Snorm16x2:
			case WGPUVertexFormat_Float16x2: case WGPUVertexFormat_Float32: case WGPUVertexFormat_Uint32: case WGPUVertexFormat_Sint32: return 4;
			case WGPUVertexFormat_Uint16x4: case WGPUVertexFormat_Sint16x4: case WGPUVertexFormat_Unorm16x4: case WGPUVertexFormat_Snorm16x4:
			case WGPUVertexFormat_Float16x4: case WGPUVertexFormat_Float32x2: case WGPUVertexFormat_Uint32x2: case WGPUVertexFormat_Sint32x2: return 8;
			case WGPUVertexFormat_Float32x3: case WGPUVertexFormat_Uint32x3: case WGPUVertexFormat_Sint32x3: return 12;
			case WGPUVertexFormat_Float32x4: case WGPUVertexFormat_Uint32x4: case WGPUVertexFormat_Sint32x4: return 16;
			default: return 16;
			}
		};
		// Promote X to N components, preserving base type. Returns X if no known promotion.
		auto PromoteComps = [](WGPUVertexFormat X, int N) -> WGPUVertexFormat
		{
			if (N != 4) { return X; } // only 4-component promotion needed (all skinned shader inputs are vec4)
			switch (X)
			{
			case WGPUVertexFormat_Float16x2: return WGPUVertexFormat_Float16x4;
			case WGPUVertexFormat_Float32x2: case WGPUVertexFormat_Float32x3: return WGPUVertexFormat_Float32x4;
			case WGPUVertexFormat_Uint8x2:   return WGPUVertexFormat_Uint8x4;
			case WGPUVertexFormat_Sint8x2:   return WGPUVertexFormat_Sint8x4;
			case WGPUVertexFormat_Unorm8x2:  return WGPUVertexFormat_Unorm8x4;
			case WGPUVertexFormat_Snorm8x2:  return WGPUVertexFormat_Snorm8x4;
			case WGPUVertexFormat_Uint16x2:  return WGPUVertexFormat_Uint16x4;
			case WGPUVertexFormat_Sint16x2:  return WGPUVertexFormat_Sint16x4;
			case WGPUVertexFormat_Unorm16x2: return WGPUVertexFormat_Unorm16x4;
			case WGPUVertexFormat_Snorm16x2: return WGPUVertexFormat_Snorm16x4;
			case WGPUVertexFormat_Uint32x2: case WGPUVertexFormat_Uint32x3: return WGPUVertexFormat_Uint32x4;
			case WGPUVertexFormat_Sint32x2: case WGPUVertexFormat_Sint32x3: return WGPUVertexFormat_Sint32x4;
			default: return X;
			}
		};
		for (uint32 SIdx = 0; SIdx < NumStreamSlots; ++SIdx)
		{
			for (WGPUVertexAttribute& A : StreamAttributes[SIdx])
			{
				if (const WGPUVertexFormat* WantFmt = ShaderInputs.Find((uint32)A.shaderLocation))
				{
					const WGPUVertexFormat NewFmt = Reconcile(A.format, *WantFmt);
					if (NewFmt != A.format)
					{
						static uint32 _rc = 0;
						if (_rc++ < 24) { printf("DAWNBG ATTRFIX loc=%u fmt=%d -> %d (shader class fmt=%d)\n", (uint32)A.shaderLocation, (int)A.format, (int)NewFmt, (int)*WantFmt); fflush(stdout); }
						A.format = NewFmt;
					}
					// Component-count reconcile: if the shader reads MORE components than declared AND the
					// stream stride holds the extra bytes (i.e. the data is really there, e.g. a 4-weight
					// buffer mis-declared x2), promote so all components arrive. The stride check keeps this
					// correct: position (Float32x3 @stride12) can't promote to x16 -> stays x3 -> (x,y,z,1)
					// which is the right homogeneous default; a Float16x2 weight @stride8 promotes to x4.
					const int WantComps = CompCount(*WantFmt);
					if (CompCount(A.format) < WantComps)
					{
						const WGPUVertexFormat Prom = PromoteComps(A.format, WantComps);
						const uint64 Stride = StreamStrides[SIdx];
						if (Prom != A.format && (Stride == 0 || (uint64)A.offset + (uint64)FmtByteSize(Prom) <= Stride))
						{
							static uint32 _pc = 0;
							if (_pc++ < 24) { printf("DAWNBG ATTRFIX-COMP loc=%u fmt=%d -> %d (shader wants %d comps; stride=%llu)\n", (uint32)A.shaderLocation, (int)A.format, (int)Prom, WantComps, (unsigned long long)Stride); fflush(stdout); }
							A.format = Prom;
						}
					}
				}
			}
		}
		TArray<uint32> Missing;
		for (const TPair<uint32, WGPUVertexFormat>& I : ShaderInputs)
		{
			bool bHave = false;
			for (uint32 S = 0; S < NumStreamSlots && !bHave; ++S)
				for (const WGPUVertexAttribute& A : StreamAttributes[S])
					if ((uint32)A.shaderLocation == I.Key) { bHave = true; break; }
			if (!bHave) { Missing.Add(I.Key); }
		}
		if (Missing.Num() > 0)
		{
			int32 Slot = -1;
			for (uint32 S = 0; S < NumStreamSlots; ++S) { if (StreamAttributes[S].Num() == 0) { Slot = (int32)S; break; } }
			if (Slot < 0 && NumStreamSlots < MaxVertexStreams) { Slot = (int32)NumStreamSlots++; }
			if (Slot >= 0)
			{
				for (uint32 Loc : Missing)
				{
					WGPUVertexAttribute A = {};
					A.format = ShaderInputs[Loc];
					A.offset = 0;
					A.shaderLocation = Loc;
					StreamAttributes[Slot].Add(A);
				}
				StreamStrides[Slot] = 0;
				VertexStreamMask |= (1u << Slot);
				DummyVertexStreamSlot = Slot;
				static uint32 _vp = 0;
				if (_vp++ < 24) { printf("DAWNBG VTXPAD slot=%d nMissing=%d first=%u\n", Slot, Missing.Num(), Missing[0]); fflush(stdout); }
			}
		}
	}
	WGPUVertexBufferLayout StreamLayouts[MaxVertexStreams] = {};
	for (uint32 Slot = 0; Slot < NumStreamSlots; ++Slot)
	{
		WGPUVertexBufferLayout& L = StreamLayouts[Slot];
		if (StreamAttributes[Slot].Num() == 0)
		{
			// Hole slot (a declaration skipping a stream index): mark unused —
			// stepMode Undefined + no attributes is the C-API "null entry".
			L.arrayStride = 0;
			L.stepMode = WGPUVertexStepMode_Undefined;
			L.attributeCount = 0;
			L.attributes = nullptr;
			continue;
		}
		// arrayStride 0 is legal WebGPU (UE's FNullColorVertexBuffer color
		// stream declares stride 0: every vertex re-reads element 0 of a
		// 1-element buffer; validation then only requires offset+formatSize
		// to fit in the BOUND buffer, not the stride).
		L.arrayStride = StreamStrides[Slot];
		// INSTSTEP: per-instance streams step per instance (see above).
		L.stepMode = StreamInstanced[Slot] ? WGPUVertexStepMode_Instance : WGPUVertexStepMode_Vertex;
		L.attributeCount = StreamAttributes[Slot].Num();
		L.attributes = StreamAttributes[Slot].GetData();
	}
	// WNDR VSDUMP (sliver hunt): for the first world-mesh VS (6-stream, mask 0x3f),
	// dump the WGSL lines that read the vertex INPUT struct and compute the world/clip
	// position -- to see whether position comes from @location inputs or a manual-fetch
	// SRV, and how the vertex-input attributes feed the position math.
	if (VS && !VS->WGSLSource.IsEmpty() && !VS->WGSLSource.Contains(TEXT("GPUSkinVFBase")) && VS->WGSLSource.Contains(TEXT("Primitive_LocalToRelativeWorld")) && VS->WGSLSource.Contains(TEXT("Main_inner")))
	{
		static uint32 _vsd = 0;
		if (_vsd++ < 2)
		{
			const FString& Src = VS->WGSLSource;
			// print lines containing position/location/VertexFetch/Buffer keywords
			int32 Start = 0;
			const TCHAR* Keys[] = { TEXT("@location"), TEXT("VertexFetch"), TEXT("struct VertexFactoryInput"), TEXT("in.") , TEXT("LocalPosition"), TEXT("WorldPosition"), TEXT("SvPosition"), TEXT("gl_Position"), TEXT("output.position") };
			FString Lines;
			int32 Nl = 0;
			while (Start < Src.Len() && Nl < 60)
			{
				int32 End = Src.Find(TEXT("\n"), ESearchCase::CaseSensitive, ESearchDir::FromStart, Start);
				if (End < 0) { End = Src.Len(); }
				FString Line = Src.Mid(Start, End - Start);
				for (const TCHAR* K : Keys) { if (Line.Contains(K)) { Lines += Line.TrimStartAndEnd() + TEXT(" ## "); ++Nl; break; } }
				Start = End + 1;
			}
			printf("DAWNBG VSDUMP #%u len=%d lines: %s\n", _vsd, Src.Len(), TCHAR_TO_UTF8(*Lines.Left(1200)));
			// also dump the region around the clip-position output construction
			int32 Fp = Src.Find(TEXT("fn Main_inner"), ESearchCase::CaseSensitive, ESearchDir::FromStart);
			if (Fp < 0) { Fp = FMath::Max(0, Src.Len() - 2600); }
			FString Tail = Src.Mid(FMath::Max(0, Fp), 3200);
			Tail.ReplaceInline(TEXT("\n"), TEXT(" "));
			printf("DAWNBG VSOUT #%u: %s\n", _vsd, TCHAR_TO_UTF8(*Tail)); fflush(stdout);
		}
	}

	// WNDR VTXLAYOUT DIAG (sliver hunt 2026-08-19): dump the declared per-stream
	// vertex layout (stride + each attribute loc/offset/format) AND what the
	// cross-compiled WGSL VS actually wants (@location inputs). If the shader
	// reads position from an SRV (manual vertex fetch) rather than a @location,
	// SHADER-WANTS will lack loc 0 -> the vertex-input position is ignored ->
	// slivers with GPUScene off.
	{
		static uint32 _vl = 0;
		if (_vl++ < 14 && VertexDecl && VS && !VS->WGSLSource.IsEmpty())
		{
			printf("DAWNBG VTXLAYOUT #%u slots=%u mask=0x%x\n", _vl, NumStreamSlots, VertexStreamMask);
			for (uint32 S = 0; S < NumStreamSlots; ++S)
			{
				printf("DAWNBG VTXLAYOUT  stream%u stride=%llu inst=%d nAttr=%d\n", S, (unsigned long long)StreamStrides[S], StreamInstanced[S]?1:0, StreamAttributes[S].Num());
				for (const WGPUVertexAttribute& A : StreamAttributes[S])
				{
					printf("DAWNBG VTXLAYOUT    loc=%u off=%llu fmt=%d\n", (uint32)A.shaderLocation, (unsigned long long)A.offset, (int)A.format);
				}
			}
			TMap<uint32, WGPUVertexFormat> _si;
			ParseWgslVertexInputs(VS->WGSLSource, _si);
			for (const TPair<uint32, WGPUVertexFormat>& It : _si) { printf("DAWNBG VTXLAYOUT  SHADER-WANTS loc=%u fmt=%d\n", It.Key, (int)It.Value); }
			fflush(stdout);
		}
	}

	// WNDR task-B (2026-08-20): GPUSkin (character) vertex-input mismatch dump. The skinned
	// player/bot meshes don't render. VSDUMP above EXCLUDES GPUSkinVFBase, so it was never captured.
	// Dump the DECLARED per-stream vertex layout vs what the GPUSkin WGSL VS actually wants (the
	// loc/format mismatch, e.g. loc5 bone-weights declared x2 vs shader vec4, names the fix directly).
	if (VS && !VS->WGSLSource.IsEmpty() && VS->WGSLSource.Contains(TEXT("GPUSkinVFBase")))
	{
		static uint32 _gsk = 0;
		if (_gsk++ < 8)
		{
			printf("DAWNBG GPUSKINLAYOUT #%u slots=%u mask=0x%x\n", _gsk, NumStreamSlots, VertexStreamMask);
			for (uint32 S = 0; S < NumStreamSlots; ++S)
			{
				printf("DAWNBG GPUSKINLAYOUT  stream%u stride=%llu inst=%d nAttr=%d\n", S, (unsigned long long)StreamStrides[S], StreamInstanced[S]?1:0, StreamAttributes[S].Num());
				for (const WGPUVertexAttribute& A : StreamAttributes[S])
					printf("DAWNBG GPUSKINLAYOUT    loc=%u off=%llu fmt=%d\n", (uint32)A.shaderLocation, (unsigned long long)A.offset, (int)A.format);
			}
			TMap<uint32, WGPUVertexFormat> _si2;
			ParseWgslVertexInputs(VS->WGSLSource, _si2);
			for (const TPair<uint32, WGPUVertexFormat>& It : _si2)
				printf("DAWNBG GPUSKINLAYOUT  SHADER-WANTS loc=%u fmt=%d\n", It.Key, (int)It.Value);
			fflush(stdout);
		}
	}


	// Blend state: WITHOUT this ColorTarget.blend stays null -> opaque write, so
	// any alpha-blended draw (Slate text emits rgb=white, alpha=glyph-coverage) loses
	// its coverage and paints solid white quads. Translate the RHI blend state
	// (Initializer.BlendState -> FDawnBlendState) to a WGPUBlendState. Opaque states
	// (One/Zero/Add) round-trip to an equivalent no-op blend, so always set it.
	auto ToWgpuFactor = [](EBlendFactor F) -> WGPUBlendFactor
	{
		switch (F)
		{
		case BF_Zero:                      return WGPUBlendFactor_Zero;
		case BF_One:                       return WGPUBlendFactor_One;
		case BF_SourceColor:               return WGPUBlendFactor_Src;
		case BF_InverseSourceColor:        return WGPUBlendFactor_OneMinusSrc;
		case BF_SourceAlpha:               return WGPUBlendFactor_SrcAlpha;
		case BF_InverseSourceAlpha:        return WGPUBlendFactor_OneMinusSrcAlpha;
		case BF_DestAlpha:                 return WGPUBlendFactor_DstAlpha;
		case BF_InverseDestAlpha:          return WGPUBlendFactor_OneMinusDstAlpha;
		case BF_DestColor:                 return WGPUBlendFactor_Dst;
		case BF_InverseDestColor:          return WGPUBlendFactor_OneMinusDst;
		case BF_ConstantBlendFactor:       return WGPUBlendFactor_Constant;
		case BF_InverseConstantBlendFactor:return WGPUBlendFactor_OneMinusConstant;
		case BF_Source1Color:              return WGPUBlendFactor_Src1;
		case BF_InverseSource1Color:       return WGPUBlendFactor_OneMinusSrc1;
		case BF_Source1Alpha:              return WGPUBlendFactor_Src1Alpha;
		case BF_InverseSource1Alpha:       return WGPUBlendFactor_OneMinusSrc1Alpha;
		default:                           return WGPUBlendFactor_One;
		}
	};
	auto ToWgpuOp = [](EBlendOperation O) -> WGPUBlendOperation
	{
		switch (O)
		{
		case BO_Add:             return WGPUBlendOperation_Add;
		case BO_Subtract:        return WGPUBlendOperation_Subtract;
		case BO_ReverseSubtract: return WGPUBlendOperation_ReverseSubtract;
		case BO_Min:             return WGPUBlendOperation_Min;
		case BO_Max:             return WGPUBlendOperation_Max;
		default:                 return WGPUBlendOperation_Add;
		}
	};
	FBlendStateInitializerRHI::FRenderTarget RT0;
	if (FDawnBlendState* BS = static_cast<FDawnBlendState*>(Initializer.BlendState))
	{
		RT0 = BS->Initializer.RenderTargets[0];
	}
	WGPUBlendState BlendState = {};
	BlendState.color.operation = ToWgpuOp(RT0.ColorBlendOp);
	BlendState.color.srcFactor = ToWgpuFactor(RT0.ColorSrcBlend);
	BlendState.color.dstFactor = ToWgpuFactor(RT0.ColorDestBlend);
	BlendState.alpha.operation = ToWgpuOp(RT0.AlphaBlendOp);
	BlendState.alpha.srcFactor = ToWgpuFactor(RT0.AlphaSrcBlend);
	BlendState.alpha.dstFactor = ToWgpuFactor(RT0.AlphaDestBlend);
	WGPUColorWriteMask WriteMask = WGPUColorWriteMask_None;
	if (RT0.ColorWriteMask & CW_RED)   { WriteMask |= WGPUColorWriteMask_Red; }
	if (RT0.ColorWriteMask & CW_GREEN) { WriteMask |= WGPUColorWriteMask_Green; }
	if (RT0.ColorWriteMask & CW_BLUE)  { WriteMask |= WGPUColorWriteMask_Blue; }
	if (RT0.ColorWriteMask & CW_ALPHA) { WriteMask |= WGPUColorWriteMask_Alpha; }
	{ static uint32 _bd=0; if(_bd++<8) UE_LOG(LogDawnRHI, Warning, TEXT("BLENDDIAG cOp=%d cSrc=%d cDst=%d aSrc=%d aDst=%d mask=%d"), (int)RT0.ColorBlendOp, (int)RT0.ColorSrcBlend, (int)RT0.ColorDestBlend, (int)RT0.AlphaSrcBlend, (int)RT0.AlphaDestBlend, (int)RT0.ColorWriteMask); }

	WGPUColorTargetState ColorTarget = {};
	ColorTarget.format = DawnTextureFormatFromPixelFormat((EPixelFormat)Initializer.RenderTargetFormats[0]);
	ColorTarget.writeMask = WriteMask;
	ColorTarget.blend = &BlendState;
	// BLENDFIX (frame-3 stall): 32-bit-float and integer color formats are not
	// blendable in WebGPU (float32-blendable is an optional feature we don't
	// request) — a non-null blend on such a target fails CreateRenderPipeline
	// ("Blending is enabled but color format (RGBA32Float) is not blendable")
	// and the invalid pipeline poisons the whole command buffer. Drop blend to
	// an opaque write for those targets.
	switch (ColorTarget.format)
	{
	case WGPUTextureFormat_R32Float:
	case WGPUTextureFormat_RG32Float:
	case WGPUTextureFormat_RGBA32Float:
	case WGPUTextureFormat_R8Uint:   case WGPUTextureFormat_R8Sint:
	case WGPUTextureFormat_RG8Uint:  case WGPUTextureFormat_RG8Sint:
	case WGPUTextureFormat_RGBA8Uint: case WGPUTextureFormat_RGBA8Sint:
	case WGPUTextureFormat_R16Uint:  case WGPUTextureFormat_R16Sint:
	case WGPUTextureFormat_RG16Uint: case WGPUTextureFormat_RG16Sint:
	case WGPUTextureFormat_RGBA16Uint: case WGPUTextureFormat_RGBA16Sint:
	case WGPUTextureFormat_R32Uint:  case WGPUTextureFormat_R32Sint:
	case WGPUTextureFormat_RG32Uint: case WGPUTextureFormat_RG32Sint:
	case WGPUTextureFormat_RGBA32Uint: case WGPUTextureFormat_RGBA32Sint:
	case WGPUTextureFormat_RGB10A2Uint:
		ColorTarget.blend = nullptr;
		break;
	default:
		break;
	}

	WGPUFragmentState FragState = {};
	auto FsEntry = StringCast<UTF8CHAR>(PS ? *PS->EntryPoint : TEXT(""));
	if (PS) // FRAGLESS: depth-only pipelines have no fragment stage at all
	{
		FragState.module = PS->ShaderModule;
		FragState.entryPoint = { reinterpret_cast<const char*>(FsEntry.Get()), (size_t)FsEntry.Length() };
		FragState.targetCount = 1;
		FragState.targets = &ColorTarget;
	}

	// Milestone step 1 (+ this session's multi-@group fix): reflection-driven
	// bind group layout(s), one WGPUBindGroupLayout PER real reflected
	// FDawnShaderBinding::Group value (not just @group(0) — see the NOTE on
	// FDawnGraphicsPipelineState::BindGroupLayouts in DawnResources.h for why
	// this changed and what's actually been exercised by real content so
	// far). If either shader carries real reflected bindings
	// (FDawnVertexShader/FDawnPixelShader::Bindings, populated from the real
	// cooked SPIR-V — see DawnResources.h/DawnShaderCompiler.cpp), build the
	// layout(s) from THAT (real @group/@binding numbers, real resource
	// kinds) instead of the old fixed {UB@0,Texture@1,Sampler@2} table.
	// Falls back to the fixed single-@group(0) table only when neither
	// shader has reflection data — the Stage 1/2 hand-authored WGSL test
	// paths (DawnRHITestMain's synthetic scene_vs/scene_ps) still rely on
	// that fixed convention by construction and never populate ::Bindings.
	TMap<uint32, TArray<WGPUBindGroupLayoutEntry>> EntriesByGroup;
	auto AppendShaderBindings = [&EntriesByGroup](const TArray<FDawnShaderBinding>& Bindings, WGPUShaderStage Stage)
	{
		for (const FDawnShaderBinding& B : Bindings)
		{
			TArray<WGPUBindGroupLayoutEntry>& LayoutEntries = EntriesByGroup.FindOrAdd(B.Group);

			// Multiple shader stages can reflect the SAME @group/@binding
			// (e.g. a uniform buffer read by both VS and PS) — merge visibility
			// instead of adding a duplicate WGPUBindGroupLayoutEntry (Dawn
			// rejects a layout with two entries at the same binding number).
			bool bMerged = false;
			for (WGPUBindGroupLayoutEntry& Existing : LayoutEntries)
			{
				if (Existing.binding == B.Binding)
				{
					Existing.visibility |= Stage;
					bMerged = true;
					break;
				}
			}
			if (bMerged)
			{
				continue;
			}
			WGPUBindGroupLayoutEntry Entry = {};
			Entry.binding = B.Binding;
			Entry.visibility = Stage;
			switch (B.Kind)
			{
			case EDawnShaderBindingKind::UniformBuffer:
				// Match the address space the WGSL actually declares (parsed in
				// ParseWgslBindings): Uniform, ReadOnlyStorage or Storage. A
				// hardcoded Uniform here made CreateRenderPipeline reject any
				// pipeline whose shader declares var<storage, read> (mobile fog
				// VS/PS, instanced-stereo Main): "The buffer type in the shader
				// (ReadOnlyStorage) is not compatible with ... (Uniform)".
				Entry.buffer.type = B.BufBindingType;
				Entry.buffer.hasDynamicOffset = false;
				break;
			case EDawnShaderBindingKind::Texture:
				// Match the dimension/sample type the WGSL actually declares
				// (parsed in ParseWgslBindings). A hardcoded 2D here made
				// CreateRenderPipeline reject every material pipeline whose PS
				// samples the mobile reflection/sky cubemap (texture_cube):
				// "The shader's binding dimension ... doesn't match the
				// layout's binding dimension" (note: that Dawn message prints
				// its two arguments TRANSPOSED — the first %s labeled
				// "shader's" is really the layout side; see
				// ThirdParty/DawnTint/src/src/dawn/native/ShaderModule.cpp:671).
				Entry.texture.sampleType = B.TexSampleType;
				Entry.texture.viewDimension = B.TexViewDim;
				break;
			case EDawnShaderBindingKind::Sampler:
				Entry.sampler.type = B.bComparisonSampler ? WGPUSamplerBindingType_Comparison : WGPUSamplerBindingType_Filtering;
				break;
			default:
				continue; // unclassified resource kind — do not fabricate a layout entry
			}
			LayoutEntries.Add(Entry);
		}
	};
	// TEST (2026-08-15): shader reflection was never implemented (Bindings is
	// never populated) yet it reads as a garbage Num() -> forcing the intended
	// fixed {UB@0,Tex@1,Sampler@2} fallback. If this renders, garbage Bindings
	// was the sole blocker; if it still crashes, corruption is broader.
	AppendShaderBindings(VS->Bindings, WGPUShaderStage_Vertex);
	if (PS) { AppendShaderBindings(PS->Bindings, WGPUShaderStage_Fragment); } // FRAGLESS: no PS bindings on depth-only
	if (DAWNRHI_VERBOSE_DIAG) { static uint32 _vb=0; if(_vb++<3){ for(const FDawnShaderBinding&B:VS->Bindings) UE_LOG(LogTemp, Warning, TEXT("VBIND vs grp=%u bind=%u kind=%d"), B.Group, B.Binding, (int)B.Kind); if (PS) for(const FDawnShaderBinding&B:PS->Bindings) UE_LOG(LogTemp, Warning, TEXT("VBIND ps grp=%u bind=%u kind=%d"), B.Group, B.Binding, (int)B.Kind); } }
	if (DAWNRHI_VERBOSE_DIAG) UE_LOG(LogDawnRHI, Warning, TEXT("PSODIAG vsB=%d psB=%d groups=%d"), VS->Bindings.Num(), PS ? PS->Bindings.Num() : -1, EntriesByGroup.Num());
	if (DAWNRHI_VERBOSE_DIAG) for (const TPair<uint32, TArray<WGPUBindGroupLayoutEntry>>& P : EntriesByGroup) { for (const WGPUBindGroupLayoutEntry& E : P.Value) { UE_LOG(LogDawnRHI, Warning, TEXT("PSODIAG   grp=%u binding=%u"), P.Key, E.binding); } }

	if (EntriesByGroup.Num() == 0)
	{
		// No reflection data on either shader — fall back to Stage 2's
		// original fixed convention (see the NOTE on
		// FDawnGraphicsPipelineState::BindGroupLayouts in DawnResources.h).
		WGPUBindGroupLayoutEntry FixedLayoutEntries[3] = {};
		FixedLayoutEntries[0].binding = 0;
		FixedLayoutEntries[0].visibility = WGPUShaderStage_Vertex | WGPUShaderStage_Fragment;
		FixedLayoutEntries[0].buffer.type = WGPUBufferBindingType_Uniform;
		FixedLayoutEntries[1].binding = 1;
		FixedLayoutEntries[1].visibility = WGPUShaderStage_Fragment;
		FixedLayoutEntries[1].texture.sampleType = WGPUTextureSampleType_Float;
		FixedLayoutEntries[1].texture.viewDimension = WGPUTextureViewDimension_2D;
		FixedLayoutEntries[2].binding = 2;
		FixedLayoutEntries[2].visibility = WGPUShaderStage_Fragment;
		FixedLayoutEntries[2].sampler.type = WGPUSamplerBindingType_Filtering;
		EntriesByGroup.Add(0).Append(FixedLayoutEntries, 3);
	}

	// WGPUPipelineLayoutDescriptor::bindGroupLayouts is positional — index i
	// in that array IS @group(i) as far as Dawn/the shader is concerned — so
	// every group index from 0 up to the highest real reflected group must
	// have an entry, even if some intermediate group index was never
	// reflected by either shader (an empty WGPUBindGroupLayout, 0 entries,
	// is valid and simply means "nothing bound at this group").
	uint32 MaxGroup = 0;
	for (const TPair<uint32, TArray<WGPUBindGroupLayoutEntry>>& Pair : EntriesByGroup)
	{
		MaxGroup = FMath::Max(MaxGroup, Pair.Key);
	}

	// BGLIMIT pre-flight (18-texture-material crash fix): an over-limit bind
	// group layout does NOT fail politely on this runtime — the emdawn JS glue
	// ASSERT-aborts (observed: 18 albedo textures + per-texture samplers + 2
	// world-group samplers = 20 samplers > maxSamplersPerShaderStage=16 ->
	// wgpuDeviceCreateBindGroup abort ~15s in -> frozen black screen). Count
	// per-stage bindings across all groups and return an INERT PSO (its draws
	// are skipped; one over-complex material drops instead of the whole game).
	{
		uint32 SmpV=0, SmpF=0, TexV=0, TexF=0, BufV=0, BufF=0;
		for (const TPair<uint32, TArray<WGPUBindGroupLayoutEntry>>& Pair : EntriesByGroup)
		{
			for (const WGPUBindGroupLayoutEntry& E : Pair.Value)
			{
				const uint32 V = (E.visibility & WGPUShaderStage_Vertex) ? 1u : 0u;
				const uint32 F = (E.visibility & WGPUShaderStage_Fragment) ? 1u : 0u;
				if ((uint32)E.sampler.type != 0u)      { SmpV += V; SmpF += F; }
				else if ((uint32)E.texture.sampleType != 0u) { TexV += V; TexF += F; }
				else if ((uint32)E.buffer.type != 0u)  { BufV += V; BufF += F; }
			}
		}
		if (FMath::Max(SmpV, SmpF) > GDawnLimitMaxSamplersPerStage
			|| FMath::Max(TexV, TexF) > GDawnLimitMaxSampledTexPerStage
			|| FMath::Max(BufV, BufF) > GDawnLimitMaxUBPerStage)
		{
			static uint32 _bgl = 0; ++_bgl;
			if (_bgl <= 16 || (_bgl % 500) == 0)
			{
				printf("DAWNBG BGLIMIT-PSO vs=%s samplers=%u/%u tex=%u/%u ubs=%u/%u limits(s=%u t=%u u=%u) -> INERT (draws skipped) n=%u\n",
					(const char*)StringCast<UTF8CHAR>(*VS->EntryPoint).Get(), SmpV, SmpF, TexV, TexF, BufV, BufF,
					GDawnLimitMaxSamplersPerStage, GDawnLimitMaxSampledTexPerStage, GDawnLimitMaxUBPerStage, _bgl);
				fflush(stdout);
			}
			FDawnGraphicsPipelineState* InertPSO = new FDawnGraphicsPipelineState();
			InertPSO->Pipeline = nullptr;
			InertPSO->VertexShader = VS;
			InertPSO->PixelShader = PS;
			return InertPSO;
		}
	}
	TArray<WGPUBindGroupLayout> BindGroupLayouts;
	BindGroupLayouts.SetNum(MaxGroup + 1);
	bool bLayoutFailed = false;
	for (uint32 Group = 0; Group <= MaxGroup; ++Group)
	{
		const TArray<WGPUBindGroupLayoutEntry>* GroupEntries = EntriesByGroup.Find(Group);
		WGPUBindGroupLayoutDescriptor BglDesc = {};
		if (GroupEntries)
		{
			BglDesc.entryCount = GroupEntries->Num();
			BglDesc.entries = GroupEntries->GetData();
		}
		BindGroupLayouts[Group] = wgpuDeviceCreateBindGroupLayout(Device, &BglDesc);
		if (!BindGroupLayouts[Group]) { bLayoutFailed = true; }
	}
	if (bLayoutFailed)
	{
		// BGLIMIT: a null layout must never reach CreateBindGroup/CreateRenderPipeline
		// (JS-glue abort). Inert PSO instead.
		static uint32 _blf = 0; ++_blf;
		if (_blf <= 16) { printf("DAWNBG BGLIMIT-LAYOUTNULL vs=%s -> INERT n=%u\n", (const char*)StringCast<UTF8CHAR>(*VS->EntryPoint).Get(), _blf); fflush(stdout); }
		for (WGPUBindGroupLayout L : BindGroupLayouts) { if (L) { wgpuBindGroupLayoutRelease(L); } }
		FDawnGraphicsPipelineState* InertPSO = new FDawnGraphicsPipelineState();
		InertPSO->Pipeline = nullptr;
		InertPSO->VertexShader = VS;
		InertPSO->PixelShader = PS;
		return InertPSO;
	}

	WGPUPipelineLayoutDescriptor PlDesc = {};
	PlDesc.bindGroupLayoutCount = BindGroupLayouts.Num();
	PlDesc.bindGroupLayouts = BindGroupLayouts.GetData();
	WGPUPipelineLayout PipelineLayout = wgpuDeviceCreatePipelineLayout(Device, &PlDesc);

	WGPUDepthStencilState DepthStencil = {};
	bool bHasDepth = Initializer.DepthStencilTargetFormat != PF_Unknown;
	if (bHasDepth)
	{
		FDawnDepthStencilState* DSState = static_cast<FDawnDepthStencilState*>(Initializer.DepthStencilState);
		DepthStencil.format = DawnDepthStencilFormat();
		DepthStencil.depthWriteEnabled = DSState ? (DSState->Initializer.bEnableDepthWrite ? WGPUOptionalBool_True : WGPUOptionalBool_False) : WGPUOptionalBool_True;
		// Real depth testing (diagnostic depthCompare=Always REVERTED once the
		// 0xDD vertex-upload root cause was fixed): translate the RHI depth
		// test. UE runs reversed-Z (clear=0.0, GreaterEqual tests) — honoring
		// the state gives real occlusion.
		auto DawnCompareFromRHI = [](ECompareFunction F) -> WGPUCompareFunction
		{
			switch (F)
			{
			case CF_Less:         return WGPUCompareFunction_Less;
			case CF_LessEqual:    return WGPUCompareFunction_LessEqual;
			case CF_Greater:      return WGPUCompareFunction_Greater;
			case CF_GreaterEqual: return WGPUCompareFunction_GreaterEqual;
			case CF_Equal:        return WGPUCompareFunction_Equal;
			case CF_NotEqual:     return WGPUCompareFunction_NotEqual;
			case CF_Never:        return WGPUCompareFunction_Never;
			case CF_Always:       default: return WGPUCompareFunction_Always;
			}
		};
		// (Depth-Always diagnostic REVERTED 2026-08-18: it proved draws reach
		// the target, but mobile draws the SKY LAST — with depth forced Always
		// the sky dome overwrote the whole world every frame, hiding exactly
		// the geometry under investigation.)
		DepthStencil.depthCompare = DSState ? DawnCompareFromRHI((ECompareFunction)DSState->Initializer.DepthTest) : WGPUCompareFunction_LessEqual;
		DepthStencil.stencilFront.compare = WGPUCompareFunction_Always;
		DepthStencil.stencilBack.compare = WGPUCompareFunction_Always;
		DepthStencil.stencilReadMask = 0xFF;
		DepthStencil.stencilWriteMask = 0xFF;
	}

	WGPURenderPipelineDescriptor PipeDesc = {};
	PipeDesc.layout = PipelineLayout;
	PipeDesc.vertex.module = VS->ShaderModule;
	auto VsEntry = StringCast<UTF8CHAR>(*VS->EntryPoint);
	PipeDesc.vertex.entryPoint = { reinterpret_cast<const char*>(VsEntry.Get()), (size_t)VsEntry.Length() };
	if (NumStreamSlots > 0)
	{
		PipeDesc.vertex.bufferCount = (size_t)NumStreamSlots;
		PipeDesc.vertex.buffers = StreamLayouts;
	}
	// PRIMTYPE fix: translate the initializer's primitive type instead of
	// hardcoding TriangleList — PT_LineList batched-element draws (canvas/
	// debug lines, HUD) were rasterized as bogus triangles AND their draw-call
	// vertex math (NumPrimitives*3 vs the correct *2) over-read the exactly-
	// sized vertex buffer, a Dawn validation error that poisoned the whole
	// per-frame command buffer (nothing presented).
	// STRIPIDX fix: strip pipelines MUST bake a stripIndexFormat to be usable
	// by indexed draws (trail/ribbon particles draw indexed strips in-match;
	// Undefined here froze the game at first weapon trail). UE reuses one PSO
	// across 16- and 32-bit index buffers, so the primary pipeline bakes
	// Uint16 (the common trail width, and valid for non-indexed strip draws
	// too) and a Uint32 sibling is created below (PipelineStrip32); the draw
	// path picks by the bound index buffer's stride.
	switch (Initializer.PrimitiveType)
	{
	case PT_TriangleStrip:
		PipeDesc.primitive.topology = WGPUPrimitiveTopology_TriangleStrip;
		PipeDesc.primitive.stripIndexFormat = WGPUIndexFormat_Uint16;
		break;
	case PT_LineList:      PipeDesc.primitive.topology = WGPUPrimitiveTopology_LineList;      break;
	case PT_PointList:     PipeDesc.primitive.topology = WGPUPrimitiveTopology_PointList;     break;
	case PT_TriangleList:
	default:               PipeDesc.primitive.topology = WGPUPrimitiveTopology_TriangleList;  break;
	}
	PipeDesc.primitive.cullMode = WGPUCullMode_None;   // explicit (default already none) — closes the backface-cull theory
	PipeDesc.primitive.frontFace = WGPUFrontFace_CCW;
	PipeDesc.multisample.count = 1;
	PipeDesc.multisample.mask = 0xFFFFFFFF;
	PipeDesc.fragment = PS ? &FragState : nullptr; // FRAGLESS: fragment-less depth-only pipeline
	if (bHasDepth)
	{
		PipeDesc.depthStencil = &DepthStencil;
	}

	WGPURenderPipeline Pipeline = wgpuDeviceCreateRenderPipeline(Device, &PipeDesc);
	if (!Pipeline)
	{
		// Same non-fatal degrade as the null-shader path above: a pipeline
		// Dawn refuses to create (layout/shader validation mismatch, e.g. a
		// binding-type case not yet handled) must not abort the frame — return
		// an inert PSO whose draws are skipped.
		static uint32 _pipeFailLogs = 0;
		if (_pipeFailLogs++ < 16)
		{
			UE_LOG(LogDawnRHI, Warning, TEXT("DawnRHI: wgpuDeviceCreateRenderPipeline FAILED (vs=%s ps=%s) — returning INERT PSO, its draws will be skipped (occurrence %u)"), *VS->EntryPoint, PS ? *PS->EntryPoint : TEXT("<fragless>"), _pipeFailLogs);
		}
		{
			static uint32 _pf = 0; ++_pf;
			if (_pf <= 24) { printf("DAWNBG INERTPSO create-FAIL vs=%s ps=%s n=%u\n", (const char*)StringCast<UTF8CHAR>(*VS->EntryPoint).Get(), PS ? (const char*)StringCast<UTF8CHAR>(*PS->EntryPoint).Get() : "<fragless>", _pf); fflush(stdout); }
		}
		if (PipelineLayout) { wgpuPipelineLayoutRelease(PipelineLayout); }
		for (WGPUBindGroupLayout Layout : BindGroupLayouts) { if (Layout) { wgpuBindGroupLayoutRelease(Layout); } }
		FDawnGraphicsPipelineState* InertPSO = new FDawnGraphicsPipelineState();
		InertPSO->Pipeline = nullptr;
		InertPSO->VertexShader = VS;
		InertPSO->PixelShader = PS;
		return InertPSO;
	}

	// STRIPIDX: 32-bit-index sibling for strip topologies (see PRIMTYPE switch
	// above). Same descriptor except stripIndexFormat. Creation failure is
	// non-fatal — the draw path skips 32-bit indexed strip draws when null
	// (STRIPSKIP guard) instead of poisoning the command buffer.
	WGPURenderPipeline PipelineStrip32 = nullptr;
	if (Initializer.PrimitiveType == PT_TriangleStrip)
	{
		PipeDesc.primitive.stripIndexFormat = WGPUIndexFormat_Uint32;
		PipelineStrip32 = wgpuDeviceCreateRenderPipeline(Device, &PipeDesc);
		if (!PipelineStrip32)
		{
			static uint32 _s32 = 0;
			if (_s32++ < 8) { UE_LOG(LogDawnRHI, Warning, TEXT("DawnRHI: Uint32 strip-index pipeline variant FAILED to create (vs=%s) — 32-bit indexed strip draws will be skipped"), *VS->EntryPoint); }
		}
	}

	FDawnGraphicsPipelineState* PSO = new FDawnGraphicsPipelineState();
	PSO->Pipeline = Pipeline;
	PSO->PipelineStrip32 = PipelineStrip32;
	PSO->VertexShader = VS;
	PSO->PixelShader = PS;
	PSO->BindGroupLayouts = MoveTemp(BindGroupLayouts);
	PSO->PipelineLayout = PipelineLayout;
	PSO->VertexStreamMask = VertexStreamMask;
	PSO->DummyVertexStreamSlot = DummyVertexStreamSlot; // VTXPADFIX: draw path binds the shared zero VB here
	PSO->PrimitiveType = (uint32)Initializer.PrimitiveType; // PRIMTYPE: draw-call count math
	PSO->bFragmentless = bFragmentless; // FRAGLESS: draw path must keep these out of color passes
	for (uint32 S = 0; S < MaxVertexStreams; ++S) // INSTSTEP/VTXRANGE: draw-path range checks
	{
		PSO->StreamStrides[S] = (uint16)StreamStrides[S];
		if (StreamInstanced[S]) { PSO->InstanceStreamMask |= (1u << S); }
	}
	return PSO;
}

FRHIBufferInitializer FDawnDynamicRHI::RHICreateBufferInitializer(FRHICommandListBase& RHICmdList, const FRHIBufferCreateDesc& InCreateDesc)
{
	// RHIValidation asserts every resource is created with a known initial
	// ERHIAccess state (matches VulkanRHI's FVulkanDynamicRHI::CreateBuffer,
	// which calls DetermineInitialState() before constructing the resource).
	FRHIBufferCreateDesc CreateDesc = InCreateDesc;
	CreateDesc.DetermineInitialState();

	// emdawnwebgpu WebGPU objects are per-thread (device owned by the game
	// thread): a create from a task worker dies deep in an opaque JS assert.
	// Name the offender loudly first so wrong-thread callers self-identify
	// (parallel paths should be gated by
	// GSupportsParallelRenderingTasksWithSeparateRHIThread=false — see Init()).
	if (!IsInGameThread())
	{
		static uint32 _offThread = 0;
		if (_offThread++ < 8)
		{
			UE_LOG(LogDawnRHI, Error, TEXT("DawnRHI: RHICreateBufferInitializer OFF the game thread (size=%u usage=0x%llx) — emdawnwebgpu objects are per-thread; the JS glue will assert. A parallel render path is ignoring GSupportsParallelRenderingTasksWithSeparateRHIThread=false."), CreateDesc.Size, (unsigned long long)CreateDesc.Usage);
		}
	}

	TRefCountPtr<FDawnBuffer> NewBuffer = new FDawnBuffer(CreateDesc);

	// CopySrc: lets the GPUREADBACK probe copy real GPU contents back out
	// (without it the probe's CopyBufferToBuffer failed validation and read a
	// never-written destination = fake zeros). Harmless for normal use.
	WGPUBufferUsage Usage = WGPUBufferUsage_CopyDst | WGPUBufferUsage_CopySrc;
	if (EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::VertexBuffer)) { Usage |= WGPUBufferUsage_Vertex; }
	if (EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::IndexBuffer))  { Usage |= WGPUBufferUsage_Index; }
	if (EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::UniformBuffer)) { Usage |= WGPUBufferUsage_Uniform; }
	// Buffers that can be bound as a shader storage binding (structured /
	// byte-address buffers read via SRV, e.g. the fog / instanced-view data
	// declared var<storage, read> in WGSL) need the Storage usage bit at
	// creation or the bind group is rejected at runtime.
	if (EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::StructuredBuffer | EBufferUsageFlags::ByteAddressBuffer | EBufferUsageFlags::ShaderResource | EBufferUsageFlags::UnorderedAccess)) { Usage |= WGPUBufferUsage_Storage; }

	WGPUBufferDescriptor BufDesc = {};
	BufDesc.usage = Usage;
	BufDesc.size = Align(FMath::Max<uint32>(CreateDesc.Size, 4), 4u);
	// MAPPEDRANGE BYPASS (sliver root-cause candidate): mappedAtCreation +
	// GetMappedRange/Unmap is the ONE upload path unique to the geometry that
	// never appears on screen (static-mesh vertex/index buffers), while every
	// wgpuQueueWriteBuffer path (Slate lock/unlock, uniform buffers) provably
	// delivers data. On wasm64 the emdawn mapped-range shadow-heap copy is
	// exactly where a truncated 64-bit pointer/size would silently write the
	// wrong wasm memory. Upload via CPU staging + QueueWriteBuffer at
	// Finalize instead — the proven path.
	BufDesc.mappedAtCreation = false;

	WGPUBuffer Buffer = wgpuDeviceCreateBuffer(Device, &BufDesc);
	checkf(Buffer, TEXT("DawnRHI: buffer creation failed"));
	NewBuffer->Buffer = Buffer;
	DawnLiveHandleAdd((void*)Buffer); // LIVEHANDLE
	NewBuffer->WgpuSize = (uint32)BufDesc.size;

	void* WritableData = FMemory::Malloc((size_t)BufDesc.size, 16);
	// WebGPU-spec buffer memory is zero-initialized; keep that guarantee for
	// the staging so partial initializer writes don't upload heap garbage.
	FMemory::Memzero(WritableData, (size_t)BufDesc.size);

	// ===== THE 0xDD ROOT-CAUSE FIX (black-world speck) =====
	// FRHICommandListBase::CreateBuffer() calls this and IMMEDIATELY
	// Finalize()s — nothing upstream copies CreateDesc.InitialData; honoring
	// ERHIBufferInitAction is the BACKEND'S job:
	//   ResourceArray -> the RHI must upload CreateDesc.InitialData and then
	//                    Discard() it. This is exactly how cooked static-mesh
	//                    VERTEX/INDEX buffers deliver their data. Previously
	//                    ignored -> the mappedAtCreation range kept its
	//                    uninitialized fill (0xDD) -> every mesh vertex was
	//                    identical garbage -> the whole map collapsed to one
	//                    speck while the HUD (Slate, lock/unlock path) worked.
	//   Zeroed        -> the RHI must zero-fill (emdawn's shadow heap alloc is
	//                    NOT guaranteed zeroed even though WebGPU-spec memory
	//                    is).
	//   Initializer   -> caller writes through WritableData (the pre-existing
	//                    behaviour, which was correct ONLY for this case).
	if (CreateDesc.InitAction == ERHIBufferInitAction::ResourceArray && CreateDesc.InitialData)
	{
		const void* Src = CreateDesc.InitialData->GetResourceData();
		const uint32 SrcSize = CreateDesc.InitialData->GetResourceDataSize();
		if (Src && SrcSize > 0)
		{
			FMemory::Memcpy(WritableData, Src, (size_t)FMath::Min<uint64>(SrcSize, BufDesc.size));
		}
		// Differentiator log: UE's source data vs the mapped range AFTER the
		// copy — if source is real but mapped stays garbage, the pointer/copy
		// is wrong; if source itself is garbage, data wasn't ready at create.
		if (DAWNRHI_VERBOSE_DIAG) if (EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::VertexBuffer) && Src && SrcSize >= 36)
		{
			static uint32 _ra = 0;
			if (_ra++ < 6)
			{
				const float* SF = (const float*)Src; const float* MF = (const float*)WritableData;
				UE_LOG(LogDawnRHI, Warning, TEXT("RESARRAY vb src=%p size=%u src.f3=[%.2f %.2f %.2f][%.2f %.2f %.2f] mapped.f3=[%.2f %.2f %.2f][%.2f %.2f %.2f]"),
					Src, SrcSize, SF[0],SF[1],SF[2],SF[3],SF[4],SF[5], MF[0],MF[1],MF[2],MF[3],MF[4],MF[5]);
			}
		}
		CreateDesc.InitialData->Discard();
	}
	else if (CreateDesc.InitAction == ERHIBufferInitAction::Zeroed)
	{
		FMemory::Memzero(WritableData, (size_t)BufDesc.size);
	}

	// NOTE: FRHIBufferInitializer::FFinalizeCallback is `protected` — only
	// nameable from a derived type (FDawnBufferInitializerHelper). From this
	// (non-derived) function we pass a bare lambda as the constructor
	// argument instead of spelling the protected alias out ourselves; it
	// converts implicitly at the call site.
	const bool bSnapVB = EnumHasAnyFlags(CreateDesc.Usage, EBufferUsageFlags::VertexBuffer);
	const uint64 SnapSize = BufDesc.size;
	WGPUQueue CaptureQueue = Queue;
	WGPUDevice CaptureDevice = Device;
	return FDawnBufferInitializerHelper(RHICmdList, NewBuffer.GetReference(), WritableData, BufDesc.size,
		[NewBuffer, bSnapVB, WritableData, SnapSize, CaptureQueue, CaptureDevice](FRHICommandListBase&) mutable -> FBufferRHIRef
		{
			// MAPPEDRANGE BYPASS: the caller has finished writing initial
			// contents into the CPU staging; upload via the proven
			// QueueWriteBuffer path and free the staging.
			if (bSnapVB) { DawnDiagSnapshotVB((void*)NewBuffer->Buffer, WritableData, SnapSize); }
			wgpuQueueWriteBuffer(CaptureQueue, NewBuffer->Buffer, 0, WritableData, (size_t)SnapSize);
			// GPUREADBACK probe (sliver hunt): async copy the head of the first
			// few mesh-sized vertex buffers back from the GPU and print it —
			// verifies the upload actually LANDED (wasm64 pointer-width
			// suspicion). Compare against the cpu= line printed here.
			static uint32 _rbN = 0;
			const float* _cf = (const float*)WritableData;
			const bool _bRealData = (SnapSize >= 792) && (_cf[0] != 0.f || _cf[1] != 0.f || _cf[2] != 0.f);
			if (bSnapVB && _bRealData && _rbN < 3)
			{
				++_rbN;
				const float* CF = (const float*)WritableData;
				printf("DAWNBG GPUREADBACK cpu buf=%p size=%llu v0=[%.2f %.2f %.2f] v1=[%.2f %.2f %.2f]\n",
					(void*)NewBuffer->Buffer, (unsigned long long)SnapSize, CF[0], CF[1], CF[2], CF[3], CF[4], CF[5]);
				WGPUBufferDescriptor RD = {};
				RD.usage = WGPUBufferUsage_CopyDst | WGPUBufferUsage_MapRead;
				RD.size = 72;
				WGPUBuffer RB = wgpuDeviceCreateBuffer(CaptureDevice, &RD);
				if (RB)
				{
					WGPUCommandEncoderDescriptor ED = {};
					WGPUCommandEncoder Enc = wgpuDeviceCreateCommandEncoder(CaptureDevice, &ED);
					wgpuCommandEncoderCopyBufferToBuffer(Enc, NewBuffer->Buffer, 0, RB, 0, 72);
					WGPUCommandBufferDescriptor CD = {};
					WGPUCommandBuffer CB = wgpuCommandEncoderFinish(Enc, &CD);
					wgpuQueueSubmit(CaptureQueue, 1, &CB);
					wgpuCommandBufferRelease(CB);
					wgpuCommandEncoderRelease(Enc);
					WGPUBufferMapCallbackInfo MC = {};
					MC.mode = WGPUCallbackMode_AllowSpontaneous;
					MC.callback = [](WGPUMapAsyncStatus Status, WGPUStringView Msg, void* U1, void*)
					{
						WGPUBuffer B = (WGPUBuffer)U1;
						if (Status == WGPUMapAsyncStatus_Success)
						{
							const float* F = (const float*)wgpuBufferGetConstMappedRange(B, 0, 72);
							if (F) { printf("DAWNBG GPUREADBACK gpu v0=[%.2f %.2f %.2f] v1=[%.2f %.2f %.2f] v2=[%.2f %.2f %.2f]\n", F[0], F[1], F[2], F[3], F[4], F[5], F[6], F[7], F[8]); }
							else   { printf("DAWNBG GPUREADBACK gpu mapped-range NULL\n"); }
							wgpuBufferUnmap(B);
						}
						else
						{
							printf("DAWNBG GPUREADBACK FAILED status=%d %.*s\n", (int)Status, (int)Msg.length, Msg.data ? Msg.data : "");
						}
						fflush(stdout);
					};
					MC.userdata1 = (void*)RB;
					wgpuBufferMapAsync(RB, WGPUMapMode_Read, 0, 72, MC);
					// RB intentionally kept alive (3 max) for the async map.
				}
				fflush(stdout);
			}
			FMemory::Free(WritableData);
			return FBufferRHIRef(NewBuffer);
		});
}

void* FDawnDynamicRHI::RHILockBuffer(FRHICommandListBase& RHICmdList, FRHIBuffer* BufferRHI, uint32 Offset, uint32 Size, EResourceLockMode LockMode)
{
	// WebGPU buffer mapping is asynchronous (needs an event-loop pump), so CPU
	// access uses a staging allocation. Writes upload via wgpuQueueWriteBuffer on
	// unlock; read locks are zero-filled best-effort (init-time resources lock
	// write-only, which this handles exactly).
	FDawnBuffer* Buffer = static_cast<FDawnBuffer*>(BufferRHI);
	const uint64 Alloc = Align((uint64)FMath::Max<uint32>(Size, 4u), 4u);
	Buffer->LockOffset = Offset;
	Buffer->LockSize = Size;
	Buffer->LockStaging = FMemory::Malloc(Alloc);
	Buffer->bLockReadOnly = (LockMode == RLM_ReadOnly);
	if (LockMode == RLM_ReadOnly)
	{
		FMemory::Memzero(Buffer->LockStaging, Alloc);
		// READLOCK-WIPE diag: a read lock on a vertex/index buffer is exactly
		// the access pattern that used to zero real mesh data on unlock.
		static uint32 _rl = 0;
		if (_rl++ < 12 && EnumHasAnyFlags(Buffer->GetDesc().Usage, EBufferUsageFlags::VertexBuffer | EBufferUsageFlags::IndexBuffer))
		{
			printf("DAWNBG READLOCK vb/ib buf=%p off=%u size=%u (returning zeros; unlock will NOT write back)\n", (void*)Buffer->Buffer, Offset, Size);
			fflush(stdout);
		}
	}
	return Buffer->LockStaging;
}

void FDawnDynamicRHI::RHIUnlockBuffer(FRHICommandListBase& RHICmdList, FRHIBuffer* BufferRHI)
{
	FDawnBuffer* Buffer = static_cast<FDawnBuffer*>(BufferRHI);
	if (!Buffer->LockStaging)
	{
		return;
	}
	// READLOCK-WIPE fix: a read-only lock's staging is zero-filled (WebGPU has
	// no synchronous readback) — writing it back on unlock DESTROYED the
	// buffer's real contents (map-load collision/nav read-locks zeroed mesh
	// vertex buffers -> world collapsed to slivers). Read locks upload nothing.
	if (Buffer->bLockReadOnly)
	{
		FMemory::Free(Buffer->LockStaging);
		Buffer->LockStaging = nullptr;
		Buffer->bLockReadOnly = false;
		return;
	}
	if (Buffer->Buffer && Buffer->LockSize > 0)
	{
		uint64 WriteSize = Align((uint64)Buffer->LockSize, 4u);
		if (Buffer->LockOffset + WriteSize > Buffer->WgpuSize)
		{
			WriteSize = (Buffer->WgpuSize > Buffer->LockOffset) ? (Buffer->WgpuSize - Buffer->LockOffset) : 0;
			WriteSize &= ~3ull; // keep 4-byte aligned
		}
		if (WriteSize > 0)
		{
			wgpuQueueWriteBuffer(Queue, Buffer->Buffer, Buffer->LockOffset, Buffer->LockStaging, (size_t)WriteSize);
			// POSDUMP: lock/unlock upload path — snapshot vertex-buffer head.
			if (Buffer->LockOffset == 0 && EnumHasAnyFlags(Buffer->GetDesc().Usage, EBufferUsageFlags::VertexBuffer))
			{
				DawnDiagSnapshotVB((void*)Buffer->Buffer, Buffer->LockStaging, WriteSize);
			}
		}
	}
	FMemory::Free(Buffer->LockStaging);
	Buffer->LockStaging = nullptr;
}

FRHITextureInitializer FDawnDynamicRHI::RHICreateTextureInitializer(FRHICommandListBase& RHICmdList, const FRHITextureCreateDesc& InCreateDesc)
{
	// Same DetermineInitialState() requirement as RHICreateBufferInitializer above.
	FRHITextureCreateDesc CreateDesc = InCreateDesc;
	if (CreateDesc.InitialState == ERHIAccess::Unknown)
	{
		CreateDesc.SetInitialState(RHIGetDefaultResourceState(CreateDesc.Flags, false));
	}

	if (DAWNRHI_VERBOSE_DIAG) { UE_LOG(LogDawnRHI, Warning, TEXT("TEXDIAG entry: thread=%u gt=%d rt=%d"), FPlatformTLS::GetCurrentThreadId(), (int32)IsInGameThread(), (int32)IsInRenderingThread()); UE_LOG(LogDawnRHI, Warning, TEXT("TEXDIAG e2: fmt=%d %dx%d flags=0x%llx"), (int32)CreateDesc.Format, CreateDesc.Extent.X, CreateDesc.Extent.Y, (uint64)CreateDesc.Flags); }
	TRefCountPtr<FDawnTexture> NewTexture = new FDawnTexture(CreateDesc);

	const bool bIsDepthStencil = EnumHasAnyFlags(CreateDesc.Flags, ETextureCreateFlags::DepthStencilTargetable);

	WGPUTextureUsage Usage = WGPUTextureUsage_CopySrc | WGPUTextureUsage_CopyDst;
	if (bIsDepthStencil)
	{
		Usage |= WGPUTextureUsage_RenderAttachment;
	}
	if (EnumHasAnyFlags(CreateDesc.Flags, ETextureCreateFlags::RenderTargetable))
	{
		Usage |= WGPUTextureUsage_RenderAttachment;
	}
	if (EnumHasAnyFlags(CreateDesc.Flags, ETextureCreateFlags::ShaderResource) || !bIsDepthStencil)
	{
		// Default non-depth textures to sampleable: most UE textures (incl. Slate's
		// font atlas, whose create desc omits an explicit ShaderResource flag) are
		// sampled, and WebGPU requires the usage bit up-front at creation.
		Usage |= WGPUTextureUsage_TextureBinding;
	}

	// Real texture-dimension support. WebGPU has no cube texture TYPE — a cube
	// is a 2D texture with 6 array layers sampled through a Cube-dimension
	// VIEW — so cubes stay WGPUTextureDimension_2D but get 6*ArraySize layers.
	// (Previously everything was created single-layer 2D, so the mobile
	// reflection/sky cubemap could never bind as a cube.)
	uint32 DepthOrLayers = 1;
	switch (CreateDesc.Dimension)
	{
	case ETextureDimension::TextureCube:      DepthOrLayers = 6; break;
	case ETextureDimension::TextureCubeArray: DepthOrLayers = 6u * FMath::Max<uint32>(1u, (uint32)CreateDesc.ArraySize); break;
	case ETextureDimension::Texture2DArray:   DepthOrLayers = FMath::Max<uint32>(1u, (uint32)CreateDesc.ArraySize); break;
	case ETextureDimension::Texture3D:        DepthOrLayers = FMath::Max<uint32>(1u, (uint32)CreateDesc.Depth); break;
	default: break;
	}

	WGPUTextureDescriptor TexDesc = {};
	TexDesc.usage = Usage;
	TexDesc.dimension = (CreateDesc.Dimension == ETextureDimension::Texture3D) ? WGPUTextureDimension_3D : WGPUTextureDimension_2D;
	TexDesc.size = { (uint32)CreateDesc.Extent.X, (uint32)CreateDesc.Extent.Y, DepthOrLayers };
	TexDesc.format = bIsDepthStencil ? DawnDepthStencilFormat() : DawnTextureFormatFromPixelFormat(CreateDesc.Format);
	// Clamp mip count to what WebGPU allows for these dimensions
	// (floor(log2(max(w,h)))+1). A NumMips larger than the extent supports makes
	// the full-mip TextureView invalid -> "mip level count (N) is invalid" ->
	// invalid command buffer -> crash.
	{
		const uint32 _MaxDim = FMath::Max<uint32>(TexDesc.size.width, TexDesc.size.height);
		const uint32 _MaxMips = _MaxDim > 0 ? ((uint32)FMath::FloorLog2(_MaxDim) + 1u) : 1u;
		TexDesc.mipLevelCount = FMath::Clamp<uint32>((uint32)CreateDesc.NumMips, 1u, _MaxMips);
	}
	TexDesc.sampleCount = 1;

	if (DAWNRHI_VERBOSE_DIAG) UE_LOG(LogDawnRHI, Warning, TEXT("TEXDIAG desc: usage=0x%x wgpuFmt=%d dim=%d size=%ux%u mip=%u samp=%u ds=%d"), (uint32)TexDesc.usage, (int32)TexDesc.format, (int32)TexDesc.dimension, TexDesc.size.width, TexDesc.size.height, TexDesc.mipLevelCount, TexDesc.sampleCount, (int32)bIsDepthStencil);
	WGPUTexture Texture = wgpuDeviceCreateTexture(Device, &TexDesc);
	if (DAWNRHI_VERBOSE_DIAG) UE_LOG(LogDawnRHI, Warning, TEXT("TEXDIAG created: wgpuTex=%p wgpuFmt=%d"), (void*)Texture, (int32)TexDesc.format);
	checkf(Texture, TEXT("DawnRHI: texture creation failed"));
	NewTexture->Texture = Texture;
	if (CreateDesc.IsTextureCube())
	{
		// Cube textures MUST be sampled through an explicit Cube/CubeArray view:
		// the default view of a 6-layer 2D texture is 2d-array, which would
		// mismatch both the texture_cube WGSL declaration and the (now
		// dimension-correct) bind group layout.
		WGPUTextureViewDescriptor CubeViewDesc = {};
		CubeViewDesc.format = TexDesc.format;
		CubeViewDesc.dimension = (CreateDesc.Dimension == ETextureDimension::TextureCubeArray) ? WGPUTextureViewDimension_CubeArray : WGPUTextureViewDimension_Cube;
		CubeViewDesc.baseMipLevel = 0;
		CubeViewDesc.mipLevelCount = TexDesc.mipLevelCount;
		CubeViewDesc.baseArrayLayer = 0;
		CubeViewDesc.arrayLayerCount = DepthOrLayers;
		CubeViewDesc.aspect = WGPUTextureAspect_All;
		NewTexture->View = wgpuTextureCreateView(Texture, &CubeViewDesc);
		DawnLiveHandleAdd((void*)NewTexture->View); // LIVEHANDLE
	}
	else
	{
		NewTexture->View = wgpuTextureCreateView(Texture, nullptr);
		DawnLiveHandleAdd((void*)NewTexture->View); // LIVEHANDLE
	}
	// Render-pass attachments require a single-mip view (WebGPU forbids binding a
	// multi-mip view as a color/depth attachment). Keep the full-mip View for
	// sampling; build a dedicated single-mip RTView for RT/depth binding.
	if (EnumHasAnyFlags(CreateDesc.Flags, ETextureCreateFlags::RenderTargetable | ETextureCreateFlags::DepthStencilTargetable))
	{
		WGPUTextureViewDescriptor _RtvDesc = {};
		_RtvDesc.format = TexDesc.format;
		_RtvDesc.dimension = WGPUTextureViewDimension_2D;
		_RtvDesc.baseMipLevel = 0;
		_RtvDesc.mipLevelCount = 1;
		_RtvDesc.baseArrayLayer = 0;
		_RtvDesc.arrayLayerCount = 1;
		_RtvDesc.aspect = WGPUTextureAspect_All;
		NewTexture->RTView = wgpuTextureCreateView(Texture, &_RtvDesc);
		DawnLiveHandleAdd((void*)NewTexture->RTView); // LIVEHANDLE
	}

	// Initial pixel data (Stage 2: sampled textures, e.g. a material/UI
	// texture). GetSubresourceCallback hands the caller a CPU-side staging
	// buffer to WriteData() into; FinalizeCallback uploads it via
	// wgpuQueueWriteTexture and frees the staging memory. WebGPU has no
	// buffer-style mappedAtCreation for textures, so this (rather than the
	// buffer path's direct-mapped-pointer trick) is the correct shape here.
	const uint32 Width = (uint32)CreateDesc.Extent.X;
	const uint32 Height = (uint32)CreateDesc.Extent.Y;
	// Block-aware staging size (handles wide formats like RGBA16F/RGBA32F and
	// BC/DXT compressed, not just 4-byte RGBA8). A hardcoded 4 bpp overflowed the
	// staging buffer for wider formats -> heap corruption on free.
	const FPixelFormatInfo& InitFmt = GPixelFormats[CreateDesc.Format];
	const uint32 BlockSizeX = (uint32)FMath::Max<int32>(1, InitFmt.BlockSizeX);
	const uint32 BlockSizeY = (uint32)FMath::Max<int32>(1, InitFmt.BlockSizeY);
	const uint32 BlockBytes = (uint32)InitFmt.BlockBytes;
	// COMPRESSEDFIX: only skip compressed uploads when the device genuinely
	// can't take the format (feature absent -> RGBA8 substitute texture).
	// When the compression feature IS present the texture was created with
	// its REAL BC/ETC2/ASTC format and the block data uploads directly.
	const bool bInitCompressed = (InitFmt.BlockSizeX > 1) && !DawnIsCompressedFormatUploadable((EPixelFormat)CreateDesc.Format);
	{
		static uint32 _cc = 0;
		if (InitFmt.BlockSizeX > 1 && _cc++ < 12) { printf("DAWNBG COMPTEX fmt=%d %dx%d uploadable=%d\n", (int)CreateDesc.Format, CreateDesc.Extent.X, CreateDesc.Extent.Y, bInitCompressed ? 0 : 1); fflush(stdout); }
	}
	// Cube (and array) textures deliver initial data per SUBRESOURCE
	// (face/slice/mip) — the old single shared staging buffer collapsed all 6
	// cube faces onto layer 0. Keep one staging allocation per requested
	// subresource and upload each into its own array layer/mip at finalize.
	struct FDawnSubresUpload { uint32 Layer = 0; uint32 Mip = 0; uint32 W = 0, H = 0, Pitch = 0, Rows = 0; TArray<uint8> Data; };
	TSharedPtr<TArray<TUniquePtr<FDawnSubresUpload>>> Uploads = MakeShared<TArray<TUniquePtr<FDawnSubresUpload>>>();
	const uint32 NumFaces = CreateDesc.IsTextureCube() ? 6u : 1u;
	const uint32 MaxLayers = DepthOrLayers;
	const uint32 MaxMips = TexDesc.mipLevelCount;

	// NOTE: same protected-typedef situation as FFinalizeCallback above —
	// FGetSubresourceCallback can't be named from this (non-derived)
	// function, so both lambdas below are passed as bare arguments rather
	// than assigned to a named variable of that type first.
	WGPUQueue QueueCopy = Queue;
	return FDawnTextureInitializerHelper(RHICmdList, NewTexture.GetReference(),
		[NewTexture, Uploads, bInitCompressed, MaxLayers, MaxMips, QueueCopy, BlockSizeX, BlockSizeY](FRHICommandListBase&) mutable -> FTextureRHIRef
		{
			if (!bInitCompressed)
			{
				for (const TUniquePtr<FDawnSubresUpload>& Up : *Uploads)
				{
					if (!Up.IsValid() || Up->Data.Num() == 0 || Up->Layer >= MaxLayers || Up->Mip >= MaxMips)
					{
						continue;
					}
					WGPUTexelCopyTextureInfo Dst = {};
					Dst.texture = NewTexture->Texture;
					Dst.mipLevel = Up->Mip;
					Dst.origin = { 0, 0, Up->Layer };
					WGPUTexelCopyBufferLayout Layout = {};
					Layout.bytesPerRow = Up->Pitch;
					Layout.rowsPerImage = Up->Rows;
					// COMPRESSEDFIX: compressed copy extents must be BLOCK-ALIGNED
					// (small 2x2/1x1 mips upload at their physical padded size —
					// the cooked block data always holds the full block).
					WGPUExtent3D Size = { FMath::DivideAndRoundUp(Up->W, BlockSizeX) * BlockSizeX, FMath::DivideAndRoundUp(Up->H, BlockSizeY) * BlockSizeY, 1 };
					wgpuQueueWriteTexture(QueueCopy, &Dst, Up->Data.GetData(), (size_t)Up->Data.Num(), &Layout, &Size);
				}
			}
			Uploads->Empty();
			return FTextureRHIRef(NewTexture);
		},
		[Uploads, Width, Height, BlockSizeX, BlockSizeY, BlockBytes, NumFaces](FRHITextureInitializer::FSubresourceIndex SubresourceIndex) -> FRHITextureSubresourceInitializer
		{
			const uint32 MipW = FMath::Max<uint32>(1u, Width >> (uint32)SubresourceIndex.MipIndex);
			const uint32 MipH = FMath::Max<uint32>(1u, Height >> (uint32)SubresourceIndex.MipIndex);
			const uint32 BX = FMath::DivideAndRoundUp(MipW, BlockSizeX);
			const uint32 BY = FMath::DivideAndRoundUp(MipH, BlockSizeY);
			TUniquePtr<FDawnSubresUpload> Up = MakeUnique<FDawnSubresUpload>();
			Up->Layer = (uint32)SubresourceIndex.ArrayIndex * NumFaces + (uint32)SubresourceIndex.FaceIndex;
			Up->Mip = (uint32)SubresourceIndex.MipIndex;
			Up->W = MipW; Up->H = MipH;
			Up->Pitch = BX * BlockBytes;
			Up->Rows = BY;
			Up->Data.SetNumUninitialized((int64)Up->Pitch * BY);
			FRHITextureSubresourceInitializer SubresourceInit;
			SubresourceInit.Data = Up->Data.GetData();
			SubresourceInit.Size = (uint64)Up->Data.Num();
			SubresourceInit.Stride = Up->Pitch;
			Uploads->Add(MoveTemp(Up));
			return SubresourceInit;
		});
}

