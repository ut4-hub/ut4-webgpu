// POSDUMP (speck diagnostic): WebGPU has no easy synchronous GPU readback
// under -onethread, so capture the first 72 bytes (6 float3 positions at
// stride 12) of every VERTEX buffer's CPU-side contents at upload time,
// keyed by WGPUBuffer handle. The draw path (DawnCommandContext) looks the
// slot-0 buffer up here and prints the actual position bytes the VS reads.
static TMap<void*, TArray<uint8>> GDawnVBSnapshots;
void DawnDiagSnapshotVB(void* WgpuBuf, const void* Data, uint64 DataSize)
{
	// Un-gated (sliver hunt): 72-byte head snapshot per vertex buffer is cheap
	// and lets the draw path verify real position data reaches the GPU.
	if (!WgpuBuf || !Data || DataSize < 12) { return; }
	if (GDawnVBSnapshots.Num() >= 16384 && !GDawnVBSnapshots.Contains(WgpuBuf)) { return; }
	TArray<uint8>& Snap = GDawnVBSnapshots.FindOrAdd(WgpuBuf);
	const int32 N = (int32)FMath::Min<uint64>(DataSize, 72);
	Snap.SetNumUninitialized(N);
	FMemory::Memcpy(Snap.GetData(), Data, N);
}
const TArray<uint8>* DawnDiagGetVBSnapshot(void* WgpuBuf)
{
	return GDawnVBSnapshots.Find(WgpuBuf);
}

// ============================================================================
// CLIPPROBE (invisible-world fork test 2026-08-18): replicate the vertex
// shader's position math ON THE CPU from the exact bytes the GPU sees — the
// slot-0 vertex snapshot, the LAST-uploaded (post-FOLD) Primitive UB, and the
// LAST-uploaded View UB (the transient per-draw Primitive UB is created right
// before its draw, so at draw time "last uploaded" IS this draw's data; see
// PRIMSRC totals). Verdict per sampled draw: does vertex 0 land IN the
// frustum (clip.w>0, |x|,|y|<=w, 0<=z<=w reversed-Z)?
//   IN  -> the world rasterizes where it should; invisibility is SHADING
//          (black lighting) — fix lighting/ambient.
//   OUT -> the transform chain is broken for the static-mesh (LocalVF) path
//          specifically — read the WGSLX world-VS dump.
// No GPU readback needed; single-threaded RHI so plain globals.
// ============================================================================
TArray<uint8> GDawnLastPrimUBUpload; // post-fold FPrimitiveUniformShaderParameters bytes
TArray<uint8> GDawnLastViewUBData;   // View UB bytes
void DawnDiagClipProbe(void* Slot0WgpuBuf, uint32 Slot0Offset, uint32 Stride, uint32 NumPrims)
{
	static uint32 _seen = 0, _shown = 0;
	++_seen;
	if (_shown >= 40 || (_seen % 400) != 1) { return; }
	if (GDawnLastPrimUBUpload.Num() < 816 || GDawnLastViewUBData.Num() < 4096) { return; }
	const TArray<uint8>* Snap = Slot0WgpuBuf ? GDawnVBSnapshots.Find(Slot0WgpuBuf) : nullptr;
	if (!Snap || Slot0Offset + 12 > (uint32)Snap->Num()) { return; }
	static int32 OffTWTC = -1, OffPVTH = -1, OffPVTL = -1;
	static bool _resolved = false;
	if (!_resolved)
	{
		_resolved = true;
		if (FShaderParametersMetadata* Meta = FindUniformBufferStructByName(TEXT("View")))
		{
			for (const FShaderParametersMetadata::FMember& M : Meta->GetMembers())
			{
				if (FCString::Stricmp(M.GetName(), TEXT("TranslatedWorldToClip")) == 0) { OffTWTC = (int32)M.GetOffset(); }
				else if (FCString::Stricmp(M.GetName(), TEXT("PreViewTranslationHigh")) == 0) { OffPVTH = (int32)M.GetOffset(); }
				else if (FCString::Stricmp(M.GetName(), TEXT("PreViewTranslationLow")) == 0) { OffPVTL = (int32)M.GetOffset(); }
				else if (OffPVTH < 0 && FCString::Stricmp(M.GetName(), TEXT("PreViewTranslation")) == 0) { OffPVTH = (int32)M.GetOffset(); }
			}
		}
		printf("DAWNBG CLIPPROBE viewOffsets TWTC=%d PVTH=%d PVTL=%d\n", OffTWTC, OffPVTH, OffPVTL);
		fflush(stdout);
	}
	if (OffTWTC < 0 || OffPVTH < 0) { return; }
	const float* P  = (const float*)GDawnLastPrimUBUpload.GetData();
	const float* T  = (const float*)(GDawnLastViewUBData.GetData() + OffTWTC);
	const float* H  = (const float*)(GDawnLastViewUBData.GetData() + OffPVTH);
	const float* L  = (OffPVTL >= 0) ? (const float*)(GDawnLastViewUBData.GetData() + OffPVTL) : nullptr;
	const float* lp = (const float*)(Snap->GetData() + Slot0Offset);
	// Row-vector math, matching the WGSL (local.x*M[0] + local.y*M[1] +
	// local.z*M[2] + trans + PositionHigh + PreViewTranslation). P[4..6] is
	// PositionHigh (zero post-fold — included so unfolded data still probes
	// correctly); rows of LocalToRelativeWorld at floats 8/12/16, translation
	// at 20.
	float W0[3];
	for (int32 C = 0; C < 3; ++C)
	{
		W0[C] = lp[0]*P[8+C] + lp[1]*P[12+C] + lp[2]*P[16+C] + P[20+C] + P[4+C] + H[C] + (L ? L[C] : 0.f);
	}
	float Clip[4];
	for (int32 C = 0; C < 4; ++C)
	{
		Clip[C] = W0[0]*T[0*4+C] + W0[1]*T[1*4+C] + W0[2]*T[2*4+C] + T[3*4+C];
	}
	const bool bIn = Clip[3] > 0.f && FMath::Abs(Clip[0]) <= Clip[3] && FMath::Abs(Clip[1]) <= Clip[3] && Clip[2] >= 0.f && Clip[2] <= Clip[3];
	++_shown;
	printf("DAWNBG CLIPPROBE #%u prims=%u stride=%u local=[%.2f %.2f %.2f] trans=[%.1f %.1f %.1f] high=[%.1f %.1f %.1f] pvtH=[%.1f %.1f %.1f] clip=[%.1f %.1f %.2f %.1f] %s\n",
		_shown, NumPrims, Stride, lp[0], lp[1], lp[2], P[20], P[21], P[22], P[4], P[5], P[6], H[0], H[1], H[2], Clip[0], Clip[1], Clip[2], Clip[3], bIn ? "IN-FRUSTUM" : "OUT");
	fflush(stdout);
}

