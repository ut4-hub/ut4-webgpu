void FDawnDynamicRHI::RHIEndFrame(const FRHIEndFrameArgs& Args)
{
	// WNDR SINGLETHREAD: the RHI-submit dispatch task (RHISubmitCommandLists ->
	// SubmitToQueue -> wgpuQueueSubmit) is enqueued to the render(=game)-thread-local
	// TaskGraph queue, but single-threaded on wasm that queue suffers a lost-wakeup:
	// FRHICommandListExecutor::Submit parks on the named-thread stall event and the
	// dispatch task never runs, so wgpuQueueSubmit is never called (wgpuSubmit=0,
	// presentedFrame=-1) even though the frame's draws are fully encoded inline
	// (Bypass) into CommandEncoder. RHIEndFrame IS reached every frame on the game
	// thread, so flush the pending command encoder here. SubmitToQueue() is a no-op
	// when there is no open encoder, and it nulls CommandEncoder, so if the stuck
	// dispatch task ever does run its SubmitToQueue() is harmless (double-submit safe).
	if (CommandContext.IsValid())
	{
		CommandContext->SubmitToQueue();
	}
#if PLATFORM_WASM
	// Frame boundary: release the UBs held alive across this frame's draws (see WndrFrameHeldUBs).
	if (CommandContext.IsValid()) { CommandContext->WndrReleaseFrameHeldUBs(); }
#endif
#if PLATFORM_WASM
	// Controlled end-of-frame delete drain (RHIResources.cpp, friend of FRHIResource -> can call the
	// private Gather/Delete statics). Fence held during deletes so the executor cascade can't re-enter.
	{ extern RHI_API void WndrDrainPendingDeletesEndFrame(); WndrDrainPendingDeletesEndFrame(); }
#endif

	// FRAMESUM: per-frame pass/draw accounting (see DawnCommandContext.cpp).
	{ extern void DawnDiagFrameSummaryTick(); DawnDiagFrameSummaryTick(); }
	// GPUREADBACK probe support: pump instance events once per frame so
	// AllowSpontaneous buffer-map callbacks actually deliver on this runtime.
	if (Instance) { wgpuInstanceProcessEvents(Instance); }
	// Per-frame surface backbuffer rotation. emdawnwebgpu auto-presents whatever was
	// submitted to the current surface texture when the worker yields, so we must
	// release+re-acquire the surface texture EACH frame. The viewport's own
	// RHIEndDrawingViewport fires only occasionally on this SimplyStream setup;
	// RHIEndFrame is called once per frame, so drive the rotation from here. Deferred
	// by one frame (via PendingRelease, released at the next RHIGetViewportBackBuffer)
	// so the browser has presented the texture before we destroy it.
	if (ActiveViewportRHI)
	{
		FDawnViewport* Viewport = static_cast<FDawnViewport*>(ActiveViewportRHI);
		// Backbuffer is persistent; surface texture swapped in RHIGetViewportBackBuffer.
		// The browser AUTO-presents the surface when the worker yields (JSPI); calling
		// wgpuSurfacePresent here blocks the worker and stalls the render loop.
		(void)Viewport;
	}
}

