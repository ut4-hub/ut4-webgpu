class FDawnGraphicsPipelineState : public FRHIGraphicsPipelineState
{
public:
	WGPURenderPipeline Pipeline = nullptr;
	// STRIPIDX fix: WebGPU bakes stripIndexFormat into the pipeline, but UE
	// reuses one PSO across 16- and 32-bit index buffers (trail/ribbon
	// particles: ParticleSystemRender.cpp Source.IndexStride is uint16 for
	// small trails, uint32 for large). Strip-topology PSOs therefore carry
	// BOTH variants: Pipeline = stripIndexFormat Uint16 (also serves
	// non-indexed draws — stripIndexFormat only constrains INDEXED draws),
	// PipelineStrip32 = Uint32. RHIDrawIndexedPrimitive binds the variant
	// matching the bound index buffer's stride. Null for list topologies.
	// (Leaving stripIndexFormat Undefined made every indexed strip draw a
	// Dawn validation error that poisoned the whole per-frame command buffer
	// — 190 cascading errors, frozen presented frame, in-match freeze.)
	WGPURenderPipeline PipelineStrip32 = nullptr;
	// FRAGLESS: true = depth-only pipeline (null pixel shader, fragment=nullptr
	// — valid WebGPU). Depth prepass / CSM shadow-depth PSOs are legitimately
	// PS-less; the old code returned an INERT PSO for them, silently skipping
	// every prepass/shadow draw. The draw path must only use these inside
	// passes with NO color attachment (attachment-compatibility guard).
	bool bFragmentless = false;
	TRefCountPtr<FDawnVertexShader> VertexShader;
	TRefCountPtr<FDawnPixelShader> PixelShader;

	// Multi-stream vertex input (black-world fix): bit S set => the pipeline
	// declared a vertex-buffer layout at slot S (slot index == the vertex
	// declaration's StreamIndex). The draw path binds the command context's
	// per-stream bound buffer to each set slot; a set slot with no bound
	// buffer skips the draw (Dawn "missing vertex buffer" would invalidate
	// the whole command buffer). 0 = pipeline takes no vertex buffers.
	uint32 VertexStreamMask = 0;

	// VTXPADFIX: slot of the stride-0 dummy stream added at pipeline build to
	// satisfy shader-consumed attribute locations the vertex declaration
	// omitted (Dawn "Vertex attribute slot N ... not present in VertexState").
	// -1 = no padding. The draw path binds the shared zero vertex buffer here
	// (RHISetStreamSource never targets this slot).
	int32 DummyVertexStreamSlot = -1;

	// PRIMTYPE fix (the per-frame "Vertex range ... requires a larger buffer"
	// poison): the initializer's primitive type. The draw path derives vertex/
	// index counts from NumPrimitives with THIS — the old hardcoded
	// NumPrimitives*3 turned every PT_LineList batched-elements draw (4 lines
	// = 8 verts in an exactly-sized 512-byte buffer) into a 12-vertex request,
	// a Dawn validation error that invalidated the WHOLE command buffer every
	// frame (presentedFrame=-1). The pipeline's WGPU topology is translated
	// from this too (lines/points used to rasterize as bogus triangles).
	uint32 PrimitiveType = 0; // EPrimitiveType (PT_TriangleList)

	// INSTSTEP fix: per-slot vertex input rate + stride, mirroring the
	// pipeline's WGPUVertexBufferLayouts. Bit S of InstanceStreamMask set =>
	// slot S steps per-instance (FVertexElement::bUseInstanceIndex, exactly
	// like VulkanRHI's VK_VERTEX_INPUT_RATE_INSTANCE). The draw path uses
	// these to range-check each draw against the bound buffers (VTXRANGE
	// guard) so an under-sized bind skips ONE draw instead of poisoning the
	// whole command buffer.
	uint32 InstanceStreamMask = 0;
	uint16 StreamStrides[17] = {}; // == FDawnCommandContext::MaxVertexStreams

	// Stage 2 convention (no shader reflection yet — that lands with the real
	// shader-cook pipeline): a single, fixed @group(0) bind group layout used
	// by every PSO — binding 0 = uniform buffer (vertex+fragment visible),
	// binding 1 = texture (fragment), binding 2 = sampler (fragment). Shaders
	// that don't use all three simply don't declare the unused bindings in
	// WGSL; Dawn only requires the *bind group* contents to satisfy whatever
	// the shader actually references, not the other way around.
	//
	// Multi-@group fix (this session): real reflected bindings carry their
	// own FDawnShaderBinding::Group (see above), but until now
	// RHICreateGraphicsPipelineState silently ignored it and always built
	// exactly one WGPUBindGroupLayout/PipelineLayout with
	// bindGroupLayoutCount=1 — every reflected binding was folded into
	// @group(0) regardless of what the real cooked WGSL declared. Empirically
	// every real UE global shader cooked through this toolchain so far
	// (ScreenPass.usf, DistortApplyScreenPS.usf — see HANDOFF.md "Update 12")
	// DOES land entirely in @group(0) (ShaderConductor's DXC->SPIR-V path
	// assigns one flat descriptor set here), so the bug was latent/untested
	// rather than a live symptom — but it was still a real correctness gap
	// for any future shader that legitimately reflects >1 group. Now:
	// BindGroupLayouts/PipelineLayout are keyed by the real distinct Group
	// values found across VS+PS bindings (still exactly 1 entry for every
	// real shader cooked so far, 0-length falls back to the old fixed
	// single-@group(0) 3-slot convention below for the Stage 1/2
	// hand-authored WGSL paths).
	TArray<WGPUBindGroupLayout> BindGroupLayouts;
	WGPUPipelineLayout PipelineLayout = nullptr;

	virtual FRHIGraphicsShader* GetShader(EShaderFrequency Frequency) const override
	{
		switch (Frequency)
		{
		case SF_Vertex: return VertexShader.GetReference();
		case SF_Pixel:  return PixelShader.GetReference();
		default:        return nullptr;
		}
	}

	~FDawnGraphicsPipelineState()
	{
		if (Pipeline) { wgpuRenderPipelineRelease(Pipeline); }
		if (PipelineStrip32) { wgpuRenderPipelineRelease(PipelineStrip32); }
		if (PipelineLayout) { wgpuPipelineLayoutRelease(PipelineLayout); }
		for (WGPUBindGroupLayout Layout : BindGroupLayouts) { if (Layout) { DawnLiveHandleRemove((void*)Layout); /* wndr BGCACHE-1: evict cached groups */ wgpuBindGroupLayoutRelease(Layout); } }
	}
};

class FDawnBuffer : public FRHIBuffer
{
public:
	WGPUBuffer Buffer = nullptr;
	uint32 WgpuSize = 0;
	// CPU-staging lock state (RHILockBuffer/RHIUnlockBuffer): WebGPU buffer
	// mapping is async, so CPU access uses a staging alloc uploaded on unlock.
	void* LockStaging = nullptr;
	uint32 LockOffset = 0;
	uint32 LockSize = 0;
	// READLOCK-WIPE fix: read-only locks hand out a ZERO-filled staging (no
	// sync readback on WebGPU); unlock must NOT write that staging back or it
	// destroys the buffer's real GPU contents (collision/nav read-locks on
	// map load were zeroing mesh vertex buffers -> sliver world).
	bool bLockReadOnly = false;

	explicit FDawnBuffer(const FRHIBufferCreateDesc& CreateDesc) : FRHIBuffer(CreateDesc) {}
	~FDawnBuffer()
	{
		if (Buffer) { DawnLiveHandleRemove((void*)Buffer); wgpuBufferRelease(Buffer); }
	}
};

