// COMPRESSEDFIX (black-world root cause): compressed texture support flags,
// set at device creation from wgpuAdapterHasFeature (the features are also
// added to requiredFeatures). The old code assumed "Apple WebGPU has no BC
// support", created BC textures as RGBA8 substitutes and SKIPPED their
// uploads — every DXT/BC albedo, normal and LIGHTMAP in the map stayed a
// zero texture: black surfaces, black GI, while the uncompressed UI worked.
// Chrome/Dawn on Apple Silicon exposes texture-compression-bc (and etc2/astc).
extern bool GDawnBCTextureSupport;
extern bool GDawnETC2TextureSupport;
extern bool GDawnASTCTextureSupport;

inline bool DawnIsCompressedFormatUploadable(EPixelFormat Format)
{
	switch (Format)
	{
	case PF_DXT1: case PF_DXT3: case PF_DXT5:
	case PF_BC4: case PF_BC5: case PF_BC6H: case PF_BC7:
		return GDawnBCTextureSupport;
	case PF_ETC2_RGB: case PF_ETC2_RGBA: case PF_ETC2_R11_EAC: case PF_ETC2_RG11_EAC:
		return GDawnETC2TextureSupport;
	case PF_ASTC_4x4: case PF_ASTC_6x6: case PF_ASTC_8x8: case PF_ASTC_10x10: case PF_ASTC_12x12:
		return GDawnASTCTextureSupport;
	default:
		return false;
	}
}

// Helper: EPixelFormat -> WGPUTextureFormat. Stage 1 only needs RGBA8Unorm;
// this is intentionally narrow and will grow as real content lands (Stage 2).
inline WGPUTextureFormat DawnTextureFormatFromPixelFormat(EPixelFormat Format)
{
	switch (Format)
	{
	// COMPRESSEDFIX: real block-compressed formats whenever the device carries
	// the matching feature (see DawnIsCompressedFormatUploadable); otherwise
	// fall through to the RGBA8 substitute below (uploads skipped as before).
	case PF_DXT1: if (GDawnBCTextureSupport) { return WGPUTextureFormat_BC1RGBAUnorm; } break;
	case PF_DXT3: if (GDawnBCTextureSupport) { return WGPUTextureFormat_BC2RGBAUnorm; } break;
	case PF_DXT5: if (GDawnBCTextureSupport) { return WGPUTextureFormat_BC3RGBAUnorm; } break;
	case PF_BC4:  if (GDawnBCTextureSupport) { return WGPUTextureFormat_BC4RUnorm; } break;
	case PF_BC5:  if (GDawnBCTextureSupport) { return WGPUTextureFormat_BC5RGUnorm; } break;
	case PF_BC6H: if (GDawnBCTextureSupport) { return WGPUTextureFormat_BC6HRGBUfloat; } break;
	case PF_BC7:  if (GDawnBCTextureSupport) { return WGPUTextureFormat_BC7RGBAUnorm; } break;
	case PF_ETC2_RGB:      if (GDawnETC2TextureSupport) { return WGPUTextureFormat_ETC2RGB8Unorm; } break;
	case PF_ETC2_RGBA:     if (GDawnETC2TextureSupport) { return WGPUTextureFormat_ETC2RGBA8Unorm; } break;
	case PF_ETC2_R11_EAC:  if (GDawnETC2TextureSupport) { return WGPUTextureFormat_EACR11Unorm; } break;
	case PF_ETC2_RG11_EAC: if (GDawnETC2TextureSupport) { return WGPUTextureFormat_EACRG11Unorm; } break;
	case PF_ASTC_4x4:   if (GDawnASTCTextureSupport) { return WGPUTextureFormat_ASTC4x4Unorm; } break;
	case PF_ASTC_6x6:   if (GDawnASTCTextureSupport) { return WGPUTextureFormat_ASTC6x6Unorm; } break;
	case PF_ASTC_8x8:   if (GDawnASTCTextureSupport) { return WGPUTextureFormat_ASTC8x8Unorm; } break;
	case PF_ASTC_10x10: if (GDawnASTCTextureSupport) { return WGPUTextureFormat_ASTC10x10Unorm; } break;
	case PF_ASTC_12x12: if (GDawnASTCTextureSupport) { return WGPUTextureFormat_ASTC12x12Unorm; } break;
	default: break;
	}
	switch (Format)
	{
	case PF_R8G8B8A8:      return WGPUTextureFormat_RGBA8Unorm;
	case PF_B8G8R8A8:      return WGPUTextureFormat_BGRA8Unorm;
	case PF_FloatRGBA:     return WGPUTextureFormat_RGBA16Float;
	// Narrow formats MUST map to a Dawn format of the SAME bytes-per-pixel as the
	// engine's GPixelFormats[Format].BlockBytes, or wgpuQueueWriteTexture rejects
	// the upload ("byte size of each row > bytesPerRow") and aborts. Fonts/UI use
	// single-channel PF_G8/PF_A8 (1 byte) -> R8Unorm; 2-byte formats -> R16/RG8.
	case PF_G8:            return WGPUTextureFormat_R8Unorm;   // 1B (Slate font atlases)
	case PF_A8:            return WGPUTextureFormat_RGBA8Unorm; // no WebGPU A8; 1B coverage expanded to RGBA (a=cov) at upload so the grayscale-font shader's .w read works
	case PF_R8:            return WGPUTextureFormat_R8Unorm;   // 1B
	case PF_L8:            return WGPUTextureFormat_R8Unorm;   // 1B
	case PF_R8G8:          return WGPUTextureFormat_RG8Unorm;  // 2B
	case PF_R16F:          return WGPUTextureFormat_R16Float;  // 2B
	case PF_R16F_FILTER:   return WGPUTextureFormat_R16Float;  // 2B
	case PF_G16:           return WGPUTextureFormat_R16Float;  // 2B (approx, avoids abort)
	case PF_R32_FLOAT:     return WGPUTextureFormat_R32Float;  // 4B
	case PF_A2B10G10R10:   return WGPUTextureFormat_RGB10A2Unorm; // 4B
	case PF_G16R16:        return WGPUTextureFormat_RG16Float; // 4B (approx)
	case PF_G16R16F:       return WGPUTextureFormat_RG16Float; // 4B
	case PF_A32B32G32R32F: return WGPUTextureFormat_RGBA32Float; // 16B
	default:
	{
		// Generic catch-all: pick a Dawn format whose bytes-per-pixel equals the
		// engine's GPixelFormats[Format].BlockBytes so the upload stride always
		// matches (no "row > bytesPerRow" abort). Exact channel semantics may be
		// approximate for uncommon formats, but the write validates and content loads.
		const FPixelFormatInfo& _Info = GPixelFormats[Format];
		if (_Info.BlockSizeX > 1) return WGPUTextureFormat_RGBA8Unorm; // BC/compressed -> RGBA8 (write skipped)
		switch (_Info.BlockBytes)
		{
		case 1:  return WGPUTextureFormat_R8Unorm;
		case 2:  return WGPUTextureFormat_RG8Unorm;
		case 8:  return WGPUTextureFormat_RGBA16Float;
		case 16: return WGPUTextureFormat_RGBA32Float;
		default: return WGPUTextureFormat_RGBA8Unorm; // 4B and anything else
		}
	}
	}
}

inline WGPUVertexFormat DawnVertexFormatFromElementType(EVertexElementType Type)
{
	switch (Type)
	{
	case VET_Float1: return WGPUVertexFormat_Float32;
	case VET_Float2: return WGPUVertexFormat_Float32x2;
	case VET_Float3: return WGPUVertexFormat_Float32x3;
	case VET_Float4: return WGPUVertexFormat_Float32x4;
	// Non-float element types must map to their REAL byte size, else the pipeline
	// vertex stride check fails (e.g. FSlateVertex's VET_Color is 4 bytes, not 16).
	case VET_PackedNormal: return WGPUVertexFormat_Unorm8x4;
	case VET_UByte4:       return WGPUVertexFormat_Uint8x4;
	case VET_UByte4N:      return WGPUVertexFormat_Unorm8x4;
	case VET_Color:        return WGPUVertexFormat_Unorm8x4;
	case VET_Short2:       return WGPUVertexFormat_Sint16x2;
	case VET_Short4:       return WGPUVertexFormat_Sint16x4;
	case VET_Short2N:      return WGPUVertexFormat_Snorm16x2;
	case VET_Short4N:      return WGPUVertexFormat_Snorm16x4;
	case VET_Half2:        return WGPUVertexFormat_Float16x2;
	case VET_Half4:        return WGPUVertexFormat_Float16x4;
	case VET_UShort2:      return WGPUVertexFormat_Uint16x2;
	case VET_UShort4:      return WGPUVertexFormat_Uint16x4;
	case VET_UShort2N:     return WGPUVertexFormat_Unorm16x2;
	case VET_UShort4N:     return WGPUVertexFormat_Unorm16x4;
	case VET_UInt:         return WGPUVertexFormat_Uint32;
	default:         return WGPUVertexFormat_Float32x4;
	}
}

// Stage 2: the fixed depth-buffer format DawnRHI uses whenever a PSO/render
// pass asks for depth/stencil. Narrow on purpose (no stencil-capable variant
// selection yet) — broadened alongside real content needs.
inline WGPUTextureFormat DawnDepthStencilFormat()
{
	return WGPUTextureFormat_Depth24Plus;
}

inline WGPUCompareFunction DawnCompareFunctionFromRHI(ECompareFunction Fn)
{
	switch (Fn)
	{
	case CF_Less:         return WGPUCompareFunction_Less;
	case CF_LessEqual:    return WGPUCompareFunction_LessEqual;
	case CF_Greater:      return WGPUCompareFunction_Greater;
	case CF_GreaterEqual: return WGPUCompareFunction_GreaterEqual;
	case CF_Equal:        return WGPUCompareFunction_Equal;
	case CF_NotEqual:     return WGPUCompareFunction_NotEqual;
	case CF_Never:        return WGPUCompareFunction_Never;
	case CF_Always:       return WGPUCompareFunction_Always;
	default:              return WGPUCompareFunction_Always;
	}
}

inline WGPUFilterMode DawnFilterModeFromRHI(ESamplerFilter Filter)
{
	switch (Filter)
	{
	case SF_Point:              return WGPUFilterMode_Nearest;
	default:                    return WGPUFilterMode_Linear; // Bilinear/Trilinear/Anisotropic*
	}
}

inline WGPUMipmapFilterMode DawnMipFilterModeFromRHI(ESamplerFilter Filter)
{
	switch (Filter)
	{
	case SF_Point:  return WGPUMipmapFilterMode_Nearest;
	default:        return WGPUMipmapFilterMode_Linear;
	}
}

inline WGPUAddressMode DawnAddressModeFromRHI(ESamplerAddressMode Mode)
{
	switch (Mode)
	{
	case AM_Wrap:   return WGPUAddressMode_Repeat;
	case AM_Clamp:  return WGPUAddressMode_ClampToEdge;
	case AM_Mirror: return WGPUAddressMode_MirrorRepeat;
	case AM_Border: return WGPUAddressMode_ClampToEdge; // Dawn has no border-color address mode
	default:        return WGPUAddressMode_ClampToEdge;
	}
}
