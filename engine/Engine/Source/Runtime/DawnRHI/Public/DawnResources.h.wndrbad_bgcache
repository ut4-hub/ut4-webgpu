// UBREGISTRY (owner-pairing fix): WGPUBuffer -> FDawnUniformBuffer lookup so
// the bind-group builder can resolve THIS DRAW's Material UB (the one bound at
// the group's "Material" constant binding) to its captured resource table.
void DawnUBRegistryRemove(void* WgpuBuf); // DawnDynamicRHI.cpp

class FDawnUniformBuffer : public FRHIUniformBuffer
{
public:
	WGPUBuffer Buffer = nullptr;

	// UBRESTABLE (the black-world/collapsed-bots root-cause fix): UE delivers
	// a uniform buffer's TEXTURE/SAMPLER/SRV members (material albedo
	// Material_Texture2D_0, lightmaps, reflection captures, GPUSkin bone
	// matrices) inside the UB's RESOURCE TABLE — raw FRHIResource* pointers
	// embedded in the Contents blob at Layout.Resources[].MemberOffset. They
	// are NEVER sent as loose RHISetShaderParameters params; the RHI must
	// extract and bind them itself. DawnRHI ignored the table, so every such
	// WGSL binding fell to the zero/black dummy (black albedo -> black world;
	// zero bone matrices -> bots collapsed to a point). Captured at
	// create/update (DawnCaptureUBResourceTable), consumed at bind-group
	// build (FlushPendingBindGroups UBRESTABLE fill) by matching the
	// reflected WGSL binding name "<ShaderName>_<WgslName>".
	FString ShaderName; // WGSL var name of this UB ("Material", "GPUSkinVFBase", ...)
	struct FTableEntry
	{
		FString WgslName;                  // flattened member name ("Texture2D_0", "Common_BoneMatrices")
		TRefCountPtr<FRHIResource> Resource;
		uint8 MemberType;                  // EUniformBufferBaseType
	};
	TArray<FTableEntry> ResTable;
	TArray<uint8> LastUploadBytes; // WNDR per-draw probe: cached CPU bytes of the last upload (Primitive UBs)

	explicit FDawnUniformBuffer(const FRHIUniformBufferLayout* InLayout) : FRHIUniformBuffer(InLayout) {}
	~FDawnUniformBuffer()
	{
#if PLATFORM_WASM
		// wndr UBDEAD diag: a ResTable entry whose resource is already dead -> name the UB + member,
		// and drop it WITHOUT Release (the release would hit freed/reused memory).
		for (FTableEntry& E : ResTable)
		{
			FRHIResource* R = E.Resource.GetReference();
			if (R && !R->IsValid())
			{
				static uint32 _ud = 0;
				if (_ud++ < 40) { printf("WNDR UBDEAD ub=%s sn=%s member=%s mt=%d res=%p rtype=%d\n", TCHAR_TO_UTF8(*GetLayout().GetDebugName()), TCHAR_TO_UTF8(*ShaderName), TCHAR_TO_UTF8(*E.WgslName), (int)E.MemberType, (void*)R, (int)R->GetType()); fflush(stdout); }
				*reinterpret_cast<FRHIResource**>(&E.Resource) = nullptr;
			}
		}
#endif
		if (Buffer) { DawnUBRegistryRemove((void*)Buffer); DawnLiveHandleRemove((void*)Buffer); wgpuBufferRelease(Buffer); }
	}
};

